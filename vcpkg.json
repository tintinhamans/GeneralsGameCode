{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "9eec002df1cd109f8f104cd966a763daf9751489",
  "vcpkg-configuration": {
    "overlay-ports": [ "cmake/vcpkg/ports" ],
    "overlay-triplets": [ "cmake/vcpkg/triplets" ]
  },
  "dependencies": [
    "zlib",
    "stb"
  ],
  "features": {
    "openal-ffmpeg": {
      "description": "Use FFmpeg instead of Bink for movies, and on Windows OpenAL Soft instead of Miles for audio",
      "dependencies": [
        "ffmpeg",
        {
          "name": "openal-soft",
          "platform": "windows"
        }
      ]
    }
  }
}
