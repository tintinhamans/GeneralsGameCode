{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "b61d33065508ba0d5e393206abb3cb2366299699",
  "dependencies": [
    "dxsdk-d3dx",
    "zlib",
    "stb",
    "genonline-plugin-sdk",
    "protobuf",
    {
      "name": "curl",
      "default-features": false,
      "features": [ "openssl", "websockets", "http2", "http3", "sspi" ]
    },
    {
      "name": "gamenetworkingsockets",
      "version>=": "1.6.1#1",
      "default-features": false,
      "features": [ "ice", "webrtc" ]
    },
    {
      "name": "sentry-native",
      "version>=": "0.17.6",
      "default-features": false,
      "features": [ "backend", "transport" ]
    }
  ],
  "features": {
    "ffmpeg": {
      "description": "Use FFmpeg instead of Bink for video rendering",
      "dependencies": [ "ffmpeg" ]
    },
    "openal-audio": {
      "description": "Trimmed static FFmpeg and OpenAL Soft for the OpenAL audio backend",
      "dependencies": [ "ffmpeg", "openal-soft" ]
    }
  }
}
