{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "builtin-baseline": "b61d33065508ba0d5e393206abb3cb2366299699",
  "vcpkg-configuration": {
    "overlay-ports": [ "cmake/ports" ],
    "registries": [
      {
        "kind": "git",
        "repository": "https://github.com/tintinhamans/GNS",
        "reference": "vcpkg-registry",
        "baseline": "213a9c0d0cadc33e80336d0330318970d0538be4",
        "packages": [ "gamenetworkingsockets" ]
      }
    ]
  },
  "dependencies": [
    "zlib",
    "stb",
    {
      "name": "curl",
      "default-features": false,
      "features": [ "openssl", "websockets" ]
    },
    {
      "name": "gamenetworkingsockets",
      "version>=": "1.6.1#1",
      "default-features": false,
      "features": [ "ice", "webrtc" ]
    },
    {
      "name": "sentry-native",
      "version>=": "0.17.0",
      "default-features": false,
      "features": [ "backend", "transport" ]
    }
  ],
  "features": {
    "ffmpeg": {
      "description": "Use FFmpeg instead of Bink for video rendering",
      "dependencies": [ "ffmpeg" ]
    },
    "openal-audio": {
      "description": "Trimmed static FFmpeg and OpenAL Soft for the OpenAL audio backend",
      "dependencies": [ "ffmpeg-minimal", "openal-soft" ]
    }
  }
}
