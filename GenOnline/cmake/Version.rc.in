#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GENONLINE_FV_MAJOR@,@GENONLINE_FV_MINOR@,@GENONLINE_FV_PATCH@,0
 PRODUCTVERSION @GENONLINE_FV_MAJOR@,@GENONLINE_FV_MINOR@,@GENONLINE_FV_PATCH@,0
 FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
 FILEFLAGS @GENONLINE_FILE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Generals Online\0"
            VALUE "FileDescription", "@GENONLINE_DESCRIPTION@\0"
            VALUE "FileVersion", "@GENONLINE_FILE_VERSION@\0"
            VALUE "InternalName", "@GENONLINE_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright Electronic Arts Inc. and contributors, GPL-3.0-or-later\0"
            VALUE "OriginalFilename", "@GENONLINE_ORIGINAL_NAME@\0"
            VALUE "ProductName", "Generals Online\0"
            VALUE "ProductVersion", "@GENONLINE_PRODUCT_VERSION@\0"
            VALUE "GenOnlineVersion", "@GENONLINE_COMPAT@\0"
            VALUE "GenOnlineChannel", "@GENONLINE_CHANNEL@\0"
            VALUE "GenOnlineBaselineDataPack", "@GENONLINE_BASELINE_PACK@\0"
            VALUE "GitReleaseTag", "@GENONLINE_TAG@\0"
            VALUE "GitCommit", "@GENONLINE_SHA@\0"
            VALUE "GitCommitDate", "@GENONLINE_DATE@\0"
            @GENONLINE_PRIVATE_BUILD_LINE@
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
