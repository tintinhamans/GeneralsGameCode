#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @GO_FV_MAJOR@,@GO_FV_MINOR@,@GO_FV_PATCH@,0
 PRODUCTVERSION @GO_FV_MAJOR@,@GO_FV_MINOR@,@GO_FV_PATCH@,0
 FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE | VS_FF_PRIVATEBUILD
 FILEFLAGS @GO_FILE_FLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Generals Online\0"
            VALUE "FileDescription", "@GO_DESCRIPTION@\0"
            VALUE "FileVersion", "@GO_FILE_VERSION@\0"
            VALUE "InternalName", "@GO_INTERNAL_NAME@\0"
            VALUE "LegalCopyright", "Copyright Electronic Arts Inc. and contributors, GPL-3.0-or-later\0"
            VALUE "OriginalFilename", "@GO_ORIGINAL_NAME@\0"
            VALUE "ProductName", "Generals Online\0"
            VALUE "ProductVersion", "@GO_PRODUCT_VERSION@\0"
            VALUE "GenOnlineVersion", "@GO_COMPAT@\0"
            VALUE "GenOnlineChannel", "@GO_CHANNEL@\0"
            VALUE "GenOnlineBaselineDataPack", "@GO_BASELINE_PACK@\0"
            VALUE "GitReleaseTag", "@GO_TAG@\0"
            VALUE "GitCommit", "@GO_SHA@\0"
            VALUE "GitCommitDate", "@GO_DATE@\0"
            @GO_PRIVATE_BUILD_LINE@
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
