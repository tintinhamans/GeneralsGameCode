{
  "name": "ffmpeg",
  "version": "9.0.2",
  "port-version": 1,
  "description": "FFmpeg trimmed to the Bink, WAV and MP3 demuxers and decoders the game uses.",
  "homepage": "https://ffmpeg.org",
  "license": "LGPL-2.1-or-later",
  "dependencies": [
    {
      "name": "vcpkg-cmake-get-vars",
      "host": true
    },
    {
      "name": "vcpkg-pkgconfig-get-modules",
      "host": true
    }
  ],
  "default-features": [
    "avcodec",
    "avformat",
    "swresample",
    "swscale"
  ],
  "features": {
    "avcodec": {
      "description": "Build the avcodec library"
    },
    "avformat": {
      "description": "Build the avformat library",
      "dependencies": [
        {
          "name": "ffmpeg",
          "default-features": false,
          "features": [
            "avcodec"
          ]
        }
      ]
    },
    "swresample": {
      "description": "Build the swresample library"
    },
    "swscale": {
      "description": "Build the swscale library"
    }
  }
}
