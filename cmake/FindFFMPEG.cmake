set(FFMPEG_ROOT "" CACHE PATH "Explicit FFmpeg installation (headers and import libraries)")

if(NOT FFMPEG_ROOT)
    find_package(FFMPEG CONFIG QUIET NO_MODULE)
    if(FFMPEG_FOUND)
        return()
    endif()
endif()

if(DEFINED _FFMPEG_DISCOVERY_ROOT AND NOT _FFMPEG_DISCOVERY_ROOT STREQUAL FFMPEG_ROOT)
    unset(FFMPEG_INCLUDE_DIR CACHE)
    foreach(_component avformat avcodec avutil swscale swresample)
        unset(FFMPEG_${_component}_LIBRARY CACHE)
    endforeach()
endif()
set(_FFMPEG_DISCOVERY_ROOT "${FFMPEG_ROOT}" CACHE INTERNAL "FFmpeg discovery root" FORCE)

set(_ffmpeg_paths)
if(FFMPEG_ROOT)
    list(APPEND _ffmpeg_paths NO_DEFAULT_PATH)
endif()
find_path(FFMPEG_INCLUDE_DIR libavcodec/avcodec.h HINTS "${FFMPEG_ROOT}/include" ${_ffmpeg_paths})
set(FFMPEG_LIBRARIES)
set(_ffmpeg_required FFMPEG_INCLUDE_DIR)
foreach(_component avformat avcodec avutil swscale swresample)
    find_library(FFMPEG_${_component}_LIBRARY NAMES ${_component}
        HINTS "${FFMPEG_ROOT}/lib" "${FFMPEG_ROOT}/bin" ${_ffmpeg_paths})
    list(APPEND _ffmpeg_required FFMPEG_${_component}_LIBRARY)
    list(APPEND FFMPEG_LIBRARIES "${FFMPEG_${_component}_LIBRARY}")
endforeach()
# A static install ships no runtime DLLs and needs the Windows libs FFmpeg calls.
set(_ffmpeg_static OFF)
if(WIN32 AND FFMPEG_INCLUDE_DIR)
    # FFMPEG_ROOT or the vcpkg installed tree (trimmed ffmpeg overlay port)
    get_filename_component(_ffmpeg_prefix "${FFMPEG_INCLUDE_DIR}" DIRECTORY)
    file(GLOB _ffmpeg_runtime_dlls "${_ffmpeg_prefix}/bin/avcodec*.dll")
    if(NOT _ffmpeg_runtime_dlls)
        set(_ffmpeg_static ON)
        list(APPEND FFMPEG_LIBRARIES bcrypt ole32 user32)
    endif()
endif()
set(FFMPEG_STATIC ${_ffmpeg_static} CACHE INTERNAL "FFmpeg links statically" FORCE)
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(FFMPEG REQUIRED_VARS ${_ffmpeg_required})
set(FFMPEG_INCLUDE_DIRS "${FFMPEG_INCLUDE_DIR}")
mark_as_advanced(${_ffmpeg_required})
