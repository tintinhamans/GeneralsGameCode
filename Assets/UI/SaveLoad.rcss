/*
	SaveLoad.rcss -- SaveLoad.wnd (the main menu's Load Game) and PopupSaveLoad.wnd (the in-game
	Save/Load, body.popup) on the screen template (common.rcss): a rich list of the saves in the
	main column (name, campaign and mission or map, date and time), the selected save's card on the
	right, and the load / overwrite / save name / delete confirmations as modal cards on a scrim.

	Over the game (body.popup) the page sits on a scrim that dims the game, like the options.
	A save game keeps no map picture the list can show (the save list only reads the save's header),
	so the card leads with what the save is instead of a thumbnail.
*/

body.popup
{
	background-color: #03050CC8;
}

/* ---- Save list ------------------------------------------------------------------------------- */
.saves
{
	display: flex;
	flex-direction: column;
	min-height: 0;
	padding: 10dp 20dp 10dp 20dp;
}

.head-name
{
	flex: 1 1 0%;
	min-width: 0;
}

.head-when
{
	flex: 0 0 200dp;
	text-align: right;
}

.save-list
{
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

.save-row
{
	height: 72dp;
	padding-left: 15dp;
	color: #D7DCF0;
}

.save-row.locked
{
	pointer-events: none;
}

/* The new save entry leads with a plus. */
.save-mark
{
	flex: 0 0 auto;
	box-sizing: border-box;
	width: 38dp;
	height: 38dp;
	margin-right: 14dp;
	line-height: 34dp;
	text-align: center;
	font-size: 28dp;
	font-weight: bold;
	color: #FF9A3D;
	border: 2dp #F07A1A;
}

.save-main
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.save-name
{
	display: block;
	font-size: 21dp;
	line-height: 27dp;
	font-weight: bold;
	color: #EEF1FA;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.save-row.new .save-name
{
	color: #FF9A3D;
}

.save-sub
{
	display: block;
	margin-top: 2dp;
	font-size: 16dp;
	line-height: 21dp;
	color: #A9B1CF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.save-sep
{
	margin: 0 8dp;
	color: #7079A0;
}

.save-chip
{
	padding: 0 8dp;
	margin-right: 10dp;
	font-size: 13dp;
	line-height: 19dp;
}

.save-when
{
	display: block;
	flex: 0 0 200dp;
	margin-left: 14dp;
	text-align: right;
}

.save-date
{
	display: block;
	font-size: 19dp;
	line-height: 25dp;
	color: #EEF1FA;
}

.save-time
{
	display: block;
	margin-top: 2dp;
	font-size: 16dp;
	line-height: 21dp;
	color: #7079A0;
}

.save-row.selected .save-name
{
	color: #FFFFFF;
}

.save-row.selected .save-sub, .save-row.selected .save-time
{
	color: #C4CAE4;
}

/* ---- Details card ---------------------------------------------------------------------------- */
.detail-col
{
	width: 520dp;
}

.detail
{
	display: flex;
	flex-direction: column;
	flex: 0 1 auto;
	min-height: 0;
	padding: 20dp 28dp 30dp 28dp;
	border-top: 4dp #3A46D0;
}

.detail-body
{
	display: block;
	flex: 0 1 auto;
	min-height: 0;
	overflow-y: auto;
}

.detail-kind
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

.detail-kind .chip-label
{
	margin: 0 8dp 4dp 0;
}

.detail-name
{
	display: block;
	margin-top: 16dp;
	font-size: 30dp;
	line-height: 36dp;
	font-weight: bold;
	color: #FFFFFF;
}

.facts
{
	display: block;
	margin-top: 22dp;
	border-top: 1dp #8080FF28;
	padding-top: 6dp;
}

.fact
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-top: 14dp;
}

.fact .stat-label
{
	letter-spacing: 0;
}

.fact-row
{
	display: flex;
	flex-direction: row;
}

.fact-value
{
	display: block;
	margin-top: 2dp;
	font-size: 21dp;
	font-weight: bold;
	color: #EEF1FA;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-new-mark
{
	display: block;
	box-sizing: border-box;
	width: 64dp;
	height: 64dp;
	margin-top: 10dp;
	line-height: 58dp;
	text-align: center;
	font-size: 44dp;
	font-weight: bold;
	color: #FF9A3D;
	border: 3dp #F07A1A;
}

.detail-hint
{
	display: block;
	margin-top: 8dp;
	color: #A9B1CF;
}

/* ---- Modal cards ------------------------------------------------------------------------------- */
.modal-scrim
{
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 10;
	background-color: #03050CB4;
}

.modal-card
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	width: 680dp;
	padding: 28dp 32dp 28dp 32dp;
	background-color: #070A1AF0;
	border-top: 4dp #F07A1A;
}

.modal-card.danger
{
	border-top-color: #FF5050;
}

.modal-title
{
	display: block;
	font-size: 30dp;
	line-height: 36dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
}

.modal-message
{
	display: block;
	margin-top: 16dp;
	color: #D7DCF0;
}

.modal-label
{
	margin-top: 20dp;
	margin-bottom: 10dp;
}

.modal-input
{
	display: block;
	box-sizing: border-box;
	width: 100%;
}

.modal-actions
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 30dp;
}

.screen .modal-actions button.btn-cta
{
	height: 55dp;
	line-height: 55dp;
	min-width: 220dp;
	padding: 0 34dp;
	font-size: 21dp;
}

.screen .modal-card.danger button.btn-cta
{
	color: #FFFFFF;
	decorator: vertical-gradient(#E04848 #B82E2E);
}

.screen .modal-card.danger button.btn-cta:hover
{
	decorator: vertical-gradient(#F05A5A #C83838);
}

/* ---- 5:4 and 4:3 ------------------------------------------------------------------------------ */
@media (max-aspect-ratio: 3/2)
{
	.detail-col { width: 360dp; }
	.head-when, .save-when { flex-basis: 150dp; }
}
