/*
	OnlineLogin.rcss -- the screen under the Generals Online login flow, on the screen template
	(common.rcss). It has no controls (see OnlineLogin.rml): the ruler frame and header over the
	map, the centre left free for the message-box card the login flow shows, and a pulsing status
	where the back button would be (there is no way back from here but that card's Cancel).
*/

.login-status
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 55dp;
	padding: 0 24dp 0 20dp;
	font-size: 19dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #C4CAE4;
	background-color: #070A1AC8;
}

.login-status .dot
{
	margin-right: 14dp;
	background-color: #D1FD04;
}
