<rml>
<head>
	<title>NetworkDirectConnect</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="NetworkDirectConnect.rcss"/>
</head>
<body class="screen" data-model="networkdirectconnect">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="screen-frame">
		<div class="screen-header">
			<div class="screen-heading">
				<div class="screen-crumb"><gametext key="GUI:LANLobby"/><span class="crumb-sep">&#8250;</span></div>
				<div class="screen-title"><gametext key="GUI:DirectConnect"/></div>
			</div>
		</div>

		<!-- One card in the middle of the map: who you are, the address others join you on, and the
		     address to join, with the addresses joined before under it. -->
		<div class="screen-body dc-body">
			<div class="surface dc-card">
				<div class="dc-field">
					<div class="overline dc-label"><gametext key="GUI:PlayerName"/></div>
					<input type="text" class="text-input dc-input" data-value="player_name"/>
				</div>

				<div class="dc-local">
					<div class="overline dc-label"><gametext key="GUI:LocalIPDesc"/></div>
					<div class="dc-ip">{{local_ip}}</div>
				</div>

				<div class="dc-field dc-remote">
					<div class="overline dc-label"><gametext key="GUI:RemoteIPDesc"/></div>
					<input type="text" class="text-input dc-input" data-value="remote_ip_text" data-event-change="remote_ip_text_changed"/>
					<div class="dc-history">
						<div data-for="entry : remote_ip_history">
							<div class="row-item dc-history-row" data-if="entry.used" data-class-selected="entry.is_selected"
								data-event-click="select_remote_ip(entry.index)">{{entry.text}}</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			<div class="spacer"></div>
			<button data-event-click="host_game"><gametext key="GUI:Host"/></button>
			<button class="btn-cta" data-event-click="join_game"><gametext key="GUI:Join"/></button>
		</div>
	</div>
</body>
</rml>
