/*
	common.rcss -- shared look for every RmlUi shell screen.

	Palette, taken from the original .wnd menus (Data/Window/Menus/*.wnd) so RmlUi screens
	keep the native Generals look:
		panel background   rgba(2, 2, 2, 191)     -- ~75% alpha dark panel
		panel border       #2F37A8                -- thin blue border (47 55 168)
		text               #FFFFFF                -- white
		hilite / focus     #8080FF                -- hilite blue (128 128 255)
		disabled text      #C0C0C0                -- disabled grey (192 192 192)

	Sizing uses RmlUi's dp unit throughout; RmlUiManager sets the context's
	density-independent-pixel ratio to screen height / 1080 so 1dp keeps the same apparent
	size (and the same relative layout) at any resolution/aspect ratio -- no per-callsite
	scaling math needed in the RML itself.
*/

body
{
	font-family: Barlow;
	font-size: 16dp;
	color: #FFFFFF;
}

/* ---- Frame: the translucent bordered panel every screen is drawn on ------------------- */
.frame
{
	background-color: rgba(2, 2, 2, 191);
	border: 2dp #2F37A8;
	padding: 12dp;
}

.title-bar
{
	font-size: 22dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	padding-bottom: 8dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 8dp;
}

/* ---- Tabs -------------------------------------------------------------------------- */
.tabs
{
	display: flex;
	flex-direction: row;
	margin-bottom: 8dp;
}

.tab
{
	flex: 1 1 auto;
	text-align: center;
	padding: 6dp 4dp;
	color: #C0C0C0;
	background-color: rgba(2, 2, 2, 140);
	border: 1dp #2F37A8;
	margin-right: 2dp;
	font-weight: bold;
}

.tab:hover
{
	color: #FFFFFF;
}

.tab.selected
{
	color: #FFFFFF;
	background-color: rgba(47, 55, 168, 120);
	border: 1dp #8080FF;
}

/* ---- Rows: label left, control right, on a grid ------------------------------------- */
.row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4dp 0;
	min-height: 28dp;
}

.row > .label
{
	flex: 1 1 auto;
	color: #FFFFFF;
}

.row > .control
{
	flex: 0 0 auto;
	width: 220dp;
}

.row.disabled > .label,
.row.disabled > .control
{
	color: #C0C0C0;
}

/* ---- Buttons ------------------------------------------------------------------------ */
button, .button
{
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 6dp 16dp;
	text-align: center;
	font-weight: bold;
}

button:hover, .button:hover
{
	border-color: #8080FF;
	color: #8080FF;
}

button:disabled, .button.disabled
{
	color: #C0C0C0;
	border-color: #6A6A6A;
}

/* ---- Dropdown (select) --------------------------------------------------------------- */
select
{
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 4dp 8dp;
}

select:hover
{
	border-color: #8080FF;
}

/* ---- Slider (input type=range) ------------------------------------------------------- */
input.range
{
	width: 100%;
	height: 16dp;
}

input.range slidertrack
{
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
	height: 4dp;
}

input.range sliderbar
{
	background-color: #8080FF;
	border: 1dp #2F37A8;
	width: 12dp;
}

/* ---- Checkbox ------------------------------------------------------------------------- */
input.checkbox
{
	width: 18dp;
	height: 18dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

input.checkbox:checked
{
	background-color: #8080FF;
	border-color: #8080FF;
}

/* ---- Scroll container ------------------------------------------------------------------ */
.scroll-container
{
	overflow-y: auto;
	flex: 1 1 auto;
}

/* ---- Footer button row ------------------------------------------------------------------ */
.footer
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 8dp;
	border-top: 1dp #2F37A8;
	padding-top: 8dp;
}

.footer button
{
	margin-left: 8dp;
}
