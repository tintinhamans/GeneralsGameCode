/*
	common.rcss -- shared look for every RmlUi shell screen.

	Palette, taken from the original .wnd menus (Data/Window/Menus/*.wnd) so RmlUi screens
	keep the native Generals look:
		panel background   rgba(2, 2, 2, 191)     -- ~75% alpha dark panel
		panel border       #2F37A8                -- thin blue border (47 55 168)
		text               #FFFFFF                -- white
		hilite / focus     #8080FF                -- hilite blue (128 128 255)
		button hilite      #BAFF0C                -- PUSHBUTTON hilite text (186 255 12)
		muted text         #C0C0C0                -- disabled grey (192 192 192)
		disabled text      #7C7E99                -- text of a disabled control

	Sizing uses RmlUi's dp unit throughout; RmlUiManager sets the context's
	density-independent-pixel ratio to screen height / 1080 so 1dp keeps the same apparent
	size (and the same relative layout) at any resolution/aspect ratio -- no per-callsite
	scaling math needed in the RML itself.

	Design tokens. RCSS has no variables, so these values are the contract: screen sheets use
	them (or the classes that carry them) instead of one-off sizes.
	  Type scale     display  40dp bold       splash text only: load screen titles and names, challenge title
	                 title    26dp bold       .title-bar, .shell-title-bar, .t-title
	                 section  18dp bold       .section-title, .slot-header, .t-section
	                 body     16dp            body, .t-body
	                 small    13dp            .t-small (versions, hints, map marker labels)
	  Controls       control height 32dp      select, .text-input, .chat-input, .btn-inline, .icon-btn
	                 row height 40dp          .slot-row; list rows (.list-row) are 30dp
	  Buttons        primary   48dp tall, 20dp text, at least 180dp wide   .btn-primary (= .button-lg)
	                 secondary 34dp tall, 16dp text                        button
	                 inline    32dp tall, 14dp text                        .btn-inline
	                 icon      32dp square                                 .icon-btn
	                 button text is always upper case
	  Spacing        4 / 8 / 12 / 16 / 24dp   (xs / s / m / l / xl)
	  Panels         frame padding 16dp, sub-panel padding 12dp, 1dp #2F37A8 separators

	Shared components. Every screen links this sheet, so mods restyle a component here once
	instead of per screen (screen sheets only hold what is unique to that screen; GameSetup.rcss
	adds the setup-screen pieces):

	  Frames        .frame, .title-bar             centered dialog panel and its heading
	                .shell-frame, .shell-title-bar, .shell-background
	                                               full-screen blueprint panel; put class="shell" on <body>
	                .panel-box                     bordered sub-panel inside a frame
	  Layout        .row > .label + .control       label/control grid: label 40%, control the rest;
	                                               wrap a checkbox in <div class="control"> to keep the grid
	                .tabs > .tab(.selected)        tab strip
	                .footer, .footer-split         button row along the bottom edge
	                .spacer                        pushes what follows to the far end of a flex row
	                .section-title                 underlined heading over a column or list
	  Controls      .btn-primary/.button-lg, button, .btn-inline, .icon-btn, button.active (toggle on)
	                select (drop-down arrow from the .wnd combo box art), .color-swatch,
	                input.range, input.checkbox, .text-input
	  Lists         .list-box (+ .opaque)          bordered pane; combine with .scroll-container
	                .list-row (+ .flex, .compact, .selected)
	                                               one entry of a .list-box; block by default, .flex for cells
	                .text-list, .text-line         bordered pane of plain text lines (status feed, MOTD)
	  Chat          .chat > .chat-log > .chat-line       fixed-height block: scrolling lines ...
	                     > .chat-entry > .chat-input + .icon-btn   ... over the entry row
	                <scrolllog>                    scrolling pane that stays at its newest line unless
	                                               the user scrolled up; use it for .chat-log and log-style
	                                               .text-list panes (plain <div> for ones that start at the top)
	  Rank cluster  .rank-column, .rank-border, .rank-image-wrap, .rank-image, .faction-image,
	                .rank-progress(-fill), .rank-label   rank portrait, faction badge, progress, name
	  Popups        .context-menu(-backdrop/-item) right-click menu placed at the cursor

	A bare <div data-for="..."> wrapping a row is inline unless it is a direct child of a .list-box or
	.text-list (which makes it a block); a row that is a data-for element itself needs display:block,
	which .list-row and .chat-line/.text-line already give it.
*/

body
{
	font-family: Barlow;
	font-size: 16dp;
	color: #FFFFFF;
}

/* ---- Type scale ------------------------------------------------------------------------ */
.t-title { font-size: 26dp; font-weight: bold; }
.t-section { font-size: 18dp; font-weight: bold; }
.t-body { font-size: 16dp; }
.t-small { font-size: 13dp; }
.t-muted { color: #C0C0C0; }

/* ---- Frame: the translucent bordered panel every screen is drawn on ------------------- */
.frame
{
	background-color: rgba(2, 2, 2, 191);
	border: 2dp #2F37A8;
	padding: 16dp;
}

.title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	padding-bottom: 8dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 12dp;
}

/* Bordered sub-panel inside a frame (option groups, honors, stats). */
.panel-box
{
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
	padding: 12dp;
}

/* ---- Tabs -------------------------------------------------------------------------- */
.tabs
{
	display: flex;
	flex-direction: row;
	margin-bottom: 12dp;
}

.tab
{
	flex: 1 1 0%;
	box-sizing: border-box;
	height: 34dp;
	line-height: 32dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #C0C0C0;
	background-color: rgba(2, 2, 2, 140);
	border: 1dp #2F37A8;
	margin-right: 4dp;
}

.tab:last-child
{
	margin-right: 0;
}

.tab:hover
{
	color: #FFFFFF;
	border-color: #8080FF;
}

.tab.selected
{
	color: #FFFFFF;
	background-color: rgba(47, 55, 168, 140);
	border: 1dp #8080FF;
}

/* ---- Rows: label/control grid ------------------------------------------------------------
   The label takes 40% of the row and the control the rest, so every control of a panel starts
   at the same x. A checkbox goes inside <div class="control"> so it sits at that x too. */
.row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 32dp;
	margin-bottom: 8dp;
}

.row > .label
{
	flex: 0 0 40%;
	box-sizing: border-box;
	padding-right: 12dp;
	color: #FFFFFF;
}

.row > .control
{
	flex: 1 1 0%;
	min-width: 0;
}

.row > .control.checkbox
{
	flex: 0 0 auto;
}

.row.disabled > .label,
.row.disabled > .control
{
	color: #C0C0C0;
}

/* ---- Buttons -------------------------------------------------------------------------
   The engine's own capsule button art (the Buttons, Buttons-HiLite, Buttons-Pushed and
   Buttons-Disabled Left/Middle/Right mapped images, exposed as sprites by RmlUiFileInterface):
   fixed end caps scaled to the button height, stretched middle. Text colours and the 1dp dark shadow follow
   the .wnd PUSHBUTTON text colours (white / 186,255,12 hilite / 62,64,92 disabled).
   Three sizes with fixed heights and one line of centred, upper case text: button (secondary),
   .btn-primary/.button-lg (footer and menu actions) and .btn-inline (next to a 32dp control). */
button, .button
{
	display: inline-block;
	box-sizing: border-box;
	decorator: tiled-horizontal(Buttons-Left, Buttons-Middle, Buttons-Right);
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	height: 34dp;
	line-height: 34dp;
	padding: 0 18dp;
	font-size: 16dp;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	white-space: nowrap;
}

.btn-primary, .button-lg
{
	height: 48dp;
	line-height: 48dp;
	padding: 0 32dp;
	min-width: 180dp;
	font-size: 20dp;
}

.btn-inline
{
	height: 32dp;
	line-height: 32dp;
	padding: 0 12dp;
	font-size: 14dp;
}

button:hover, .button:hover
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

button:active, .button:active
{
	decorator: tiled-horizontal(Buttons-Pushed-Left, Buttons-Pushed-Middle, Buttons-Pushed-Right);
	color: #BAFF0C;
}

/* A toggle button that is on (sort/filter/tab buttons): drawn lit like a hovered button. */
button.active
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

/* <button> never gets :disabled in RmlUi; match the disabled attribute that data-attrif-disabled sets.
   Listed after :hover/:active (and repeated with them) so a disabled button never lights up. */
button:disabled, button[disabled], .button.disabled, button.disabled,
button[disabled]:hover, button.disabled:hover, .button.disabled:hover,
button[disabled]:active, button.disabled:active, .button.disabled:active
{
	decorator: tiled-horizontal(Buttons-Disabled-Left, Buttons-Disabled-Middle, Buttons-Disabled-Right);
	color: #3E405C;
	font-effect: shadow(1dp 1dp #1F202F);
}

/* Square glyph/icon buttons are too small for the capsule end caps: keep the plain bordered box. */
.icon-btn, .joingame-close,
.icon-btn:hover, .joingame-close:hover,
.icon-btn:active, .joingame-close:active
{
	decorator: none;
	font-effect: none;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

.icon-btn:hover, .joingame-close:hover
{
	border-color: #8080FF;
	color: #8080FF;
}

/* Fixed 32dp square (the control height) holding a <mappedimage> glyph (chat send/emote, list
   refresh). The art isn't always perfectly square, so both the button and the image clip instead of
   overflowing. The doubled class outranks a screen's "<container> button { padding }" rule. */
.icon-btn.icon-btn
{
	width: 32dp;
	height: 32dp;
	min-width: 0;
	line-height: 30dp;
	padding: 3dp;
	text-align: center;
	overflow: hidden;
}

.icon-btn mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

/* ---- Dropdown (select) ---------------------------------------------------------------
   32dp control with the .wnd combo box's drop-down button art on the right
   (COMBOBOXDROPDOWNBUTTON*DRAWDATA: VSliderDownButtonEnabled/-Hilite/-HiliteSelected/-Disabled).
   The open list is opaque, scrolls past ten rows and lights the hovered row. */
select
{
	display: inline-block;
	box-sizing: border-box;
	height: 32dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	font-size: 16dp;
	vertical-align: middle;
}

select selectvalue
{
	height: 30dp;
	line-height: 30dp;
	margin-right: 32dp;
	padding: 0 8dp;
	white-space: nowrap;
	overflow: hidden;
}

select selectarrow
{
	width: 30dp;
	height: 30dp;
	decorator: image(VSliderDownButtonEnabled);
}

select:hover, select:focus
{
	border-color: #8080FF;
}

select:hover selectarrow
{
	decorator: image(VSliderDownButtonHilite);
}

select:checked selectarrow
{
	decorator: image(VSliderDownButtonHiliteSelected);
}

select[disabled], select[disabled]:hover
{
	border-color: rgba(47, 55, 168, 110);
	background-color: rgba(2, 2, 2, 120);
	color: #7C7E99;
}

select[disabled] selectarrow, select[disabled]:hover selectarrow
{
	decorator: image(VSliderDownButtonDisabled);
	opacity: 0.6;
}

select selectbox
{
	box-sizing: border-box;
	background-color: #06061A;
	border: 1dp #8080FF;
	padding: 2dp 0;
	max-height: 320dp;
	overflow-y: auto;
	z-index: 100;
}

select selectbox option
{
	height: 30dp;
	line-height: 30dp;
	padding: 0 10dp;
	white-space: nowrap;
	color: #FFFFFF;
}

select selectbox option:hover
{
	background-color: rgba(47, 55, 168, 220);
}

select selectbox option:checked
{
	color: #BAFF0C;
}

/* Colour choice: a swatch in front of the colour's name (a hollow swatch for Random). */
.color-swatch
{
	display: inline-block;
	width: 14dp;
	height: 14dp;
	margin-right: 8dp;
	border: 1dp rgba(255, 255, 255, 160);
	vertical-align: middle;
}

/* ---- Slider (input type=range) ------------------------------------------------------- */
input.range
{
	height: 20dp;
}

input.range slidertrack
{
	margin-top: 7dp;
	height: 6dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

input.range sliderbar
{
	width: 12dp;
	height: 20dp;
	background-color: #8080FF;
	border: 1dp #2F37A8;
}

input.range sliderbar:hover
{
	background-color: #BAFF0C;
}

input.range[disabled] sliderbar
{
	background-color: #3E405C;
}

/* ---- Checkbox -------------------------------------------------------------------------
   The .wnd checkbox art (CHECKBOX draw data: Active-Unchecked/-HiLighted/-Checked and
   Disabled-Unchecked/-Checked). */
input.checkbox
{
	width: 20dp;
	height: 20dp;
	decorator: image(Active-Unchecked);
}

input.checkbox:hover
{
	decorator: image(Active-HiLighted);
}

input.checkbox:checked, input.checkbox:checked:hover
{
	decorator: image(Active-Checked);
}

input.checkbox[disabled], input.checkbox[disabled]:hover
{
	decorator: image(Disabled-Unchecked);
}

input.checkbox[disabled]:checked
{
	decorator: image(Disabled-Checked);
}

/* ---- Scroll container ------------------------------------------------------------------ */
/* min-height: 0 lets the box shrink to its frame; without it a flex item never goes below its
   content height, so a long list grows past the frame instead of scrolling. */
.scroll-container
{
	overflow-y: auto;
	flex: 1 1 auto;
	min-height: 0;
}

/* Scrollbar must be sized explicitly: unstyled, RmlUi gives it the container's full width, so as
   soon as a list needs to scroll its content width collapses to ~0 (one word per line). */
scrollbarvertical
{
	width: 12dp;
}

scrollbarvertical slidertrack
{
	width: 12dp;
	background-color: rgba(2, 2, 2, 191);
	border-left: 1dp rgba(47, 55, 168, 110);
}

scrollbarvertical sliderbar
{
	width: 12dp;
	min-height: 32dp;
	background-color: #2F37A8;
}

scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active
{
	background-color: #8080FF;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
	width: 0dp;
	height: 0dp;
}

/* ---- Text input -------------------------------------------------------------------------- */
.text-input, .chat-input
{
	box-sizing: border-box;
	height: 32dp;
	line-height: 30dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 0 8dp;
}

.text-input:hover, .chat-input:hover
{
	border-color: #5A5FD0;
}

.text-input[disabled]
{
	color: #7C7E99;
	border-color: rgba(47, 55, 168, 110);
}

.text-input:focus, .chat-input:focus
{
	border-color: #8080FF;
}

/* ---- Small layout helpers -------------------------------------------------------------- */
/* Pushes whatever follows it to the far end of a flex row. */
.spacer
{
	flex: 1 1 auto;
}

/* Underlined heading over a column or list. */
.section-title
{
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	padding-bottom: 4dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 8dp;
	flex: 0 0 auto;
}

/* <scrolllog> is a scrolling block that keeps itself at its newest line (C++ RmlScrollLogElement). */
scrolllog
{
	display: block;
	overflow-y: auto;
}

/* ---- Boxed lists -------------------------------------------------------------------------
   Combine with .scroll-container. .list-box is the bordered pane around a list of .list-row
   entries, .text-list the same pane for plain text lines (status feed, message of the day), and
   .chat-log the darker, tail-following variant a .chat uses. */
.list-box, .text-list, .chat-log
{
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
}

.list-box.opaque
{
	background-color: rgba(2, 2, 2, 191);
}

.text-list, .chat-log
{
	padding: 4dp 6dp;
}

/* The bare <div data-for="..."> wrapping each row is display:inline (no UA stylesheet), and a block
   inside an inline wrapper gets no reliable width; make the wrapper a real block. */
.list-box > div, .text-list > div
{
	display: block;
}

/* One line inside a .text-list. */
.text-line
{
	display: block;
	padding: 1dp 0;
}

/* ---- List row -----------------------------------------------------------------------------
   One entry of a .list-box. Block by default: RmlUi lays out data-for children as inline unless told
   otherwise, so every row needs the display. Add .flex for a row of cells (icon, name, count), and
   .compact for the tighter padding. .selected marks the chosen row, hover lights it. */
.list-row
{
	display: block;
	box-sizing: border-box;
	min-height: 30dp;
	padding: 5dp 8dp;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.list-row.flex
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.list-row.compact
{
	min-height: 26dp;
	padding: 2dp 8dp;
}

.list-row:hover
{
	background-color: rgba(47, 55, 168, 60);
}

.list-row.selected
{
	background-color: rgba(47, 55, 168, 120);
	border: 1dp #8080FF;
}

/* ---- Chat ---------------------------------------------------------------------------------
   <div class="chat"> is the fixed-height block at the bottom of a screen: a .chat-log (scrolling
   lines, one .chat-line each) over a .chat-entry row (a .chat-input and one or two .icon-btn). */
.chat
{
	display: flex;
	flex-direction: column;
	margin-top: 12dp;
	height: 160dp;
}

.chat-log
{
	flex: 1 1 0%;
	min-height: 0;
	background-color: rgba(2, 2, 2, 191);
}

.chat-line
{
	display: block;
}

.chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 8dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 8dp;
}

/* ---- Rank cluster --------------------------------------------------------------------------
   Rank portrait, faction badge, progress bar and rank name (online welcome, player info, quick
   match stats). Uses fixed dp sizes (matching WOLWelcomeMenu.wnd's RankBorder/WinRank/FactionImage
   1:1) instead of percentages -- dp already scales with screen height (see common.rcss header
   comment), so this still scales consistently across resolutions, just not stretched
   independently like the .wnd's own non-uniform 800x600 stretch. mappedimage itself does resolve
   percentage width/height fine (its inner <img> is always 100%x100% of it); fixed dp is used here
   only because the whole rank-column is a fixed-width column, not a mappedimage limitation. */
.rank-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 128dp;
	margin-right: 12dp;
}

.rank-border
{
	position: relative;
	box-sizing: border-box; /* declared width/height must include the border, or this (and its
		border-box child .rank-progress below) overflow rank-column by the border width
		(audit: OVERFLOW div.rank-border / div.rank-progress) */
	width: 128dp;
	height: 156dp;
	background-color: #020280;
	border: 1dp #2F37A8;
}

.rank-image-wrap
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 100%; /* fill rank-border's content box exactly, instead of duplicating its 128dp and
		overflowing once rank-border switched to box-sizing:border-box */
	height: 128dp;
	border-bottom: 1dp #2E37A8;
}

.rank-image
{
	display: block;
	width: 100%;
	height: 128dp;
}

.faction-image
{
	display: block;
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 48dp;
	height: 48dp;
}

.rank-progress
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	left: 0;
	bottom: 0;
	width: 100%; /* fill rank-border's content box exactly, see .rank-image-wrap above */
	height: 24dp;
	background-color: rgba(2, 2, 2, 164);
	border: 1dp #FFBB00;
}

.rank-progress-fill
{
	height: 100%;
	background-color: rgba(59, 255, 0, 200);
}

.rank-label
{
	margin-top: 4dp;
	text-align: center;
	flex: 0 0 auto;
}

/* ---- Footer button row ------------------------------------------------------------------ */
.footer
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex: 0 0 auto;
	margin-top: 12dp;
	border-top: 1dp #2F37A8;
	padding-top: 12dp;
}

.footer button
{
	margin-left: 12dp;
}

/* Primary action left, secondary (Main Menu) right -- matches the .wnd originals (e.g.
   Skirmish's Play Game / Main Menu) instead of grouping both buttons at the right edge. */
.footer-split
{
	justify-content: space-between;
}

.footer-split button
{
	margin-left: 0;
}

/* ---- Shell frame: full-screen blueprint background + bordered panel ------------------
   Shared by screens whose .wnd fills the whole 800x600 blueprint-ruler backdrop (see
   WOLWelcomeMenu.wnd's WOLWelcomeMenuParent/MainMenuRuler + GadgetParent), instead of
   floating in a fixed-size dialog like .frame. Percent geometry mirrors the .wnd's own
   non-uniform 800x600-to-screen stretch. */
.shell-background
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -1;
}

body.shell
{
	width: 100%;
	height: 100%;
}

.shell-frame
{
	box-sizing: border-box;
	position: absolute;
	left: 5.6%;
	top: 7.3%;
	width: 88.8%;
	height: 85.4%;
	background-color: rgba(2, 2, 2, 190);
	border: 2dp #2F37A8;
	padding: 16dp;
	display: flex;
	flex-direction: column;
}

.shell-title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: left;
	padding-bottom: 8dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 12dp;
	flex: 0 0 auto;
}

/* ---- Right-click context menu -------------------------------------------------------------
   Generic reusable popup for the RC*.wnd-style right-click menus (WOLLobbyMenu.cpp's
   GLM_RIGHT_CLICKED, WOLBuddyOverlay.cpp's own right-click menus). A screen positions
   .context-menu at the cursor via data-style-left/top (pre-clamped on-screen by the caller,
   same clamp WOLLobbyMenu.cpp's GLM_RIGHT_CLICKED does against TheDisplay's width/height) and
   toggles it + a full-viewport .context-menu-backdrop with data-if="menu_visible"; the backdrop
   sits behind the menu and closes it on any click outside, replacing winSetLoneWindow()'s
   click-away-closes behavior. Both use position:fixed (viewport-relative), not absolute: a caller
   may nest .context-menu inside an already-positioned ancestor (e.g. OnlineLobby.rml's
   .shell-frame), and RmlUi's mouse_x/mouse_y event coordinates the caller feeds into
   data-style-left/top are viewport-relative, not relative to that ancestor. */
.context-menu-backdrop
{
	display: block;
	position: fixed;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 100;
}

.context-menu
{
	display: block;
	position: fixed;
	z-index: 101;
	background-color: rgba(2, 2, 2, 235);
	border: 1dp #2F37A8;
	min-width: 110dp;
}

.context-menu-item
{
	display: block;
	height: 30dp;
	line-height: 30dp;
	padding: 0 12dp;
	color: #FFFFFF;
	text-align: center;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.context-menu-item:last-child
{
	border-bottom: 0dp transparent;
}

.context-menu-item:hover
{
	background-color: rgba(47, 55, 168, 160);
}
