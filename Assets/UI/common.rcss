/*
	common.rcss -- shared look for every RmlUi shell screen.

	Palette, taken from the original .wnd menus (Data/Window/Menus/*.wnd) so RmlUi screens
	keep the native Generals look:
		panel background   rgba(2, 2, 2, 191)     -- ~75% alpha dark panel
		panel border       #2F37A8                -- thin blue border (47 55 168)
		text               #FFFFFF                -- white
		hilite / focus     #8080FF                -- hilite blue (128 128 255)
		button hilite      #BAFF0C                -- PUSHBUTTON hilite text (186 255 12)
		muted text         #C0C0C0                -- disabled grey (192 192 192)
		disabled text      #7C7E99                -- text of a disabled control

	Sizing uses RmlUi's dp unit throughout; RmlUiManager sets the context's
	density-independent-pixel ratio to screen height / 1080 so 1dp keeps the same apparent
	size (and the same relative layout) at any resolution/aspect ratio -- no per-callsite
	scaling math needed in the RML itself.

	Design tokens. RCSS has no variables, so these values are the contract: screen sheets use
	them (or the classes that carry them) instead of one-off sizes.
	  Type scale     display  40dp bold       splash text only: load screen titles and names, challenge title
	                 title    26dp bold       .title-bar, .shell-title-bar, .t-title
	                 section  18dp bold       .section-title, .slot-header, .t-section
	                 body     16dp            body, .t-body
	                 small    13dp            .t-small (versions, hints, map marker labels)
	  Controls       control height 32dp      select, .text-input, .chat-input, .btn-inline, .icon-btn
	                 row height 40dp          .slot-row; list rows (.list-row) are 30dp
	  Buttons        primary   48dp tall, 20dp text, at least 180dp wide   .btn-primary (= .button-lg)
	                 secondary 34dp tall, 16dp text                        button
	                 inline    32dp tall, 14dp text                        .btn-inline
	                 icon      32dp square                                 .icon-btn
	                 button text is always upper case
	  Spacing        4 / 8 / 12 / 16 / 24dp   (xs / s / m / l / xl)
	  Panels         frame padding 16dp, sub-panel padding 12dp, 1dp #2F37A8 separators

	Shared components. Every screen links this sheet, so mods restyle a component here once
	instead of per screen (screen sheets only hold what is unique to that screen; GameSetup.rcss
	adds the setup-screen pieces):

	  Frames        .frame, .title-bar             centered dialog panel and its heading
	                .shell-frame, .shell-title-bar, .shell-background
	                                               full-screen blueprint panel; put class="shell" on <body>
	                .panel-box                     bordered sub-panel inside a frame
	  Layout        .row > .label + .control       label/control grid: label 40%, control the rest;
	                                               wrap a checkbox in <div class="control"> to keep the grid
	                .tabs > .tab(.selected)        tab strip
	                .footer, .footer-split         button row along the bottom edge
	                .spacer                        pushes what follows to the far end of a flex row
	                .section-title                 underlined heading over a column or list
	  Controls      .btn-primary/.button-lg, button, .btn-inline, .icon-btn, button.active (toggle on)
	                select (drop-down arrow from the .wnd combo box art), .color-swatch,
	                input.range, input.checkbox, .text-input
	  Lists         .list-box (+ .opaque)          bordered pane; combine with .scroll-container
	                .list-row (+ .flex, .compact, .selected)
	                                               one entry of a .list-box; block by default, .flex for cells
	                .text-list, .text-line         bordered pane of plain text lines (status feed, MOTD)
	  Chat          .chat > .chat-log > .chat-line       fixed-height block: scrolling lines ...
	                     > .chat-entry > .chat-input + .icon-btn   ... over the entry row
	                <scrolllog>                    scrolling pane that stays at its newest line unless
	                                               the user scrolled up; use it for .chat-log and log-style
	                                               .text-list panes (plain <div> for ones that start at the top)
	  Rank cluster  .rank-column, .rank-border, .rank-image-wrap, .rank-image, .faction-image,
	                .rank-progress(-fill), .rank-label   rank portrait, faction badge, progress, name
	  Popups        .context-menu(-backdrop/-item) right-click menu placed at the cursor

	A bare <div data-for="..."> wrapping a row is inline unless it is a direct child of a .list-box or
	.text-list (which makes it a block); a row that is a data-for element itself needs display:block,
	which .list-row and .chat-line/.text-line already give it.
*/

body
{
	font-family: Barlow;
	font-size: 16dp;
	color: #FFFFFF;
}

/* ---- Type scale ------------------------------------------------------------------------ */
.t-title { font-size: 26dp; font-weight: bold; }
.t-section { font-size: 18dp; font-weight: bold; }
.t-body { font-size: 16dp; }
.t-small { font-size: 13dp; }
.t-muted { color: #C0C0C0; }

/* ---- Frame: the translucent bordered panel every screen is drawn on ------------------- */
.frame
{
	background-color: rgba(2, 2, 2, 191);
	border: 2dp #2F37A8;
	padding: 16dp;
}

.title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: center;
	padding-bottom: 8dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 12dp;
}

/* Bordered sub-panel inside a frame (option groups, honors, stats). */
.panel-box
{
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
	padding: 12dp;
}

/* ---- Tabs -------------------------------------------------------------------------- */
.tabs
{
	display: flex;
	flex-direction: row;
	margin-bottom: 12dp;
}

.tab
{
	flex: 1 1 0%;
	box-sizing: border-box;
	height: 34dp;
	line-height: 32dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #C0C0C0;
	background-color: rgba(2, 2, 2, 140);
	border: 1dp #2F37A8;
	margin-right: 4dp;
}

.tab:last-child
{
	margin-right: 0;
}

.tab:hover
{
	color: #FFFFFF;
	border-color: #8080FF;
}

.tab.selected
{
	color: #FFFFFF;
	background-color: rgba(47, 55, 168, 140);
	border: 1dp #8080FF;
}

/* ---- Rows: label/control grid ------------------------------------------------------------
   The label takes 40% of the row and the control the rest, so every control of a panel starts
   at the same x. A checkbox goes inside <div class="control"> so it sits at that x too. */
.row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 32dp;
	margin-bottom: 8dp;
}

.row > .label
{
	flex: 0 0 40%;
	box-sizing: border-box;
	padding-right: 12dp;
	color: #FFFFFF;
}

.row > .control
{
	flex: 1 1 0%;
	min-width: 0;
}

.row > .control.checkbox
{
	flex: 0 0 auto;
}

.row.disabled > .label,
.row.disabled > .control
{
	color: #C0C0C0;
}

/* ---- Buttons -------------------------------------------------------------------------
   The engine's own capsule button art (the Buttons, Buttons-HiLite, Buttons-Pushed and
   Buttons-Disabled Left/Middle/Right mapped images, exposed as sprites by RmlUiFileInterface):
   fixed end caps scaled to the button height, stretched middle. Text colours and the 1dp dark shadow follow
   the .wnd PUSHBUTTON text colours (white / 186,255,12 hilite / 62,64,92 disabled).
   Three sizes with fixed heights and one line of centred, upper case text: button (secondary),
   .btn-primary/.button-lg (footer and menu actions) and .btn-inline (next to a 32dp control). */
button, .button
{
	display: inline-block;
	box-sizing: border-box;
	decorator: tiled-horizontal(Buttons-Left, Buttons-Middle, Buttons-Right);
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	height: 34dp;
	line-height: 34dp;
	padding: 0 18dp;
	font-size: 16dp;
	font-weight: bold;
	text-align: center;
	text-transform: uppercase;
	white-space: nowrap;
}

.btn-primary, .button-lg
{
	height: 48dp;
	line-height: 48dp;
	padding: 0 32dp;
	min-width: 180dp;
	font-size: 20dp;
}

.btn-inline
{
	height: 32dp;
	line-height: 32dp;
	padding: 0 12dp;
	font-size: 14dp;
}

button:hover, .button:hover
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

button:active, .button:active
{
	decorator: tiled-horizontal(Buttons-Pushed-Left, Buttons-Pushed-Middle, Buttons-Pushed-Right);
	color: #BAFF0C;
}

/* A toggle button that is on (sort/filter/tab buttons): drawn lit like a hovered button. */
button.active
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

/* <button> never gets :disabled in RmlUi; match the disabled attribute that data-attrif-disabled sets.
   Listed after :hover/:active (and repeated with them) so a disabled button never lights up. */
button:disabled, button[disabled], .button.disabled, button.disabled,
button[disabled]:hover, button.disabled:hover, .button.disabled:hover,
button[disabled]:active, button.disabled:active, .button.disabled:active
{
	decorator: tiled-horizontal(Buttons-Disabled-Left, Buttons-Disabled-Middle, Buttons-Disabled-Right);
	color: #3E405C;
	font-effect: shadow(1dp 1dp #1F202F);
}

/* Square glyph/icon buttons are too small for the capsule end caps: keep the plain bordered box. */
.icon-btn, .joingame-close,
.icon-btn:hover, .joingame-close:hover,
.icon-btn:active, .joingame-close:active
{
	decorator: none;
	font-effect: none;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

.icon-btn:hover, .joingame-close:hover
{
	border-color: #8080FF;
	color: #8080FF;
}

/* Fixed 32dp square (the control height) holding a <mappedimage> glyph (chat send/emote, list
   refresh). The art isn't always perfectly square, so both the button and the image clip instead of
   overflowing. The doubled class outranks a screen's "<container> button { padding }" rule. */
.icon-btn.icon-btn
{
	width: 32dp;
	height: 32dp;
	min-width: 0;
	line-height: 30dp;
	padding: 3dp;
	text-align: center;
	overflow: hidden;
}

.icon-btn mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
	overflow: hidden;
}

/* ---- Dropdown (select) ---------------------------------------------------------------
   32dp control with the .wnd combo box's drop-down button art on the right
   (COMBOBOXDROPDOWNBUTTON*DRAWDATA: VSliderDownButtonEnabled/-Hilite/-HiliteSelected/-Disabled).
   The open list is opaque, scrolls past ten rows and lights the hovered row. */
select
{
	display: inline-block;
	box-sizing: border-box;
	height: 32dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	font-size: 16dp;
	vertical-align: middle;
}

select selectvalue
{
	height: 30dp;
	line-height: 30dp;
	margin-right: 32dp;
	padding: 0 8dp;
	white-space: nowrap;
	overflow: hidden;
}

select selectarrow
{
	width: 30dp;
	height: 30dp;
	decorator: image(VSliderDownButtonEnabled);
}

select:hover, select:focus
{
	border-color: #8080FF;
}

select:hover selectarrow
{
	decorator: image(VSliderDownButtonHilite);
}

select:checked selectarrow
{
	decorator: image(VSliderDownButtonHiliteSelected);
}

select[disabled], select[disabled]:hover
{
	border-color: rgba(47, 55, 168, 110);
	background-color: rgba(2, 2, 2, 120);
	color: #7C7E99;
}

select[disabled] selectarrow, select[disabled]:hover selectarrow
{
	decorator: image(VSliderDownButtonDisabled);
	opacity: 0.6;
}

select selectbox
{
	box-sizing: border-box;
	background-color: #06061A;
	border: 1dp #8080FF;
	padding: 2dp 0;
	max-height: 320dp;
	overflow-y: auto;
	z-index: 100;
}

select selectbox option
{
	height: 30dp;
	line-height: 30dp;
	padding: 0 10dp;
	white-space: nowrap;
	color: #FFFFFF;
}

select selectbox option:hover
{
	background-color: rgba(47, 55, 168, 220);
}

select selectbox option:checked
{
	color: #BAFF0C;
}

/* Colour choice: a swatch in front of the colour's name (a hollow swatch for Random). */
.color-swatch
{
	display: inline-block;
	width: 14dp;
	height: 14dp;
	margin-right: 8dp;
	border: 1dp rgba(255, 255, 255, 160);
	vertical-align: middle;
}

/* ---- Slider (input type=range) ------------------------------------------------------- */
input.range
{
	height: 20dp;
}

input.range slidertrack
{
	margin-top: 7dp;
	height: 6dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

input.range sliderbar
{
	width: 12dp;
	height: 20dp;
	background-color: #8080FF;
	border: 1dp #2F37A8;
}

input.range sliderbar:hover
{
	background-color: #BAFF0C;
}

input.range[disabled] sliderbar
{
	background-color: #3E405C;
}

/* ---- Checkbox -------------------------------------------------------------------------
   The .wnd checkbox art (CHECKBOX draw data: Active-Unchecked/-HiLighted/-Checked and
   Disabled-Unchecked/-Checked). */
input.checkbox
{
	width: 20dp;
	height: 20dp;
	decorator: image(Active-Unchecked);
}

input.checkbox:hover
{
	decorator: image(Active-HiLighted);
}

input.checkbox:checked, input.checkbox:checked:hover
{
	decorator: image(Active-Checked);
}

input.checkbox[disabled], input.checkbox[disabled]:hover
{
	decorator: image(Disabled-Unchecked);
}

input.checkbox[disabled]:checked
{
	decorator: image(Disabled-Checked);
}

/* ---- Scroll container ------------------------------------------------------------------ */
/* min-height: 0 lets the box shrink to its frame; without it a flex item never goes below its
   content height, so a long list grows past the frame instead of scrolling. */
.scroll-container
{
	overflow-y: auto;
	flex: 1 1 auto;
	min-height: 0;
}

/* Scrollbar must be sized explicitly: unstyled, RmlUi gives it the container's full width, so as
   soon as a list needs to scroll its content width collapses to ~0 (one word per line). */
scrollbarvertical
{
	width: 12dp;
}

scrollbarvertical slidertrack
{
	width: 12dp;
	background-color: rgba(2, 2, 2, 191);
	border-left: 1dp rgba(47, 55, 168, 110);
}

scrollbarvertical sliderbar
{
	width: 12dp;
	min-height: 32dp;
	background-color: #2F37A8;
}

scrollbarvertical sliderbar:hover, scrollbarvertical sliderbar:active
{
	background-color: #8080FF;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc
{
	width: 0dp;
	height: 0dp;
}

/* ---- Text input -------------------------------------------------------------------------- */
.text-input, .chat-input
{
	box-sizing: border-box;
	height: 32dp;
	line-height: 30dp;
	background-color: rgba(2, 2, 2, 220);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 0 8dp;
}

.text-input:hover, .chat-input:hover
{
	border-color: #5A5FD0;
}

.text-input[disabled]
{
	color: #7C7E99;
	border-color: rgba(47, 55, 168, 110);
}

.text-input:focus, .chat-input:focus
{
	border-color: #8080FF;
}

/* ---- Small layout helpers -------------------------------------------------------------- */
/* Pushes whatever follows it to the far end of a flex row. */
.spacer
{
	flex: 1 1 auto;
}

/* Underlined heading over a column or list. */
.section-title
{
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	padding-bottom: 4dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 8dp;
	flex: 0 0 auto;
}

/* <scrolllog> is a scrolling block that keeps itself at its newest line (C++ RmlScrollLogElement). */
scrolllog
{
	display: block;
	overflow-y: auto;
}

/* ---- Boxed lists -------------------------------------------------------------------------
   Combine with .scroll-container. .list-box is the bordered pane around a list of .list-row
   entries, .text-list the same pane for plain text lines (status feed, message of the day), and
   .chat-log the darker, tail-following variant a .chat uses. */
.list-box, .text-list, .chat-log
{
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
}

.list-box.opaque
{
	background-color: rgba(2, 2, 2, 191);
}

.text-list, .chat-log
{
	padding: 4dp 6dp;
}

/* The bare <div data-for="..."> wrapping each row is display:inline (no UA stylesheet), and a block
   inside an inline wrapper gets no reliable width; make the wrapper a real block. */
.list-box > div, .text-list > div
{
	display: block;
}

/* One line inside a .text-list. */
.text-line
{
	display: block;
	padding: 1dp 0;
}

/* ---- List row -----------------------------------------------------------------------------
   One entry of a .list-box. Block by default: RmlUi lays out data-for children as inline unless told
   otherwise, so every row needs the display. Add .flex for a row of cells (icon, name, count), and
   .compact for the tighter padding. .selected marks the chosen row, hover lights it. */
.list-row
{
	display: block;
	box-sizing: border-box;
	min-height: 30dp;
	padding: 5dp 8dp;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.list-row.flex
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.list-row.compact
{
	min-height: 26dp;
	padding: 2dp 8dp;
}

.list-row:hover
{
	background-color: rgba(47, 55, 168, 60);
}

.list-row.selected
{
	background-color: rgba(47, 55, 168, 120);
	border: 1dp #8080FF;
}

/* ---- Chat ---------------------------------------------------------------------------------
   <div class="chat"> is the fixed-height block at the bottom of a screen: a .chat-log (scrolling
   lines, one .chat-line each) over a .chat-entry row (a .chat-input and one or two .icon-btn). */
.chat
{
	display: flex;
	flex-direction: column;
	margin-top: 12dp;
	height: 160dp;
}

.chat-log
{
	flex: 1 1 0%;
	min-height: 0;
	background-color: rgba(2, 2, 2, 191);
}

.chat-line
{
	display: block;
}

.chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 8dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 8dp;
}

/* ---- Rank cluster --------------------------------------------------------------------------
   Rank portrait, faction badge, progress bar and rank name (online welcome, player info, quick
   match stats). Uses fixed dp sizes (matching WOLWelcomeMenu.wnd's RankBorder/WinRank/FactionImage
   1:1) instead of percentages -- dp already scales with screen height (see common.rcss header
   comment), so this still scales consistently across resolutions, just not stretched
   independently like the .wnd's own non-uniform 800x600 stretch. mappedimage itself does resolve
   percentage width/height fine (its inner <img> is always 100%x100% of it); fixed dp is used here
   only because the whole rank-column is a fixed-width column, not a mappedimage limitation. */
.rank-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 128dp;
	margin-right: 12dp;
}

.rank-border
{
	position: relative;
	box-sizing: border-box; /* declared width/height must include the border, or this (and its
		border-box child .rank-progress below) overflow rank-column by the border width
		(audit: OVERFLOW div.rank-border / div.rank-progress) */
	width: 128dp;
	height: 156dp;
	background-color: #020280;
	border: 1dp #2F37A8;
}

.rank-image-wrap
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 100%; /* fill rank-border's content box exactly, instead of duplicating its 128dp and
		overflowing once rank-border switched to box-sizing:border-box */
	height: 128dp;
	border-bottom: 1dp #2E37A8;
}

.rank-image
{
	display: block;
	width: 100%;
	height: 128dp;
}

.faction-image
{
	display: block;
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 48dp;
	height: 48dp;
}

.rank-progress
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	left: 0;
	bottom: 0;
	width: 100%; /* fill rank-border's content box exactly, see .rank-image-wrap above */
	height: 24dp;
	background-color: rgba(2, 2, 2, 164);
	border: 1dp #FFBB00;
}

.rank-progress-fill
{
	height: 100%;
	background-color: rgba(59, 255, 0, 200);
}

.rank-label
{
	margin-top: 4dp;
	text-align: center;
	flex: 0 0 auto;
}

/* ---- Footer button row ------------------------------------------------------------------ */
.footer
{
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
	flex: 0 0 auto;
	margin-top: 12dp;
	border-top: 1dp #2F37A8;
	padding-top: 12dp;
}

.footer button
{
	margin-left: 12dp;
}

/* Primary action left, secondary (Main Menu) right -- matches the .wnd originals (e.g.
   Skirmish's Play Game / Main Menu) instead of grouping both buttons at the right edge. */
.footer-split
{
	justify-content: space-between;
}

.footer-split button
{
	margin-left: 0;
}

/* ---- Shell frame: full-screen blueprint background + bordered panel ------------------
   Shared by screens whose .wnd fills the whole 800x600 blueprint-ruler backdrop (see
   WOLWelcomeMenu.wnd's WOLWelcomeMenuParent/MainMenuRuler + GadgetParent), instead of
   floating in a fixed-size dialog like .frame. Percent geometry mirrors the .wnd's own
   non-uniform 800x600-to-screen stretch. */
.shell-background
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: -1;
}

body.shell
{
	width: 100%;
	height: 100%;
}

.shell-frame
{
	box-sizing: border-box;
	position: absolute;
	left: 5.6%;
	top: 7.3%;
	width: 88.8%;
	height: 85.4%;
	background-color: rgba(2, 2, 2, 190);
	border: 2dp #2F37A8;
	padding: 16dp;
	display: flex;
	flex-direction: column;
}

.shell-title-bar
{
	font-size: 26dp;
	font-weight: bold;
	color: #FFFFFF;
	text-align: left;
	padding-bottom: 8dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 12dp;
	flex: 0 0 auto;
}

/* ---- Right-click context menu -------------------------------------------------------------
   Generic reusable popup for the RC*.wnd-style right-click menus (WOLLobbyMenu.cpp's
   GLM_RIGHT_CLICKED, WOLBuddyOverlay.cpp's own right-click menus). A screen positions
   .context-menu at the cursor via data-style-left/top (pre-clamped on-screen by the caller,
   same clamp WOLLobbyMenu.cpp's GLM_RIGHT_CLICKED does against TheDisplay's width/height) and
   toggles it + a full-viewport .context-menu-backdrop with data-if="menu_visible"; the backdrop
   sits behind the menu and closes it on any click outside, replacing winSetLoneWindow()'s
   click-away-closes behavior. Both use position:fixed (viewport-relative), not absolute: a caller
   may nest .context-menu inside an already-positioned ancestor (e.g. OnlineLobby.rml's
   .shell-frame), and RmlUi's mouse_x/mouse_y event coordinates the caller feeds into
   data-style-left/top are viewport-relative, not relative to that ancestor. */
.context-menu-backdrop
{
	display: block;
	position: fixed;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	z-index: 100;
}

.context-menu
{
	display: block;
	position: fixed;
	z-index: 101;
	background-color: rgba(2, 2, 2, 235);
	border: 1dp #2F37A8;
	min-width: 110dp;
}

.context-menu-item
{
	display: block;
	height: 30dp;
	line-height: 30dp;
	padding: 0 12dp;
	color: #FFFFFF;
	text-align: center;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.context-menu-item:last-child
{
	border-bottom: 0dp transparent;
}

.context-menu-item:hover
{
	background-color: rgba(47, 55, 168, 160);
}


/* =========================================================================================
   Screen template -- the redesigned shell look. Opt in with class="screen" on <body>; every
   rule below is scoped to it, so screens that still use .shell-frame keep their look.

   The shell map (the live battle behind the menus) is the backdrop, so nothing fills the frame:
   content sits in floating translucent .surface panels with the map showing around and between
   them, headings and quiet buttons float on the map behind a soft text glow, and the frame stops
   growing on ultrawide screens so the map fills the sides. Keep the map in view: prefer a panel
   that is as tall as its content over one stretched to the bottom.

   Design language
	  Palette   ink       #05070F            deepest backdrop
	            surface   #070A1AE0          panels (.surface), the only filled boxes; 88% so text
	                                         reads over any terrain. Text on the map itself gets
	                                         a #070A1AC8-D9 plate (heading, back) or .map-glow
	            raised    #141A3ED7          controls, hovered rows
	            line      #8080FF28          hairline separators; borders only where needed
	            blue      #2F37A8 / #3A46D0 / #8080FF   brand, selected, hover/focus
	            text      #EEF1FA  text-2 #A9B1CF  text-3 #7079A0 (labels, overlines)
	            accent    #F07A1A            Zero Hour orange, the one "act here" colour: title
	                                         tick, focus ring, selected-row bar, checks, badges
	                      #FF9A3D            accent as text on dark (pressed, checked option)
	                      #F5A93A            gold: only the highlight atop the hovered primary
	                      #C9540F            pressed primary; #1A0C02 text on the accent
	                                         Selection fills and "on" segments stay blue.
	            status    good #3CD28C  warn #E8D440 (yellow, clear of the accent)  bad #FF5050
	                      buddy #14B1FF
	  Type      Barlow Regular/Bold. Title 40dp bold caps behind an accent tick; crumb and
	            overline 15-16dp bold caps tracked 2dp; body 20dp (the .wnd Arial 12 at 800x600);
	            small 16dp; primary button 24dp. Text drawn straight on the map (.on-map, the
	            header, the back button) gets .map-glow.
	  Spacing   4 / 8 / 12 / 16 / 20 / 24 / 40dp; 20dp between floating panels.
	  Frame     the ruler is the MainMenuRuler art's tick strips and frame line at full strength
	            (.screen-ruler) without its grid band; the content frame sits inside it and is at
	            most 2150dp wide, centred.
	  Motion    hover/press 0.12s cubic-out, panels 0.22s cubic-out, loading pulse 1.2s.
	            Opacity, colours and margins only: the renderer has no transforms.

   Skeleton
	<body class="screen" data-model="...">
		<div class="screen-ruler"><div class="rs rs-top"><mappedimage name="MainMenuRuler"/></div>
			(rs-bottom, rs-left and rs-right the same)</div>
		<div class="screen-frame">
			<div class="screen-header">
				<div class="screen-heading">
					<div class="screen-crumb">parent<span class="crumb-sep">&#8250;</span></div>
					<div class="screen-title">title</div>
				</div>
				<div class="screen-header-aside">optional controls</div>
			</div>
			<div class="screen-body">.col.col-main / .col.col-side of .surface panels</div>
			<div class="action-bar">
				<button class="btn-back">back or cancel</button>   always far left
				<div class="spacer"/> secondary buttons
				<button class="btn-cta">primary</button>            always far right
			</div>
		</div>
	</body>

   Components: .surface, .overline, .seg > button.seg-item(.on), label.check > input.checkbox,
   .swatches > button.swatch(.on/.random), .row-item(.selected), .list-head, .empty-state,
   .pulse, .stat, .dot, the map card (.map-frame, .marker, .map-name), plus scoped restyles of button, select, input.range, text inputs and
   scrollbars. Clickable pieces are <button>s so they get the click sound and disabled handling.
   ========================================================================================= */

body.screen
{
	width: 100%;
	height: 100%;
	font-size: 20dp;
}

/* ---- Ruler: the MainMenuRuler art's tick strips and bright frame line ----------------------------
   Four clipped windows onto the full-screen art (its 800x600 maps to the viewport, so the strips land
   where the .wnd draws them): rows and columns 24-43 of each edge. The grid band outside them is left
   off so the map shows out to the screen edge. mappedimage ignores percentage sizes: vw/vh instead. */
.screen-ruler
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	pointer-events: none;
}

.screen-ruler .rs
{
	display: block;
	position: absolute;
	overflow: hidden;
	clip: always; /* the art is absolutely placed, so it never counts as overflow to clip */
}

.rs-top, .rs-bottom { left: 3vw; width: 94vw; height: 3.1667vh; }
.rs-top { top: 4vh; }
.rs-bottom { top: 92.8333vh; }
.rs-left, .rs-right { top: 7.1667vh; width: 2.375vw; height: 85.6667vh; }
.rs-left { left: 3vw; }
.rs-right { left: 94.625vw; }

.screen-ruler .rs mappedimage
{
	display: block;
	position: absolute;
	width: 100vw;
	height: 100vh;
}

.rs-top mappedimage { left: -3vw; top: -4vh; }
.rs-bottom mappedimage { left: -3vw; top: -92.8333vh; }
.rs-left mappedimage { left: -3vw; top: -7.1667vh; }
.rs-right mappedimage { left: -94.625vw; top: -7.1667vh; }

/* Content frame: inside the ruler, at most 2150dp wide and centred, no fill of its own. */
.screen-frame
{
	box-sizing: border-box;
	position: absolute;
	left: 6.6%;
	right: 6.6%;
	top: 7.9%;
	bottom: 8.1%;
	max-width: 2150dp;
	margin-left: auto;
	margin-right: auto;
	display: flex;
	flex-direction: column;
}

/* Dark halo behind text drawn straight on the map: a local scrim, only as big as the text. */
.map-glow, .screen-crumb, .screen-title, .screen .btn-back, .on-map
{
	font-effect: glow(1dp 8dp 0dp 1dp #000000F0);
}

/* ---- Header ------------------------------------------------------------------------------ */
.screen-header
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	padding: 10dp 0 0 0;
	margin-bottom: 23dp;
}

/* The heading sits on its own plate so it reads over bright terrain. */
.screen-heading
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 1 auto;
	min-width: 0;
	padding: 8dp 28dp 8dp 20dp;
	background-color: #070A1AD9;
}

.screen-crumb
{
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #B8C0DE;
	margin-right: 18dp;
	white-space: nowrap;
}

.crumb-sep
{
	color: #8080FF;
	margin: 0 8dp;
}

.screen-title
{
	font-size: 40dp;
	line-height: 50dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
	border-left: 4dp #F07A1A;
	padding-left: 15dp;
	white-space: nowrap;
}

.screen-header-aside
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-left: auto;
}

/* ---- Body and columns --------------------------------------------------------------------- */
.screen-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
}

.col
{
	display: flex;
	flex-direction: column;
	min-width: 0;
	min-height: 0;
}

.col-main
{
	flex: 1 1 0%;
}

.col-side
{
	flex: 0 0 auto;
	margin-left: 20dp;
}

/* Floating panel: the only filled box on a screen, 88% so text on it reads over any map. */
.surface
{
	display: block;
	background-color: #070A1AE0;
	padding: 20dp;
}

.surface + .surface
{
	margin-top: 20dp;
}

/* Small tracked caps over a group: the section heading of the template. */
.overline
{
	display: block;
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #8089B0;
	white-space: nowrap;
}

.muted { color: #A9B1CF; }
.dim { color: #7079A0; }

/* ---- Action bar: back far left, primary far right; floats on the map ------------------------ */
.action-bar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 75dp;
	margin-top: 20dp;
}

.action-bar button
{
	margin-left: 15dp;
}

.action-bar button:first-child
{
	margin-left: 0;
}

/* ---- Buttons ------------------------------------------------------------------------------ */
.screen button, .screen .button
{
	decorator: none;
	font-effect: none;
	box-sizing: border-box;
	height: 50dp;
	line-height: 48dp;
	padding: 0 25dp;
	min-width: 0;
	font-size: 19dp;
	font-weight: bold;
	letter-spacing: 1dp;
	color: #D7DCF0;
	background-color: #141A3ED7;
	border: 1dp #8080FF46;
	transition: background-color color border-color 0.12s cubic-out;
}

.screen button:hover, .screen .button:hover
{
	decorator: none;
	color: #FFFFFF;
	background-color: #2F37A8D2;
	border-color: #8080FF;
}

.screen button:active, .screen .button:active
{
	decorator: none;
	color: #FF9A3D;
	background-color: #1E246EE6;
	border-color: #8080FF;
}

.screen button:focus-visible
{
	border-color: #F07A1A;
}

.screen button[disabled], .screen button.disabled,
.screen button[disabled]:hover, .screen button.disabled:hover,
.screen button[disabled]:active, .screen button.disabled:active
{
	decorator: none;
	font-effect: none;
	color: #4A5070;
	background-color: #0C0F24AA;
	border-color: #8080FF1E;
}

/* Primary action: the accent. One per screen, always at the right end of the action bar. */
.screen button.btn-cta
{
	height: 65dp;
	line-height: 65dp;
	min-width: 300dp;
	padding: 0 50dp;
	font-size: 24dp;
	letter-spacing: 2dp;
	color: #1A0C02;
	border-width: 0;
	decorator: vertical-gradient(#F79A34 #E0661A);
}

.screen button.btn-cta:hover
{
	color: #120800;
	decorator: vertical-gradient(#F5A93A #F07A1A);
}

.screen button.btn-cta:active
{
	color: #120800;
	decorator: vertical-gradient(#C9540F #D8601A);
}

.screen button.btn-cta[disabled], .screen button.btn-cta[disabled]:hover, .screen button.btn-cta[disabled]:active
{
	decorator: none;
	color: #4A5070;
	background-color: #1A2040C8;
}

/* Back/cancel: quiet text button with a chevron, always at the left end of the action bar. */
.screen button.btn-back
{
	height: 55dp;
	line-height: 55dp;
	padding: 0 23dp 0 15dp;
	font-size: 21dp;
	color: #C4CAE4;
	background-color: #070A1AC8;
	border-color: transparent;
}

.screen button.btn-back:hover
{
	color: #FFFFFF;
	background-color: #1E246EE6;
	border-color: transparent;
}

.screen button.btn-back:active
{
	color: #FF9A3D;
}

.chevron
{
	font-size: 33dp;
	margin-right: 10dp;
	color: #8080FF;
}

.screen button.btn-small
{
	height: 40dp;
	line-height: 38dp;
	padding: 0 18dp;
	font-size: 16dp;
}

/* ---- Segmented control: a small set of choices, one on --------------------------------------
	<div class="seg"><button class="seg-item" data-class-on="...">1</button>...</div> */
.seg
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	background-color: #05070FC8;
	border: 1dp #8080FF28;
	padding: 2dp;
}

.screen .seg button.seg-item
{
	height: 38dp;
	line-height: 38dp;
	padding: 0 15dp;
	min-width: 38dp;
	font-size: 18dp;
	letter-spacing: 0.5dp;
	text-align: center;
	color: #A9B1CF;
	background-color: transparent;
	border-width: 0;
	margin-left: 2dp;
}

.screen .seg button.seg-item:first-child
{
	margin-left: 0;
}

.screen .seg button.seg-item:hover
{
	color: #FFFFFF;
	background-color: #2F37A878;
}

.screen .seg button.seg-item.on, .screen .seg button.seg-item.on:hover
{
	color: #FFFFFF;
	background-color: #3A46D0;
}

.screen .seg button.seg-item[disabled], .screen .seg button.seg-item[disabled]:hover
{
	color: #4A5070;
	background-color: transparent;
}

.screen .seg button.seg-item.on[disabled]
{
	color: #A9B1CF;
	background-color: #2F37A850;
}

/* ---- Colour swatches -----------------------------------------------------------------------
	<div class="swatches"><button class="swatch" data-class-on=".." data-style-background-color=".."/>
	.swatch.random is the hollow "?" swatch for no fixed colour. */
.swatches
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.screen .swatches button.swatch
{
	width: 28dp;
	height: 28dp;
	line-height: 23dp;
	padding: 0;
	margin-right: 4dp;
	font-size: 16dp;
	text-align: center;
	color: #A9B1CF;
	border: 2dp #05070F;
	opacity: 0.8;
	transition: opacity border-color 0.12s cubic-out;
}

.screen .swatches button.swatch:hover
{
	opacity: 1;
	border-color: #FFFFFF;
}

.screen .swatches button.swatch.on, .screen .swatches button.swatch.on:hover
{
	opacity: 1;
	border-color: #FFFFFF;
}

.screen .swatches button.swatch.random
{
	background-color: #141A3E;
	border-color: #8080FF46;
}

.screen .swatches button.swatch.random.on, .screen .swatches button.swatch.random:hover
{
	color: #FFFFFF;
	border-color: #FFFFFF;
}

.screen .swatches button.swatch[disabled], .screen .swatches button.swatch[disabled]:hover
{
	opacity: 0.25;
	border-color: #05070F;
}

.screen .swatches button.swatch.on[disabled]
{
	opacity: 0.9;
	border-color: #A9B1CF;
}

/* ---- Checkbox: <label class="check"><input class="checkbox" type="checkbox"/><span>..</span></label> */
label.check
{
	display: flex;
	flex-direction: row;
	align-items: center;
	color: #D7DCF0;
}

label.check:hover
{
	color: #FFFFFF;
}

.screen input.checkbox, .screen input.checkbox:hover
{
	decorator: none;
	box-sizing: border-box;
	width: 25dp;
	height: 25dp;
	margin-right: 13dp;
	background-color: #05070FDC;
	border: 2dp #8080FF6E;
	transition: background-color border-color 0.12s cubic-out;
}

.screen label.check:hover input.checkbox
{
	border-color: #8080FF;
}

.screen input.checkbox:checked, .screen input.checkbox:checked:hover
{
	decorator: none;
	background-color: #F07A1A;
	border: 6dp #0B1030;
}

.screen input.checkbox[disabled], .screen input.checkbox[disabled]:checked
{
	decorator: none;
	opacity: 0.4;
}

/* ---- Slider ------------------------------------------------------------------------------- */
.screen input.range
{
	height: 30dp;
}

.screen input.range slidertrack
{
	margin-top: 13dp;
	height: 4dp;
	background-color: #8080FF3C;
	border-width: 0;
}

.screen input.range sliderbar
{
	width: 18dp;
	height: 30dp;
	background-color: #D7DCF0;
	border-width: 0;
	transition: background-color 0.12s cubic-out;
}

.screen input.range sliderbar:hover, .screen input.range sliderbar:active
{
	background-color: #F07A1A;
}

/* ---- Dropdown ----------------------------------------------------------------------------- */
.screen select
{
	height: 45dp;
	background-color: #05070FD2;
	border: 1dp #8080FF3C;
	color: #EEF1FA;
	font-size: 19dp;
	transition: background-color border-color 0.12s cubic-out;
}

.screen select selectvalue
{
	height: 43dp;
	line-height: 43dp;
	margin-right: 35dp;
	padding: 0 13dp;
}

/* A small down triangle drawn with borders (no such glyph in Barlow, no rotation in the renderer). */
.screen select selectarrow, .screen select:hover selectarrow, .screen select:checked selectarrow
{
	decorator: none;
	width: 0;
	height: 0;
	margin: 19dp 15dp 0 0;
	border-top: 8dp #8080FF;
	border-left: 6dp transparent;
	border-right: 6dp transparent;
}

.screen select:hover, .screen select:focus
{
	background-color: #141A3EE6;
	border-color: #8080FF;
}

.screen select:hover selectarrow, .screen select:checked selectarrow
{
	border-top-color: #FFFFFF;
}

.screen select[disabled], .screen select[disabled]:hover
{
	opacity: 0.45;
	background-color: #05070FA0;
	border-color: #8080FF28;
	color: #A9B1CF;
}

.screen select[disabled] selectarrow
{
	decorator: none;
	opacity: 1;
	border-top-color: #7079A0;
}

.screen select selectbox
{
	background-color: #090C1E;
	border: 1dp #3A46D0;
	padding: 4dp 0;
	max-height: 450dp;
}

.screen select selectbox option
{
	height: 40dp;
	line-height: 40dp;
	padding: 0 15dp;
	color: #D7DCF0;
}

.screen select selectbox option:hover
{
	background-color: #2F37A8DC;
	color: #FFFFFF;
}

.screen select selectbox option:checked
{
	color: #FF9A3D;
}

/* ---- Text input --------------------------------------------------------------------------- */
.screen .text-input, .screen .chat-input
{
	height: 50dp;
	line-height: 48dp;
	padding: 0 15dp;
	background-color: #05070FD2;
	border: 1dp #8080FF3C;
	transition: border-color 0.12s cubic-out;
}

.screen .text-input:hover, .screen .chat-input:hover
{
	border-color: #8080FF8C;
}

.screen .text-input:focus, .screen .chat-input:focus
{
	border-color: #8080FF;
	background-color: #0B1030E6;
}

/* ---- Scrollbar: slim, lit on hover -------------------------------------------------------- */
.screen scrollbarvertical
{
	width: 10dp;
}

.screen scrollbarvertical slidertrack
{
	width: 10dp;
	background-color: #FFFFFF0A;
	border-width: 0;
}

.screen scrollbarvertical sliderbar
{
	width: 10dp;
	min-height: 50dp;
	background-color: #8080FF64;
	transition: background-color 0.12s cubic-out;
}

.screen scrollbarvertical sliderbar:hover, .screen scrollbarvertical sliderbar:active
{
	background-color: #8080FF;
}

/* ---- List rows ---------------------------------------------------------------------------
	One entry of a scrolling list, a flex row of cells. Hover lights it; .selected adds the
	accent bar on the left. A data-for row needs the display, which this gives it. */
.row-item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 44dp;
	padding: 0 15dp 0 13dp;
	border-left: 3dp transparent;
	border-bottom: 1dp #FFFFFF0A;
	transition: background-color 0.1s cubic-out;
}

.row-item:hover
{
	background-color: #2F37A84B;
}

.row-item.selected, .row-item.selected:hover
{
	background-color: #2F37A8A0;
	border-left-color: #F07A1A;
}

/* Column caption row over a list. */
.list-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 38dp;
	padding: 0 15dp 0 16dp;
	border-bottom: 1dp #8080FF28;
}

/* ---- Empty and loading states --------------------------------------------------------------- */
.empty-state
{
	display: block;
	padding: 60dp 30dp;
	text-align: center;
	color: #7079A0;
	font-size: 20dp;
}

.empty-state .overline
{
	display: block;
	margin-bottom: 10dp;
}

@keyframes pulse
{
	from { opacity: 0.35; }
	to { opacity: 1; }
}

.pulse
{
	animation: 1.2s cubic-in-out infinite alternate pulse;
}

/* ---- Small pieces ------------------------------------------------------------------------- */
/* Big number over a small caption (career stats and the like). */
.stat
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
}

.stat-value
{
	font-size: 33dp;
	line-height: 38dp;
	font-weight: bold;
	color: #EEF1FA;
}

.stat-label
{
	font-size: 15dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #7079A0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Status dot (ping, presence). */
.dot
{
	display: inline-block;
	width: 10dp;
	height: 10dp;
	border-radius: 4dp;
	background-color: #3CD28C;
}

/* ---- Map card: a map preview with numbered start positions, its name under it ---------------
	<div class="map-frame"><mappreview class="map-image" data-attr-map=".."/>
		<div data-for="marker : start_markers"><div class="marker" data-if="marker.used"
			data-style-left="marker.x_style" data-style-top="marker.y_style">
			<div class="marker-dot">{{marker.position + 1}}</div></div></div></div>
	<div class="map-name">..</div> <div class="map-meta">..</div> */
.group-title
{
	margin-bottom: 15dp;
}

.map-frame
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 400dp;
	height: 400dp;
	background-color: #05070F;
}

.map-image
{
	display: block;
	width: 100%;
	height: 100%;
}

.map-missing
{
	display: flex;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	color: #7079A0;
	text-align: center;
}

.map-name
{
	display: block;
	margin: 18dp 0 18dp 0;
	font-size: 25dp;
	font-weight: bold;
	color: #EEF1FA;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.map-button
{
	display: block;
}

/* Start positions: numbered squares, filled with the occupant's colour. Left click takes the
   spot, right click clears it. */
.marker
{
	display: block;
	position: absolute;
	width: 30dp;
	height: 30dp;
	margin-left: -15dp;
	margin-top: -15dp;
}

.marker-dot
{
	display: block;
	box-sizing: border-box;
	width: 30dp;
	height: 30dp;
	line-height: 25dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	border: 2dp #FFFFFFB4;
	background-color: #05070FA0;
	transition: border-color 0.12s cubic-out;
}

.marker:hover .marker-dot
{
	border-color: #F07A1A;
}

.marker.occupied .marker-dot
{
	border-color: #FFFFFF;
}

.marker-label
{
	display: block;
	margin-left: -88dp;
	margin-right: -88dp;
	margin-top: 2dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	white-space: nowrap;
}

.map-meta
{
	display: block;
	margin-top: -10dp;
	color: #A9B1CF;
}


/* ---- Social dock: an online screen makes room for the expanded dock ----------------------------
	RmlSocialDock sets .dock-open on every body with .dock-host while its panel is out, so the
	screen narrows beside the 390dp panel instead of sitting under it. */
.screen.dock-open .screen-frame
{
	margin-right: 406dp;
}

.shell.dock-open .shell-frame
{
	width: auto;
	right: 5.6%;
	margin-right: 402dp;
}

/* 5:4 and 4:3: a 340dp panel. */
@media (max-aspect-ratio: 3/2)
{
	.screen.dock-open .screen-frame { margin-right: 356dp; }
	.shell.dock-open .shell-frame { margin-right: 352dp; }
}
