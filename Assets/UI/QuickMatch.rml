<rml>
<head>
	<title>QuickMatch</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="QuickMatch.rcss"/>
</head>
<body data-model="quickmatch">
	<mappedimage class="shell-background" name="MainMenuRuler"/>

	<div class="shell-frame quickmatch-panel">
		<div class="shell-title-bar">{{title}}</div>

		<div class="quickmatch-body">
			<div class="setup-panel" data-if="!show_stats">
				<div class="row">
					<div class="label"><gametext key="GUI:NumPlayers"/></div>
					<select class="control" data-value="selected_playlist" data-event-change="playlist_changed" data-tooltip="TOOLTIP:PlayerSetting">
						<option data-for="opt : playlists" data-attr-value="opt.index">{{opt.label}}</option>
					</select>
				</div>

				<div class="section-title"><gametext key="GUI:AllowableMaps"/></div>
				<div class="scroll-container map-list">
					<div data-for="row : maps">
						<div class="map-row" data-if="row.used" data-class-selected="row.selected" data-event-click="map_row_clicked(row.index)">
							<div class="map-check" data-class-checked="row.selected"></div>
							<div class="map-name">{{row.label}}</div>
						</div>
					</div>
				</div>

				<!-- ComboBoxLadder/ComboBoxMaxPing/ComboBoxMaxDisconnects/ComboBoxSide/ComboBoxColor: real,
				     populated controls the .wnd force-disables every Init under Generals Online (see the
				     quick match triage note's §1/§2) -- shown disabled with their static labels/tooltips
				     instead of omitted, not re-populated from live faction/color data (their values never
				     reach an actual GO match). -->
				<div class="row disabled">
					<div class="label"><gametext key="GUI:LadderName"/></div>
					<select class="control" disabled="disabled" data-tooltip="TOOLTIP:Ladder"><option>Automatic Ladder</option></select>
				</div>
				<div class="row disabled">
					<div class="label"><gametext key="GUI:MaxPing"/></div>
					<select class="control" disabled="disabled" data-tooltip="TOOLTIP:Ping"><option><gametext key="GUI:ANY"/></option></select>
				</div>
				<div class="row disabled">
					<div class="label"><gametext key="GUI:MaxDisconnects"/></div>
					<select class="control" disabled="disabled" data-tooltip="TOOLTIP:Disconnect"><option><gametext key="GUI:Any"/></option></select>
				</div>
				<div class="row disabled">
					<div class="label"><gametext key="GUI:Side"/></div>
					<select class="control" disabled="disabled"><option><gametext key="GUI:Random"/></option></select>
				</div>
				<div class="row disabled">
					<div class="label"><gametext key="GUI:Color"/></div>
					<select class="control" disabled="disabled"><option><gametext key="GUI:???"/></option></select>
				</div>
			</div>

			<div class="stats-panel" data-if="show_stats">
				<div class="rank-column">
					<div class="section-title"><gametext key="GUI:Rank"/></div>
					<div class="rank-border">
						<div class="rank-image-wrap">
							<mappedimage class="rank-image" data-attr-name="rank_image_name"/>
							<mappedimage class="faction-image" data-attr-name="faction_image_name" data-if="show_faction_image"/>
						</div>
						<div class="rank-progress" data-if="!rank_at_max">
							<div class="rank-progress-fill" data-style-width="rank_progress_width_style"></div>
						</div>
					</div>
					<div class="rank-label">{{rank_text}}</div>
				</div>

				<div class="stats-column">
					<div class="row"><div class="label"><gametext key="GUI:GamesPlayed"/></div><div class="control">{{games_played_text}}</div></div>
					<div class="row"><div class="label"><gametext key="GUI:CareerWins"/></div><div class="control">{{wins_text}}</div></div>
					<div class="row"><div class="label"><gametext key="GUI:CareerLosses"/></div><div class="control">{{losses_text}}</div></div>
					<div class="row"><div class="label">{{disconnects_label_text}}</div><div class="control">{{disconnects_value_text}}</div></div>
					<div class="row"><div class="label"><gametext key="GUI:BestWinStreak"/></div><div class="control">{{best_streak_text}}</div></div>
					<div class="row"><div class="label">{{streak_label_text}}</div><div class="control">{{streak_value_text}}</div></div>
					<div class="row"><div class="label"><gametext key="GUI:CarrerWinPercent"/></div><div class="control">{{win_percent_text}}</div></div>
				</div>
			</div>
		</div>

		<div id="status-feed" class="scroll-container status-feed">
			<div class="status-line" data-for="line : status_lines"><span data-style-color="line.color">{{line.text}}</span></div>
		</div>

		<div class="footer footer-split">
			<!-- WOLQuickMatchMenu.cpp:1114-1115 relabels these to hardcoded English literals at Init
			     (not GameText keys) -- kept verbatim, same as the welcome/instructions status lines. -->
			<button class="button-lg" data-if="start_visible" data-attr-disabled="!start_enabled" data-class-disabled="!start_enabled" data-event-click="start">START MATCHMAKING</button>
			<button class="button-lg" data-if="stop_visible" data-attr-disabled="!stop_enabled" data-class-disabled="!stop_enabled" data-event-click="stop">CANCEL MATCHMAKING</button>
			<button class="button-lg" data-attr-disabled="!widen_enabled" data-class-disabled="!widen_enabled" data-event-click="widen"><gametext key="GUI:WidenSearch"/></button>
			<button class="button-lg" data-event-click="toggle_options">{{options_button_label}}</button>
			<button class="button-lg" data-attr-disabled="!communicator_enabled" data-class-disabled="!communicator_enabled" data-event-click="buddies">{{communicator_label}}</button>
			<button class="button-lg" data-attr-disabled="!back_enabled" data-class-disabled="!back_enabled" data-event-click="back"><gametext key="GUI:Back"/></button>
		</div>
	</div>
</body>
</rml>
