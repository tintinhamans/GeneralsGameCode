<rml>
<head>
	<title>QuickMatch</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="QuickMatch.rcss"/>
</head>
<!-- Quick match (WOLQuickMatchMenu.wnd, RmlQuickMatchScreen) as a matchmaking hub on the screen
     template. The main column is the setup (playlist cards over the map pool) or the player's
     persona, switched in the header; the side column is the search state over the loadout and the
     status feed. Start and Cancel matchmaking take turns as the primary action. -->
<body class="screen hq dock-host" data-model="quickmatch">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="hq-band hq-header"><div class="hq-band-in">
			<mappedimage name="GeneralsLogo" class="hq-logo"/>
			<div class="hq-heading"><div class="hq-crumb"><gametext key="GUI:GeneralsOnline"/><span class="crumb-sep">&#8250;</span></div><div class="hq-title qm-title">{{title}}</div></div>
			<div class="hq-aside qm-views">
				<div class="seg">
					<button class="seg-item" data-class-on="!show_stats" data-attrif-disabled="!show_stats" data-event-click="toggle_options"><gametext key="GUI:Setup"/></button>
					<button class="seg-item" data-class-on="show_stats" data-attrif-disabled="show_stats" data-event-click="toggle_options"><gametext key="GUI:PlayerInfo"/></button>
				</div>
			</div>
			<div class="hq-status">
				<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
				<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span><gametext key="GO:GUI:MenuOffline"/></div>
				<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
			</div>
	</div></div>

	<div class="screen-frame">
		<div class="screen-body">
			<div class="col col-main">
				<!-- Setup: the playlist as cards, then the maps it allows, each toggled in or out. -->
				<div class="surface qm-playlists" data-if="!show_stats" data-tooltip="TOOLTIP:PlayerSetting">
					<div class="overline group-title"><gametext key="GO:GUI:QMPlaylist"/></div>
					<div class="qm-pl-row">
						<button class="qm-pl hq-brackets" data-for="opt : playlists" data-class-on="opt.index == selected_playlist" data-class-selected="opt.index == selected_playlist"
							data-event-click="selected_playlist = opt.index; playlist_changed()"><span class="qm-pl-label">{{opt.label}}</span><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span><span class="hq-edge"></span></button>
					</div>
				</div>

				<div class="surface qm-maps" data-if="!show_stats">
					<div class="overline group-title"><gametext key="GUI:AllowableMaps"/></div>
					<div class="qm-map-grid">
						<div class="qm-map" data-for="row : maps" data-if="row.used" data-class-on="row.selected" data-event-click="map_row_clicked(row.index)"
							data-event-mouseover="map_row_hover(row.index)" data-event-mousemove="map_row_hover(row.index)" data-event-mouseout="map_row_hover_clear">
							<div class="qm-thumb"><mappreview class="qm-thumb-image" data-attr-map="row.path"/></div>
							<div class="qm-map-name">{{row.label}}</div>
							<div class="qm-check"></div>
						</div>
					</div>
				</div>

				<!-- Player info (ParentStats): the persona of the dashboard, rank and career record. -->
				<div class="surface qm-persona" data-if="show_stats">
					<div class="persona-hero">
						<div class="persona-portrait">
							<mappedimage class="persona-rank-image" data-attr-name="rank_image_name"/>
							<div class="persona-badge" data-if="show_faction_image"><mappedimage data-attr-name="faction_image_name"/></div>
						</div>
						<div class="persona-rank">
							<div class="overline"><gametext key="GUI:Rank"/></div>
							<div class="persona-rank-name">{{rank_text}}</div>
							<div class="progress persona-progress" data-if="!rank_at_max" data-tooltip="TOOLTIP:ProgressToNextRank">
								<div class="progress-fill" data-style-width="rank_progress_width_style"></div>
							</div>
						</div>
					</div>
					<div class="stat-blocks">
						<div class="stat-block"><div class="stat-block-value">{{games_played_text}}</div><div class="stat-label"><gametext key="GUI:GamesPlayed"/></div></div>
						<div class="stat-block"><div class="stat-block-value">{{wins_text}}</div><div class="stat-label"><gametext key="GUI:CareerWins"/></div></div>
						<div class="stat-block"><div class="stat-block-value">{{losses_text}}</div><div class="stat-label"><gametext key="GUI:CareerLosses"/></div></div>
						<div class="stat-block"><div class="stat-block-value">{{win_percent_text}}</div><div class="stat-label"><gametext key="GUI:CarrerWinPercent"/></div></div>
						<div class="stat-block"><div class="stat-block-value">{{disconnects_value_text}}</div><div class="stat-label">{{disconnects_label_text}}</div></div>
						<div class="stat-block"><div class="stat-block-value">{{best_streak_text}}</div><div class="stat-label"><gametext key="GUI:BestWinStreak"/></div></div>
						<div class="stat-block"><div class="stat-block-value">{{streak_value_text}}</div><div class="stat-label">{{streak_label_text}}</div></div>
					</div>
				</div>
			</div>

			<div class="col col-side qm-side">
				<!-- Where the search stands: ready, or searching with the time in the queue. -->
				<div class="surface qm-search" data-class-searching="stop_visible">
					<div class="overline"><gametext key="GUI:QuickMatch"/></div>
					<div class="qm-state" data-if="!stop_visible">
						<div class="qm-idle">
							<div class="qm-state-title"><gametext key="GO:GUI:QMReady"/></div>
							<div class="qm-state-hint"><gametext key="GO:GUI:QMReadyHint"/></div>
						</div>
					</div>
					<div class="qm-state" data-if="stop_visible">
						<div class="qm-radar"><div class="qm-ring pulse"></div><div class="qm-core"></div></div>
						<div class="qm-searching">
							<div class="qm-state-title qm-accent"><gametext key="GO:GUI:QMSearching"/></div>
							<div class="qm-elapsed">{{search_elapsed_text}}</div>
							<div class="stat-label"><gametext key="GO:GUI:QMElapsed"/></div>
						</div>
					</div>
					<button class="qm-widen" data-if="stop_visible" data-attrif-disabled="!widen_enabled" data-event-click="widen"><gametext key="GUI:WidenSearch"/></button>
				</div>

				<!-- The loadout and filters the service decides for Generals Online (the .wnd shows them
				     disabled): what they are set to, read only. -->
				<div class="surface qm-loadout">
					<div class="qm-cards">
						<div class="qm-card">
							<div class="stat-label"><gametext key="GUI:Side"/></div>
							<div class="qm-card-value"><div data-for="opt : side_options"><span data-if="opt.value == side_selected">{{opt.label}}</span></div></div>
						</div>
						<div class="qm-card">
							<div class="stat-label"><gametext key="GUI:Color"/></div>
							<div class="qm-card-value"><div data-for="opt : color_options"><span data-if="opt.value == color_selected">{{opt.label}}</span></div></div>
						</div>
					</div>
					<div class="qm-filter" data-tooltip="TOOLTIP:Ladder"><div class="qm-filter-label"><gametext key="GUI:Ladder"/></div>
						<div class="qm-filter-value"><div data-for="opt : ladder_options"><span data-if="opt.value == ladder_selected">{{opt.label}}</span></div></div></div>
					<div class="qm-filter" data-tooltip="TOOLTIP:Ping"><div class="qm-filter-label"><gametext key="GUI:MaxPing"/></div>
						<div class="qm-filter-value"><div data-for="opt : max_ping_options"><span data-if="opt.value == max_ping_selected">{{opt.label}}</span></div></div></div>
					<div class="qm-filter" data-tooltip="TOOLTIP:Disconnect"><div class="qm-filter-label"><gametext key="GUI:MaxDisconnects"/></div>
						<div class="qm-filter-value"><div data-for="opt : max_disconnects_options"><span data-if="opt.value == max_disconnects_selected">{{opt.label}}</span></div></div></div>
				</div>

				<!-- ListboxQuickMatch: the session's status lines, newest at the bottom. -->
				<div class="surface qm-feed">
					<div class="overline"><gametext key="GUI:Status"/></div>
					<scrolllog class="qm-lines">
						<div class="qm-line" data-for="line : status_lines"><span data-style-color="line.color">{{line.text}}</span></div>
					</scrolllog>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-attrif-disabled="!back_enabled" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			<div class="spacer"></div>
			<!-- WOLQuickMatchMenu.cpp:1114-1115 relabels these to hardcoded English literals at Init
			     (not GameText keys), kept verbatim. -->
			<button class="btn-cta" data-if="start_visible" data-attrif-disabled="!start_enabled" data-event-click="start"><gametext key="GO:GUI:StartMatchmaking"/></button>
			<button class="btn-cta qm-stop" data-if="stop_visible" data-attrif-disabled="!stop_enabled" data-event-click="stop"><gametext key="GO:GUI:CancelMatchmaking"/></button>
		</div>
	</div>

	<!-- A viewport layer, direct child of <body>: the hovered map's preview beside the cursor
	     (updateMapHoverPreview(), WOLQuickMatchMenu.cpp:248-282), clamped on screen by the screen. -->
	<div id="map-hover-preview" class="map-hover-preview" data-if="map_preview_visible" data-style-left="map_preview_x_style" data-style-top="map_preview_y_style">
		<mappreview class="map-hover-preview-image" data-attr-map="map_preview_map_path"/>
	</div>
</body>
</rml>
