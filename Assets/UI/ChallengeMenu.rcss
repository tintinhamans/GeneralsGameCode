/*
	ChallengeMenu.rcss -- the Generals Challenge general select (ChallengeMenu.wnd), on the screen
	template of common.rcss over the shell map. A grid of the generals the challenge starts with
	(portrait, medallion and name), the dossier of the one under the cursor or chosen beside it,
	typed out like the .wnd's, and Play once one is chosen.
*/

.ch-frame
{
	animation: 0.4s linear-in-out 1 ch-fade-in; /* ChallengeMenuFade */
}

@keyframes ch-fade-in
{
	from { opacity: 0; }
	to { opacity: 1; }
}

/* ---- Grid ------------------------------------------------------------------------------------ */
.ch-grid-scroll
{
	flex: 1 1 0%;
	min-height: 0;
}

.ch-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
}

.ch-slot
{
	display: block;
	margin: 0 16dp 16dp 0;
}

.screen button.ch-tile
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 212dp;
	height: auto;
	padding: 0;
	line-height: 24dp;
	text-align: left;
	letter-spacing: 0;
	background-color: #070A1AE6;
	border: 1dp #8080FF28;
	border-bottom: 4dp #2F37A8;
	transition: background-color border-color 0.12s cubic-out;
}

.screen button.ch-tile:hover
{
	background-color: #141A3EF0;
	border-color: #8080FF;
	border-bottom-color: #F07A1A;
}

.screen button.ch-tile.selected, .screen button.ch-tile.selected:hover
{
	background-color: #2F37A8C8;
	border-color: #F07A1A;
	border-bottom-color: #F07A1A;
}

.ch-portrait
{
	display: block;
	width: 210dp;
	height: 208dp;
	background-color: #05070F;
	overflow: hidden;
}

.ch-portrait mappedimage
{
	display: block;
	width: 210dp;
	height: 208dp;
	opacity: 0.85;
	transition: opacity 0.12s cubic-out;
}

.ch-tile:hover .ch-portrait mappedimage, .ch-tile.selected .ch-portrait mappedimage
{
	opacity: 1;
}

/* The general's medallion over the portrait's corner: silver, blue under the cursor, orange once chosen. */
.ch-medal
{
	display: block;
	position: absolute;
	left: 8dp;
	top: 150dp;
	width: 50dp;
	height: 50dp;
}

.ch-medal mappedimage
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 50dp;
	height: 50dp;
}

.ch-medal .ch-hilite, .ch-medal .ch-selected,
.ch-tile:hover .ch-medal .ch-normal,
.ch-tile.selected .ch-medal .ch-normal, .ch-tile.selected .ch-medal .ch-hilite
{
	display: none;
}

.ch-tile:hover .ch-medal .ch-hilite, .ch-tile.selected .ch-medal .ch-selected
{
	display: block;
}

.ch-name
{
	display: block;
	padding: 10dp 12dp 10dp 12dp;
	font-size: 19dp;
	line-height: 24dp;
	font-weight: bold;
	color: #D7DCF0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.ch-tile:hover .ch-name, .ch-tile.selected .ch-name
{
	color: #FFFFFF;
}

/* ---- Dossier ---------------------------------------------------------------------------------- */
.col-side .surface.ch-bio
{
	width: 480dp;
	padding: 20dp 24dp 24dp 24dp;
	border-left: 4dp #F07A1A;
}

.ch-bio-portrait
{
	display: block;
	width: 330dp;
	height: 327dp;
	margin: 0 auto 18dp auto;
	background-color: #05070F;
	border: 1dp #8080FF46;
}

.ch-bio-portrait mappedimage
{
	display: block;
	width: 330dp;
	height: 327dp;
}

.ch-bio-empty
{
	display: block;
	line-height: 327dp;
	text-align: center;
	font-size: 120dp;
	font-weight: bold;
	color: #8080FF28;
}

.ch-bio-hint
{
	display: block;
	margin-top: 10dp;
	font-size: 19dp;
	line-height: 26dp;
	color: #A9B1CF;
}

.ch-bio-body
{
	display: block;
}

.ch-bio-name
{
	display: block;
	min-height: 40dp;
	margin: 4dp 0 10dp 0;
	font-size: 32dp;
	line-height: 40dp;
	font-weight: bold;
	color: #FFFFFF;
}

.ch-bio-row
{
	display: flex;
	flex-direction: row;
	padding: 7dp 0;
	border-top: 1dp #8080FF1E;
}

.ch-bio-label
{
	flex: 0 0 110dp;
	font-size: 15dp;
	line-height: 25dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #8089B0;
}

.ch-bio-entry
{
	flex: 1 1 0%;
	min-width: 0;
	min-height: 25dp;
	font-size: 19dp;
	line-height: 25dp;
	color: #EEF1FA;
}

/* ---- 5:4 and 4:3: smaller tiles and a narrower dossier ---------------------------------------- */
@media (max-aspect-ratio: 3/2)
{
	.screen button.ch-tile { width: 172dp; }
	.ch-portrait, .ch-portrait mappedimage { width: 170dp; height: 168dp; }
	.ch-medal { top: 112dp; width: 46dp; height: 46dp; }
	.ch-medal mappedimage { width: 46dp; height: 46dp; }
	.ch-slot { margin: 0 12dp 12dp 0; }
	.ch-name { font-size: 17dp; padding: 8dp 10dp; }
	.col-side .surface.ch-bio { width: 380dp; }
	.ch-bio-portrait, .ch-bio-portrait mappedimage { width: 280dp; height: 277dp; }
	.ch-bio-empty { line-height: 277dp; }
	.ch-bio-name { font-size: 28dp; line-height: 34dp; min-height: 34dp; }
}
