/*
	OnlineLobby.rcss -- layout specific to OnlineLobby.rml. Palette/frame/button/scroll-container/
	list/chat rules come from common.rcss.
*/

/* ---- Two-column body: games (wide) / players (narrow) ------------------------------------ */
.lobby-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.games-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	margin-right: 8dp;
	min-height: 0;
}

.players-column
{
	display: flex;
	flex-direction: column;
	width: 200dp;
	min-height: 0;
}

.games-header
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 4dp;
}

.games-header button
{
	margin-right: 4dp;
	padding: 4dp 10dp;
}

.room-select
{
	width: 220dp;
}

button.active
{
	decorator: tiled-horizontal(Buttons-HiLite-Left, Buttons-HiLite-Middle, Buttons-HiLite-Right);
	color: #BAFF0C;
}

.filter-row
{
	display: flex;
	flex-direction: row;
	margin-bottom: 4dp;
}

.filter-row button
{
	margin-right: 4dp;
	padding: 3dp 8dp;
	font-size: 12dp;
}

/* ---- Game list row: fixed dp columns (a scrolling overflow-y:auto container corrupts
   flex/auto widths inside it, see project notes) ------------------------------------------- */
/* .game-row sits on common.rcss's .list-row.flex.compact; its own text colour and a stronger
   selected highlight without the outline. */
.game-row
{
	color: #BFC6C9;
}

.game-row.selected
{
	background-color: rgba(47, 55, 168, 160);
	color: #FFFFFF;
	border: 0dp transparent;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.game-row.buddy
{
	color: #14B1FF;
}

.game-row.crcmismatch
{
	color: #7A7A7A;
}

.game-name
{
	flex: 1 1 auto;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
}

.game-map
{
	width: 170dp;
	flex: 0 0 auto;
	overflow: hidden;
	white-space: nowrap;
	text-overflow: ellipsis;
	margin-left: 8dp;
}

.game-players
{
	width: 44dp;
	flex: 0 0 auto;
	text-align: center;
}

.game-players.almost-full
{
	color: #10AD90;
}

.game-players.full
{
	color: #FF5050;
}

.game-icon
{
	width: 16dp;
	height: 16dp;
	flex: 0 0 auto;
	margin-left: 4dp;
}

.game-ping
{
	width: 12dp;
	height: 12dp;
	flex: 0 0 auto;
	margin-left: 4dp;
	background-color: #10AD90;
	border-radius: 6dp;
}

.game-ping.ok
{
	background-color: #F0C020;
}

.game-ping.bad
{
	background-color: #FF5050;
}

/* ---- Player list row: admin/friend/ignored/self coloring (see GSCOLOR_PLAYER_* in
   WOLLobbyMenu.cpp's RebuildLobbyPlayerList(), which this mirrors) ------------------------- */
.player-row.admin
{
	color: #F0C020;
}

.player-row.friend
{
	color: #14B1FF;
}

.player-row.ignored
{
	color: #7A7A7A;
}

.player-row.self
{
	color: #10AD90;
}

/* ---- Chat ---------------------------------------------------------------------------------- */

/* Shorter than the shared 140dp: this screen has more list above the chat. */
.chat
{
	height: 130dp;
}
