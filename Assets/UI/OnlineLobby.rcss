/*
	OnlineLobby.rcss -- the online custom match lobby on the screen template (common.rcss): the game
	list over the room chat in the main column and the hovered/selected game's card on the right.
	The room's players are the social dock's Lobby tab (SocialDock.rcss).

	Rows keep the .wnd's colour language: buddy games #14B1FF, CRC-mismatched games grey, player
	counts green when almost full and red when full. Connection is a three-bar signal (good/ok/bad = 3/2/1 bars).
*/

/* ---- Columns ------------------------------------------------------------------------------- */
.details-col
{
	width: 440dp;
}

/* The game card fills its column; a long member list scrolls inside it. */
.details
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
}

.players
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
}

.room-select
{
	width: 300dp;
}

/* ---- Game list ------------------------------------------------------------------------------- */
.games
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
	padding-bottom: 10dp;
}

.toolbar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	flex-wrap: wrap;
	margin-bottom: 4dp;
}

.toolbar .seg, .toolbar .icon-btn
{
	margin-bottom: 10dp;
}

.screen .toolbar .icon-btn
{
	width: 45dp;
	height: 45dp;
	padding: 6dp;
	margin-right: 15dp;
	background-color: #05070FC8;
	border: 1dp #8080FF28;
}

.screen .toolbar .icon-btn:hover
{
	border-color: #8080FF;
	background-color: #2F37A878;
}

.game-list
{
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

.game-row
{
	color: #D7DCF0;
}

.game-row.buddy
{
	color: #14B1FF;
}

.game-row.crcmismatch
{
	color: #6A6F88;
}

.game-lock
{
	flex: 0 0 23dp;
	height: 20dp;
	margin-right: 10dp;
}

.game-lock mappedimage
{
	display: block;
	width: 20dp;
	height: 20dp;
}

.game-name
{
	flex: 1 1 auto;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.game-row.selected .game-name
{
	font-weight: bold;
	color: #FFFFFF;
}

.game-map
{
	flex: 0 0 250dp;
	margin-left: 15dp;
	color: #A9B1CF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.game-flags
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 65dp;
	margin-left: 10dp;
	opacity: 0.8;
}

.flag-observers
{
	width: 28dp;
	height: 19dp;
	margin-right: 8dp;
}

.flag-stats
{
	width: 15dp;
	height: 15dp;
}

.game-players
{
	flex: 0 0 60dp;
	text-align: right;
	font-weight: bold;
	color: #EEF1FA;
}

.game-players.almost-full
{
	color: #3CD28C;
}

.game-players.full
{
	color: #FF5050;
}

/* Three-bar connection signal. */
.signal
{
	display: flex;
	flex-direction: row;
	align-items: flex-end;
	flex: 0 0 auto;
	height: 18dp;
	margin-left: 20dp;
}

.bar
{
	width: 4dp;
	margin-left: 2dp;
	background-color: #3CD28C;
}

.b1 { height: 8dp; }
.b2 { height: 13dp; }
.b3 { height: 18dp; }

.signal.ok .bar { background-color: #E8D440; }
.signal.ok .b3 { background-color: #FFFFFF26; }
.signal.bad .bar { background-color: #FF5050; }
.signal.bad .b2, .signal.bad .b3 { background-color: #FFFFFF26; }

/* Keep the art's inline <img> from sitting on a text baseline inside its box. */
.game-row mappedimage img, .tag mappedimage img
{
	display: block;
}

/* ---- Chat --------------------------------------------------------------------------------- */
.chat-panel
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	height: 220dp;
}

.chat-lines
{
	flex: 1 1 0%;
	min-height: 0;
	padding-right: 10dp;
}

.chat-row
{
	display: block;
	padding: 3dp 0;
	line-height: 25dp;
}

.chat-time
{
	font-size: 16dp;
	color: #7079A0;
	margin-right: 10dp;
}

.chat-name
{
	font-weight: bold;
	margin-right: 10dp;
}

.chat-body
{
	color: #D7DCF0;
}

.chat-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 13dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 10dp;
}

.screen .chat-entry .icon-btn
{
	width: 50dp;
	height: 50dp;
	padding: 10dp;
	background-color: #2F37A8D2;
	border: 1dp #8080FF;
}

.screen .chat-entry .icon-btn:hover
{
	background-color: #3A46D0;
}

/* ---- Details panel -------------------------------------------------------------------------- */
.detail-map
{
	width: 400dp;
	height: 400dp;
}

.detail-name
{
	display: block;
	margin-top: 18dp;
	font-size: 23dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.detail-map-name
{
	display: block;
	margin-top: 2dp;
	color: #A9B1CF;
}

.facts
{
	display: flex;
	flex-direction: row;
	margin-top: 20dp;
}

.facts .stat-label
{
	letter-spacing: 0;
}

.fact
{
	flex: 1 1 0%;
	min-width: 0;
}

.fact-value
{
	display: block;
	margin-top: 2dp;
	font-size: 21dp;
	font-weight: bold;
	color: #EEF1FA;
	white-space: nowrap;
}

.fact-value .dot
{
	margin-right: 8dp;
	vertical-align: middle;
}

.dot.ok { background-color: #E8D440; }
.dot.bad { background-color: #FF5050; }

.tags
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 18dp;
}

.tag
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 33dp;
	padding: 0 10dp;
	margin: 0 8dp 8dp 0;
	font-size: 16dp;
	color: #D7DCF0;
	background-color: #2F37A850;
}

.tag mappedimage
{
	width: 18dp;
	height: 18dp;
	margin-right: 8dp;
}

/* The details stack in a column so a long member list scrolls instead of running off the card. */
.detail-body
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.detail-body .map-frame, .detail-name, .detail-map-name, .facts, .tags
{
	flex: 0 0 auto;
}

.members
{
	display: block;
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
	margin-top: 13dp;
	border-top: 1dp #8080FF28;
	padding-top: 10dp;
}

.member
{
	display: block;
	height: 33dp;
	line-height: 33dp;
	padding-left: 13dp;
	border-left: 2dp #8080FF46;
	margin-bottom: 2dp;
	color: #D7DCF0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.member.host
{
	border-left-color: #F07A1A;
	font-weight: bold;
	color: #FFFFFF;
}

/* ---- 5:4 and 4:3 ------------------------------------------------------------------------------ */
@media (max-aspect-ratio: 3/2)
{
	.details-col { width: 300dp; }
	.detail-map { width: 260dp; height: 260dp; }
	.game-map { flex-basis: 163dp; }
	.game-flags { display: none; }
	.facts { flex-wrap: wrap; }
	.fact { flex: 0 0 50%; margin-bottom: 8dp; }
	.col-side { margin-left: 20dp; }
}

/* Beside the expanded social dock on 5:4 and 4:3 the game card goes: the list keeps the width. */
@media (max-aspect-ratio: 3/2)
{
	.dock-open .details-col { display: none; }
}
