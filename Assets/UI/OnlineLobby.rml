<rml>
<head>
	<title>OnlineLobby</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="GameSetup.rcss"/>
	<link type="text/rcss" href="OnlineLobby.rcss"/>
</head>
<body data-model="onlinelobby">
	<mappedimage class="shell-background" name="MainMenuRuler"/>

	<div class="shell-frame lobby-panel">
		<div class="lobby-row">
			<div class="games-column">
				<div class="games-header">
					<button class="icon-btn" data-event-click="refresh"><mappedimage name="LobbyRefresh"/></button>
					<button data-class-active="sort_by_age" data-event-click="sort_age" data-tooltip="Tooltip:NameButton"><gametext key="GUI:SortAlpha"/></button>
					<button data-class-active="sort_by_map" data-event-click="sort_map" data-tooltip="Tooltip:PingButton"><gametext key="GUI:SortPing"/></button>
					<button data-class-active="sort_buddies_first" data-event-click="sort_buddies" data-tooltip="Tooltip:SortBuddies"><gametext key="GUI:SortBuddies"/></button>
					<div class="spacer"></div>
					<select class="room-select" data-value="current_room_index" data-event-change="join_room">
						<option data-for="room : rooms" data-if="room.used" data-attr-value="room.index">{{room.label}}</option>
					</select>
				</div>
				<div class="filter-row">
					<button data-class-active="filter_is_all" data-event-click="set_filter(0)">Filter: All</button>
					<button data-class-active="filter_is_1v1" data-event-click="set_filter(1)">1v1</button>
					<button data-class-active="filter_is_team" data-event-click="set_filter(2)">Team</button>
					<button data-class-active="filter_is_ffa" data-event-click="set_filter(3)">FFA</button>
					<button data-class-active="filter_is_aod" data-event-click="set_filter(4)">AOD</button>
					<button data-class-active="filter_is_buddies" data-event-click="set_filter(5)">Buddies</button>
				</div>
				<div class="scroll-container game-list">
					<div data-for="game : games">
						<div class="game-row" data-if="game.used" data-class-selected="game.is_selected" data-class-buddy="game.has_buddy"
							data-class-crcmismatch="game.crc_mismatch"
							data-event-click="game_row_clicked(game.index)" data-event-dblclick="game_row_activated(game.index)">
							<div class="game-name">{{game.display_name}}</div>
							<div class="game-map">{{game.map_display_name}}</div>
							<div class="game-players" data-class-almost-full="game.players_almost_full" data-class-full="game.players_full">{{game.players_text}}</div>
							<mappedimage class="game-icon" name="Password" data-if="game.has_password"/>
							<div class="game-icon" data-if="!game.has_password"></div>
							<mappedimage class="game-icon" name="Observer" data-if="game.allow_observers"/>
							<div class="game-icon" data-if="!game.allow_observers"></div>
							<mappedimage class="game-icon" name="GoodStatsIcon" data-if="game.track_stats"/>
							<div class="game-icon" data-if="!game.track_stats"></div>
							<div class="game-ping" data-class-ok="game.ping_ok" data-class-bad="game.ping_bad"></div>
						</div>
					</div>
				</div>
			</div>

			<div class="players-column">
				<div class="section-title"><gametext key="GUI:Players"/></div>
				<div class="scroll-container player-list">
					<div data-for="player : players">
						<div class="player-row" data-if="player.used" data-class-admin="player.is_admin" data-class-friend="player.is_friend"
							data-class-ignored="player.is_ignored" data-class-self="player.is_self"
							data-event-mousedown="player_row_mousedown(player.index)">{{player.name}}</div>
					</div>
				</div>
			</div>
		</div>

		<div class="chat">
			<div class="scroll-container chat-body">
				<div class="chat-line" data-for="line : chat_lines">
					<span data-if="line.used" data-style-color="line.color">{{line.text}}</span>
				</div>
			</div>
			<div class="chat-entry-row">
				<input type="text" class="chat-input" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
				<button class="btn-send" data-event-click="send_chat"><mappedimage name="ReturnButton"/></button>
			</div>
		</div>

		<div class="footer">
			<button data-event-click="host_game"><gametext key="GUI:Host"/></button>
			<button data-event-click="join_selected"><gametext key="GUI:Join"/></button>
			<button data-event-click="buddy_overlay"><gametext key="GUI:Buddies"/></button>
			<div class="spacer"></div>
			<button data-event-click="back"><gametext key="GUI:Back"/></button>
		</div>

	</div>

	<!-- Siblings of .shell-frame (not nested inside it), same as .shell-background above: .shell-frame
	     is itself position:absolute, so a .context-menu nested inside it would resolve data-style-left/
	     top's viewport-relative mouse_x/mouse_y against .shell-frame's box instead of the viewport. -->
	<div class="context-menu-backdrop" data-if="player_menu_visible" data-event-mousedown="player_menu_dismiss"></div>
	<div id="player-context-menu" class="context-menu" data-if="player_menu_visible" data-style-left="player_menu_x_style" data-style-top="player_menu_y_style">
		<div data-for="item : player_menu_items">
			<div class="context-menu-item" data-if="item.used" data-event-click="player_menu_item_clicked(item.action)">{{item.label}}</div>
		</div>
	</div>
</body>
</rml>
