/*
	BuddyOverlay.rcss -- WOLBuddyOverlay.wnd (the Generals Online buddy overlay, GSOVERLAY_BUDDY).
	Floating popup over whatever's showing underneath, same "body itself is centered and flex"
	precedent as PlayerInfo.rcss/QuitMenu.rcss.
*/

body
{
	display: flex;
	flex-direction: column;
	width: 800dp;
	left: 50%;
	top: 50%;
	margin-left: -400dp;
	margin-top: -260dp;
}

.buddy-frame
{
	display: flex;
	flex-direction: column;
	height: 520dp;
}

.buddy-tabs
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-bottom: 12dp;
}

.buddy-tabs button
{
	margin-right: 8dp;
}

.buddy-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%; /* 0 basis: a content-sized basis never shrinks the tall chat/roster back into the frame */
	min-height: 0;
}

/* ---- Roster (friends/requests/current-lobby/recently-played) ------------------------------ */
.roster-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 300dp;
	margin-right: 16dp;
	min-height: 0;
}

.roster-list
{
	flex: 1 1 0%;
	min-height: 0;
}

/* Block-level .list-row, not flex: a scrolling overflow-y:auto container corrupts flex/auto child
   widths (see report's gotcha note), so the dot/name/unread/status pieces below are laid out with
   plain inline/block flow instead. */
.roster-dot
{
	display: inline-block;
	width: 8dp;
	height: 8dp;
	margin-right: 6dp;
	background-color: #64828C; /* offline grey, matches GameMakeColor(100,130,150,255) */
}

.roster-row.online .roster-dot
{
	background-color: #3BFF00; /* online green, matches GSCOLOR_PLAYER_BUDDY's usual hue */
}

.roster-name
{
	display: inline;
	font-weight: bold;
}

.roster-unread
{
	display: inline;
	margin-left: 4dp;
	color: #FFBB00;
	font-weight: bold;
}

.roster-status
{
	display: block;
	font-size: 13dp;
	color: #C0C0C0;
	margin-left: 14dp;
}

/* ---- Chat pane ------------------------------------------------------------------------------ */
.chat-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0;
	min-height: 0;
}

/* ---- Block list tab -------------------------------------------------------------------------- */
.block-list
{
	flex: 1 1 auto;
}

.block-row
{
	color: rgba(255, 100, 100, 255); /* red-tinted, matches refreshIgnoreList()'s GameMakeColor(255,100,100,255) */
}

