<rml>
<head>
	<title>Credits</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="CreditsMenu.rcss"/>
</head>
<body class="screen cr" data-model="credits">
	<!-- The credits art, darkened, with a dark band down the middle where the lines scroll. -->
	<div class="cr-art"><mappedimage name="CreditsScreen" class="cr-art-image"/></div>
	<div class="cr-scrim"></div>
	<div class="cr-band"></div>
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<!-- Populated/repositioned every frame from TheCredits (RmlCreditsScreen::syncDisplayedLines), in
	     screen pixels, so it spans the whole screen. -->
	<div id="credits_lines" class="cr-lines"></div>

	<div class="screen-frame cr-frame">
		<div class="screen-header">
			<div class="screen-heading">
				<div class="screen-title"><gametext key="GUI:Credits"/></div>
			</div>
		</div>
		<div class="spacer"></div>
		<div class="action-bar">
			<button class="btn-back" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
		</div>
	</div>
</body>
</rml>
