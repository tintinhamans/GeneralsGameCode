/*
	MainMenu.rcss -- the main menu. Palette, type and motion tokens come from the screen template
	in common.rcss.

	The shell map is the main menu's picture, so the menu is one floating card on the right of the
	frame (where MainMenu.wnd keeps its buttons) with the logo above it on the map; everything else
	stays clear. Every panel (main/single/multi/loadreplay/difficulty) is always present in
	.mm-card; the "panel" data model variable marks one .active, which is the only one laid out,
	and it slides in from the right as it fades up (a keyframe animation on opacity and
	margin-left: the renderer has no transforms). The card grows and shrinks with its panel.
*/

/* ---- Menu card ------------------------------------------------------------------------------- */
.mm-frame
{
	flex-direction: row;
	justify-content: flex-end;
	align-items: flex-start;
}

.mm-column
{
	display: block;
	flex: 0 0 420dp;
	margin-top: 36dp;
}

/* The logo is fixed dp: mappedimage ignores percentage sizes. 370x120 art. */
.mm-logo
{
	display: block;
	width: 370dp;
	height: 120dp;
	margin: 0 0 24dp 25dp;
}

.mm-card
{
	display: block;
	padding: 14dp 16dp;
	background-color: #070A1ADB;
	border-top: 2dp #8080FF46;
}

/* Only the active panel is laid out; it slides in from the right as it fades up. */
.panel
{
	display: none;
}

.panel.active
{
	display: block;
	animation: 0.26s cubic-out panel-in;
}

@keyframes panel-in
{
	from { opacity: 0; margin-left: 48dp; }
	to { opacity: 1; margin-left: 0dp; }
}

/* Sub-panel title, same accent tick as a screen title. */
.mm-heading
{
	display: block;
	font-size: 13dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: #7079A0;
	padding-left: 16dp;
	margin-bottom: 12dp;
	white-space: nowrap;
}

/* ---- Menu items: big tracked caps, lit bar on hover ------------------------------------------ */
.screen button.mm-item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 58dp;
	line-height: 58dp;
	padding: 0 20dp 0 16dp;
	text-align: left;
	font-size: 25dp;
	letter-spacing: 3dp;
	color: #D7DCF0;
	background-color: transparent;
	border-width: 0;
	border-left: 4dp transparent;
	transition: color border-color 0.12s cubic-out, padding-left 0.16s cubic-out;
}

.screen button.mm-item:hover
{
	color: #FFFFFF;
	padding-left: 24dp;
	border-left-color: #F07A1A;
	background-color: transparent;
	decorator: horizontal-gradient(#2F37A8D2 #2F37A800);
}

.screen button.mm-item:active
{
	color: #FF9A3D;
	border-left-color: #F07A1A;
	background-color: transparent;
	decorator: horizontal-gradient(#1E246EE6 #1E246E00);
}

.screen button.mm-item:focus-visible
{
	border-left-color: #F07A1A;
}

/* Right-hand chevron on items that open another panel. */
.mm-item gametext
{
	flex: 1 1 auto;
}

.mm-more
{
	flex: 0 0 auto;
	font-size: 30dp;
	color: #8080FF;
	opacity: 0.6;
}

.mm-item:hover .mm-more
{
	opacity: 1;
	color: #FF9A3D;
}

.screen button.mm-quiet, .screen button.mm-back
{
	height: 50dp;
	line-height: 50dp;
	font-size: 19dp;
	color: #A9B1CF;
}

.mm-back .chevron
{
	font-size: 28dp;
	margin-right: 12dp;
}

.mm-rule
{
	height: 1dp;
	margin: 12dp 0 12dp 16dp;
	background-color: #8080FF28;
}

.mm-version
{
	position: absolute;
	right: 4dp;
	bottom: 0;
	font-size: 13dp;
	color: #A9B1CF;
	padding: 2dp 8dp;
	background-color: #070A1AC8;
}

/* ---- Faction emblem over the map ------------------------------------------------------------ */
.mm-hero
{
	position: absolute;
	top: 34%;
	left: 20%;
	width: 216dp;
	height: 216dp;
}

.mm-hero mappedimage
{
	position: absolute;
	top: 0;
	left: 0;
	width: 216dp;
	height: 216dp;
	opacity: 0;
	transition: opacity 0.2s cubic-out;
}

.mm-hero mappedimage.visible
{
	opacity: 1;
}

/* Narrow (5:4, 4:3) screens: the card takes more of the frame, so the emblem moves left. */
@media (max-aspect-ratio: 3/2)
{
	.mm-hero
	{
		left: 8%;
	}
}
