/*
	MainMenu.rcss -- the main menu rail. Palette, type and motion tokens come from the screen
	template in common.rcss.

	The menu is a dark rail down the right of the ruler opening (where MainMenu.wnd keeps its
	buttons), with the logo on top; the rest of the opening stays clear for the shell map, with a
	soft fade into the rail. Every panel (main/single/multi/loadreplay/difficulty) is always
	present in .mm-panels; the "panel" data model variable marks one .active, which is the only one
	laid out, and it slides in from the right as it fades up (a keyframe animation on opacity and
	margin-left: the renderer has no transforms).
*/

/* ---- Rail ---------------------------------------------------------------------------------- */
/* The rail plus the soft fade on its left, down the right of the ruler opening. */
.mm-side
{
	position: absolute;
	top: 7.3%;
	right: 5.6%;
	height: 85.4%;
	width: 42%;
	min-width: 620dp;
	max-width: 720dp;
	display: flex;
	flex-direction: row;
}

.mm-fade
{
	flex: 0 0 160dp;
	decorator: horizontal-gradient(#05070F00 #05070FD2);
}

.mm-rail
{
	position: relative;
	flex: 1 1 0%;
	padding-top: 44dp;
	background-color: #05070FD2;
}

/* The logo is fixed dp: mappedimage ignores percentage sizes. 370x120 art. */
.mm-logo
{
	display: block;
	width: 380dp;
	height: 123dp;
	margin: 0 0 44dp 36dp;
}

.mm-panels
{
	margin: 0 40dp;
}

/* Only the active panel is laid out; it slides in from the right as it fades up. */
.panel
{
	display: none;
}

.panel.active
{
	display: block;
	animation: 0.26s cubic-out panel-in;
}

@keyframes panel-in
{
	from { opacity: 0; margin-left: 48dp; }
	to { opacity: 1; margin-left: 0dp; }
}

/* Sub-panel title, same accent tick as a screen title. */
.mm-heading
{
	display: block;
	font-size: 13dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: #7079A0;
	padding-left: 16dp;
	margin-bottom: 12dp;
	white-space: nowrap;
}

/* ---- Menu items: big tracked caps, lit bar on hover ------------------------------------------ */
.screen button.mm-item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 58dp;
	line-height: 58dp;
	padding: 0 20dp 0 16dp;
	text-align: left;
	font-size: 25dp;
	letter-spacing: 3dp;
	color: #D7DCF0;
	background-color: transparent;
	border-width: 0;
	border-left: 4dp transparent;
	transition: color border-color 0.12s cubic-out, padding-left 0.16s cubic-out;
}

.screen button.mm-item:hover
{
	color: #FFFFFF;
	padding-left: 24dp;
	border-left-color: #BAFF0C;
	background-color: transparent;
	decorator: horizontal-gradient(#2F37A8D2 #2F37A800);
}

.screen button.mm-item:active
{
	color: #BAFF0C;
	border-left-color: #BAFF0C;
	background-color: transparent;
	decorator: horizontal-gradient(#1E246EE6 #1E246E00);
}

.screen button.mm-item:focus-visible
{
	border-left-color: #BAFF0C;
}

/* Right-hand chevron on items that open another panel. */
.mm-item gametext
{
	flex: 1 1 auto;
}

.mm-more
{
	flex: 0 0 auto;
	font-size: 30dp;
	color: #8080FF;
	opacity: 0.6;
}

.mm-item:hover .mm-more
{
	opacity: 1;
	color: #BAFF0C;
}

.screen button.mm-quiet, .screen button.mm-back
{
	height: 50dp;
	line-height: 50dp;
	font-size: 19dp;
	color: #A9B1CF;
}

.mm-back .chevron
{
	font-size: 28dp;
	margin-right: 12dp;
}

.mm-rule
{
	height: 1dp;
	margin: 12dp 0 12dp 16dp;
	background-color: #8080FF28;
}

.mm-version
{
	position: absolute;
	right: 20dp;
	bottom: 14dp;
	font-size: 13dp;
	color: #7079A0;
}

/* ---- Faction emblem over the map ------------------------------------------------------------ */
.mm-hero
{
	position: absolute;
	top: 36%;
	left: 22%;
	width: 216dp;
	height: 216dp;
}

.mm-hero mappedimage
{
	position: absolute;
	top: 0;
	left: 0;
	width: 216dp;
	height: 216dp;
	opacity: 0;
	transition: opacity 0.2s cubic-out;
}

.mm-hero mappedimage.visible
{
	opacity: 1;
}

/* Narrow (5:4, 4:3) screens: the rail takes more of the opening, so the emblem moves left. */
@media (max-aspect-ratio: 3/2)
{
	.mm-hero
	{
		left: 12%;
	}
}
