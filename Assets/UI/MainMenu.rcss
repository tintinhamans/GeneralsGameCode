/*
	MainMenu.rcss -- the main menu. Palette, type and motion tokens come from the screen template
	in common.rcss.

	The shell map is the main menu's picture. The logo sits top-left with the root menu under it
	down the left edge; a sub-panel (solo, multiplayer, load/replay, difficulty) slides in beside the
	menu while the root stays up with its item marked. The faction emblem of the solo and
	difficulty panels floats over the map between the menus and the news strip on the right, which
	holds Generals Online's player count and message of the day when the client has them and the
	build version always. Every panel is always in .mm-sub; the "panel" data model variable marks
	one .active, the only one laid out, and it slides in as it fades up (opacity and margin-left:
	the renderer has no transforms).
*/

/* ---- Layout -------------------------------------------------------------------------------- */
.mm-frame
{
	display: block;
}

.mm-left
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 540dp;
}

/* The logo is fixed dp: mappedimage ignores percentage sizes. 370x120 art. */
.mm-logo
{
	display: block;
	width: 463dp;
	height: 150dp;
	margin: 6dp 0 34dp 4dp;
}

.mm-menu, .mm-sub
{
	display: block;
	box-sizing: border-box;
	padding: 18dp 20dp;
	background-color: #070A1AE0;
	border-top: 2dp #F07A1A;
}

.mm-sub
{
	display: none;
	position: absolute;
	left: 560dp;
	top: 190dp;
	width: 450dp;
	border-top-color: #8080FF46;
}

.mm-sub.open
{
	display: block;
	animation: 0.24s cubic-out sub-in;
}

@keyframes sub-in
{
	from { opacity: 0; margin-left: -40dp; }
	to { opacity: 1; margin-left: 0dp; }
}

/* Only the active panel is laid out; it slides in from the right as it fades up. */
.panel
{
	display: none;
}

.panel.active
{
	display: block;
	animation: 0.26s cubic-out panel-in;
}

@keyframes panel-in
{
	from { opacity: 0; margin-left: 60dp; }
	to { opacity: 1; margin-left: 0dp; }
}

/* Sub-panel title, same accent tick as a screen title. */
.mm-heading
{
	display: block;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: #7079A0;
	padding-left: 20dp;
	margin-bottom: 15dp;
	white-space: nowrap;
}

/* ---- Menu items: big tracked caps, lit bar on hover ------------------------------------------ */
.screen button.mm-item
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 100%;
	height: 73dp;
	line-height: 73dp;
	padding: 0 25dp 0 20dp;
	text-align: left;
	font-size: 31dp;
	letter-spacing: 3dp;
	color: #D7DCF0;
	background-color: transparent;
	border-width: 0;
	border-left: 4dp transparent;
	transition: color border-color 0.12s cubic-out, padding-left 0.16s cubic-out;
}

.screen button.mm-item:hover
{
	color: #FFFFFF;
	padding-left: 30dp;
	border-left-color: #F07A1A;
	background-color: transparent;
	decorator: horizontal-gradient(#2F37A8D2 #2F37A800);
}

.screen button.mm-item:active
{
	color: #FF9A3D;
	border-left-color: #F07A1A;
	background-color: transparent;
	decorator: horizontal-gradient(#1E246EE6 #1E246E00);
}

.screen button.mm-item:focus-visible
{
	border-left-color: #F07A1A;
}

/* The root item whose panel is open beside the menu. */
.screen button.mm-item.current, .screen button.mm-item.current:hover
{
	color: #FFFFFF;
	border-left-color: #F07A1A;
	decorator: horizontal-gradient(#2F37A8F0 #2F37A840);
}

.mm-item.current .mm-more
{
	opacity: 1;
	color: #FF9A3D;
}

/* Right-hand chevron on items that open another panel. */
.mm-item gametext
{
	flex: 1 1 auto;
}

.mm-more
{
	flex: 0 0 auto;
	font-size: 38dp;
	color: #8080FF;
	opacity: 0.6;
}

.mm-item:hover .mm-more
{
	opacity: 1;
	color: #FF9A3D;
}

.screen button.mm-quiet, .screen button.mm-back
{
	height: 63dp;
	line-height: 63dp;
	font-size: 24dp;
	color: #A9B1CF;
}

.mm-back .chevron
{
	font-size: 35dp;
	margin-right: 15dp;
}

.mm-rule
{
	height: 1dp;
	margin: 15dp 0 15dp 20dp;
	background-color: #8080FF28;
}

/* ---- News strip ------------------------------------------------------------------------------ */
.mm-strip
{
	display: block;
	position: absolute;
	right: 0;
	top: 0;
	width: 400dp;
}

.mm-online
{
	display: block;
	margin-top: 14dp;
	font-size: 22dp;
	font-weight: bold;
	color: #EEF1FA;
}

.mm-online .dot
{
	margin-right: 12dp;
	vertical-align: middle;
}

.mm-sub-overline
{
	margin-top: 22dp;
	padding-top: 16dp;
	border-top: 1dp #8080FF28;
}

.mm-motd-lines
{
	display: block;
	margin-top: 10dp;
	max-height: 460dp;
	overflow: hidden;
}

.mm-motd-line
{
	display: block;
	font-size: 18dp;
	line-height: 25dp;
	color: #D7DCF0;
}

.mm-offline
{
	display: block;
	margin-top: 12dp;
	font-size: 18dp;
	line-height: 25dp;
}

.mm-version-value
{
	display: block;
	margin-top: 6dp;
	font-size: 18dp;
	color: #D7DCF0;
}

/* ---- Faction emblem over the map, between the menus and the strip ----------------------------- */
.mm-hero
{
	display: block;
	position: absolute;
	left: 1030dp;
	right: 420dp;
	top: 250dp;
	height: 280dp;
}

.mm-hero mappedimage
{
	position: absolute;
	top: 0;
	left: 50%;
	margin-left: -130dp;
	width: 260dp;
	height: 260dp;
	opacity: 0;
	transition: opacity 0.2s cubic-out;
}

.mm-hero mappedimage.visible
{
	opacity: 1;
}

/* Narrow (5:4, 4:3) screens: no room for the emblem, and the strip gives way to an open sub-panel. */
@media (max-aspect-ratio: 3/2)
{
	.mm-left { width: 470dp; }
	.mm-sub { left: 490dp; width: 420dp; }
	.mm-logo { width: 432dp; height: 140dp; }
	.mm-sub { top: 180dp; }
	.mm-hero { display: none; }
	.mm-strip { width: 330dp; }
	.mm-strip.covered { display: none; }
}
