/*
	MainMenu.rcss -- layout only; palette/buttons/frame come from common.rcss.

	Panel navigation (main/single/multi/loadreplay/difficulty) is CSS-class driven, not
	data-if: every panel is always present, stacked on top of each other, and crossfades via
	opacity so switching panels gets a simple transition instead of popping in/out (see
	RmlMainMenuScreen -- "panel" data model variable selects which one is .active).
*/

body { width: 100%; height: 100%; }

/* .shell-frame is the full blueprint panel (see common.rcss), but the original MainMenu.wnd
   draws only the ruler overlay plus the logo + button column over the live 3D shell map --
   everything else is transparent. Drop shell-frame's full-panel fill/border here so the shell
   map (stood in for by the renderer's background colour) shows through; the button column gets
   its own panel below, like the original. */
.mainmenu-frame
{
	display: block;
	background-color: transparent;
	border-width: 0;
}

.logo
{
	position: absolute;
	top: 16dp;
	right: 24dp;
	width: 30%;
	min-width: 320dp;
	max-width: 480dp;
	height: 15%;
	min-height: 100dp;
	max-height: 150dp;
}

.version
{
	position: absolute;
	bottom: 8dp;
	right: 12dp;
	font-size: 13dp;
	color: #C0C0C0;
}

.panels-stack
{
	position: absolute;
	/* directly under the logo (16dp top + up to 150dp max-height) instead of a fixed 30% that left
	   a large dead gap between the logo and the button column (task: "put the button column
	   directly under the logo like the original") */
	top: 180dp;
	right: 24dp;
	width: 30%;
	min-width: 320dp;
	max-width: 480dp;
	/* No "bottom:" -- height comes from the active panel's own content (see .panel.active below),
	   so the translucent background hugs whichever button list is showing instead of stretching
	   all the way down to the frame edge and leaving empty space under the last button. */
	padding: 0; /* panels below carry their own padding so the crossfade doesn't shift content */
	box-sizing: border-box;
	background-color: rgba(2, 2, 2, 190);
	border: 2dp #2F37A8;
}

.panel
{
	/* Inactive panels are pulled out of flow (absolute, invisible) so they don't add to
	   .panels-stack's height; the active one is put back in normal flow below so the stack's
	   auto height tracks it. Both still crossfade via opacity like before. */
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	box-sizing: border-box;
	padding: 16dp;
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.2s;
	display: flex;
	flex-direction: column;
	justify-content: flex-start; /* buttons start right under the logo, not pinned to the bottom */
}

.panel.active
{
	position: static;
	opacity: 1;
	pointer-events: auto;
}

.menu-list
{
	display: flex;
	flex-direction: column;
}

.menu-list button
{
	margin-bottom: 8dp;
}

.menu-list button.back
{
	margin-top: 16dp;
}

.menu-heading
{
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	margin-bottom: 12dp;
}

.faction-art
{
	width: 144dp;
	height: 144dp;
	margin: 0 auto 16dp auto;
}

/* Single panel's faction hover previews: stacked, crossfaded via opacity (see .faction-preview
   mappedimage.visible) instead of the .wnd's TheTransitionHandler animation groups. */
.faction-preview
{
	position: relative;
	width: 144dp;
	height: 144dp;
	margin: 0 auto 16dp auto;
}

.faction-preview mappedimage
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	opacity: 0;
	transition: opacity 0.15s;
}

.faction-preview mappedimage.visible
{
	opacity: 1;
}

.hidden { display: none; }
