/*
	MainMenu.rcss -- layout only; palette/buttons/frame come from common.rcss.

	Panel navigation (main/single/multi/loadreplay/difficulty) is CSS-class driven, not
	data-if: every panel is always present, stacked on top of each other, and crossfades via
	opacity so switching panels gets a simple transition instead of popping in/out (see
	RmlMainMenuScreen -- "panel" data model variable selects which one is .active).
*/

body { width: 100%; height: 100%; }

.logo
{
	position: absolute;
	top: 24dp;
	right: 40dp;
	width: 360dp;
	height: 110dp;
}

.version
{
	position: absolute;
	bottom: 12dp;
	right: 16dp;
	font-size: 12dp;
	color: #C0C0C0;
}

.panels-stack
{
	position: absolute;
	top: 150dp;
	right: 40dp;
	width: 320dp;
	height: 420dp;
	padding: 0; /* panels below carry their own padding so the crossfade doesn't shift content */
}

.panel
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	padding: 12dp;
	opacity: 0;
	pointer-events: none;
	transition: opacity 0.2s;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
}

.panel.active
{
	opacity: 1;
	pointer-events: auto;
}

.menu-list
{
	display: flex;
	flex-direction: column;
}

.menu-list button
{
	margin-bottom: 8dp;
}

.menu-list button.back
{
	margin-top: 16dp;
}

.section-title
{
	text-align: center;
	font-weight: bold;
	margin-bottom: 12dp;
}

.faction-art
{
	width: 144dp;
	height: 144dp;
	margin: 0 auto 16dp auto;
}

/* Single panel's faction hover previews: stacked, crossfaded via opacity (see .faction-preview
   mappedimage.visible) instead of the .wnd's TheTransitionHandler animation groups. */
.faction-preview
{
	position: relative;
	width: 144dp;
	height: 144dp;
	margin: 0 auto 16dp auto;
}

.faction-preview mappedimage
{
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	opacity: 0;
	transition: opacity 0.15s;
}

.faction-preview mappedimage.visible
{
	opacity: 1;
}

.hidden { display: none; }
