<rml>
<head>
	<title>ChallengeLoadScreen</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="LoadScreen.rcss"/>
	<link type="text/rcss" href="ChallengeLoadScreen.rcss"/>
</head>
<body class="screen ld" data-model="challengeload">
	<!-- The mission's backdrop movie over the whole screen. -->
	<div class="ld-art">
		<div class="ld-movie" data-if="has_movie"><video source="loadscreen-background" fit="cover"/></div>
	</div>
	<div class="ld-scrim cl-scrim"></div>
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<!-- General against general, at the .wnd's places on a 4:3 stage: portrait movies (stills on min
	     spec), typed out names and bios, the reticle circles and the "vs" movie between them. -->
	<div class="ls-stage-wrap">
		<div class="ls-stage">
			<div class="cl-big-name left" data-if="show_bio_entries"><div>{{generals[0].big_name}}</div></div>
			<div class="cl-portrait-movie left" data-if="show_portrait_movies"><video source="loadscreen-portrait-left" fit="contain"/></div>
			<div class="cl-portrait left" data-if="show_portraits &amp;&amp; generals[0].has_portrait"><mappedimage data-attr-name="generals[0].portrait"/></div>
			<div class="cl-bio left" data-if="show_bio_titles">
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioName"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[0].name}}</div></div>
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioRank"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[0].rank}}</div></div>
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioStrategy"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[0].strategy}}</div></div>
			</div>

			<div class="cl-big-name right" data-if="show_bio_entries"><div>{{generals[1].big_name}}</div></div>
			<div class="cl-portrait-movie right" data-if="show_portrait_movies"><video source="loadscreen-portrait-right" fit="contain"/></div>
			<div class="cl-portrait right" data-if="show_portraits &amp;&amp; generals[1].has_portrait"><mappedimage data-attr-name="generals[1].portrait"/></div>
			<div class="cl-bio right" data-if="show_bio_titles">
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioName"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[1].name}}</div></div>
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioRank"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[1].rank}}</div></div>
				<div class="cl-bio-row"><div class="cl-bio-label"><gametext key="GUI:BioStrategy"/></div><div class="cl-bio-entry" data-if="show_bio_entries">{{generals[1].strategy}}</div></div>
			</div>

			<mappedimage class="cl-outer-circle" data-if="show_outer_circle" name="Circle_Small01"/>
			<mappedimage class="cl-inner-circle" data-if="show_inner_circle" name="Circle_Small01"/>
			<mappedimage class="cl-versus-backdrop" data-if="show_versus_backdrop" name="Circle_Small03_Black"/>
			<div class="cl-versus" data-if="show_versus"><video source="loadscreen-versus" fit="contain"/></div>
		</div>
	</div>

	<div class="screen-frame ld-frame">
		<div class="ld-mid"></div>
		<div class="ld-bottom">
			<div class="overline accent-overline ld-bottom-mode"><gametext key="GUI:Generals_Challenge"/></div>
			<div class="overline ld-bottom-label"><gametext key="GUI:Loading"/></div>
			<div class="progress ld-bar" data-class-center1="bar_color == 1" data-class-center2="bar_color == 2" data-class-center3="bar_color == 3"><div class="progress-fill" data-style-width="progress_style"></div></div>
		</div>
	</div>
</body>
</rml>
