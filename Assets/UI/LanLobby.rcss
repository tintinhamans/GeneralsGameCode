/*
	LanLobby.rcss -- layout specific to LanLobby.rml. Palette/frame/button/scroll-container/list/chat
	rules come from common.rcss; game-list rows reuse GameSetup.rcss's .map-row/.map-name.
*/

/* ---- Three-column body: players / games / details --------------------------------------- */
.lobby-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.players-column
{
	display: flex;
	flex-direction: column;
	width: 180dp;
	margin-right: 8dp;
}

.games-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	margin-right: 8dp;
}

.details-column
{
	display: flex;
	flex-direction: column;
	width: 260dp;
}

.map-name.in-progress
{
	color: #808080;
}

/* ---- Game details panel (mirrors GameInfoWindow.cpp's RefreshGameInfoWindow) ------------- */
.game-details
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
	padding: 6dp;
}

.details-map
{
	font-weight: bold;
	color: #FFFFFF;
	margin-bottom: 6dp;
	padding-bottom: 4dp;
	border-bottom: 1dp #2F37A8;
}

.details-slot-list
{
	flex: 1 1 auto;
}

.details-slot
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 2dp 0;
}

.details-slot.observer
{
	color: #C0C0C0;
}

.details-slot-icon
{
	flex: 0 0 auto;
	width: 20dp;
	height: 20dp;
	margin-right: 6dp;
}

.details-slot-label
{
	flex: 1 1 auto;
}

/* ---- Chat ---------------------------------------------------------------------------------- */
/* ---- Player name / footer row -------------------------------------------------------------- */
.name-row
{
	align-items: center;
}

.name-row > .label
{
	flex: 0 0 auto;
	margin-right: 6dp;
}

.name-input
{
	flex: 0 0 auto;
	width: 140dp;
	margin-right: 8dp;
}

/* ---- Chat entry icon button (original ButtonSendChat draws ReturnButton) ---------------- */
