<rml>
<head>
	<title>BuddyOverlay</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="BuddyOverlay.rcss"/>
</head>
<body data-model="buddyoverlay">
	<div class="frame buddy-frame">
		<div class="buddy-tabs">
			<button data-class-active="!show_block_tab" data-event-click="set_tab(0)"><gametext key="GUI:Buddies"/></button>
			<!-- RadioButtonIgnore's text is overwritten to this exact hardcoded (non-GUI:-key) literal
			     under GENERALS_ONLINE (WOLBuddyOverlay.cpp), not a GameText key -- mirrored verbatim. -->
			<button data-class-active="show_block_tab" data-event-click="set_tab(1)">Block</button>
			<div class="spacer"></div>
			<!-- ButtonHide's .wnd-baked label reads "EXIT" verbatim (confirmed by rendering the
			     original WOLBuddyOverlay.wnd, see report) -- a plain hardcoded literal, same as
			     PlayerInfo.rml's LOGOUT/this file's "Block" tab, not a GameText key. No TOOLTIPTEXT
			     exists on any control in the original .wnd family, so this popup carries none either. -->
			<button data-event-click="close">EXIT</button>
		</div>

		<div class="buddy-body" data-if="!show_block_tab">
			<div class="roster-column">
				<div class="scroll-container list-box opaque roster-list">
					<div data-for="row : roster_rows">
						<div class="list-row roster-row" data-if="row.used"
							data-class-lobby="row.is_lobby_member" data-class-recent="row.is_recent"
							data-class-request="row.is_request" data-class-friend="row.is_friend"
							data-class-online="row.online" data-class-offline="row.is_friend && !row.online"
							data-event-click="row_clicked(row.index)" data-event-mousedown="row_mousedown(row.index)">
							<div class="roster-dot" data-if="row.is_friend"></div>
							<div class="roster-name" data-style-color="row.name_color">{{row.name}}</div>
							<div class="roster-unread" data-if="row.has_unread">[{{row.unread_text}}]</div>
							<div class="roster-status">{{row.status_text}}</div>
						</div>
					</div>
				</div>
			</div>

			<div class="chat-column">
				<div class="section-title" data-if="has_chat_target">{{chat_target_name}}</div>
				<div class="section-title" data-if="!has_chat_target"><gametext key="GUI:Buddies"/></div>
				<scrolllog class="chat-log">
					<div class="chat-line" data-for="line : chat_lines">
						<span data-if="line.used" data-style-color="line.color">{{line.text}}</span>
					</div>
				</scrolllog>
				<div class="chat-entry">
					<input type="text" class="chat-input" maxlength="64" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
					<button class="icon-btn" data-event-click="send_chat"><mappedimage name="ReturnButton"/></button>
				</div>
			</div>
		</div>

		<div class="buddy-body" data-if="show_block_tab">
			<div class="scroll-container list-box opaque block-list">
				<div data-for="row : blocked_rows">
					<div class="list-row block-row" data-if="row.used" data-event-mousedown="blocked_row_mousedown(row.index)">{{row.name}}</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Siblings of .frame (not nested inside it), same reasoning as OnlineLobby.rml's context menu:
	     .frame is position:absolute, so a .context-menu nested inside it would resolve
	     data-style-left/top's viewport-relative mouse_x/mouse_y against .frame's box instead of the
	     viewport. -->
	<div class="context-menu-backdrop" data-if="player_menu_visible" data-event-mousedown="player_menu_dismiss"></div>
	<div id="player-context-menu" class="context-menu" data-if="player_menu_visible" data-style-left="player_menu_x_style" data-style-top="player_menu_y_style">
		<div data-for="item : player_menu_items">
			<div class="context-menu-item" data-if="item.used" data-event-click="player_menu_item_clicked(item.action)">{{item.label}}</div>
		</div>
	</div>
</body>
</rml>
