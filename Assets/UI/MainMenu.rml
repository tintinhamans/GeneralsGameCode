<rml>
<head>
	<title>Main Menu</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="MainMenu.rcss"/>
</head>
<!-- Layout variant: mm-d (HQ command terminal, default), mm-a (floating menu), mm-b (command rail) or
     mm-c (bottom bar). See MainMenu.rcss. -->
<body class="screen mm-d" data-model="mainmenu">
	<!-- Soft fade behind the menu, darkest at the screen's left edge; under the ruler. -->
	<div class="d-shade"></div>

	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<!-- Header strip: logo left; online status and the local time right. -->
	<div class="d-band d-header"><div class="d-band-in">
		<mappedimage name="GeneralsLogo" class="d-logo"/>
		<div class="d-status">
			<div class="d-pill d-on" data-if="logged_in"><span class="d-dot"></span><span class="d-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="d-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="d-name" data-if="player_name != ''">{{player_name}}</span></div>
			<div class="d-pill d-off" data-if="!logged_in"><span class="d-dot"></span><gametext key="GUI:GOMenuOffline"/></div>
			<div class="d-clock" data-if="clock_text != ''">{{clock_text}}</div>
		</div>
	</div></div>

	<div class="screen-frame mm-frame">
		<!-- Faction emblem over the shell map: the solo panel's hover preview (MainMenu.cpp's
		     GBM_MOUSE_ENTERING/LEAVING art) and the difficulty panel's chosen side. -->
		<div class="mm-hero" data-class-diff="panel == 'difficulty'">
			<mappedimage name="SAFactionLogo144_US" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'USA') || (panel == 'difficulty' &amp;&amp; selected_faction == 'USA')"/>
			<mappedimage name="SUFactionLogo144_GLA" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'GLA') || (panel == 'difficulty' &amp;&amp; selected_faction == 'GLA')"/>
			<mappedimage name="SNFactionLogo144_China" data-class-visible="(panel == 'single' &amp;&amp; hover_faction == 'China') || (panel == 'difficulty' &amp;&amp; selected_faction == 'China')"/>
			<mappedimage name="Training144" data-class-visible="panel == 'single' &amp;&amp; hover_faction == 'Training'"/>
		</div>

		<!-- Logo and the root menu; the root stays up while a sub-panel is open beside it. -->
		<div class="mm-left">
			<mappedimage name="GeneralsLogo" class="mm-logo"/>

			<div class="mm-menu">
				<button class="mm-item" data-class-current="panel == 'single' || panel == 'difficulty'" data-event-click="go_single"><gametext key="GUI:SinglePlayer"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-class-current="panel == 'multi'" data-event-click="go_multi"><gametext key="GUI:Multiplayer"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-class-current="panel == 'loadreplay'" data-event-click="go_loadreplay"><gametext key="GUI:ReplayMenu"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="options" data-event-click="go_options"><gametext key="GUI:Options"/></button>
				<button class="mm-item" data-event-click="go_credits"><gametext key="GUI:Credits"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-quiet" data-hook="exit" data-event-click="go_exit"><gametext key="GUI:Exit"/></button>
			</div>
		</div>

		<!-- Sub-panels open beside (or above) the menu; only the active one is laid out. -->
		<div class="mm-sub" data-class-open="panel != 'main'">
			<!-- Single player: skirmish, campaign faction pick, Generals Challenge -->
			<div class="panel" data-class-active="panel == 'single'">
				<div class="mm-heading"><gametext key="GUI:SinglePlayer"/></div>
				<button class="mm-item" data-hook="skirmish" data-event-click="go_skirmish" data-tooltip="GUI:SkirmishLower"><gametext key="GUI:Skirmish"/></button>
				<button class="mm-item" data-hook="usa" data-event-click="select_usa" data-event-mouseover="preview_usa" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign3"><gametext key="GUI:USA"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="gla" data-event-click="select_gla" data-event-mouseover="preview_gla" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign2"><gametext key="GUI:GLA"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="china" data-event-click="select_china" data-event-mouseover="preview_china" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign1"><gametext key="GUI:CHINA_Caps"/><span class="mm-more">&#8250;</span></button>
				<button class="mm-item" data-hook="challenge" data-event-click="select_challenge" data-event-mouseover="preview_challenge" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:ChallengeButton"><gametext key="GUI:Generals_Challenge"/><span class="mm-more">&#8250;</span></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Multiplayer -->
			<div class="panel" data-class-active="panel == 'multi'">
				<div class="mm-heading"><gametext key="GUI:Multiplayer"/></div>
				<button class="mm-item" data-hook="online" data-event-click="go_online"><gametext key="GUI:GeneralsOnline"/></button>
				<button class="mm-item" data-hook="network" data-event-click="go_network"><gametext key="GUI:Network"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Load/Replay -->
			<div class="panel" data-class-active="panel == 'loadreplay'">
				<div class="mm-heading"><gametext key="GUI:ReplayMenu"/></div>
				<button class="mm-item" data-event-click="go_load_game"><gametext key="GUI:MainMenuLoadGame"/></button>
				<button class="mm-item" data-event-click="go_replay"><gametext key="GUI:MainMenuLoadReplay"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>

			<!-- Campaign difficulty select (reached from single player's faction/challenge buttons) -->
			<div class="panel" data-class-active="panel == 'difficulty'">
				<div class="mm-heading"><gametext key="GUI:SelectDifficulty"/></div>
				<button class="mm-item" data-event-click="select_easy"><gametext key="GUI:EasyCaps"/></button>
				<button class="mm-item" data-event-click="select_medium"><gametext key="GUI:MediumDifficultyCaps"/></button>
				<button class="mm-item" data-event-click="select_hard"><gametext key="GUI:HardCaps"/></button>
				<div class="mm-rule"></div>
				<button class="mm-item mm-back" data-event-click="diff_back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			</div>
		</div>

		<!-- Generals Online: who is online and the message of the day. The client has them only while
		     logged in, so the card is only there then. -->
		<div class="mm-news" data-if="has_news || players_online_text != ''" data-class-covered="panel != 'main'">
			<div class="mm-news-head">
				<div class="mm-news-title"><gametext key="GUI:GOStatusTitle"/></div>
				<div class="mm-online" data-if="players_online_text != ''"><span class="dot"></span>{{players_online_text}}</div>
			</div>
			<div class="mm-motd" data-if="has_news">
				<div class="mm-motd-line" data-for="line : news_lines">{{line}}</div>
			</div>
		</div>

		<!-- Build: one small line. -->
		<div class="mm-build">{{ version }}</div>

		<!-- ==== D: HQ command terminal (only laid out in mm-d) ==== -->
		<!-- Root menu, lower left: big stencil labels over a line of description; brackets, an index and a
		     scan line on hover. -->
		<div class="d-menu">
			<button class="d-item" data-class-current="panel == 'single' || panel == 'difficulty'" data-event-click="go_single"><span class="d-idx">01</span><div class="d-text"><div class="d-label"><gametext key="GUI:SinglePlayer"/></div><div class="d-desc"><gametext key="GUI:GOMenuSoloDesc"/></div></div><span class="d-scan"></span><span class="br br-tl"></span><span class="br br-tr"></span><span class="br br-bl"></span><span class="br br-br"></span></button>
			<button class="d-item" data-class-current="panel == 'multi'" data-event-click="go_multi"><span class="d-idx">02</span><div class="d-text"><div class="d-label"><gametext key="GUI:Multiplayer"/></div><div class="d-desc"><gametext key="GUI:GOMenuMultiDesc"/></div></div><span class="d-scan"></span><span class="br br-tl"></span><span class="br br-tr"></span><span class="br br-bl"></span><span class="br br-br"></span></button>
			<button class="d-item" data-class-current="panel == 'loadreplay'" data-event-click="go_loadreplay"><span class="d-idx">03</span><div class="d-text"><div class="d-label"><gametext key="GUI:ReplayMenu"/></div><div class="d-desc"><gametext key="GUI:GOMenuLoadDesc"/></div></div><span class="d-scan"></span><span class="br br-tl"></span><span class="br br-tr"></span><span class="br br-bl"></span><span class="br br-br"></span></button>
			<button class="d-item" data-hook="options" data-event-click="go_options"><span class="d-idx">04</span><div class="d-text"><div class="d-label"><gametext key="GUI:Options"/></div><div class="d-desc"><gametext key="GUI:GOMenuOptionsDesc"/></div></div><span class="d-scan"></span><span class="br br-tl"></span><span class="br br-tr"></span><span class="br br-bl"></span><span class="br br-br"></span></button>
			<button class="d-item" data-event-click="go_credits"><span class="d-idx">05</span><div class="d-text"><div class="d-label"><gametext key="GUI:Credits"/></div><div class="d-desc"><gametext key="GUI:GOMenuCreditsDesc"/></div></div><span class="d-scan"></span><span class="br br-tl"></span><span class="br br-tr"></span><span class="br br-bl"></span><span class="br br-br"></span></button>
			<button class="d-exit" data-hook="exit" data-event-click="go_exit"><span class="d-exit-mark"></span><gametext key="GUI:Exit"/></button>
		</div>

		<!-- Sub-panels: a row of cards beside the menu; only the active row is laid out. -->
		<div class="d-cards" data-class-open="panel != 'main'">
			<div class="d-row" data-class-active="panel == 'single'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:SinglePlayer"/></div><button class="d-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button></div>
				<div class="d-deck">
				<div class="d-group">
				<div class="d-group-head"><gametext key="GUI:Campaign"/></div>
				<div class="d-group-cards">
				<button class="d-card d-fac" data-hook="usa" data-event-click="select_usa" data-event-mouseover="preview_usa" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign3"><div class="d-art"><mappedimage class="d-full" name="MissionLoad_USA"/><div class="d-shine"></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:USA"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-fac" data-hook="gla" data-event-click="select_gla" data-event-mouseover="preview_gla" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign2"><div class="d-art"><mappedimage class="d-full" name="MissionLoad_GLA"/><div class="d-shine"></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:GLA"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-fac" data-hook="china" data-event-click="select_china" data-event-mouseover="preview_china" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:Campaign1"><div class="d-art"><mappedimage class="d-full" name="MissionLoad_China"/><div class="d-shine"></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:CHINA_Caps"/></div></div><span class="d-edge"></span></button>
				</div>
				</div>
				<button class="d-card d-solo" data-hook="skirmish" data-event-click="go_skirmish" data-tooltip="GUI:SkirmishLower"><div class="d-art"><mappedimage class="d-bg" name="MDSkirmishLoadB"/><div class="d-tint"></div><mappedimage class="d-emb" name="Skirmish144"/></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:Skirmish"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuSkirmishDesc"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-solo" data-hook="challenge" data-event-click="select_challenge" data-event-mouseover="preview_challenge" data-event-mouseout="preview_clear" data-tooltip="TOOLTIP:ChallengeButton"><div class="d-art"><mappedimage class="d-bg" name="GCBackgroundMinSpec"/><div class="d-tint"></div><mappedimage class="d-emb" name="Training144"/></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:Generals_Challenge"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuChallengeDesc"/></div></div><span class="d-edge"></span></button>
				</div>
			</div>

			<div class="d-row" data-class-active="panel == 'multi'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:Multiplayer"/></div><button class="d-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button></div>
				<div class="d-deck">
				<button class="d-card d-wide" data-hook="online" data-event-click="go_online" data-tooltip="TOOLTIP:Online"><div class="d-art"><mappedimage class="d-bg" name="GCBackgroundMinSpec"/><div class="d-tint"></div><mappedimage class="d-medal" name="GlobalGen"/></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:GeneralsOnline"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuOnlineDesc"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-wide" data-hook="network" data-event-click="go_network" data-tooltip="TOOLTIP:Network"><div class="d-art"><mappedimage class="d-bg" name="EarthMap"/><div class="d-tint"></div><div class="d-glyph g-net"><span class="l l1"></span><span class="l l2"></span><span class="l l3"></span><span class="n n0"></span><span class="n n1"></span><span class="n n2"></span><span class="n n3"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:Network"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuNetworkDesc"/></div></div><span class="d-edge"></span></button>
				</div>
			</div>

			<div class="d-row" data-class-active="panel == 'loadreplay'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:ReplayMenu"/></div><button class="d-back" data-event-click="back_main"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button></div>
				<div class="d-deck">
				<button class="d-card d-wide" data-event-click="go_load_game"><div class="d-art"><mappedimage class="d-bg" name="EarthMap"/><div class="d-tint"></div><div class="d-glyph g-save"><span class="s s1"></span><span class="s s2"></span><span class="s s3"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:MainMenuLoadGame"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuLoadGameDesc"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-wide" data-event-click="go_replay"><div class="d-art"><mappedimage class="d-bg" name="EarthMap"/><div class="d-tint"></div><div class="d-glyph g-rec"><mappedimage class="ring" name="Circle_Mid"/><mappedimage class="ring ring-in" name="Circle_Mid"/><span class="tick t-n"></span><span class="tick t-s"></span><span class="tick t-w"></span><span class="tick t-e"></span><span class="core"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:MainMenuLoadReplay"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuReplayDesc"/></div></div><span class="d-edge"></span></button>
				</div>
			</div>

			<!-- Campaign difficulty: the chosen side, then three levels. -->
			<div class="d-row" data-class-active="panel == 'difficulty'">
				<div class="d-row-head"><div class="d-row-title"><gametext key="GUI:SelectDifficulty"/></div><button class="d-back" data-event-click="diff_back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button></div>
				<div class="d-deck">
				<div class="d-card d-pick">
					<div class="d-art">
						<mappedimage class="d-full" name="MissionLoad_USA" data-if="selected_faction == 'USA'"/>
						<mappedimage class="d-full" name="MissionLoad_GLA" data-if="selected_faction == 'GLA'"/>
						<mappedimage class="d-full" name="MissionLoad_China" data-if="selected_faction == 'China'"/>
						<mappedimage class="d-bg" name="GCBackgroundMinSpec" data-if="selected_faction == 'Training'"/>
						<div class="d-tint" data-if="selected_faction == 'Training'"></div>
						<mappedimage class="d-emb" name="Training144" data-if="selected_faction == 'Training'"/>
						<div class="d-shine"></div>
					</div>
					<div class="d-card-text">
						<div class="d-title" data-if="selected_faction == 'USA'"><gametext key="GUI:USA"/></div>
						<div class="d-title" data-if="selected_faction == 'GLA'"><gametext key="GUI:GLA"/></div>
						<div class="d-title" data-if="selected_faction == 'China'"><gametext key="GUI:CHINA_Caps"/></div>
						<div class="d-title" data-if="selected_faction == 'Training'"><gametext key="GUI:Generals_Challenge"/></div>
						<div class="d-cdesc" data-if="selected_faction != 'Training'"><gametext key="GUI:Campaign"/></div>
					</div>
				</div>
				<button class="d-card d-diff" data-event-click="select_easy"><div class="d-art"><div class="d-level"><span class="bar on"></span><span class="bar"></span><span class="bar"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:EasyCaps"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuEasyDesc"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-diff" data-event-click="select_medium"><div class="d-art"><div class="d-level"><span class="bar on"></span><span class="bar on"></span><span class="bar"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:MediumDifficultyCaps"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuMediumDesc"/></div></div><span class="d-edge"></span></button>
				<button class="d-card d-diff" data-event-click="select_hard"><div class="d-art"><div class="d-level"><span class="bar on"></span><span class="bar on"></span><span class="bar on"></span></div></div><div class="d-card-text"><div class="d-title"><gametext key="GUI:HardCaps"/></div><div class="d-cdesc"><gametext key="GUI:GOMenuHardDesc"/></div></div><span class="d-edge"></span></button>
				</div>
			</div>
		</div>
	</div>

	<!-- Bottom ticker: Generals Online news scrolling while logged in, else the build. The slide
	     brings the run in from the right edge (its left, a share of the viewport) while the run moves
	     back by its own width (its left, a share of the shrink-to-fit track), so the text enters on
	     the right and leaves on the left whatever its length. -->
	<div class="d-band d-ticker"><div class="d-band-in">
		<div class="d-tag" data-if="has_news"><span class="d-dot"></span><gametext key="GUI:GOStatusTitle"/></div>
		<div class="d-tk-view" data-if="has_news">
			<div class="d-tk-slide"><div class="d-tk-track"><div class="d-tk-run"><span data-for="line : news_lines"><span class="d-tk-item" data-if="line != ' ' &amp;&amp; line != ''">{{line}}</span></span></div></div></div>
			<div class="d-tk-fade"></div>
		</div>
		<div class="d-tk-static" data-if="!has_news">{{ version }}</div>
	</div></div>
</body>
</rml>
