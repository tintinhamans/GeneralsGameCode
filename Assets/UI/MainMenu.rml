<rml>
<head>
	<title>Main Menu</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="MainMenu.rcss"/>
</head>
<body data-model="mainmenu">
	<mappedimage name="GeneralsLogo" class="logo"/>
	<div class="version">{{ version }}</div>

	<div class="frame panels-stack">
		<!-- Root -->
		<div class="panel" data-class-active="panel == 'main'">
			<div class="menu-list">
				<button data-event-click="go_single"><gametext key="GUI:SinglePlayer"/></button>
				<button data-event-click="go_multi"><gametext key="GUI:Multiplayer"/></button>
				<button data-event-click="go_loadreplay"><gametext key="GUI:ReplayMenu"/></button>
				<button data-event-click="go_options"><gametext key="GUI:Options"/></button>
				<button data-event-click="go_credits"><gametext key="GUI:Credits"/></button>
				<button data-event-click="go_exit"><gametext key="GUI:Exit"/></button>
			</div>
		</div>

		<!-- Single player: skirmish, campaign faction pick, Generals Challenge -->
		<div class="panel" data-class-active="panel == 'single'">
			<div class="menu-list">
				<button data-event-click="go_skirmish"><gametext key="GUI:Skirmish"/></button>
				<button data-event-click="select_usa"><gametext key="GUI:USA"/></button>
				<button data-event-click="select_gla"><gametext key="GUI:GLA"/></button>
				<button data-event-click="select_china"><gametext key="GUI:CHINA_Caps"/></button>
				<button data-event-click="select_challenge"><gametext key="GUI:Generals_Challenge"/></button>
				<button class="back" data-event-click="back_main"><gametext key="GUI:Back"/></button>
			</div>
		</div>

		<!-- Multiplayer -->
		<div class="panel" data-class-active="panel == 'multi'">
			<div class="menu-list">
				<button data-event-click="go_online"><gametext key="GUI:GeneralsOnline"/></button>
				<button data-event-click="go_network"><gametext key="GUI:Network"/></button>
				<button class="back" data-event-click="back_main"><gametext key="GUI:Back"/></button>
			</div>
		</div>

		<!-- Load/Replay -->
		<div class="panel" data-class-active="panel == 'loadreplay'">
			<div class="menu-list">
				<button data-event-click="go_load_game"><gametext key="GUI:MainMenuLoadGame"/></button>
				<button data-event-click="go_replay"><gametext key="GUI:MainMenuLoadReplay"/></button>
				<button class="back" data-event-click="back_main"><gametext key="GUI:Back"/></button>
			</div>
		</div>

		<!-- Campaign difficulty select (reached from single player's faction/challenge buttons) -->
		<div class="panel" data-class-active="panel == 'difficulty'">
			<div class="faction-art">
				<mappedimage name="SAFactionLogo144_US" data-class-hidden="selected_faction != 'USA'"/>
				<mappedimage name="SUFactionLogo144_GLA" data-class-hidden="selected_faction != 'GLA'"/>
				<mappedimage name="SNFactionLogo144_China" data-class-hidden="selected_faction != 'China'"/>
			</div>
			<div class="menu-list">
				<div class="section-title"><gametext key="GUI:SelectDifficulty"/></div>
				<button data-event-click="select_easy"><gametext key="GUI:EasyCaps"/></button>
				<button data-event-click="select_medium"><gametext key="GUI:MediumDifficultyCaps"/></button>
				<button data-event-click="select_hard"><gametext key="GUI:HardCaps"/></button>
				<button class="back" data-event-click="diff_back"><gametext key="GUI:Back"/></button>
			</div>
		</div>
	</div>
</body>
</rml>
