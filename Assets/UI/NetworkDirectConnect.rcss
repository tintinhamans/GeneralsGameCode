/*
	NetworkDirectConnect.rcss -- layout specific to NetworkDirectConnect.rml. Palette/frame/button/
	scroll-container/list rules come from common.rcss; the remote-IP history rows are .list-rows
	(same look as LanLobby.rml's game-list rows). Shell layout: fields + IP history on the left,
	Host/Join stacked on the right, like NetworkDirectConnect.wnd's dialog.
*/

.dc-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.dc-left
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
	margin-right: 16dp;
}

.dc-right
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 240dp;
}

.dc-right button
{
	margin-bottom: 12dp;
}

.dc-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 32dp;
	margin-bottom: 8dp;
}

.dc-label
{
	flex: 0 0 auto;
	width: 200dp;
	color: #FFFFFF;
}

.dc-local-ip
{
	flex: 1 1 auto;
	color: #FFFFFF;
}

.dc-input
{
	flex: 1 1 auto;
}

.dc-remote-row
{
	margin-bottom: 12dp;
}

.dc-history-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.dc-history-list
{
	flex: 1 1 auto;
}
