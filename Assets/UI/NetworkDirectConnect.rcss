/*
	NetworkDirectConnect.rcss -- layout specific to NetworkDirectConnect.rml. Palette/frame/button/
	scroll-container rules come from common.rcss; the remote-IP history rows reuse GameSetup.rcss's
	.map-row/.selected (same look as LanLobby.rml's game-list rows). Shell layout: fields + IP
	history on the left, Host/Join stacked on the right, like NetworkDirectConnect.wnd's dialog.
*/

/* .dc-panel is the .shell-frame (full blueprint panel, see common.rcss) -- fills the screen like
   the original NetworkDirectConnect.wnd instead of a fixed centered dialog. body needs an
   explicit 100% size for .shell-frame's percent left/top/width/height to resolve against. */
body
{
	width: 100%;
	height: 100%;
}

.dc-panel
{
	display: flex;
	flex-direction: column;
}

.dc-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.dc-left
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
	margin-right: 16dp;
}

.dc-right
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 240dp;
}

.dc-right button
{
	margin-bottom: 8dp;
}

.dc-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 8dp;
}

.dc-label
{
	flex: 0 0 auto;
	width: 160dp;
	color: #FFFFFF;
}

.dc-local-ip
{
	flex: 1 1 auto;
	color: #FFFFFF;
}

.dc-input
{
	flex: 1 1 auto;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 4dp 6dp;
}

.dc-remote-row
{
	margin-bottom: 4dp;
}

.dc-history-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.dc-history-list
{
	flex: 1 1 auto;
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 140);
}
