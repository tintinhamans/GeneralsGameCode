/*
	JoinGame.rcss -- PopupJoinGame.wnd (Join Game password popup, GSOVERLAY_GAMEPASSWORD). Floating
	popup over the online lobby, same body-centered pattern as PlayerInfo.rcss/QuitMenu.rcss.
*/

body
{
	display: flex;
	flex-direction: column;
	width: 480dp;
	left: 50%;
	top: 50%;
	margin-left: -240dp;
	margin-top: -60dp;
}

.joingame-frame
{
	position: relative;
	padding-top: 44dp;
	display: flex;
	flex-direction: column;
}

.joingame-close
{
	position: absolute;
	top: 4dp;
	right: 4dp;
	width: 28dp;
	height: 28dp;
	min-width: 0;
	line-height: 26dp;
	padding: 0;
	text-align: center;
	color: #FFBB00;
	border-color: #FFBB00;
}

.joingame-close:hover
{
	color: #8080FF;
	border-color: #8080FF;
}
