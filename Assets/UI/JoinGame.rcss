/*
	JoinGame.rcss -- PopupJoinGame.wnd (the password prompt, GSOVERLAY_GAMEPASSWORD): the modal card
	of common.rcss, the game's name as its title.
*/

.join-card
{
	width: 560dp;
}

.join-lock
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 20dp;
	color: #A9B1CF;
}

.join-lock mappedimage
{
	display: block;
	width: 22dp;
	height: 22dp;
	margin-right: 12dp;
}

.join-lock mappedimage img
{
	display: block;
}
