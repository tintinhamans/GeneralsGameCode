/*
	SkirmishMapSelect.rcss -- map browser on the screen template (common.rcss): a filter bar and a
	scrolling grid of map thumbnails in the main column, the selected map's card on the side.

	Official/unofficial sits in the header; the player-count filter is client side
	(player_filter, a data-if per tile) and visible_count drives the empty state. maps is a
	grow-only list, so every tile also checks entry.used.
*/

.browser
{
	display: flex;
	flex: 0 1 auto;
	max-height: 100%;
	flex-direction: column;
	padding-right: 10dp;
}

.filter-bar
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-bottom: 20dp;
	padding-right: 10dp;
}

.filter-label
{
	margin-right: 18dp;
}

.count
{
	font-size: 28dp;
	font-weight: bold;
	color: #A9B1CF;
}

.grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

/* ---- Tile: thumbnail over the name ------------------------------------------------------------ */
.tile
{
	display: block;
	box-sizing: border-box;
	width: 225dp;
	margin: 0 15dp 18dp 0;
	padding: 4dp;
	border: 1dp transparent;
	background-color: #05070FB4;
	transition: background-color border-color 0.12s cubic-out;
}

.tile:hover
{
	background-color: #2F37A860;
	border-color: #8080FF8C;
}

.tile.selected, .tile.selected:hover
{
	background-color: #2F37A8B4;
	border-color: #F07A1A;
}

.thumb
{
	display: block;
	position: relative;
	width: 213dp;
	height: 213dp;
	background-color: #05070F;
}

.thumb-image
{
	display: block;
	width: 213dp;
	height: 213dp;
	opacity: 0.85;
	transition: opacity 0.12s cubic-out;
}

.tile:hover .thumb-image, .tile.selected .thumb-image
{
	opacity: 1;
}

.thumb-star
{
	position: absolute;
	top: 8dp;
	left: 8dp;
	width: 25dp;
	height: 25dp;
}

.thumb-players
{
	display: block;
	position: absolute;
	top: 8dp;
	right: 8dp;
	min-width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0 4dp;
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	background-color: #05070FC8;
}

.tile-name
{
	display: block;
	height: 40dp;
	line-height: 40dp;
	padding: 0 4dp;
	font-size: 19dp;
	color: #D7DCF0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.tile.selected .tile-name
{
	color: #FFFFFF;
	font-weight: bold;
}

.grid .empty-state
{
	width: 100%;
}

/* ---- Selected map card ------------------------------------------------------------------------ */
.col-side
{
	width: 440dp;
}

@media (max-aspect-ratio: 3/2)
{
	.col-side { width: 415dp; }
	.map-frame { width: 375dp; height: 375dp; }
	.tile { width: 195dp; }
	.thumb, .thumb-image { width: 183dp; height: 183dp; }
}
