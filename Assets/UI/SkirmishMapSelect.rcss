/*
	SkirmishMapSelect.rcss -- map browser on the screen template (common.rcss): a thumbnail grid
	across the frame, the player-count filter and official/unofficial toggle in the header, and the
	selected map's details sliding in from the right.

	The player-count filter is client side (player_filter, a data-if per tile) and visible_count
	drives the empty state. maps is a grow-only list, so every tile also checks entry.used.
*/

/* ---- Header filters ---------------------------------------------------------------------------- */
.ms-filters
{
	padding-left: 20dp;
}

.ms-filter-plate
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-right: 20dp;
	padding: 6dp 8dp 6dp 18dp;
	background-color: #070A1AD9;
}

.filter-label
{
	margin-right: 14dp;
}

.count
{
	min-width: 60dp;
	margin-left: 14dp;
	text-align: right;
	font-size: 26dp;
	font-weight: bold;
	color: #A9B1CF;
}

/* ---- Grid ---------------------------------------------------------------------------------------- */
.browser
{
	display: flex;
	flex-direction: column;
	padding: 20dp 6dp 0 20dp;
}

.grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	flex: 1 1 0%;
	min-height: 0;
	overflow-y: auto;
}

.map-tile
{
	display: block;
	box-sizing: border-box;
	width: 214dp;
	margin: 0 14dp 18dp 0;
	padding: 4dp;
	border: 1dp transparent;
	background-color: #05070FB4;
	transition: background-color border-color 0.12s cubic-out;
}

.map-tile:hover
{
	background-color: #2F37A860;
	border-color: #8080FF8C;
}

.map-tile.selected, .map-tile.selected:hover
{
	background-color: #2F37A8B4;
	border-color: #F07A1A;
}

.thumb
{
	display: block;
	position: relative;
	width: 202dp;
	height: 202dp;
	background-color: #05070F;
}

.thumb-image
{
	display: block;
	width: 202dp;
	height: 202dp;
	opacity: 0.85;
	transition: opacity 0.12s cubic-out;
}

.map-tile:hover .thumb-image, .map-tile.selected .thumb-image
{
	opacity: 1;
}

.thumb-star
{
	position: absolute;
	top: 8dp;
	left: 8dp;
	width: 25dp;
	height: 25dp;
}

.thumb-players
{
	display: block;
	position: absolute;
	top: 8dp;
	right: 8dp;
	min-width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0 4dp;
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	background-color: #05070FC8;
}

.map-tile-name
{
	display: block;
	height: 40dp;
	line-height: 40dp;
	padding: 0 4dp;
	font-size: 19dp;
	color: #D7DCF0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.map-tile.selected .map-tile-name
{
	color: #FFFFFF;
	font-weight: bold;
}

.grid .empty-state
{
	width: 100%;
}

/* ---- Selected map details, sliding in from the right --------------------------------------------- */
.detail-col
{
	width: 460dp;
	animation: 0.22s cubic-out detail-in;
}

@keyframes detail-in
{
	from { opacity: 0; margin-right: -60dp; }
	to { opacity: 1; margin-right: 0dp; }
}

.detail
{
	border-top: 2dp #F07A1A;
}

.detail .map-frame
{
	width: 420dp;
	height: 420dp;
}

@media (max-aspect-ratio: 3/2)
{
	.filter-label, .count { display: none; }
	.ms-filter-plate { padding-left: 8dp; margin-right: 12dp; }
	.screen .ms-filters .seg button.seg-item { padding: 0 10dp; font-size: 16dp; }
	.detail-col { width: 360dp; }
	.detail .map-frame { width: 320dp; height: 320dp; }
	.map-tile { width: 162dp; margin-right: 12dp; }
	.thumb, .thumb-image { width: 150dp; height: 150dp; }
	.map-tile-name { height: 34dp; line-height: 34dp; font-size: 17dp; }
}
