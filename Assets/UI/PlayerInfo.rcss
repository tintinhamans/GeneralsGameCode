/*
	PlayerInfo.rcss -- PopupPlayerInfo.wnd (the player info right-click popup, GSOVERLAY_PLAYERINFO).
	Unlike the shell screens this is a floating popup over whatever's showing underneath (the
	Generals Online welcome screen or WOLQuickMatchMenu.wnd), same as QuitMenu.rcss -- body itself is
	centered and made display:flex (not just its .frame child) so the percentage-sized honors-grid
	below can resolve against it (see common.rcss's gotcha note on body-centered popups).
*/

body
{
	display: flex;
	flex-direction: column;
	width: 680dp;
	left: 50%;
	top: 50%;
	margin-left: -340dp;
	margin-top: -280dp;
}

.playerinfo-frame
{
	display: flex;
	flex-direction: column;
}

.playerinfo-loading
{
	padding: 24dp 0;
	text-align: center;
	color: #C0C0C0;
}

.playerinfo-body
{
	display: flex;
	flex-direction: column;
}

.playerinfo-row
{
	display: flex;
	flex-direction: row;
	margin-bottom: 8dp;
}

/* ---- Stats column -- reuses common.rcss's .row/.label/.control, 24dp instead of the 32dp control
   rows since there are 13 of them in the popup (the rank cluster is shared, see common.rcss). -- */
.stats-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0;
}

.stats-column .row
{
	min-height: 24dp;
	margin-bottom: 0;
}

.stats-column .row > .label
{
	flex: 1 1 auto;
}

.stats-column .row > .control
{
	width: auto;
	flex: 0 0 auto;
	margin-left: auto;
	color: #FFFFFF;
	font-weight: bold;
}

/* ---- Battle honors grid ---------------------------------------------------------------------- */
.honors-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	background-color: rgba(0, 64, 64, 140);
	border: 1dp #2F37A8;
	padding: 6dp;
}

.honor-cell
{
	position: relative;
	width: 56dp;
	height: 57dp;
	margin: 2dp;
}

.honor-cell.disabled
{
	opacity: 0.35;
}

.honor-icon
{
	display: block;
	width: 100%;
	height: 100%;
}

.honor-count
{
	position: absolute;
	left: 2dp;
	bottom: 2dp;
	color: #FFFFFF;
	font-weight: bold;
	font-size: 13dp;
}

.playerinfo-footer
{
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 12dp;
}

.playerinfo-footer button
{
	margin-left: 12dp;
}
