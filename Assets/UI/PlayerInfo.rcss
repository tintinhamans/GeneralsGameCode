/*
	PlayerInfo.rcss -- PopupPlayerInfo.wnd (the persona popup, GSOVERLAY_PLAYERINFO): the modal card of
	common.rcss as a persona card. A rank header like the online dashboard's player card, the career
	record as stat blocks four across, the battle honors on a dark plate (earned ones lit).
*/

.pi-card
{
	width: 900dp;
}

.pi-body
{
	padding-top: 20dp;
}

/* ---- Battle honors ------------------------------------------------------------------------------ */
.pi-honors-title
{
	margin-top: 22dp;
}

.pi-honors
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	margin-top: 10dp;
	padding: 8dp;
	background-color: #05070FC8;
	border: 1dp #8080FF1E;
}

.pi-honor
{
	position: relative;
	width: 58dp;
	height: 58dp;
	margin: 3dp;
}

.pi-honor.disabled
{
	opacity: 0.25;
}

.pi-honor-icon
{
	display: block;
	width: 100%;
	height: 100%;
}

.pi-honor-count
{
	position: absolute;
	left: 0;
	bottom: 0;
	padding: 0 4dp;
	font-size: 14dp;
	line-height: 17dp;
	font-weight: bold;
	color: #FFFFFF;
	background-color: #05070FC8;
}

@media (max-aspect-ratio: 3/2)
{
	.pi-card { width: 820dp; }
}
