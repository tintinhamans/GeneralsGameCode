/*
	PlayerInfo.rcss -- PopupPlayerInfo.wnd (the player info right-click popup, GSOVERLAY_PLAYERINFO).
	Unlike the shell screens this is a floating popup over whatever's showing underneath (the
	Generals Online welcome screen or WOLQuickMatchMenu.wnd), same as QuitMenu.rcss -- body itself is
	centered and made display:flex (not just its .frame child) so the percentage-sized honors-grid
	below can resolve against it (see common.rcss's gotcha note on body-centered popups).
*/

body
{
	display: flex;
	flex-direction: column;
	width: 640dp;
	left: 50%;
	top: 50%;
	margin-left: -320dp;
	margin-top: -220dp;
}

.playerinfo-frame
{
	display: flex;
	flex-direction: column;
}

.playerinfo-loading
{
	padding: 24dp 0;
	text-align: center;
	color: #C0C0C0;
}

.playerinfo-body
{
	display: flex;
	flex-direction: column;
}

.playerinfo-row
{
	display: flex;
	flex-direction: row;
	margin-bottom: 8dp;
}

/* ---- Rank cluster -- same look as OnlineWelcome.rcss's rank-column/rank-border/etc, kept as its
   own copy here since this popup has its own data model and isn't sharing OnlineWelcome.rml. ---- */
.rank-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 128dp;
	margin-right: 12dp;
}

.rank-border
{
	position: relative;
	box-sizing: border-box;
	width: 128dp;
	height: 156dp;
	background-color: #020280;
	border: 1dp #2F37A8;
}

.rank-image-wrap
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 100%;
	height: 128dp;
	border-bottom: 1dp #2E37A8;
}

.rank-image
{
	display: block;
	width: 100%;
	height: 128dp;
}

.faction-image
{
	display: block;
	position: absolute;
	right: 0dp;
	bottom: 0dp;
	width: 48dp;
	height: 48dp;
}

.rank-progress
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	left: 0;
	bottom: 0;
	width: 100%;
	height: 24dp;
	background-color: rgba(2, 2, 2, 164);
	border: 1dp #FFBB00;
}

.rank-progress-fill
{
	height: 100%;
	background-color: rgba(59, 255, 0, 200);
}

.rank-label
{
	margin-top: 4dp;
	text-align: center;
	flex: 0 0 auto;
}

/* ---- Stats column -- reuses common.rcss's .row/.label/.control, tighter than the options-style
   28dp rows since there are 13 of them in the popup. ---------------------------------------- */
.stats-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0;
}

.stats-column .row
{
	min-height: 20dp;
	padding: 1dp 0;
}

.stats-column .row > .control
{
	width: auto;
	flex: 0 0 auto;
	margin-left: auto;
	color: #FFFFFF;
	font-weight: bold;
}

/* ---- Battle honors grid ---------------------------------------------------------------------- */
.honors-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	background-color: rgba(0, 64, 64, 140);
	border: 1dp #2F37A8;
	padding: 6dp;
}

.honor-cell
{
	position: relative;
	width: 56dp;
	height: 57dp;
	margin: 2dp;
}

.honor-cell.disabled
{
	opacity: 0.35;
}

.honor-icon
{
	display: block;
	width: 100%;
	height: 100%;
}

.honor-count
{
	position: absolute;
	left: 2dp;
	bottom: 2dp;
	color: #FFFFFF;
	font-weight: bold;
	font-size: 12dp;
}

.playerinfo-footer
{
	flex: 0 0 auto;
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 10dp;
}

.playerinfo-footer button
{
	margin-left: 8dp;
}
