<rml>
<head>
	<title>LanLobby</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="GameSetup.rcss"/>
	<link type="text/rcss" href="LanLobby.rcss"/>
</head>
<body class="shell" data-model="lanlobby">
	<mappedimage class="shell-background" name="MainMenuRuler"/>

	<div class="shell-frame">
		<div class="shell-title-bar"><gametext key="GUI:LANLobby"/></div>

		<div class="lobby-row">
			<div class="players-column">
				<div class="section-title"><gametext key="GUI:Players"/></div>
				<div class="scroll-container list-box">
					<div data-for="player : players">
						<div class="list-row compact" data-if="player.used" data-attr-data-tooltip-text="player.tooltip">{{player.name}}</div>
					</div>
				</div>
			</div>

			<div class="games-column">
				<div class="section-title"><gametext key="GUI:Games"/></div>
				<div class="scroll-container list-box">
					<div data-for="game : games">
						<div class="list-row flex map-row" data-if="game.used" data-class-selected="game.is_selected"
							data-event-click="game_row_clicked(game.index)" data-event-dblclick="game_row_activated(game.index)">
							<div class="map-name" data-class-in-progress="game.in_progress">{{game.display_name}}</div>
						</div>
					</div>
				</div>
			</div>

			<div class="details-column">
				<div class="section-title"><gametext key="GUI:GameInfo"/></div>
				<div class="game-details" data-if="details_valid">
					<div class="details-map">{{details_map_display_name}}</div>
					<div class="scroll-container details-slot-list">
						<div data-for="slot : detail_slots">
							<div class="details-slot" data-if="slot.occupied" data-class-observer="slot.is_observer">
								<mappedimage class="details-slot-icon" data-attr-name="slot.side_icon_image" data-if="slot.show_side_icon"/>
								<div class="details-slot-icon" data-if="!slot.show_side_icon"></div>
								<div class="details-slot-label">{{slot.label}}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="chat">
			<div class="chat-log">
				<div class="chat-line" data-for="line : chat_lines">{{line}}</div>
			</div>
			<div class="chat-entry">
				<input type="text" class="chat-input" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
				<button class="icon-btn" data-event-click="send_chat"><mappedimage name="ReturnButton"/></button>
			</div>
		</div>

		<div class="footer name-row">
			<div class="label"><gametext key="GUI:PlayerName"/></div>
			<input type="text" class="text-input name-input" data-value="player_name" data-event-change="name_changed"/>
			<button data-event-click="clear_name" data-tooltip="TOOLTIP:ButtonClear"><gametext key="GUI:CLEAR"/></button>
			<div class="spacer"></div>
			<button data-event-click="host_game"><gametext key="GUI:Host"/></button>
			<button data-event-click="join_selected"><gametext key="GUI:Join"/></button>
			<button data-event-click="direct_connect"><gametext key="GUI:DirectConnect"/></button>
			<button data-event-click="back"><gametext key="GUI:GotoMainMenu"/></button>
		</div>
	</div>
</body>
</rml>
