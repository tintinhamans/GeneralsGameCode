<rml>
<head>
	<title>MessageBox</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		body { width: 640dp; min-height: 180dp; left: 50%; top: 50%; margin-left: -320dp; margin-top: -120dp; }
		.frame { display: flex; flex-direction: column; }
		/* display:flex is required here, not just cosmetic -- a plain display:block .logo doesn't
		   resolve width/height percentages against its own box at all in this RmlUi build (see
		   EndGameOverlay.rml's .frame for the same fix and a fuller explanation), so its mappedimage
		   ends up drawn at some unrelated collapsed size instead of filling the logo area. */
		.logo { display: flex; width: 300dp; height: 90dp; margin: 0 auto 8dp auto; }
		.logo mappedimage { display: block; width: 100%; height: 100%; }
		.body { flex: 1 1 auto; margin: 4dp 0 8dp 0; line-height: 22dp; }
	</style>
</head>
<body data-model="messagebox">
	<div class="frame">
		<div class="logo" data-if="use_logo"><mappedimage name="GeneralsLogo"/></div>
		<div class="title-bar">{{title}}</div>
		<div class="body">{{body}}</div>
		<div class="footer">
			<button class="btn-primary" data-if="show_yes" data-event-click="yes"><gametext data-if="yes_label == ''" key="GUI:Yes"/><span data-if="yes_label != ''">{{yes_label}}</span></button>
			<button class="btn-primary" data-if="show_ok" data-event-click="ok"><gametext data-if="ok_label == ''" key="GUI:Ok"/><span data-if="ok_label != ''">{{ok_label}}</span></button>
			<button class="btn-primary" data-if="show_no" data-event-click="no"><gametext data-if="no_label == ''" key="GUI:No"/><span data-if="no_label != ''">{{no_label}}</span></button>
			<button class="btn-primary" data-if="show_cancel" data-event-click="cancel_click"><gametext data-if="cancel_label == ''" key="GUI:Cancel"/><span data-if="cancel_label != ''">{{cancel_label}}</span></button>
		</div>
	</div>
</body>
</rml>
