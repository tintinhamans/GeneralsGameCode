/*
	OnlineWelcome.rcss -- WOLWelcomeMenu.wnd (the Generals Online hub screen).
	.shell-background/.shell-frame/.shell-title-bar come from common.rcss (see WOLWelcomeMenu.wnd's
	MainMenuRuler backdrop + GadgetParent). The MOTD row and the rank/community row share the
	height between the title and the footer equally, like the .wnd's two bands.
*/

.welcome-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
	margin-bottom: 16dp;
}

.motd-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	margin-right: 16dp;
	min-height: 0;
}

.motd-players
{
	color: #FFCC00;
	font-size: 18dp;
	font-weight: bold;
	padding-bottom: 8dp;
}

.motd-list
{
	background-color: rgba(0, 0, 0, 160);
}

.motd-line
{
	width: 100%;
	white-space: pre-line;
	/* color comes from data-style-color (line.color_hex), matching the .wnd's per-line
	   GameSpyColor[GSCOLOR_MOTD_HEADING]/GameSpyColor[GSCOLOR_MOTD]/hex-prefix override */
}

.motd-line.heading
{
	font-weight: bold;
}

.buttons-column
{
	display: flex;
	flex-direction: column;
	flex: 0 0 320dp;
}

.buttons-column button
{
	margin-bottom: 12dp;
}

/* Rank + Daily Army Win Percentages band -- mirrors WOLWelcomeMenu.wnd's PlayerInfoParent
   (RankBorder/WinRank/FactionImage/ProgressBarRank/StaticTextRank + CommunityInfoParent/
   StaticTextCommunity). See D:\INIZH\Window\Menus\WOLWelcomeMenu.wnd. */
.playerinfo-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
}

/* Its rank cluster (.rank-column and friends) is shared, see common.rcss; this screen gives it the
   16dp column gap instead of the default 12dp. */
.rank-column
{
	margin-right: 16dp;
}

.community-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

/* 4 columns x 3 rows filling the panel -- each cell is a faction icon at its natural (square) aspect,
   roughly the size WOLWelcomeMenu.wnd draws its PercentXxx checkboxes (~72px tall at 1080p; the
   48px source art was blown up ~8x when it filled the whole cell), with the win-percent text
   beside it. */
.stats-grid
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	flex: 1 1 0%; /* basis 0, not auto -- with an intrinsic (content-driven) basis the wrapped grid's
		own min-content height wins over its flex-grow share and it overflows onto whatever sits
		below the panel (audit: OVERFLOW div.stats-grid -- win-grid spilling onto the MAIN MENU
		button); starting from a 0 basis and growing avoids that shrink-from-content path */
	min-height: 0;
	background-color: rgba(2, 2, 2, 128); /* CommunityInfoParent's near-black fill */
	border: 1dp #2F37A8;
	padding: 12dp;
}

.stat-cell
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 25%;
	height: 33.333%;
	box-sizing: border-box;
	padding: 2dp;
}

.stat-icon
{
	display: block;
	flex: 0 0 auto;
	width: 72dp;
	height: 72dp;
}

.stat-value
{
	flex: 0 1 auto;
	margin-left: 8dp;
	color: #FFFFFF;
	font-weight: bold;
}
