/*
	OnlineWelcome.rcss -- WOLWelcomeMenu.wnd (the Generals Online hub screen).
	Layout only; palette/buttons/scroll-container come from common.rcss.
*/

.welcome-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.motd-column
{
	display: flex;
	flex-direction: column;
	flex: 2 1 auto;
	margin-right: 12dp;
	min-height: 0;
}

.stats-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.section-title
{
	font-weight: bold;
	padding-bottom: 4dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 4dp;
}

.motd-line
{
	padding: 2dp 0;
	/* color comes from data-style-color (line.color_hex), matching the .wnd's per-line
	   GameSpyColor[GSCOLOR_MOTD_HEADING]/GameSpyColor[GSCOLOR_MOTD]/hex-prefix override */
}

.motd-line.heading
{
	font-weight: bold;
}

.stat-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 2dp 0;
}

.stat-icon
{
	width: 24dp;
	height: 24dp;
	margin-right: 6dp;
	flex: 0 0 auto;
}

.stat-value
{
	flex: 1 1 auto;
	color: #C0C0C0;
}

.welcome-footer
{
	flex-wrap: wrap;
}

/* Community rank panel -- mirrors WOLWelcomeMenu.wnd's RankBorder/WinRank/FactionImage/
   ProgressBarRank/StaticTextRank cluster (see D:\INIZH\Window\Menus\WOLWelcomeMenu.wnd). */
.rank-column
{
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 0 0 auto;
	margin-left: 12dp;
	width: 128dp;
}

.rank-border
{
	position: relative;
	width: 128dp;
	height: 156dp;
	background-color: #020280;
	border: 1dp #2F37A8;
}

.rank-image-wrap
{
	position: relative;
	width: 128dp;
	height: 128dp;
}

.rank-image
{
	width: 100%;
	height: 100%;
}

.faction-image
{
	position: absolute;
	right: 0;
	bottom: 0;
	width: 48dp;
	height: 48dp;
}

.rank-line
{
	width: 100%;
	height: 1dp;
	background-color: #2E37A8;
}

.rank-progress
{
	width: 100%;
	height: 24dp;
	background-color: rgba(2, 2, 2, 164);
	border: 1dp #FFBB00;
}

.rank-progress-fill
{
	height: 100%;
	background-color: rgba(59, 255, 0, 200);
}

.rank-label
{
	margin-top: 4dp;
	text-align: center;
}
