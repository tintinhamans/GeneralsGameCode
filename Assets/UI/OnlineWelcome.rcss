/*
	OnlineWelcome.rcss -- WOLWelcomeMenu.wnd (the Generals Online hub screen).
	Layout only; palette/buttons/scroll-container come from common.rcss.
*/

.welcome-row
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.motd-column
{
	display: flex;
	flex-direction: column;
	flex: 2 1 auto;
	margin-right: 12dp;
	min-height: 0;
}

.stats-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.section-title
{
	font-weight: bold;
	padding-bottom: 4dp;
	border-bottom: 1dp #2F37A8;
	margin-bottom: 4dp;
}

.motd-line
{
	padding: 2dp 0;
	/* color comes from data-style-color (line.color_hex), matching the .wnd's per-line
	   GameSpyColor[GSCOLOR_MOTD_HEADING]/GameSpyColor[GSCOLOR_MOTD]/hex-prefix override */
}

.motd-line.heading
{
	font-weight: bold;
}

.stat-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 2dp 0;
}

.stat-icon
{
	width: 24dp;
	height: 24dp;
	margin-right: 6dp;
	flex: 0 0 auto;
}

.stat-value
{
	flex: 1 1 auto;
	color: #C0C0C0;
}

.welcome-footer
{
	flex-wrap: wrap;
}
