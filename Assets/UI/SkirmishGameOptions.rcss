/*
	SkirmishGameOptions.rcss -- skirmish setup on the screen template (common.rcss): the players
	table and the option/honors panels in the main column, the map card in the side column.

	Every select keeps an option matching its bound value (the hidden SLOT_PLAYER occupant on
	human rows, Random in the army list): RmlUi fires a phantom "change" for an unmatched value.
	x_style/y_style of a start marker are pre-formatted CSS lengths ("12.500%"); start_markers is
	always MAX_SLOTS entries, unused ones hidden with data-if="marker.used".
*/

/* ---- Players table --------------------------------------------------------------------------- */
.slots
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
	padding-top: 8dp;
	padding-bottom: 8dp;
}

.slot
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	flex: 1 1 44dp;
	min-height: 44dp;
	max-height: 58dp;
	border-bottom: 1dp #FFFFFF0A;
}

.slot:last-child
{
	border-bottom-width: 0;
}

.slot.list-head
{
	flex: 0 0 30dp;
	min-height: 30dp;
	height: 30dp;
	padding: 0;
	border-bottom: 1dp #8080FF28;
}

/* Player colour bar at the head of the row. */
.slot-chip
{
	flex: 0 0 4dp;
	height: 28dp;
	margin-right: 12dp;
}

.slot.list-head .slot-chip
{
	height: 1dp;
}

.c-occupant, .c-army, .c-color, .c-team
{
	box-sizing: border-box;
	min-width: 0;
	margin-right: 16dp;
}

.c-occupant { flex: 1 1 0%; max-width: 300dp; }
.c-army { flex: 1.2 1 0%; max-width: 360dp; }
.c-color { flex: 0 0 234dp; }
.c-team { flex: 0 0 196dp; margin-right: 0; }

.c-occupant select, .c-army select
{
	width: 100%;
}

.slot-name
{
	display: block;
	height: 36dp;
	line-height: 36dp;
	padding: 0 10dp;
	font-size: 17dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Open and closed slots: only the occupant is set, the rest of the row is hidden. */
.slot.empty .c-army select, .slot.empty .c-color .swatches, .slot.empty .c-team .seg
{
	visibility: hidden;
}

.slot.empty .slot-chip
{
	background-color: transparent;
}

/* Army: the general's badge in front of the name, in the list and in the closed select. */
.army-icon
{
	display: inline-block;
	width: 24dp;
	height: 24dp;
	margin-right: 10dp;
	vertical-align: middle;
}

.army-random
{
	box-sizing: border-box;
	line-height: 22dp;
	text-align: center;
	font-size: 13dp;
	font-weight: bold;
	color: #A9B1CF;
	border: 1dp #8080FF46;
	background-color: #141A3E;
}

.army-select selectbox
{
	width: 280dp;
}

.screen .team-seg button.seg-item
{
	min-width: 32dp;
	padding: 0 9dp;
}

/* ---- Game options and honors ------------------------------------------------------------------ */
.lower
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	margin-top: 16dp;
}

.lower .surface + .surface
{
	margin-top: 0;
	margin-left: 16dp;
}

.options
{
	flex: 1.3 1 0%;
	max-width: 760dp;
	min-width: 0;
}

.opt-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	min-height: 36dp;
	margin-bottom: 8dp;
}

.opt-row:last-child
{
	margin-bottom: 0;
}

.opt-label
{
	flex: 0 0 150dp;
	color: #A9B1CF;
}

.speed
{
	flex: 1 1 auto;
	max-width: 320dp;
}

.honors
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
}

.stats
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	flex: 1 1 auto;
}

.stats .stat
{
	flex: 0 0 50%;
	margin-bottom: 12dp;
}

.honors-reset
{
	align-self: flex-start;
}

/* ---- Map card ---------------------------------------------------------------------------------- */
.col-side
{
	width: 404dp;
}

.map-card
{
	display: flex;
	flex-direction: column;
}

.map-button
{
	display: block;
}

/* ---- 5:4 and 4:3: tighter columns so the table still fits beside the map ------------------------ */
@media (max-aspect-ratio: 3/2)
{
	.col-side { width: 332dp; }
	.map-frame { width: 300dp; height: 300dp; }
	.c-color { flex-basis: 198dp; }
	.screen .swatches button.swatch { width: 18dp; height: 18dp; line-height: 14dp; font-size: 11dp; }
	.c-team { flex-basis: 158dp; }
	.screen .team-seg button.seg-item { min-width: 26dp; padding: 0 6dp; font-size: 13dp; }
	.c-occupant, .c-army, .c-color { margin-right: 10dp; }
	.opt-label { flex-basis: 110dp; }
	.options { flex-grow: 1.7; }
	.screen .options .seg button.seg-item { padding: 0 7dp; font-size: 13dp; }
}
