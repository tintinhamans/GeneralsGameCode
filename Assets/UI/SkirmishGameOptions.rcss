/*
	SkirmishGameOptions.rcss -- skirmish-only piece of the setup screen: the career honors box next
	to the game options. Layout, slot rows and map preview are shared, see GameSetup.rcss.
*/

.honors-panel
{
	display: flex;
	flex-direction: column;
}

.honors-panel .row
{
	flex: 0 0 auto;
}

.honors-panel .row > .control
{
	color: #C0C0C0;
}

.honors-reset
{
	flex: 0 0 auto;
	align-self: flex-start;
}
