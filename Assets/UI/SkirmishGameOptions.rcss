/*
	SkirmishGameOptions.rcss -- skirmish setup on the screen template (common.rcss): a player card
	per slot, two across, in the main column (the .player-card component); the map card and the
	game options in the side column; the battle honors between Back and Play in the action bar.

	Every select keeps an option matching its bound value (the hidden SLOT_PLAYER occupant on
	human slots, Random in the army list): RmlUi fires a phantom "change" for an unmatched value.
	x_style/y_style of a start marker are pre-formatted CSS lengths ("12.500%"); start_markers is
	always MAX_SLOTS entries, unused ones hidden with data-if="marker.used".
*/

/* ---- Player cards ------------------------------------------------------------------------------ */
.sk-cards
{
	flex: 1 1 0%;
	min-height: 0;
}

/* ---- Side column: map and options -------------------------------------------------------------- */
.col-side
{
	width: 440dp;
}

.map-card
{
	display: block;
}

.map-card .map-frame
{
	width: 360dp;
	height: 360dp;
	margin: 0 auto;
}

.map-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-top: 14dp;
}

.map-row .map-name
{
	flex: 1 1 0%;
	min-width: 0;
	margin: 0 12dp 0 0;
}

.map-row button
{
	flex: 0 0 auto;
}

.options .opt-label
{
	display: block;
	margin: 0 0 8dp 0;
	font-size: 17dp;
	color: #A9B1CF;
}

.cash-seg
{
	margin-bottom: 14dp;
}

.screen .cash-seg button.seg-item
{
	flex: 1 1 0%;
	padding: 0 6dp;
	font-size: 17dp;
}

.speed-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-bottom: 12dp;
}

.speed-row .opt-label
{
	flex: 0 0 auto;
	margin: 0 16dp 0 0;
}

.speed
{
	flex: 1 1 0%;
}

/* ---- Honors in the action bar ------------------------------------------------------------------ */
.honors
{
	display: flex;
	flex-direction: row;
	align-items: center;
	margin-left: 30dp;
	padding: 8dp 20dp;
	background-color: #070A1AC8;
}

.honors .stat
{
	flex: 0 0 auto;
	margin-right: 28dp;
}

.honors .stat:last-child
{
	margin-right: 0;
}

.honors .stat-value
{
	font-size: 26dp;
	line-height: 30dp;
}

.honors .stat-label
{
	font-size: 13dp;
}

/* ---- 5:4 and 4:3: a narrower side column and tighter cards ---------------------------------------- */
@media (max-aspect-ratio: 3/2)
{
	.col-side { width: 330dp; }
	.map-card .map-frame { width: 290dp; height: 290dp; }
	.speed-row { flex-wrap: wrap; }
	.speed-row .opt-label { flex-basis: 100%; margin-bottom: 8dp; }
	.map-row { flex-wrap: wrap; }
	.map-row .map-name { flex-basis: 100%; margin-bottom: 8dp; }
	.player-card { padding: 10dp 10dp; }
	.pc-badge { flex-basis: 46dp; width: 46dp; height: 46dp; margin-right: 10dp; }
	.pc-badge mappedimage { width: 38dp; height: 38dp; }
	.pc-name { font-size: 20dp; }
	.screen .team-seg button.seg-item { flex-basis: 28dp; width: 28dp; font-size: 15dp; }
	.screen .team-seg button.seg-item:first-child { flex-basis: 48dp; width: 48dp; }
	.screen .swatches button.swatch { width: 26dp; height: 26dp; margin-right: 1dp; }
	.swatch .chip { line-height: 18dp; font-size: 13dp; }
	.swatch.random .chip { line-height: 16dp; }
	.pc-spot { width: 32dp; height: 32dp; line-height: 28dp; margin-left: 8dp; font-size: 16dp; }
	.pc-compact .pc-who { flex-basis: 110dp; }
	.screen .pc-add button { padding: 0 7dp; margin-left: 4dp; font-size: 14dp; }
	.pc-add-label { display: none; }
	.honors { margin-left: 16dp; padding: 6dp 12dp; }
	.honors .stat { margin-right: 14dp; }
	.honors .stat-label { font-size: 11dp; letter-spacing: 0; }
	.marker-label { font-size: 13dp; margin-left: -56dp; margin-right: -56dp; }
}
