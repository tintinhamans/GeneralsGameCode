/*
	InGamePopupMessage.rcss -- InGamePopupMessage.wnd, the message a map script pops up over the game. The
	script gives the position and width in pixels (the view sets them on the document), the text height decides
	the rest: the text box sits 2 px in from the panel, the OK button 2 px below it and 2 px from the corner,
	60x20 of 800x600 (7.5vw by 3.333vh). The document is only the panel, so the HUD around it keeps the mouse.
*/

body
{
	box-sizing: border-box;
	left: 164px;
	top: 124px;
	width: 172px;
}

.pm-panel
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	padding: 1px;
	background-color: rgba(0, 0, 0, 190);
	border: 1px #2F37A8;
}

/* The message: the .wnd's static text, its color coming from the script, wrapped 5 px in from its box */
.pm-text
{
	flex: 0 0 auto;
	box-sizing: border-box;
	padding: 2px 4px 3px 4px;
	background-color: rgba(0, 0, 0, 69);
	border: 1px #000000;
	font-size: 18dp;
	text-align: left;
	white-space: pre-line;
}

.pm-footer
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 2px;
	margin-bottom: 1px;
}

.pm-ok
{
	flex: 0 0 auto;
	width: 7.5vw;
	height: 3.333vh;
	padding: 0;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 20dp;
}
