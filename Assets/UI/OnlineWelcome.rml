<rml>
<head>
	<title>OnlineWelcome</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="OnlineWelcome.rcss"/>
</head>
<body class="screen hq dock-host" data-model="onlinewelcome">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="hq-band hq-header"><div class="hq-band-in">
			<mappedimage name="GeneralsLogo" class="hq-logo"/>
			<div class="hq-heading"><div class="hq-crumb"><gametext key="GUI:Multiplayer"/><span class="crumb-sep">&#8250;</span></div><div class="hq-title"><gametext key="GUI:GOStatusTitle"/></div></div>
			<div class="hq-aside wc-header-actions">
				<button data-event-click="options" data-tooltip="TOOLTIP:Options"><gametext key="GUI:Options"/></button>
			</div>
			<div class="hq-status">
				<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
				<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span><gametext key="GUI:GOMenuOffline"/></div>
				<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
			</div>
	</div></div>

	<div class="screen-frame">
		<div class="screen-body">
			<div class="col col-main">
				<div class="wc-lower">
					<!-- Message of the day, lines coloured as the .wnd listbox colours them. -->
					<div class="surface wc-news">
						<div class="overline accent-overline"><gametext key="GUI:MOTD"/></div>
						<div class="scroll-container wc-motd">
							<div data-for="line : motd_lines">
								<div class="wc-motd-line" data-if="line.used" data-class-heading="line.is_heading" data-style-color="line.color_hex">{{line.text}}</div>
							</div>
						</div>
					</div>

					<!-- Daily army win rates: each general's silver medallion, its rate and a bar. -->
					<div class="surface wc-armies">
						<div class="overline" data-tooltip="TOOLTIP:Community"><gametext key="GUI:Community"/></div>
						<div class="wc-army-grid">
							<div class="wc-army" data-for="stat : faction_stats" data-if="stat.used" data-attr-data-tooltip-text="stat.tooltip_text">
								<mappedimage class="wc-army-icon" data-attr-name="stat.icon"/>
								<div class="wc-army-text">
									<div class="wc-army-pct">{{stat.percent_text}}</div>
									<div class="wc-army-count">{{stat.count_text}}</div>
									<div class="wc-army-bar"><div class="wc-army-fill" data-style-width="stat.percent_text != '' ? stat.percent_text : '0%'"></div></div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- The player: rank portrait with the general badge, progress to the next rank, career record. -->
			<div class="col col-side">
				<div class="surface wc-player">
					<div class="wc-greeting">{{title}}</div>
					<div class="wc-rank">
						<div class="wc-portrait">
							<mappedimage class="wc-rank-image" data-attr-name="rank_image_name"/>
							<div class="wc-badge" data-if="show_faction_image"><mappedimage data-attr-name="faction_image_name"/></div>
						</div>
						<div class="wc-rank-info">
							<div class="overline"><gametext key="GUI:Rank"/></div>
							<div class="wc-rank-name">{{rank_text}}</div>
							<div class="progress wc-progress" data-if="!rank_at_max" data-tooltip="TOOLTIP:ProgressToNextRank">
								<div class="progress-fill" data-style-width="rank_progress_width_style"></div>
							</div>
						</div>
					</div>

					<div class="wc-stats">
						<div class="wc-stat"><div class="wc-stat-label"><gametext key="GUI:GamesPlayed"/></div><div class="wc-stat-value">{{has_stats ? games_played_text : '-'}}</div></div>
						<div class="wc-stat"><div class="wc-stat-label"><gametext key="GUI:CareerWins"/></div><div class="wc-stat-value">{{has_stats ? wins_text : '-'}}</div></div>
						<div class="wc-stat"><div class="wc-stat-label"><gametext key="GUI:CareerLosses"/></div><div class="wc-stat-value">{{has_stats ? losses_text : '-'}}</div></div>
						<div class="wc-stat"><div class="wc-stat-label"><gametext key="GUI:WinPercentLabel"/></div><div class="wc-stat-value">{{has_stats ? win_percent_text : '-'}}</div></div>
						<div class="wc-stat"><div class="wc-stat-label"><gametext key="GUI:BestWinStreak"/></div><div class="wc-stat-value">{{has_stats ? best_streak_text : '-'}}</div></div>
						<div class="wc-stat" data-if="has_stats"><div class="wc-stat-label">{{streak_label_text}}</div><div class="wc-stat-value">{{streak_value_text}}</div></div>
					</div>

					<button class="wc-persona" data-event-click="my_info" data-tooltip="TOOLTIP:MyInfo"><gametext key="GUI:MyInfo"/></button>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:GotoMainMenu"/></button>
			<div class="spacer"></div>
			<div class="wc-online" data-if="num_players_text != ''"><span class="dot"></span>{{num_players_text}}</div>
			<!-- The two ways into a game: primary actions, Quick Match at the far right; the tooltips carry the descriptions. -->
			<button class="btn-cta wc-cta" data-event-click="custom_match" data-tooltip="TOOLTIP:CustomMatch"><gametext key="GUI:CustomMatch"/></button>
			<button class="btn-cta wc-cta" data-event-click="quick_match" data-tooltip="TOOLTIP:Quickmatch"><gametext key="GUI:QuickMatch"/></button>
		</div>
	</div>
</body>
</rml>
