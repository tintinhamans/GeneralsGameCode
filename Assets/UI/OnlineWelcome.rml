<rml>
<head>
	<title>OnlineWelcome</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="OnlineWelcome.rcss"/>
</head>
<body data-model="onlinewelcome">
	<div class="frame panel">
		<div class="title-bar">{{title}}</div>

		<div class="welcome-row">
			<div class="motd-column">
				<div class="section-title">{{num_players_text}}</div>
				<div class="scroll-container motd-list">
					<div data-for="line : motd_lines">
						<div class="motd-line" data-if="line.used" data-class-heading="line.is_heading" data-style-color="line.color_hex">{{line.text}}</div>
					</div>
				</div>
			</div>

			<div class="stats-column">
				<div class="section-title"><gametext key="GUI:WinPercent"/></div>
				<div class="scroll-container stats-list">
					<div data-for="stat : faction_stats">
						<div class="stat-row" data-if="stat.used" data-attr-data-tooltip-text="stat.tooltip_text">
							<mappedimage class="stat-icon" data-attr-name="stat.icon"/>
							<div class="stat-value">{{stat.text}}</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="footer welcome-footer">
			<button data-event-click="quick_match">
				<gametext key="GUI:QuickMatch"/>
			</button>
			<button data-event-click="custom_match">
				<gametext key="GUI:CustomMatch"/>
			</button>
			<button data-event-click="buddies">{{buddies_button_text}}</button>
			<button data-event-click="my_info">
				<gametext key="GUI:MyInfo"/>
			</button>
			<button data-event-click="options">
				<gametext key="GUI:Options"/>
			</button>
			<button data-event-click="back">
				<gametext key="GUI:GotoMainMenu"/>
			</button>
		</div>
	</div>
</body>
</rml>
