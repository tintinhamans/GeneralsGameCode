/*
	LanGameOptions.rcss -- screen-specific layout for the LAN game setup screen. Slot-row/
	map-preview/start-marker element styles live in GameSetup.rcss (shared with
	SkirmishGameOptions.rml); the chat block below mirrors LanLobby.rcss's .chat/.chat-body/
	.chat-entry-row/.chat-input (kept as a local copy since this screen doesn't otherwise link
	LanLobby.rcss).
*/

.panel
{
	display: flex;
	flex-direction: column;
	width: 100%;
	height: 100%;
}

.lan-setup-panel
{
	width: 960dp;
	height: 700dp;
	margin: 20dp auto;
	display: flex;
	flex-direction: column;
}

.lan-setup-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
}

.slot-list
{
	flex: 1 1 auto;
	margin-right: 12dp;
}

.slot-header
{
	font-weight: bold;
	color: #8080FF;
	border-bottom: 1dp #2F37A8;
}

.side-panel
{
	flex: 0 0 auto;
	width: 280dp;
	display: flex;
	flex-direction: column;
}

.map-not-found
{
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #C0C0C0;
}

.map-display-name
{
	margin-top: 4dp;
	margin-bottom: 8dp;
	color: #C0C0C0;
}

/* ---- Per-slot accept/ready indicator (only slot 0 shows one -- see .wnd's buttonAccept[1..7]
   hiding and RmlLanGameSetupScreen::SlotRowModel::showAccept) ------------------------------- */
.slot-accept
{
	width: 16dp;
	height: 16dp;
	border: 1dp #2F37A8;
	background-color: rgba(255, 255, 255, 40);
}

.slot-accept.accepted
{
	background-color: #40C040;
	border-color: #FFFFFF;
}

/* ---- Chat (copy of LanLobby.rcss's chat block) ---------------------------------------------- */
.chat
{
	display: flex;
	flex-direction: column;
	margin-top: 8dp;
	border-top: 1dp #2F37A8;
	padding-top: 8dp;
	height: 140dp;
}

.chat-body
{
	flex: 1 1 auto;
}

.chat-entry-row
{
	display: flex;
	flex-direction: row;
	margin-top: 4dp;
}

.chat-input
{
	flex: 1 1 auto;
	margin-right: 4dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
	color: #FFFFFF;
	padding: 4dp 6dp;
}

/* ---- Emote icon button (original is icon-only, no text label) -------------------------- */
.btn-emote
{
	width: 24dp;
	height: 24dp;
	text-align: center;
}
