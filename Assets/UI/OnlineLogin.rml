<rml>
<head>
	<title>OnlineLogin</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="OnlineLogin.rcss"/>
</head>
<!--
	The screen under the login flow. It has no controls of its own: under GENERALS_ONLINE the .wnd
	it replaces hides its whole layout, and everything the player answers during login ("Please
	wait...", the "continue in your web browser" Cancel box, "Logged in!", "Login failed.") is the
	RmlUi message-box card (gogoMessageBox()/RmlUiMessageBoxHook) drawn centred on top of this.
	So this only frames the map in the shell template and says what is going on; the centre stays
	free for that card. See RmlOnlineLoginScreen.h.
-->
<body class="screen hq" data-model="onlinelogin">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="hq-band hq-header"><div class="hq-band-in">
			<mappedimage name="GeneralsLogo" class="hq-logo"/>
			<div class="hq-heading"><div class="hq-crumb"><gametext key="GUI:GeneralsOnline"/><span class="crumb-sep">&#8250;</span></div><div class="hq-title"><gametext key="GUI:Login"/></div></div>
			<div class="hq-status">
				<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
				<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span><gametext key="GUI:GOMenuOffline"/></div>
				<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
			</div>
	</div></div>

	<div class="screen-frame">
		<div class="screen-body"></div>

		<div class="action-bar">
			<div class="login-status">
				<span class="dot pulse"></span><gametext key="FTP:StatusLoggingIn"/>
			</div>
		</div>
	</div>
</body>
</rml>
