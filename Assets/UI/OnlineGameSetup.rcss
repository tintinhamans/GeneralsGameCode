/*
	OnlineGameSetup.rcss -- online-only pieces of the Generals Online game setup screen
	(GameSpyGameOptionsMenu.wnd): the occupant cell and its connection indicator.
	The layout, slot rows and map preview are shared, see GameSetup.rcss; chat is in common.rcss.
*/

/* ---- Occupant cell: the state select + connection dot + (client-only) name label share the
   .slot-occupant column ------------------------------------------------------------------- */
.occupant-cell
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.occupant-cell select, .occupant-cell .slot-name
{
	flex: 1 1 0%;
	min-width: 0;
}

/* Live mesh connection indicator, one per occupied human slot (GenericPing0..7 /
   WOLConnectionIndicatorDraw). Default (data-class-connected unset) reads as not-yet-connected. */
.conn-indicator
{
	width: 12dp;
	height: 12dp;
	margin-left: 8dp;
	border-radius: 6dp;
	background-color: #C0C000;
	flex-shrink: 0;
}

.conn-indicator.connected
{
	background-color: #40C040;
}
