/*
	QuickMatch.rcss -- WOLQuickMatchMenu.wnd. Shell screen, same .shell-frame/.shell-title-bar
	backdrop as OnlineGameSetup.rcss/OnlineWelcome.rcss. ParentOptions (setup-panel) and ParentStats
	(stats-panel) are mutually exclusive, toggled by show_stats -- see QuickMatch.rml.
*/

.quickmatch-body
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
	margin-bottom: 8dp;
}

/* ---- Setup panel: playlist combo, map list, disabled cosmetic ladder/ping/disconnects/side/color
   rows (see QuickMatch.rml's comment -- real controls the .wnd force-disables under GO). --------- */
.setup-panel
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.map-list
{
	flex: 1 1 auto;
	min-height: 80dp;
	margin-bottom: 6dp;
}

/* Map rows are common.rcss's .list-row.flex.compact with a stronger selected highlight and no outline. */
.qm-map-row.selected
{
	background-color: rgba(47, 55, 168, 160);
	border: 0dp transparent;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.map-check
{
	box-sizing: border-box;
	width: 14dp;
	height: 14dp;
	margin-right: 8dp;
	background-color: rgba(2, 2, 2, 191);
	border: 1dp #2F37A8;
}

.map-check.checked
{
	background-color: #FFFF00;
	border-color: #FFFF00;
}

.map-name
{
	flex: 1 1 auto;
}

/* row.disabled already dims .label/.control via common.rcss; select[disabled] isn't styled by
   common.rcss's select rule (only button is), so dim it here too. */
.row.disabled select
{
	color: #C0C0C0;
	border-color: #6A6A6A;
}

/* ---- Stats panel: the shared rank cluster (common.rcss) + a tighter stats column, same subset of
   fields WOLQuickMatchMenu.wnd's ParentStats shows. -------------------------------------------- */
.stats-panel
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.stats-column
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-width: 0;
}

.stats-column .row > .control
{
	width: auto;
	flex: 0 0 auto;
	margin-left: auto;
	color: #FFFFFF;
	font-weight: bold;
}

/* ---- Status feed: ListboxQuickMatch, append-only colored lines (see QuickMatchSession::EventSink::
   statusLine) -- a .text-list of .text-line, common.rcss. --------------------------------------- */
.status-feed
{
	flex: 0 0 96dp;
	margin-bottom: 8dp;
}

/* ---- Map hover preview: ports updateMapHoverPreview() (WOLQuickMatchMenu.cpp:248-282), the preview
   image that follows the mouse near ListBoxMapSelect. Sibling of .shell-frame (not nested inside it,
   same reasoning as OnlineLobby.rcss's .context-menu: data-style-left/top's mouse_x/mouse_y are
   viewport-relative) and position:fixed so RmlQuickMatchScreen.cpp's clampMapPreview() can place it
   in viewport pixels. pointer-events:none so it never steals the map-row hover/click it's floating
   over. --------------------------------------------------------------------------------------- */
.map-hover-preview
{
	display: block;
	position: fixed;
	z-index: 100;
	width: 128dp;
	height: 128dp;
	pointer-events: none;
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 200);
}

/* <mappreview> is a custom element (RmlUiElements.cpp) with no default display -- same reasoning as
   PlayerInfo.rcss's .rank-image/.faction-image classes on <mappedimage>. */
.map-hover-preview-image
{
	display: block;
	width: 100%;
	height: 100%;
}
