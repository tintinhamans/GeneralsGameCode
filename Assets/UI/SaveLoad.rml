<rml>
<head>
	<title>SaveLoad</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="GameSetup.rcss"/>
	<link type="text/rcss" href="SaveLoad.rcss"/>
</head>
<body data-model="saveload" data-class-popup="is_popup" data-event-keydown="key_down">
	<mappedimage class="shell-background" name="MainMenuRuler" data-if="!is_popup"/>

	<div class="sl-frame">
		<div class="shell-title-bar"><gametext key="GUI:SelectAGame"/></div>

		<div class="sl-list scroll-container">
			<div data-for="row : rows">
				<div class="map-row sl-row" data-class-selected="row.selected" data-class-locked="list_locked"
					data-event-click="select_row(row.index)" data-event-dblclick="activate_row(row.index)">
					<div class="sl-name" data-style-color="row.color_hex">{{row.name}}</div>
					<div class="sl-time" data-style-color="row.color_hex">{{row.time}}</div>
					<div class="sl-date" data-style-color="row.color_hex">{{row.date}}</div>
				</div>
			</div>
		</div>

		<div class="sl-buttons">
			<button class="button-lg" data-attr-disabled="save_disabled" data-event-click="save"><gametext key="GUI:SaveGame"/></button>
			<button class="button-lg" data-attr-disabled="load_disabled" data-event-click="load"><gametext key="GUI:LoadGame"/></button>
			<button class="button-lg" data-attr-disabled="delete_disabled" data-event-click="delete"><gametext key="GUI:DeleteGame"/></button>
			<button class="button-lg" data-attr-disabled="back_disabled" data-event-click="back"><gametext key="GUI:Back"/></button>
		</div>
	</div>

	<div class="sl-dialog sl-dialog-load" data-if="show_load_confirm">
		<div class="sl-message"><gametext key="GUI:LoadGameConfirmation"/></div>
		<div class="sl-dialog-buttons">
			<button class="button-lg" data-event-click="confirm_load"><gametext key="GUI:LoadGame"/></button>
			<button class="button-lg" data-event-click="cancel_load"><gametext key="GUI:Cancel"/></button>
		</div>
	</div>

	<div class="sl-dialog" data-if="show_overwrite_confirm">
		<div class="sl-message"><gametext key="GUI:OverwriteSaveConfirmation"/></div>
		<div class="sl-dialog-buttons">
			<button class="button-lg" data-event-click="confirm_overwrite"><gametext key="GUI:SaveGame"/></button>
			<button class="button-lg" data-event-click="cancel_overwrite"><gametext key="GUI:Cancel"/></button>
		</div>
	</div>

	<div class="sl-dialog" data-if="show_save_desc">
		<div class="sl-message sl-message-entry"><gametext key="GUI:EnterSaveDesc"/></div>
		<input type="text" class="sl-input" data-value="description" data-attr-maxlength="description_max"/>
		<div class="sl-dialog-buttons">
			<button class="button-lg" data-event-click="confirm_save_desc"><gametext key="GUI:SaveGame"/></button>
			<button class="button-lg" data-event-click="cancel_save_desc"><gametext key="GUI:Cancel"/></button>
		</div>
	</div>

	<div class="sl-dialog" data-if="show_delete_confirm">
		<div class="sl-message"><gametext key="GUI:ConfirmDelete"/></div>
		<div class="sl-dialog-buttons">
			<button class="button-lg" data-event-click="confirm_delete"><gametext key="GUI:Yes"/></button>
			<button class="button-lg" data-event-click="cancel_delete"><gametext key="GUI:No"/></button>
		</div>
	</div>
</body>
</rml>
