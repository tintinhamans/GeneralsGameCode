/*
	SocialDock.rcss -- the Generals Online social dock (RmlSocialDock) on the screen template's
	palette (common.rcss). It stays up beside every online shell screen, so it is built to cost the
	screen nothing while collapsed:

	  collapsed  a tab in the frame's right band (common.rcss), outside every screen's content:
	             friends online, a badge for unread conversations plus friend requests.
	  expanded   a 390dp side panel docked against the right band, inside the frame line.
	             The host screen makes room for it
	             (body.dock-open, see common.rcss), so it never covers the screen's own actions.
	             Views: friends and requests, the custom lobby's room (its Lobby tab, while the
	             lobby is up), the block list, one conversation.

	Presence: online #36D8B2, in a lobby #14B1FF, in a game #E8D440, offline grey. The unread badge
	uses the accent. .template/.shell (from the host screen) line the panel up with its frame.
*/

body
{
	pointer-events: none;
	z-index: 50;
}

/* ---- Collapsed tab ----------------------------------------------------------------------------- */
.screen button.dock-tab
{
	display: flex;
	flex-direction: column;
	align-items: center;
	position: absolute; /* in the body: on a narrowed interface area (RmlInterfaceArea.h) the band moves in */
	right: 0;
	top: 38%;
	width: 39dp;
	height: auto;
	line-height: 22dp;
	padding: 12dp 0 8dp 0;
	background-color: #070A1AEB;
	border: 1dp #8080FF46;
	border-left: 2dp #3A46D0;
	pointer-events: auto;
}

.screen button.dock-tab:hover
{
	background-color: #1E246EE6;
	border-color: #8080FF;
	border-left-color: #D1FD04;
}

.screen button.dock-tab[disabled], .screen button.dock-tab[disabled]:hover
{
	background-color: #070A1AD2;
	border-color: #8080FF1E;
	opacity: 0.6;
}

/* A person glyph drawn from two boxes (the UI fonts have no icons). */
.tab-icon, .head-icon
{
	display: block;
	width: 25dp;
	height: 25dp;
}

.icon-head
{
	display: block;
	width: 10dp;
	height: 10dp;
	margin: 0 auto 2dp auto;
	border-radius: 4dp;
	background-color: #A9B1CF;
}

.icon-body
{
	display: block;
	width: 20dp;
	height: 10dp;
	margin: 0 auto;
	border-radius: 10dp 10dp 0 0;
	background-color: #A9B1CF;
}

.dock-tab:hover .icon-head, .dock-tab:hover .icon-body
{
	background-color: #FFFFFF;
}

.tab-online
{
	display: flex;
	flex-direction: column;
	align-items: center;
	margin-top: 10dp;
	font-weight: bold;
	color: #D7DCF0;
}

.tab-count
{
	margin-top: 5dp;
	font-size: 15dp;
	line-height: 18dp;
}

.tab-online .dot
{
	flex: 0 0 auto;
}

.tab-badge
{
	display: block;
	margin-top: 10dp;
	min-width: 26dp;
	height: 24dp;
	line-height: 24dp;
	padding: 0 3dp;
	box-sizing: border-box;
	border-radius: 12dp;
	text-align: center;
	font-size: 14dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #D1FD04;
}

.tab-chevron
{
	display: block;
	margin-top: 6dp;
	font-size: 30dp;
	line-height: 28dp;
	color: #8080FF;
}

/* ---- Expanded panel ------------------------------------------------------------------------------ */
.dock-panel
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	position: absolute;
	right: 40dp;
	top: 112dp;
	bottom: 88dp;
	width: 390dp;
	padding: 0 18dp 18dp 18dp;
	background-color: #070A1AEB;
	border-top: 2dp #3A46D0;
	pointer-events: auto;
	animation: 0.2s cubic-out dock-in;
}

/* Over a screen still on the .shell-frame look, line up with that frame instead. */
.dock-panel.shell
{
	right: 5.6%;
	top: 7.3%;
	bottom: 7.3%;
}

@keyframes dock-in
{
	from { opacity: 0; margin-right: -30dp; }
	to { opacity: 1; margin-right: 0dp; }
}

.dock-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 60dp;
}

.head-icon
{
	margin-right: 13dp;
}

.dock-title
{
	font-size: 19dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #EEF1FA;
	white-space: nowrap;
}

.screen button.head-btn
{
	width: 40dp;
	height: 40dp;
	line-height: 35dp;
	padding: 0;
	text-align: center;
	font-size: 33dp;
	color: #A9B1CF;
	background-color: transparent;
	border-color: transparent;
}

.screen button.head-btn:hover
{
	color: #FFFFFF;
	background-color: #2F37A878;
	border-color: transparent;
}

.dock-view
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-height: 0;
}

.dock-tabs
{
	flex: 0 0 auto;
}

.screen .dock-tabs button.seg-item
{
	flex: 1 1 0%;
}

.dock-scroll
{
	flex: 1 1 0%;
	min-height: 0;
	margin-top: 8dp;
	overflow-y: auto;
}

/* ---- Lobby tab: the custom lobby's room ----------------------------------------------------------- */
.tab-count-chip
{
	margin-left: 6dp;
	font-size: 14dp;
	color: #A9B1CF;
}

.seg-item.on .tab-count-chip
{
	color: #FFFFFF;
}

.room-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 36dp;
	padding: 0 10dp 0 8dp;
	border-left: 3dp transparent;
	color: #D7DCF0;
	font-size: 18dp;
	transition: background-color 0.1s cubic-out;
}

.room-row:hover
{
	background-color: #2F37A84B;
}

.room-rank
{
	flex: 0 0 24dp;
	height: 24dp;
	margin-right: 10dp;
}

.room-rank mappedimage
{
	display: block;
	width: 24dp;
	height: 24dp;
}

.room-rank mappedimage img
{
	display: block;
}

.room-name
{
	flex: 1 1 auto;
	min-width: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

/* Buddies: blue name, blue bar and a dot at the end of the row; admins gold, you green, blocked grey. */
.room-row.friend
{
	color: #14B1FF;
	border-left-color: #14B1FF;
	background-color: #14B1FF14;
}

.room-buddy
{
	flex: 0 0 10dp;
	width: 10dp;
	height: 10dp;
	margin-left: 8dp;
	border-radius: 4dp;
	background-color: #14B1FF;
}

.room-row.admin { color: #F0C020; }
.room-row.self { color: #10AD90; font-weight: bold; }
.room-row.ignored { color: #7A7A7A; }

/* ---- Sections and rows ----------------------------------------------------------------------------- */
.section
{
	display: block;
}

.section-head
{
	display: block;
	margin: 18dp 0 8dp 4dp;
}

.section-count
{
	margin-left: 10dp;
	color: #A9B1CF;
	letter-spacing: 1dp;
}

.person
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	height: 63dp;
	padding: 0 10dp 0 8dp;
	border-left: 3dp transparent;
	transition: background-color 0.1s cubic-out;
}

.person:hover
{
	background-color: #2F37A84B;
}

.person.friend.selected, .person.friend.selected:hover
{
	background-color: #2F37A880;
	border-left-color: #D1FD04;
}

.avatar
{
	display: block;
	position: relative;
	flex: 0 0 40dp;
	width: 40dp;
	height: 40dp;
	line-height: 40dp;
	margin-right: 13dp;
	text-align: center;
	font-size: 19dp;
	font-weight: bold;
	color: #D7DCF0;
	background-color: #1E246E;
}

.presence
{
	display: block;
	position: absolute;
	right: 0;
	bottom: 0;
	width: 15dp;
	height: 15dp;
	box-sizing: border-box;
	border-radius: 8dp;
	border: 2dp #070A1A;
	background-color: #4A5070;
}

.presence.online { background-color: #36D8B2; }
.presence.lobby { background-color: #14B1FF; }
.presence.game { background-color: #E8D440; }

.who
{
	display: block;
	flex: 1 1 auto;
	min-width: 0;
}

.name
{
	display: block;
	font-size: 20dp;
	line-height: 25dp;
	font-weight: bold;
	color: #EEF1FA;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.sub
{
	display: block;
	font-size: 16dp;
	line-height: 21dp;
	color: #A9B1CF;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.person.offline .name { color: #7079A0; }
.person.offline .sub { color: #5A6288; }
.person.offline .avatar { color: #7079A0; background-color: #141A3E; }

.unread, .thread-others
{
	display: block;
	flex: 0 0 auto;
	min-width: 28dp;
	height: 28dp;
	line-height: 28dp;
	padding: 0 6dp;
	margin-left: 10dp;
	box-sizing: border-box;
	border-radius: 14dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #D1FD04;
}

/* Requests: two lines of who, the answer buttons under them. */
.person.request
{
	height: auto;
	padding-top: 10dp;
	padding-bottom: 10dp;
	align-items: flex-start;
}

.req-actions
{
	display: flex;
	flex-direction: row;
	margin-top: 8dp;
}

.screen .person button.btn-small
{
	flex: 0 0 auto;
	height: 35dp;
	line-height: 33dp;
	padding: 0 15dp;
	margin-right: 8dp;
	font-size: 15dp;
}

.screen .person button.accept
{
	color: #FFFFFF;
	background-color: #2F37A8;
	border-color: #6170FA;
}

.screen .person button.accept:hover
{
	color: #D1FD04;
	background-color: #3A46D0;
	border-color: #D1FD04;
}

.screen .person button.quiet
{
	background-color: transparent;
}

.screen .person button.quiet:hover
{
	background-color: #2F37A8D2;
}

.dock-empty
{
	display: block;
	padding: 13dp 10dp;
	font-size: 18dp;
	line-height: 24dp;
	color: #7079A0;
}

/* ---- Conversation ---------------------------------------------------------------------------------- */
.thread-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	height: 65dp;
	padding-bottom: 8dp;
	border-bottom: 1dp #8080FF28;
}

.screen button.head-btn.back
{
	margin-right: 10dp;
}

.thread-lines
{
	display: block;
	flex: 1 1 0%;
	min-height: 0;
	margin-top: 13dp;
	padding-right: 8dp;
}

/* Their messages hang off a blue rule on the left, mine sit indented with the brand blue; a run from
   one sender shows the name once. */
.msg
{
	display: block;
	padding: 6dp 13dp;
	margin: 10dp 35dp 0 0;
	line-height: 25dp;
	color: #EEF1FA;
	background-color: #141A3E8C;
	border-left: 2dp #14B1FF;
}

.msg.cont
{
	margin-top: 2dp;
}

.msg.mine
{
	margin-left: 35dp;
	margin-right: 0;
	background-color: #2F37A866;
	border-left-color: #8080FF;
}

.msg-name
{
	display: block;
	font-size: 16dp;
	font-weight: bold;
	letter-spacing: 0.5dp;
	color: #14B1FF;
}

.msg.mine .msg-name
{
	color: #A9B1CF;
}

.msg.note
{
	margin-right: 0;
	color: #A9B1CF;
	background-color: transparent;
	border-left-color: #8080FF46;
}

.thread-entry
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	margin-top: 13dp;
}

.thread-entry .chat-input
{
	flex: 1 1 auto;
	margin-right: 10dp;
}

/* ---- Context menu: common.rcss draws it; here it takes the mouse over the pass-through body ------- */
.context-menu-backdrop
{
	pointer-events: auto;
}

.screen .context-menu
{
	pointer-events: auto;
}

/* ---- 5:4 and 4:3: a narrower panel; the host keeps 356dp for it (common.rcss) ------------------------ */
@media (max-aspect-ratio: 3/2)
{
	.dock-panel { width: 340dp; padding: 0 12dp 12dp 12dp; }
}

/* The three tabs share the dock's width; tighter padding leaves room for longer translated names
   (Spanish, Polish, Portuguese "Blocked"). */
.screen .dock-tabs button.seg-item
{
	padding: 0 6dp;
	font-size: 17dp;
	letter-spacing: 0;
}
