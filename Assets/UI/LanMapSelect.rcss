/*
	LanMapSelect.rcss -- screen-specific layout for the LAN map-select overlay. Map-row/
	map-preview element styles live in GameSetup.rcss (shared with SkirmishMapSelect.rml);
	this file only positions this screen's own panels.
*/

/* .map-select-panel is the .shell-frame (full blueprint panel, see common.rcss) -- fills the
   screen like the original *MapSelectMenu.wnd instead of a fixed centered dialog. body needs an
   explicit 100% size for .shell-frame's percent left/top/width/height to resolve against. */
body
{
	width: 100%;
	height: 100%;
}

.map-select-panel
{
	display: flex;
	flex-direction: column;
}

.map-select-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	margin-top: 8dp;
}

.map-list
{
	flex: 1 1 auto;
	margin-right: 12dp;
}

.side-panel
{
	flex: 0 0 auto;
	width: 320dp;
	display: flex;
	flex-direction: column;
}

.map-display-name
{
	margin-top: 4dp;
	color: #C0C0C0;
}

.map-not-found
{
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #C0C0C0;
}
