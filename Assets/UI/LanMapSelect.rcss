/*
	LanMapSelect.rcss -- screen-specific layout for the LAN map-select overlay. Map-row/
	map-preview element styles live in GameSetup.rcss (shared with SkirmishMapSelect.rml);
	this file only positions this screen's own panels.
*/

.map-select-panel
{
	width: 820dp;
	height: 560dp;
	margin: 60dp auto;
	display: flex;
	flex-direction: column;
}

.map-select-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	margin-top: 8dp;
}

.map-list
{
	flex: 1 1 auto;
	margin-right: 12dp;
}

.side-panel
{
	flex: 0 0 auto;
	width: 280dp;
	display: flex;
	flex-direction: column;
}

.map-display-name
{
	margin-top: 4dp;
	color: #C0C0C0;
}

.map-not-found
{
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #C0C0C0;
}
