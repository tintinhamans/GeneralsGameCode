<rml>
<head>
	<title>SkirmishGameOptions</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="SkirmishGameOptions.rcss"/>
</head>
<body class="screen" data-model="skirmishsetup">
	<div class="screen-ruler"><div class="rs rs-top"><mappedimage name="MainMenuRuler"/></div><div class="rs rs-bottom"><mappedimage name="MainMenuRuler"/></div><div class="rs rs-left"><mappedimage name="MainMenuRuler"/></div><div class="rs rs-right"><mappedimage name="MainMenuRuler"/></div></div>

	<div class="screen-frame">
		<div class="screen-header">
			<div class="screen-heading">
				<div class="screen-crumb"><gametext key="GUI:SinglePlayer"/><span class="crumb-sep">&#8250;</span></div>
				<div class="screen-title"><gametext key="GUI:Skirmish"/></div>
			</div>
		</div>

		<div class="screen-body">
			<div class="col col-main">
				<!-- Players: one row per slot. Colour is a row of swatches, team a segmented control;
				     occupant and army stay drop-downs (long lists). Open and closed slots only show
				     their occupant. -->
				<div class="surface slots">
					<div class="list-head slot">
						<div class="slot-chip"></div>
						<div class="c-occupant overline"><gametext key="GUI:Players"/></div>
						<div class="c-army overline"><gametext key="GUI:Faction"/></div>
						<div class="c-color overline"><gametext key="GUI:Color"/></div>
						<div class="c-team overline"><gametext key="GUI:Team"/></div>
					</div>
					<div class="slot" data-for="row : slots" data-class-empty="!row.is_occupied" data-class-human="row.is_human_occupant">
						<div class="slot-chip" data-style-background-color="row.color_hex"></div>
						<div class="c-occupant">
							<select data-if="!row.is_human_occupant" data-value="row.occupant_state" data-attrif-disabled="!row.can_edit_occupant"
								data-event-change="slot_occupant_changed(row.slot_index)">
								<option value="0"><gametext key="GUI:Open"/></option>
								<option value="1"><gametext key="GUI:Closed"/></option>
								<option value="2"><gametext key="GUI:EasyAI"/></option>
								<option value="3"><gametext key="GUI:MediumAI"/></option>
								<option value="4"><gametext key="GUI:HardAI"/></option>
								<option value="5" data-if="row.is_human_occupant">{{row.player_name}}</option>
							</select>
							<div class="slot-name" data-if="row.is_human_occupant">{{row.player_name}}</div>
						</div>
						<div class="c-army">
							<select class="army-select" data-value="row.player_template" data-attrif-disabled="!row.can_edit || !row.is_occupied"
								data-event-change="slot_faction_changed(row.slot_index)">
								<option data-for="opt : faction_options" data-attr-value="opt.value"><mappedimage class="army-icon" data-if="opt.icon != ''" data-attr-name="opt.icon"/><span class="army-icon army-random" data-if="opt.icon == ''">?</span>{{opt.label}}</option>
							</select>
						</div>
						<div class="c-color">
							<div class="swatches">
								<button class="swatch" data-for="opt : row.color_options" data-class-random="opt.value &lt; 0" data-class-on="opt.value == row.color"
									data-style-background-color="opt.value &lt; 0 ? '#141A3E' : opt.swatch" data-attrif-disabled="!row.can_edit || !row.is_occupied"
									data-event-click="slot_color_picked(row.slot_index, opt.value)"><span data-if="opt.value &lt; 0">?</span></button>
							</div>
						</div>
						<div class="c-team">
							<div class="seg team-seg">
								<button class="seg-item" data-class-on="row.team_number == -1" data-attrif-disabled="!row.can_edit || !row.is_occupied" data-event-click="slot_team_picked(row.slot_index, -1)"><gametext key="Team:0"/></button>
								<button class="seg-item" data-class-on="row.team_number == 0" data-attrif-disabled="!row.can_edit || !row.is_occupied" data-event-click="slot_team_picked(row.slot_index, 0)"><gametext key="Team:1"/></button>
								<button class="seg-item" data-class-on="row.team_number == 1" data-attrif-disabled="!row.can_edit || !row.is_occupied" data-event-click="slot_team_picked(row.slot_index, 1)"><gametext key="Team:2"/></button>
								<button class="seg-item" data-class-on="row.team_number == 2" data-attrif-disabled="!row.can_edit || !row.is_occupied" data-event-click="slot_team_picked(row.slot_index, 2)"><gametext key="Team:3"/></button>
								<button class="seg-item" data-class-on="row.team_number == 3" data-attrif-disabled="!row.can_edit || !row.is_occupied" data-event-click="slot_team_picked(row.slot_index, 3)"><gametext key="Team:4"/></button>
							</div>
						</div>
					</div>
				</div>

				<div class="lower">
					<div class="surface options">
						<div class="overline group-title"><gametext key="GUI:GameOptions"/></div>
						<div class="opt-row">
							<div class="opt-label"><gametext key="GUI:StartingMoney"/></div>
							<div class="seg" data-tooltip="TOOLTIP:StartingMoney">
								<button class="seg-item" data-for="opt : starting_cash_options" data-class-on="opt.value == starting_cash"
									data-event-click="starting_cash_picked(opt.value)">{{opt.label}}</button>
							</div>
						</div>
						<div class="opt-row">
							<div class="opt-label"><gametext key="GUI:GameSpeed"/></div>
							<input class="range speed" type="range" min="15" max="61" step="1" data-value="game_speed_slider_pos" data-event-change="game_speed_changed" data-tooltip="GUI:AdjustGameSpeed"/>
						</div>
						<div class="opt-row">
							<label class="check" data-tooltip="TOOLTIP:LimitSuperweapons">
								<input class="checkbox" type="checkbox" data-checked="superweapons_restricted" data-event-change="superweapons_changed"/>
								<gametext key="GUI:LimitSuperweapons"/>
							</label>
						</div>
					</div>

					<div class="surface honors" data-tooltip="TOOLTIP:BattleHonors">
						<div class="stats">
							<div class="stat"><div class="stat-value">{{honor_wins}}</div><div class="stat-label"><gametext key="GUI:CareerWins"/></div></div>
							<div class="stat"><div class="stat-value">{{honor_losses}}</div><div class="stat-label"><gametext key="GUI:CareerLosses"/></div></div>
							<div class="stat"><div class="stat-value">{{honor_win_streak}}</div><div class="stat-label"><gametext key="GUI:CurrentWinStreak"/></div></div>
							<div class="stat"><div class="stat-value">{{honor_best_win_streak}}</div><div class="stat-label"><gametext key="GUI:BestWinStreak"/></div></div>
						</div>
						<button class="btn-small honors-reset" data-event-click="reset_honors"><gametext key="GUI:ResetHonors"/></button>
					</div>
				</div>
			</div>

			<div class="col col-side">
				<div class="surface map-card">
					<div class="overline group-title"><gametext key="GUI:MapPreview"/></div>
					<div class="map-frame">
						<mappreview class="map-image" data-attr-map="map_name" data-if="map_found"/>
						<div class="map-missing" data-if="!map_found"><gametext key="GUI:CantFindMap"/></div>
						<div data-for="marker : start_markers">
							<div class="marker" data-if="marker.used" data-class-occupied="marker.is_occupied"
								data-style-left="marker.x_style" data-style-top="marker.y_style"
								data-event-click="start_marker_clicked(marker.position)"
								data-event-mousedown="start_marker_mousedown(marker.position)">
								<div class="marker-dot" data-style-background-color="marker.color_hex">{{marker.position + 1}}</div>
								<div class="marker-label" data-if="marker.is_occupied">{{marker.occupant_label}}</div>
							</div>
						</div>
					</div>
					<div class="map-name">{{map_display_name}}</div>
					<button class="map-button" data-event-click="select_map"><gametext key="GUI:SelectMap"/></button>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:GotoMainMenu"/></button>
			<div class="spacer"></div>
			<button class="btn-cta" data-event-click="start"><gametext key="GUI:Start"/></button>
		</div>
	</div>
</body>
</rml>
