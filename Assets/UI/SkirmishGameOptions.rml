<rml>
<head>
	<title>SkirmishGameOptions</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="GameSetup.rcss"/>
	<link type="text/rcss" href="SkirmishGameOptions.rcss"/>
</head>
<body data-model="skirmishsetup">
	<div class="frame panel skirmish-panel">
		<div class="title-bar"><gametext key="GUI:Skirmish"/></div>

		<div class="skirmish-body">
			<div class="slot-list">
				<div class="slot-row slot-header">
					<div class="slot-occupant"><gametext key="GUI:Players"/></div>
					<div class="slot-faction"><gametext key="GUI:Faction"/></div>
					<div class="slot-color"><gametext key="GUI:Color"/></div>
					<div class="slot-team"><gametext key="GUI:Team"/></div>
				</div>
				<div class="slot-row" data-for="row : slots">
					<select class="slot-occupant" data-value="row.occupant_state" data-attr-disabled="!row.can_edit_occupant"
						data-event-change="slot_occupant_changed(row.slot_index)">
						<option value="0"><gametext key="GUI:Open"/></option>
						<option value="1"><gametext key="GUI:Closed"/></option>
						<option value="2"><gametext key="GUI:EasyAI"/></option>
						<option value="3"><gametext key="GUI:MediumAI"/></option>
						<option value="4"><gametext key="GUI:HardAI"/></option>
					</select>
					<div class="slot-name" data-if="row.is_human_occupant">{{row.player_name}}</div>
					<select class="slot-faction" data-if="!row.is_human_occupant" data-value="row.player_template"
						data-attr-disabled="!row.can_edit || !row.is_occupied" data-event-change="slot_faction_changed(row.slot_index)">
						<option data-for="opt : faction_options" data-attr-value="opt.value">{{opt.label}}</option>
					</select>
					<div class="slot-faction" data-if="row.is_human_occupant">{{row.faction_label}}</div>
					<select class="slot-color" data-value="row.color" data-attr-disabled="!row.can_edit || !row.is_occupied"
						data-event-change="slot_color_changed(row.slot_index)">
						<option data-for="opt : color_options" data-attr-value="opt.value" data-style-background-color="opt.label">&#160;&#160;&#160;&#160;</option>
					</select>
					<select class="slot-team" data-value="row.team_number" data-attr-disabled="!row.can_edit || !row.is_occupied"
						data-event-change="slot_team_changed(row.slot_index)">
						<option value="-1"><gametext key="GUI:NoTeam"/></option>
						<option value="0">1</option>
						<option value="1">2</option>
						<option value="2">3</option>
						<option value="3">4</option>
					</select>
				</div>
			</div>

			<div class="side-panel">
				<div class="map-preview">
					<mappreview class="map-preview-image" data-attr-map="map_name" data-if="map_found"/>
					<div class="map-not-found" data-if="!map_found"><gametext key="GUI:CantFindMap"/></div>
					<div data-for="marker : start_markers">
						<div class="start-marker" data-if="marker.used"
							data-style-left="marker.x_style" data-style-top="marker.y_style"
							data-event-click="start_marker_clicked(marker.position)"
							data-event-mousedown="start_marker_mousedown(marker.position)">
							<div class="start-marker-dot" data-class-occupied="marker.is_occupied" data-style-background-color="marker.color_hex"></div>
							<div class="start-marker-label" data-if="marker.is_occupied">{{marker.occupant_label}}</div>
						</div>
					</div>
				</div>
				<div class="map-display-name"><gametext key="GUI:MapPreview"/>: {{map_display_name}}</div>
				<button data-event-click="select_map"><gametext key="GUI:SelectMap"/></button>

				<div class="row">
					<div class="label"><gametext key="GUI:StartingMoney"/></div>
					<select class="control" data-value="starting_cash" data-event-change="starting_cash_changed" data-tooltip="TOOLTIP:StartingMoney">
						<option data-for="opt : starting_cash_options" data-attr-value="opt.value">{{opt.label}}</option>
					</select>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:LimitSuperweapons"/></div>
					<input class="control checkbox" type="checkbox" data-checked="superweapons_restricted" data-event-change="superweapons_changed" data-tooltip="TOOLTIP:LimitSuperweapons"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:GameSpeed"/></div>
					<input class="control range" type="range" min="15" max="61" step="1" data-value="game_speed_slider_pos" data-event-change="game_speed_changed" data-tooltip="GUI:AdjustGameSpeed"/>
				</div>

				<div class="honors-panel" data-tooltip="TOOLTIP:BattleHonors">
					<div class="honors-row"><gametext key="GUI:CareerWins"/>: {{honor_wins}}</div>
					<div class="honors-row"><gametext key="GUI:CareerLosses"/>: {{honor_losses}}</div>
					<div class="honors-row"><gametext key="GUI:CurrentWinStreak"/>: {{honor_win_streak}}</div>
					<div class="honors-row"><gametext key="GUI:BestWinStreak"/>: {{honor_best_win_streak}}</div>
					<button data-event-click="reset_honors"><gametext key="GUI:ResetHonors"/></button>
				</div>
			</div>
		</div>

		<div class="footer">
			<button data-event-click="back"><gametext key="GUI:GotoMainMenu"/></button>
			<button data-event-click="start"><gametext key="GUI:Start"/></button>
		</div>
	</div>
</body>
</rml>
