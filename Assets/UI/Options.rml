<rml>
<head>
	<title>Options</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="Options.rcss"/>
</head>
<body class="screen hq dock-host" data-model="options">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="hq-band hq-header"><div class="hq-band-in">
			<mappedimage name="GeneralsLogo" class="hq-logo"/>
			<div class="hq-heading"><div class="hq-title"><gametext key="GUI:Options"/></div></div>
			<div class="hq-status">
				<div class="hq-pill" data-if="logged_in"><span class="hq-dot"></span><span class="hq-count" data-if="online_count_text != ''">{{online_count_text}}</span><span class="hq-sep" data-if="online_count_text != '' &amp;&amp; player_name != ''"></span><span class="hq-name" data-if="player_name != ''">{{player_name}}</span></div>
				<div class="hq-pill hq-off" data-if="!logged_in"><span class="hq-dot"></span><gametext key="GO:GUI:MenuOffline"/></div>
				<div class="hq-clock" data-if="clock_text != ''">{{clock_text}}</div>
			</div>
	</div></div>

	<div class="screen-frame">
		<div class="screen-body">
			<!-- Categories down the left. -->
			<div class="tab-rail">
				<button class="rail-item hq-brackets" data-class-on="tab == 'video'" data-class-selected="tab == 'video'" data-event-click="select_video"><span class="hq-index rail-idx">01</span><gametext key="GO:GUI:OptionsDisplay"/><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
				<button class="rail-item hq-brackets" data-class-on="tab == 'graphics'" data-class-selected="tab == 'graphics'" data-event-click="select_graphics"><span class="hq-index rail-idx">02</span><gametext key="GO:GUI:OptionsGraphics"/><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
				<button class="rail-item hq-brackets" data-class-on="tab == 'audio'" data-class-selected="tab == 'audio'" data-event-click="select_audio"><span class="hq-index rail-idx">03</span><gametext key="GUI:Audio"/><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
				<button class="rail-item hq-brackets" data-class-on="tab == 'controls'" data-class-selected="tab == 'controls'" data-event-click="select_controls"><span class="hq-index rail-idx">04</span><gametext key="GO:GUI:OptionsControls"/><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
				<button class="rail-item hq-brackets" data-class-on="tab == 'network'" data-class-selected="tab == 'network'" data-event-click="select_network"><span class="hq-index rail-idx">05</span><gametext key="GUI:Network"/><span class="hq-scan"></span><span class="hq-br hq-br-tl"></span><span class="hq-br hq-br-tr"></span><span class="hq-br hq-br-bl"></span><span class="hq-br hq-br-br"></span></button>
			</div>

			<!-- One label/control row per setting, its tooltip text under the label. Only the active
			     category is laid out. -->
			<div class="surface opt-panel">
				<!-- Display: resolution, brightness, anti-aliasing, texture filtering, anisotropy -->
				<div class="opt-page scroll-container" data-if="tab == 'video'">
					<div class="opt-head"><gametext key="GO:GUI:OptionsDisplay"/></div>
					<!-- The UI text language (Generals Online's settings.json); the options are filled in C++. -->
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:GOLanguage"/></div><div class="opt-desc"><gametext key="GUI:GOLanguageRestart"/></div></div>
						<div class="opt-control"><select id="select_language" data-value="text_language"></select></div>
					</div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:Resolution"/></div><div class="opt-desc"><gametext key="TOOLTIP:Resolution"/></div></div>
						<div class="opt-control"><select id="select_resolution" data-value="resolution_index" data-attrif-disabled="restricted"></select></div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:GammaAdjustment"/></div><div class="opt-desc"><gametext key="TOOLTIP:Brightness"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="100" step="1" data-value="brightness" data-tooltip="TOOLTIP:Brightness"/>
							<div class="opt-value">{{brightness}}</div>
						</div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:AntiAliasing"/></div></div>
						<div class="opt-control">
							<select data-value="anti_aliasing">
								<option value="0"><gametext key="GUI:AntiAliasing0"/></option>
								<option value="1"><gametext key="GUI:GOMSAA2"/></option>
								<option value="2"><gametext key="GUI:GOMSAA4"/></option>
								<option value="3"><gametext key="GUI:GOMSAA8"/></option>
							</select>
						</div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GO:GUI:TextureFiltering"/></div></div>
						<div class="opt-control">
							<select data-value="texture_filter">
								<option value="0"><gametext key="GUI:GOBilinear"/></option>
								<option value="1"><gametext key="GUI:GOTrilinear"/></option>
								<option value="2"><gametext key="GUI:GOAnisotropic"/></option>
							</select>
						</div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GO:GUI:Anisotropy"/></div></div>
						<div class="opt-control">
							<select data-value="anisotropy">
								<option value="0">2x</option>
								<option value="1">4x</option>
								<option value="2">8x</option>
								<option value="3">16x</option>
							</select>
						</div>
					</div>
				</div>

				<!-- Graphics: the detail preset (options filled in C++, RmlOptionsScreen::populateSelectOptions),
				     its sliders and every effect toggle; editing one switches the preset to Custom. -->
				<div class="opt-page scroll-container" data-if="tab == 'graphics'">
					<div class="opt-head"><gametext key="GO:GUI:OptionsGraphics"/></div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:Detail"/></div></div>
						<div class="opt-control"><select id="select_detail" data-value="detail_level" data-attrif-disabled="restricted"
							data-event-change="detail_level_changed"></select></div>
					</div>
					<div class="opt-row" data-class-disabled="detail_controls_disabled">
						<div class="opt-text"><div class="opt-label"><gametext key="GO:GUI:TextureResolution"/></div><div class="opt-desc"><gametext key="TOOLTIP:LowResSlider"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="2" step="1" data-value="texture_resolution"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:LowResSlider"/>
						</div>
					</div>
					<div class="opt-row" data-class-disabled="detail_controls_disabled">
						<div class="opt-text"><div class="opt-label"><gametext key="GO:GUI:ParticleCap"/></div><div class="opt-desc"><gametext key="TOOLTIP:ParticleCapSlider"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="2500" step="50" data-value="particle_cap"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ParticleCapSlider"/>
							<div class="opt-value">{{particle_cap}}</div>
						</div>
					</div>

					<div class="opt-group" data-class-disabled="detail_controls_disabled">
						<div class="overline"><gametext key="GUI:AdvanceDisplayOptions"/></div>
						<div class="opt-desc"><gametext key="GUI:AdvancedOptionsToggleOnOff"/></div>
					</div>
					<div class="opt-toggles" data-class-disabled="detail_controls_disabled">
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="shadow_3d"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:Shadows3D"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:Shadows3D"/></div><div class="opt-desc"><gametext key="TOOLTIP:Shadows3D"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="shadow_2d"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:Shadows2D"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:Shadows2D"/></div><div class="opt-desc"><gametext key="TOOLTIP:Shadows2D"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="cloud_shadows"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:CloudShadows"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:CloudShadows"/></div><div class="opt-desc"><gametext key="TOOLTIP:CloudShadows"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="ground_lighting"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:GroundLighting"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:GroundLighting"/></div><div class="opt-desc"><gametext key="TOOLTIP:GroundLighting"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="smooth_water"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:SmoothWater"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:SmoothWater"/></div><div class="opt-desc"><gametext key="TOOLTIP:SmoothWater"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="extra_animations"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ExtraAnimations"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:ExtraAnimations"/></div><div class="opt-desc"><gametext key="TOOLTIP:ExtraAnimations"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="no_dynamic_lod"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:NoDynamicLOD"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:NoDynamicLOD"/></div><div class="opt-desc"><gametext key="TOOLTIP:NoDynamicLOD"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="heat_effects"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:HeatEffects"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:HeatEffects"/></div><div class="opt-desc"><gametext key="TOOLTIP:HeatEffects"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="building_occlusion"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:BehindBuilding"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:BehindBuilding"/></div><div class="opt-desc"><gametext key="TOOLTIP:BehindBuilding"/></div></div>
						</label>
						<label class="check opt-toggle">
							<input class="checkbox" type="checkbox" data-checked="props"
								data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ShowProps"/>
							<div class="opt-text"><div class="opt-label"><gametext key="GUI:ShowProps"/></div><div class="opt-desc"><gametext key="TOOLTIP:ShowProps"/></div></div>
						</label>
					</div>
				</div>

				<!-- Audio -->
				<div class="opt-page scroll-container" data-if="tab == 'audio'">
					<div class="opt-head"><gametext key="GUI:Audio"/></div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:MusicVolume"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="100" step="1" data-value="music_volume" data-tooltip="GUI:MusicVolume"/>
							<div class="opt-value">{{music_volume}}</div>
						</div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:SFXVolume"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="100" step="1" data-value="sfx_volume" data-tooltip="GUI:SFXVolume"/>
							<div class="opt-value">{{sfx_volume}}</div>
						</div>
					</div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:VoiceVolume"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="100" step="1" data-value="voice_volume" data-tooltip="GUI:VoiceVolume"/>
							<div class="opt-value">{{voice_volume}}</div>
						</div>
					</div>
				</div>

				<!-- Controls -->
				<div class="opt-page scroll-container" data-if="tab == 'controls'">
					<div class="opt-head"><gametext key="GO:GUI:OptionsControls"/></div>
					<div class="opt-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:ScrollSpeed"/></div><div class="opt-desc"><gametext key="TOOLTIP:ScrollSpeed"/></div></div>
						<div class="opt-control opt-slider">
							<input class="range" type="range" min="0" max="100" step="1" data-value="scroll_speed" data-tooltip="ToolTip:ScrollSpeed"/>
							<div class="opt-value">{{scroll_speed}}</div>
						</div>
					</div>
					<label class="check opt-row opt-check-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:AlternateMouse"/></div><div class="opt-desc"><gametext key="TOOLTIP:AlternateMouse"/></div></div>
						<div class="opt-control"><input class="checkbox" type="checkbox" data-checked="alternate_mouse" data-tooltip="TOOLTIP:AlternateMouse"/></div>
					</label>
					<label class="check opt-row opt-check-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:RetaliationTitle"/></div><div class="opt-desc"><gametext key="GUI:Retaliation"/></div></div>
						<div class="opt-control"><input class="checkbox" type="checkbox" data-checked="retaliation" data-tooltip="GUI:Retaliation"/></div>
					</label>
					<label class="check opt-row opt-check-row">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:DoubleClickAttackMove"/></div><div class="opt-desc"><gametext key="TOOLTIP:DoubleClickAttackMove"/></div></div>
						<div class="opt-control"><input class="checkbox" type="checkbox" data-checked="double_click_attack_move" data-tooltip="TOOLTIP:DoubleClickAttackMove"/></div>
					</label>
				</div>

				<!-- Network: IP choices filled in C++ like the detail preset. -->
				<div class="opt-page scroll-container" data-if="tab == 'network'">
					<div class="opt-head"><gametext key="GUI:Network"/></div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:IPAddresses"/></div><div class="opt-desc"><gametext key="TOOLTIP:LanIP"/></div></div>
						<div class="opt-control"><select id="select_lan_ip" data-value="lan_ip_index" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:LanIP"></select></div>
					</div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:OnlineIPAddresses"/></div><div class="opt-desc"><gametext key="TOOLTIP:OnlineIP"/></div></div>
						<div class="opt-control"><select id="select_online_ip" data-value="online_ip_index" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:OnlineIP"></select></div>
					</div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:FireWallPort"/></div><div class="opt-desc"><gametext key="TOOLTIP:FireWallPort"/></div></div>
						<div class="opt-control"><input class="text-input" type="text" maxlength="5" data-value="firewall_port_override" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:FireWallPort"/></div>
					</div>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:HTTPProxy"/></div><div class="opt-desc"><gametext key="TOOLTIP:HTTPProxy"/></div></div>
						<div class="opt-control"><input class="text-input" type="text" data-value="http_proxy" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:HTTPProxy"/></div>
					</div>
					<label class="check opt-row opt-check-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:SendDelay"/></div><div class="opt-desc"><gametext key="TOOLTIP:SendDelay"/></div></div>
						<div class="opt-control"><input class="checkbox" type="checkbox" data-checked="send_delay" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:SendDelay"/></div>
					</label>
					<div class="opt-row" data-class-disabled="restricted">
						<div class="opt-text"><div class="opt-label"><gametext key="GUI:FirewallRefresh"/></div><div class="opt-desc"><gametext key="TOOLTIP:RefreshNat"/></div></div>
						<div class="opt-control"><button class="btn-small" data-event-click="firewall_refresh" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:RefreshNat"><gametext key="GUI:FirewallRefresh"/></button></div>
					</div>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-event-click="cancel" data-tooltip="TOOLTIP:OptionsCancel"><span class="chevron">&#8249;</span><gametext key="GUI:Cancel"/></button>
			<div class="spacer"></div>
			<button data-event-click="defaults" data-tooltip="TOOLTIP:OptionsDefaults"><gametext key="GUI:Defaults"/></button>
			<button class="btn-cta" data-event-click="accept" data-tooltip="TOOLTIP:OptionsAccept"><gametext key="GUI:Accept"/></button>
		</div>
	</div>
</body>
</rml>
