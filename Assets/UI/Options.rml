<rml>
<head>
	<title>Options</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		body { width: 840dp; height: 640dp; left: 50%; top: 50%; margin-left: -420dp; margin-top: -320dp; }
		.frame { box-sizing: border-box; width: 100%; height: 100%; display: flex; flex-direction: column; }
		.panels { flex: 1 1 auto; display: flex; overflow: hidden; }
		.panel { width: 100%; height: 100%; }
		/* common.rcss's .row is a flex label/control grid -- fine on every other screen, but here it
		   collapses every row in this panel to 0 width as soon as the Graphics/Network tab's content
		   needs to scroll: RmlUi's flex width resolution doesn't survive an overflow-y:auto container
		   transitioning into "needs a scrollbar". So both columns are pinned to fixed dp instead: the
		   frame's 808dp content box minus the 12dp scrollbar is a 440dp label column and a 340dp
		   control column. */
		.row { display: block; position: relative; height: 40dp; margin-bottom: 0; box-sizing: border-box; }
		.row > .label { display: block; width: 440dp; line-height: 40dp; box-sizing: border-box; }
		.row > .control { position: absolute; top: 4dp; left: 440dp; width: 340dp; }
		.row > input.range.control { top: 10dp; }
		.row > .control.checkbox { top: 10dp; width: 20dp; }
	</style>
</head>
<body data-model="options">
	<div class="frame">
		<div class="title-bar"><gametext key="GUI:Options"/></div>

		<div class="tabs">
			<div class="tab" data-class-selected="tab == 'video'" data-event-click="select_video">Video</div>
			<div class="tab" data-class-selected="tab == 'graphics'" data-event-click="select_graphics">Graphics</div>
			<div class="tab" data-class-selected="tab == 'audio'" data-event-click="select_audio">Audio</div>
			<div class="tab" data-class-selected="tab == 'controls'" data-event-click="select_controls">Controls</div>
			<div class="tab" data-class-selected="tab == 'network'" data-event-click="select_network">Network</div>
		</div>

		<div class="panels">
			<!-- Video: brightness / anti-aliasing / texture filtering / anisotropy -->
			<div class="panel scroll-container" data-if="tab == 'video'">
				<div class="row">
					<div class="label"><gametext key="GUI:GammaAdjustment"/></div>
					<input class="control range" type="range" min="0" max="100" step="1" data-value="brightness" data-tooltip="TOOLTIP:Brightness"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:AntiAliasing"/></div>
					<select class="control" data-value="anti_aliasing">
						<option value="0">Off</option>
						<option value="1">2x MSAA</option>
						<option value="2">4x MSAA</option>
						<option value="3">8x MSAA</option>
					</select>
				</div>
				<div class="row">
					<div class="label">Texture Filtering</div>
					<select class="control" data-value="texture_filter">
						<option value="0">Bilinear</option>
						<option value="1">Trilinear</option>
						<option value="2">Anisotropic</option>
					</select>
				</div>
				<div class="row">
					<div class="label">Anisotropy</div>
					<select class="control" data-value="anisotropy">
						<option value="0">2x</option>
						<option value="1">4x</option>
						<option value="2">8x</option>
						<option value="3">16x</option>
					</select>
				</div>
			</div>

			<!-- Graphics: resolution, detail preset/Custom, and every effect toggle. Options are
			     populated in C++ (RmlOptionsScreen::populateSelectOptions) since they come from
			     runtime data (display modes, LOD manager) rather than fixed markup. -->
			<div class="panel scroll-container" data-if="tab == 'graphics'">
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:Resolution"/></div>
					<select id="select_resolution" class="control" data-value="resolution_index" data-attrif-disabled="restricted"></select>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:Detail"/></div>
					<select id="select_detail" class="control" data-value="detail_level" data-attrif-disabled="restricted"
						data-event-change="detail_level_changed"></select>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label">Texture Resolution</div>
					<input class="control range" type="range" min="0" max="2" step="1" data-value="texture_resolution"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:LowResSlider"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:ParticleCap"/></div>
					<input class="control range" type="range" min="0" max="2500" step="50" data-value="particle_cap"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ParticleCapSlider"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:Shadows3D"/></div>
					<input class="control checkbox" type="checkbox" data-checked="shadow_3d"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:Shadows3D"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:Shadows2D"/></div>
					<input class="control checkbox" type="checkbox" data-checked="shadow_2d"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:Shadows2D"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:CloudShadows"/></div>
					<input class="control checkbox" type="checkbox" data-checked="cloud_shadows"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:CloudShadows"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:GroundLighting"/></div>
					<input class="control checkbox" type="checkbox" data-checked="ground_lighting"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:GroundLighting"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:SmoothWater"/></div>
					<input class="control checkbox" type="checkbox" data-checked="smooth_water"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:SmoothWater"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:ExtraAnimations"/></div>
					<input class="control checkbox" type="checkbox" data-checked="extra_animations"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ExtraAnimations"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:NoDynamicLOD"/></div>
					<input class="control checkbox" type="checkbox" data-checked="no_dynamic_lod"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:NoDynamicLOD"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:HeatEffects"/></div>
					<input class="control checkbox" type="checkbox" data-checked="heat_effects"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:HeatEffects"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:BehindBuilding"/></div>
					<input class="control checkbox" type="checkbox" data-checked="building_occlusion"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:BehindBuilding"/>
				</div>
				<div class="row" data-class-disabled="detail_controls_disabled">
					<div class="label"><gametext key="GUI:ShowProps"/></div>
					<input class="control checkbox" type="checkbox" data-checked="props"
						data-attrif-disabled="detail_controls_disabled" data-event-change="detail_control_changed" data-tooltip="TOOLTIP:ShowProps"/>
				</div>
			</div>

			<!-- Audio -->
			<div class="panel scroll-container" data-if="tab == 'audio'">
				<div class="row">
					<div class="label"><gametext key="GUI:MusicVolume"/></div>
					<input class="control range" type="range" min="0" max="100" step="1" data-value="music_volume" data-tooltip="GUI:MusicVolume"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:SFXVolume"/></div>
					<input class="control range" type="range" min="0" max="100" step="1" data-value="sfx_volume" data-tooltip="GUI:SFXVolume"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:VoiceVolume"/></div>
					<input class="control range" type="range" min="0" max="100" step="1" data-value="voice_volume" data-tooltip="GUI:VoiceVolume"/>
				</div>
			</div>

			<!-- Controls -->
			<div class="panel scroll-container" data-if="tab == 'controls'">
				<div class="row">
					<div class="label"><gametext key="GUI:ScrollSpeed"/></div>
					<input class="control range" type="range" min="0" max="100" step="1" data-value="scroll_speed" data-tooltip="ToolTip:ScrollSpeed"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:AlternateMouse"/></div>
					<input class="control checkbox" type="checkbox" data-checked="alternate_mouse" data-tooltip="TOOLTIP:AlternateMouse"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:RetaliationTitle"/></div>
					<input class="control checkbox" type="checkbox" data-checked="retaliation" data-tooltip="GUI:Retaliation"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:DoubleClickAttackMove"/></div>
					<input class="control checkbox" type="checkbox" data-checked="double_click_attack_move" data-tooltip="TOOLTIP:DoubleClickAttackMove"/>
				</div>
			</div>

			<!-- Network: IP selection populated in C++ the same way as the Graphics tab's selects. -->
			<div class="panel scroll-container" data-if="tab == 'network'">
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:IPAddresses"/></div>
					<select id="select_lan_ip" class="control" data-value="lan_ip_index" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:LanIP"></select>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:OnlineIPAddresses"/></div>
					<select id="select_online_ip" class="control" data-value="online_ip_index" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:OnlineIP"></select>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:FireWallPort"/></div>
					<input class="control text-input" type="text" maxlength="5" data-value="firewall_port_override" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:FireWallPort"/>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:HTTPProxy"/></div>
					<input class="control text-input" type="text" data-value="http_proxy" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:HTTPProxy"/>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:SendDelay"/></div>
					<input class="control checkbox" type="checkbox" data-checked="send_delay" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:SendDelay"/>
				</div>
				<div class="row" data-class-disabled="restricted">
					<div class="label"><gametext key="GUI:FirewallRefresh"/></div>
					<button class="control btn-inline" data-event-click="firewall_refresh" data-attrif-disabled="restricted" data-tooltip="TOOLTIP:RefreshNat"><gametext key="GUI:FirewallRefresh"/></button>
				</div>
			</div>
		</div>

		<div class="footer">
			<button class="btn-primary" data-event-click="defaults" data-tooltip="TOOLTIP:OptionsDefaults"><gametext key="GUI:Defaults"/></button>
			<button class="btn-primary" data-event-click="cancel" data-tooltip="TOOLTIP:OptionsCancel"><gametext key="GUI:Cancel"/></button>
			<button class="btn-primary" data-event-click="accept" data-tooltip="TOOLTIP:OptionsAccept"><gametext key="GUI:Accept"/></button>
		</div>
	</div>
</body>
</rml>
