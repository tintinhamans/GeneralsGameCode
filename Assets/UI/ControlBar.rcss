/* ---- Which sprite draws what ---------------------------------------------------------------------- */
/* ---- usa ---- */
body.usa .cb-radar { decorator: image(cb-usa-radar fill); }
body.usa .cb-alarm { decorator: image(cb-usa-alarm fill); }
body.usa .cb-main { decorator: image(cb-usa-production fill); }
body.usa .cb-unit { decorator: image(cb-usa-upgrades fill); }
body.usa .cb-emblem { decorator: image(cb-usa-logo fill); }
body.usa .cb-tray { decorator: image(cb-usa-tray-top fill); }
body.usa .cb-tray0 { decorator: image(cb-usa-tray fill); }
body.usa .cb-science { decorator: image(cb-usa-power-power fill); }
body.usa.low .cb-main { decorator: image(cb-usa-production scale-none left top); }
body.usa.low .cb-unit { decorator: image(cb-usa-upgrades scale-none left top); }
body.usa .cb-options { decorator: image(cb-usa-options fill); }
body.usa .cb-options:hover { decorator: image(cb-usa-options-h fill); }
body.usa .cb-options:active { decorator: image(cb-usa-options-p fill); }
body.usa .cb-options.off { decorator: image(cb-usa-options-i fill); }
body.usa .cb-chat { decorator: image(cb-usa-chat fill); }
body.usa .cb-chat:hover { decorator: image(cb-usa-chat-h fill); }
body.usa .cb-chat:active { decorator: image(cb-usa-chat-p fill); }
body.usa .cb-chat.off { decorator: image(cb-usa-chat-i fill); }
body.usa .cb-worker { decorator: image(cb-usa-worker fill); }
body.usa .cb-worker:hover { decorator: image(cb-usa-worker-h fill); }
body.usa .cb-worker:active { decorator: image(cb-usa-worker-p fill); }
body.usa .cb-worker.off { decorator: image(cb-usa-worker-i fill); }
body.usa .cb-beacon-btn { decorator: image(cb-usa-beacon fill); }
body.usa .cb-beacon-btn:hover { decorator: image(cb-usa-beacon-h fill); }
body.usa .cb-beacon-btn:active { decorator: image(cb-usa-beacon-p fill); }
body.usa .cb-beacon-btn.off { decorator: image(cb-usa-beacon-i fill); }
body.usa .cb-exp-fg { decorator: image(cb-usa-expbar fill); }
body.usa .cb-general { decorator: image(cb-usa-general fill); }
body.usa .cb-general:hover { decorator: image(cb-usa-general-h fill); }
body.usa .cb-general:active { decorator: image(cb-usa-general-p fill); }
body.usa .cb-general.off { decorator: image(cb-usa-general-i fill); }
body.usa .cb-general.lit { decorator: image(cb-usa-general-h fill); }
body.usa .cb-minmax { decorator: image(cb-usa-minimize fill); }
body.usa .cb-minmax:hover { decorator: image(cb-usa-minimize-h fill); }
body.usa .cb-minmax:active { decorator: image(cb-usa-minimize-p fill); }
body.usa .cb-minmax.off { decorator: image(cb-usa-minimize-i fill); }
body.usa.low .cb-minmax { decorator: image(cb-usa-maximize fill); }
body.usa.low .cb-minmax:hover { decorator: image(cb-usa-maximize-h fill); }
body.usa.low .cb-minmax:active { decorator: image(cb-usa-maximize-p fill); }
body.usa.low .cb-minmax.off { decorator: image(cb-usa-maximize-i fill); }

