@media (min-aspect-ratio: 12/5)
{
	body.gla .cb-radar { decorator: ninepatch(cb-gla-frame-c, cb-gla-frame-c-in, 1); }
	body.gla .cb-unit { decorator: ninepatch(cb-gla-frame-c, cb-gla-frame-c-in, 1); }
	body.gla .cb-tab { decorator: ninepatch(cb-gla-notch, cb-gla-notch-in, 1); }
}
@media (min-aspect-ratio: 161/90)
{
	body.gla.iw-169 .cb-radar { decorator: ninepatch(cb-gla-frame-c, cb-gla-frame-c-in, 1); }
	body.gla.iw-169 .cb-unit { decorator: ninepatch(cb-gla-frame-c, cb-gla-frame-c-in, 1); }
	body.gla.iw-169 .cb-tab { decorator: ninepatch(cb-gla-notch, cb-gla-notch-in, 1); }
}

/* ---- neutral ---- */
body.neutral .cb-rail { decorator: vertical-gradient(#5C66B8 #141836); border-top: 1dp #000000; }
body.neutral .cb-wing-l { decorator: ninepatch(cb-neutral-wing-l, cb-neutral-wing-l-in, 1); }
body.neutral .cb-wing-r { decorator: ninepatch(cb-neutral-tab, cb-neutral-tab-in, 1); }
body.neutral .cb-radar { decorator: ninepatch(cb-neutral-frame-l, cb-neutral-frame-l-in, 1); }
body.neutral .cb-main { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
body.neutral .cb-unit { decorator: ninepatch(cb-neutral-frame-r, cb-neutral-frame-r-in, 1); }
body.neutral .cb-tab { decorator: ninepatch(cb-neutral-tab, cb-neutral-tab-in, 1); }
body.neutral .cb-money { decorator: ninepatch(cb-neutral-notch, cb-neutral-notch-in, 1); }
body.neutral .cb-powers, body.neutral .cb-science, body.neutral .cb-tip { decorator: ninepatch(cb-neutral-box, cb-neutral-box-in, 1); }
body.neutral .cb-plate { decorator: ninepatch(cb-neutral-plate, cb-neutral-plate-in, 1); }
body.neutral .cb-ear { decorator: ninepatch(cb-neutral-ear, cb-neutral-ear-in, 1); }
body.neutral .cb-radar-well, body.neutral .cb-power-bar, body.neutral .cb-task-bar, body.neutral .cb-exp, body.neutral .cb-sci-exp, body.neutral .cb-slot { decorator: ninepatch(cb-neutral-well, cb-neutral-well-in, 1); }
body.neutral .cb-power-ticks { decorator: image(cb-neutral-ticks fill); }
body.neutral .cb-slot.live, body.neutral .cb-side-btn, body.neutral .cb-text-btn, body.neutral .cb-portrait, body.neutral .cb-upgrade.owned { decorator: ninepatch(cb-neutral-btn-normal, cb-neutral-btn-normal-in, 1); }
body.neutral .cb-upgrade { decorator: ninepatch(cb-neutral-btn-disabled, cb-neutral-btn-disabled-in, 1); }
body.neutral .cb-slot.live:hover, body.neutral .cb-slot.live.flash, body.neutral .cb-side-btn:hover, body.neutral .cb-text-btn:hover { decorator: ninepatch(cb-neutral-btn-hover, cb-neutral-btn-hover-in, 1); }
body.neutral .cb-slot.live:active, body.neutral .cb-side-btn:active, body.neutral .cb-text-btn:active { decorator: ninepatch(cb-neutral-btn-pressed, cb-neutral-btn-pressed-in, 1); }
body.neutral .cb-slot.live.off, body.neutral .cb-side-btn.off, body.neutral .cb-text-btn.off { decorator: ninepatch(cb-neutral-btn-disabled, cb-neutral-btn-disabled-in, 1); }
body.neutral .cb-slot.live.checked, body.neutral .cb-slot.cb-sci.buy, body.neutral .cb-general.lit { decorator: ninepatch(cb-neutral-btn-checked, cb-neutral-btn-checked-in, 1); }
body.neutral .cb-power-label, body.neutral .cb-sci-tier, body.neutral .cb-beacon-label, body.neutral .cb-obs-label { color: #8E97F8; }
@media (min-aspect-ratio: 12/5)
{
	body.neutral .cb-radar { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral .cb-unit { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral .cb-tab { decorator: ninepatch(cb-neutral-notch, cb-neutral-notch-in, 1); }
}
@media (min-aspect-ratio: 161/90)
{
	body.neutral.iw-169 .cb-radar { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral.iw-169 .cb-unit { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral.iw-169 .cb-tab { decorator: ninepatch(cb-neutral-notch, cb-neutral-notch-in, 1); }
}
