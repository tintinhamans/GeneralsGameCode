/*
	ControlBar.rcss -- the in-game control bar (ControlBar.rml, RmlControlBarScreen), laid out after Control Bar
	Pro (TheSuperHackers, MIT): a radar panel bottom left, the command panel bottom centre with the money on a
	notch above it and the buttons round the bar down its left side, the selection bottom right with a tower
	over its right end (the general's tab, the powers column standing on it); the tooltip over the radar, the
	promotions over the grid. Sizes follow Pro's at 1080 lines and are in dp, so they keep the same share of
	the screen height at every resolution.

	The look is a military instrument panel in the side's metal: clean steel blue for the USA, heavy dark iron
	with red plates for China, worn tan with rust and weld wear for the GLA, blue-grey for observers (and any
	other side). Every panel is three layers:
	  .cb-skin   the plate behind everything, baked at the panel's size (scanline field, mottling, vignette)
	  content    header channels with small caps labels, the bezelled radar screen, recessed slot wells, the
	             segmented power and experience meters, buttons in metal bezels
	  .cb-frame  the two-layer bezel (dark housing, textured metal face with a groove) over the edges
	plus the side's accent plates on the rims and fins on the command panel's sides. The art is generated
	(Textures/ControlBar/cb_<faction>.png, 2 px per dp for the ninepatch pieces, 1 px per dp for the skins).

	Wide screens: the dock spans the screen up to 21:9 and is centred beyond it, the wings and the rail carrying
	the bar out to the edges. The interface width option narrows it further (body.iw-169, RmlInterfaceArea.h).
	5:4 and 4:3 move the command panel right next to a slightly smaller radar.

	Buttons (.cb-slot) are 5:4 like the cameo art: an empty slot is a recessed well with corner marks; a live
	one has the cameo in a metal bezel, the veterancy art, the clock darkening what is still to go, the hotkey
	on a badge bottom left, a count top right, and the command's border kind as a hairline along the top of
	the cameo (build blue, upgrade orange, action teal, system yellow, as the .wnd borders).
*/

body.cb
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: -1; /* under every other in-game document (menus, popups) */
	font-family: "Noto Sans";
	font-size: 15dp;
	color: #D8DDE4;
}

/* ---- The rail, the wings and the dock ------------------------------------------------------------ */
.cb-rail
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 8dp;
	pointer-events: none;
	decorator: vertical-gradient(#3A3F46 #121418);
	border-top: 1dp #06070A;
}

.cb-dock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	pointer-events: none;
}

/* Wings: the bar's extension from the screen edges to the dock's ends, shown when the dock is narrower
   than the screen. Each runs from its edge to the middle less half the dock (plus 24dp under the panel). */
.cb-wing
{
	display: none;
	position: absolute;
	bottom: 0;
	height: 26dp;
	pointer-events: none;
}

.cb-wing-l { left: 0; right: 50%; margin-right: 1266dp; }
.cb-wing-r { left: 50%; right: 0; margin-left: 1266dp; }

/* ---- Panels: skin under, frame over ------------------------------------------------------------------ */
.cb-panel
{
	display: block;
	position: absolute;
	bottom: 0;
	box-sizing: border-box;
	pointer-events: auto;
	z-index: 0; /* its own stack: the skin under the content, the frame over it */
}

.cb-skin, .cb-frame
{
	display: block;
	position: absolute;
	pointer-events: none;
}

.cb-skin { left: 6dp; top: 6dp; right: 6dp; bottom: 0; z-index: -1; }
.cb-frame { left: 0; top: 0; right: 0; bottom: 0; }

/* the side's stepped accent plates on a rim */
.cb-plate
{
	display: block;
	position: absolute;
	top: 0;
	width: 60dp;
	height: 7dp;
	pointer-events: none;
	z-index: 1; /* over the frame */
}

/* a recessed header channel and its small caps label */
.cb-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: relative;
	height: 20dp;
	margin-bottom: 6dp;
	padding: 0 22dp 0 20dp;
}

.cb-head-label, .cb-power-label, .cb-sci-tier, .cb-beacon-label, .cb-obs-label
{
	font-size: 11dp;
	line-height: 14dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
}

.cb-head-label { flex: 1 1 auto; }

.cb-head-vent, .cb-vent
{
	display: block;
	flex: 0 0 auto;
	width: 20dp;
	height: 11dp;
}

/* ---- Radar ------------------------------------------------------------------------------------------ */
.cb-radar
{
	left: 0;
	width: 332dp;
	height: 332dp;
	padding: 28dp 21dp 8dp 8dp;
}

.cb-radar .cb-skin { left: 0; }

.cb-radar-well
{
	display: block;
	position: relative;
	height: 270dp;
	box-sizing: border-box;
	background-color: #030405;
}

/* the engine draws the radar here (RmlRadarElement); the bezel's ring lies over the screen's edge */
.cb-radar-map
{
	display: block;
	position: absolute;
	left: 7dp;
	top: 7dp;
	right: 7dp;
	bottom: 7dp;
}

.cb-radar-bezel
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	pointer-events: none;
}

.cb-plate-radar { left: 110dp; }

/* under attack: the screen's edge blinks red with the .wnd's WinUAttack light */
.cb-radar.alert .cb-radar-map { border: 1dp #E04848; }
.cb-radar.alert .cb-head-label { color: #FF7060; }

/* ---- Centre: the money notch, the power channel, the side buttons and the grid ---------------------- */
.cb-centre
{
	display: block;
	position: absolute;
	left: 50%;
	bottom: 0;
	width: 772dp;
	margin-left: -386dp;
	height: 246dp;
	pointer-events: none;
}

.cb-fin
{
	display: block;
	position: absolute;
	bottom: 70dp;
	width: 6dp;
	height: 60dp;
	pointer-events: none;
}

.cb-fin-l { left: 5dp; }
.cb-fin-r { right: 5dp; }

.cb-main
{
	left: 10dp;
	width: 752dp;
	height: 212dp;
	padding: 27dp 22dp 6dp 22dp;
}

.cb-plate-ml { left: 130dp; }
.cb-plate-mr { right: 130dp; }

.cb-notch-row
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 44dp;
	pointer-events: none;
}

/* the funds on a glass readout */
.cb-money
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 220dp;
	height: 44dp;
	padding: 8dp 38dp 0 38dp;
	font-size: 22dp;
	line-height: 28dp;
	letter-spacing: 2dp;
	text-align: center;
	white-space: nowrap;
	color: #C8F060;
	font-effect: glow(0dp 4dp 0dp 0dp #9CD01C40);
	pointer-events: auto;
}

/* the power channel: label, segmented meter, value */
.cb-strip
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin-bottom: 8dp;
	padding: 0 12dp 0 12dp;
}

.cb-strip-fill { flex: 1 1 auto; }

.cb-power
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	white-space: nowrap;
}

.cb-power-label { flex: 0 0 auto; margin-right: 10dp; }

.cb-power-bar
{
	display: block;
	position: relative;
	flex: 1 1 auto;
	height: 14dp;
}

.cb-power-fill
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 2dp;
	height: 10dp;
	max-width: 100%;
	decorator: vertical-gradient(#9CC850 #5A8A26);
}

.cb-power.low-power .cb-power-fill { decorator: vertical-gradient(#E0C050 #A07E18); }
.cb-power.no-power .cb-power-fill { decorator: vertical-gradient(#E06050 #9A2418); }

.cb-power-seg
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	top: 2dp;
	height: 10dp;
}

/* the needle stands at the end of a track as long as the consumption */
.cb-power-rail
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 0;
	bottom: 0;
	max-width: 100%;
}

.cb-power-needle
{
	display: block;
	position: absolute;
	right: 0;
	top: 0;
	width: 3dp;
	height: 14dp;
	box-sizing: border-box;
	background-color: #F2F4F7;
	border: 1dp #000000;
}

.cb-power-value
{
	flex: 0 0 auto;
	min-width: 72dp;
	font-size: 15dp;
	text-align: right;
	margin-left: 10dp;
	color: #D8DDE4;
}

.cb-power.no-power .cb-power-value { color: #F07868; }
.cb-power.low-power .cb-power-value { color: #E8D070; }

/* a replay plays */
.cb-replay
{
	flex: 0 0 auto;
	height: 16dp;
	padding: 0 6dp;
	margin-left: 12dp;
	font-size: 11dp;
	line-height: 16dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #D1FD04;
	border: 1dp #D1FD0480;
}

.cb-body
{
	display: flex;
	flex-direction: row;
	height: 148dp;
}

/* Round the bar: Pro's column left of the grid. */
.cb-side
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 60dp;
	height: 148dp;
	margin-right: 4dp;
}

.cb-side-btn
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 60dp;
	height: 34dp;
	margin-bottom: 4dp;
	text-align: center;
	background-color: #0A0C0F;
	color: #B8C0CA;
}

.cb-glyph
{
	display: block;
	font-size: 16dp;
	line-height: 34dp;
}

.cb-side-btn:hover { color: #D1FD04; }
.cb-side-btn.off { color: #4A4E55; }

.cb-badge
{
	display: block;
	position: absolute;
	right: 4dp;
	top: 4dp;
	min-width: 8dp;
	height: 14dp;
	padding: 0 3dp;
	font-size: 11dp;
	line-height: 14dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #C8F060;
}

/* ButtonCommand01..14: two rows, filled a column at a time. */
.cb-grid
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-slot
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 88dp;
	height: 70dp;
	margin: 0 4dp 4dp 0;
}

.cb-slot.live { background-color: #0A0C0F; }
.cb-slot.live.flash { background-color: #34400E; }

/* the bezel's window */
.cb-win
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	right: 4dp;
	bottom: 4dp;
	overflow: hidden;
	clip: always;
}

/* the command's border kind along the top of the cameo */
.cb-slot.live.b1 .cb-win { border-top: 2dp #7088E0; }
.cb-slot.live.b2 .cb-win { border-top: 2dp #E0883A; }
.cb-slot.live.b3 .cb-win { border-top: 2dp #48C0A0; }
.cb-slot.live.b4 .cb-win { border-top: 2dp #D8C850; }

.cb-art, .cb-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-art mappedimage, .cb-vet mappedimage, .cb-portrait mappedimage, .cb-upgrade mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.cb-slot.off .cb-art img { image-color: #4E525C; }
.cb-slot.poor .cb-art img { image-color: #8E8E8E; }

/* the clock: what is still to go darkens from the top, a lit edge */
.cb-clock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	background-color: #000000A8;
	border-bottom: 1dp #C8F060B0;
}

/* the hotkey: a small dark badge bottom left, as Pro's */
.cb-key
{
	display: block;
	position: absolute;
	left: 4dp;
	bottom: 4dp;
	min-width: 11dp;
	height: 18dp;
	padding: 0 4dp;
	font-size: 15dp;
	line-height: 18dp;
	font-weight: bold;
	text-align: center;
	color: #F2F4F7;
	background-color: #05070ADC;
	border-top: 1dp #FFFFFF38;
	border-right: 1dp #FFFFFF38;
}

.cb-slot.live:hover .cb-key { color: #0E1400; background-color: #D1FD04; }
.cb-slot.off .cb-key { color: #7A808A; }

.cb-text
{
	display: block;
	position: absolute;
	right: 6dp;
	top: 5dp;
	font-size: 15dp;
	line-height: 16dp;
	font-weight: bold;
	color: #F2F4F7;
	font-effect: outline(1dp #000000E0);
}

/* Under construction and OCL timers */
.cb-task
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-slot.cb-task-slot { flex: 0 0 auto; margin: 0 20dp 0 0; }

.cb-task-info
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-task-text
{
	display: block;
	font-size: 17dp;
	line-height: 24dp;
	color: #E4E8EE;
}

.cb-task-bar
{
	display: block;
	position: relative;
	height: 14dp;
	margin-top: 10dp;
	box-sizing: border-box;
	padding: 2dp;
}

.cb-task-fill
{
	display: block;
	height: 100%;
	decorator: vertical-gradient(#9CC850 #5A8A26);
}

/* A beacon: the delete button and the message entry. */
.cb-beacon { align-items: center; }

.cb-text-btn
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 34dp;
	padding: 0 16dp;
	font-size: 13dp;
	line-height: 34dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #C8CED6;
	background-color: #0A0C0F;
}

.cb-text-btn:hover { color: #D1FD04; }
.cb-text-btn.off { color: #4A4E55; }

.cb-beacon-delete { margin-right: 20dp; }

.cb-beacon-entry
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-beacon-label { display: block; margin-bottom: 6dp; }

.cb-beacon-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

input.cb-input
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	box-sizing: border-box;
	height: 34dp;
	padding: 0 10dp;
	margin-right: 8dp;
	font-size: 16dp;
	line-height: 32dp;
	color: #E4E8EE;
	background-color: #050607;
	border: 1dp #3A3F46;
}

input.cb-input:focus { border-color: #D1FD04; }

/* ---- The tower: the powers column standing on the general's tab, over the selection's right end -------- */
.cb-tower
{
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	position: absolute;
	right: 0;
	bottom: 238dp;
	width: 108dp;
	z-index: 1;
	pointer-events: none;
}

.cb-tab
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 76dp;
	padding: 14dp 6dp 0 14dp;
	pointer-events: auto;
}

.cb-tab .cb-vent { display: none; }

.cb-rank
{
	display: block;
	width: 86dp;
	height: 22dp;
	font-size: 15dp;
	line-height: 20dp;
	letter-spacing: 2dp;
	text-align: center;
	white-space: nowrap;
	color: #FFFFFF1E;
}

.cb-star.on { color: #E8C860; font-effect: glow(0dp 3dp 0dp 0dp #E8C86040); }

.cb-side-btn.cb-general, .cb-side-btn.cb-minmax
{
	flex: 0 0 auto;
	height: 30dp;
	margin: 2dp 0 0 0;
}

.cb-side-btn.cb-general { width: 50dp; margin-right: 4dp; }
.cb-side-btn.cb-minmax { width: 32dp; }
.cb-tab-row { display: block; flex: 0 0 auto; }
.cb-general .cb-glyph, .cb-minmax .cb-glyph { font-size: 15dp; line-height: 30dp; }
.cb-general.lit { color: #D1FD04; }

.cb-powers
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	margin-bottom: 0;
	padding: 14dp 8dp 6dp 16dp;
	pointer-events: auto;
}

.cb-powers-vent { width: 78dp; height: 8dp; margin: 0 0 6dp 0; display: block; }

.cb-slot.cb-pslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 0 4dp 0;
}

/* ---- The selection ------------------------------------------------------------------------------------ */
.cb-unit
{
	right: 0;
	width: 308dp;
	height: 250dp;
	padding: 28dp 16dp 6dp 22dp;
}

.cb-unit .cb-skin { right: 0; }
.cb-plate-unit { left: 70dp; }

.cb-unit-head { padding: 0 20dp 0 12dp; margin-bottom: 6dp; height: 22dp; }

/* the side's small tag by the name */
.cb-tag
{
	display: block;
	flex: 0 0 auto;
	width: 3dp;
	height: 12dp;
	margin-right: 8dp;
}

.cb-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 13dp;
	line-height: 22dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	color: #E4E8EE;
}

.cb-count
{
	flex: 0 0 auto;
	font-size: 14dp;
	font-weight: bold;
	color: #C8F060;
	margin-left: 8dp;
}

.cb-unit-body
{
	display: flex;
	flex-direction: row;
	height: 188dp;
}

/* Pro's 3 x 3 cells, every one a well: the portrait takes four, the upgrades the right column and the bottom row */
.cb-cells
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 243dp;
	height: 188dp;
}

.cb-cell
{
	display: block;
	position: absolute;
	width: 78dp;
	height: 62dp;
}

.cb-cell0 { left: 0; top: 0; }
.cb-cell1 { left: 81dp; top: 0; }
.cb-cell2 { left: 162dp; top: 0; }
.cb-cell3 { left: 0; top: 63dp; }
.cb-cell4 { left: 81dp; top: 63dp; }
.cb-cell5 { left: 162dp; top: 63dp; }
.cb-cell6 { left: 0; top: 126dp; }
.cb-cell7 { left: 81dp; top: 126dp; }
.cb-cell8 { left: 162dp; top: 126dp; }

.cb-portrait
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 159dp;
	height: 125dp;
	background-color: #0A0C0F;
}

.cb-portrait-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.cb-upgrades
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-upgrade
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	width: 78dp;
	height: 62dp;
	background-color: #0A0C0F;
}

.cb-up0 { left: 162dp; top: 0; }
.cb-up1 { left: 162dp; top: 63dp; }
.cb-up2 { left: 162dp; top: 126dp; }
.cb-up3 { left: 81dp; top: 126dp; }
.cb-up4 { left: 0; top: 126dp; }

.cb-upgrade img { image-color: #464A52; }
.cb-upgrade.owned img { image-color: #FFFFFF; }

/* the build queue: nine cells, three by three */
.cb-queue
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	position: absolute;
	left: 0;
	top: 0;
	width: 243dp;
	height: 188dp;
}

.cb-slot.cb-qslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 3dp 1dp 0;
}

/* a movie a script plays in the portrait, over the selection */
.cb-cameo-movie
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	width: 151dp;
	height: 117dp;
	background-color: #000000;
}

/* Several things selected: how many, on the portrait's place. */
.cb-multi
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 159dp;
	height: 125dp;
	font-size: 44dp;
	line-height: 125dp;
	text-align: center;
	color: #E4E8EE;
	background-color: #0A0C0FC0;
}

.cb-multi-x { font-size: 26dp; color: #8A929C; margin-right: 4dp; }

/* Nothing selected: the side's emblem, faint and grey, on the portrait's place. */
.cb-emblem
{
	display: block;
	position: absolute;
	left: 22dp;
	top: 6dp;
	width: 114dp;
	height: 114dp;
	opacity: 0.10;
}

.cb-emblem-img { display: block; width: 114dp; height: 114dp; }
.cb-emblem img { image-color: #B0B0B0; }

/* the general's experience: Pro's upright gauge at the right edge, segmented */
.cb-exp
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 14dp;
	height: 188dp;
	margin-left: 13dp;
	box-sizing: border-box;
}

.cb-exp-fill
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	bottom: 2dp;
	max-height: 184dp;
	decorator: horizontal-gradient(#E8C860 #A8882C);
}

.cb-exp-seg
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	top: 2dp;
	bottom: 2dp;
}

/* ---- The promotions panel: over the grid, the tiers of the side's sciences ---------------------------- */
.cb-science
{
	left: 50%;
	margin-left: -268dp;
	bottom: 258dp;
	width: 536dp;
	padding: 18dp 24dp 20dp 24dp;
}

.cb-sci-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-sci-title
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 17dp;
	line-height: 26dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: #E4E8EE;
}

.cb-sci-points
{
	flex: 0 0 auto;
	height: 22dp;
	padding: 0 8dp;
	font-size: 14dp;
	line-height: 22dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #C8F060;
}

.cb-sci-star { margin-right: 4dp; }

.cb-sci-exp
{
	display: block;
	position: relative;
	height: 10dp;
	margin: 10dp 0 4dp 0;
	box-sizing: border-box;
	padding: 2dp;
}

.cb-sci-exp-fill
{
	display: block;
	height: 100%;
	decorator: vertical-gradient(#E8C860 #A8882C);
}

.cb-sci-tier
{
	display: block;
	margin: 12dp 0 6dp 0;
}

.cb-sci-row
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

/* the rank 3 tier: five columns of three, filled a column at a time like the .wnd */
.cb-sci-rank3
{
	flex-direction: column;
	height: 222dp;
	align-content: flex-start;
}

.cb-slot.cb-sci { margin: 0 6dp 4dp 0; }

.cb-owned
{
	display: block;
	position: absolute;
	right: 5dp;
	bottom: 4dp;
	font-size: 14dp;
	line-height: 14dp;
	font-weight: bold;
	color: #6CD0B0;
	font-effect: outline(1dp #000000D0);
}

.cb-sci-foot
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 10dp;
}

/* ---- Build tooltip: over the radar, where Pro puts it; it never takes the mouse ------------------------ */
.cb-tip
{
	left: 8dp;
	bottom: 344dp;
	width: 420dp;
	padding: 16dp 20dp 18dp 20dp;
	pointer-events: none;
}

.cb-tip-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-tip-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 15dp;
	line-height: 22dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #E4E8EE;
}

.cb-tip-key
{
	flex: 0 0 auto;
	min-width: 12dp;
	height: 18dp;
	padding: 0 5dp;
	margin-left: 10dp;
	font-size: 12dp;
	line-height: 18dp;
	font-weight: bold;
	text-align: center;
	color: #F2F4F7;
	background-color: #05070AE0;
	border: 1dp #FFFFFF40;
}

.cb-tip-cost
{
	display: block;
	margin-top: 4dp;
	font-size: 15dp;
	line-height: 20dp;
	color: #C8F060;
}

.cb-tip-desc
{
	display: block;
	margin-top: 8dp;
	padding-top: 8dp;
	border-top: 1dp #FFFFFF18;
	font-size: 14dp;
	line-height: 20dp;
	white-space: pre-line;
	color: #AEB6C0;
}

/* ---- Observing ------------------------------------------------------------------------------------ */
.cb-observers
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-obs-player
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: 314dp;
	height: 34dp;
	margin: 0 8dp 3dp 0;
	padding: 0 8dp 0 3dp;
	background-color: #0A0C0FE6;
	border-left: 2dp #FFFFFF22;
}

.cb-obs-player:hover { border-left-color: #D1FD04; background-color: #16181C; }

.cb-obs-side
{
	display: block;
	flex: 0 0 auto;
	width: 32dp;
	height: 26dp;
	margin-right: 8dp;
}

.cb-obs-side mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 15dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.cb-observed
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-obs-flag
{
	display: block;
	flex: 0 0 auto;
	width: 64dp;
	height: 106dp;
	margin-right: 16dp;
}

.cb-obs-flag mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-main
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-title
{
	display: block;
	font-size: 17dp;
	line-height: 24dp;
	font-weight: bold;
	letter-spacing: 1dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-bottom: 10dp;
}

.cb-obs-stats
{
	display: flex;
	flex-direction: row;
}

.cb-obs-stat
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-value
{
	display: block;
	font-size: 24dp;
	line-height: 30dp;
	color: #E4E8EE;
}

.cb-obs-label { display: block; white-space: pre-line; }

.cb-obs-back { margin: 0 4dp 0 12dp; }

/* ---- Collapsed (the min/max button, CONTROL_BAR_STAGE_LOW): the notch, the power channel, the buttons -- */
body.low .cb-radar, body.low .cb-unit, body.low .cb-powers { display: none; }
body.low .cb-main { height: 98dp; }
body.low .cb-grid, body.low .cb-task, body.low .cb-observers, body.low .cb-observed { display: none; }
body.low .cb-body { height: 40dp; }
body.low .cb-side { flex-direction: row; width: auto; height: 40dp; }
body.low .cb-side .cb-side-btn { margin: 0 6dp 0 0; }
body.low .cb-tower { bottom: 0; }
body.low .cb-fin { display: none; }
body.low .cb-tip { bottom: 140dp; }
body.low .cb-science { bottom: 140dp; }

/* ---- 5:4 and 4:3: the command panel next to the radar, which gets a little smaller ------------------- */
@media (max-aspect-ratio: 29/20)
{
	.cb-radar { width: 280dp; height: 280dp; }
	.cb-radar-well { height: 218dp; }
	.cb-centre { left: 274dp; margin-left: 0; }
	.cb-fin { display: none; }
	.cb-science { left: 390dp; margin-left: 0; }
	.cb-tip { bottom: 292dp; }
}

/* ---- Wide screens: past 21:9 (43:18, 3440x1440) the dock stops and centres; the wings carry the bar out to
   the edges. The interface width option's 21:9 is the same band, so only its 16:9 needs its own rule
   (RmlInterfaceArea.h sets body.iw-169). The radar and the selection then close their outer sides. -------- */
@media (min-aspect-ratio: 12/5)
{
	.cb-dock { left: 50%; right: auto; width: 2580dp; margin-left: -1290dp; }
	.cb-wing { display: block; }
	.cb-radar { padding-left: 16dp; }
	.cb-radar .cb-skin { left: 6dp; }
	.cb-unit .cb-skin { right: 6dp; }
	.cb-tower { right: 8dp; }
}

@media (min-aspect-ratio: 161/90)
{
	body.iw-169 .cb-dock { left: 50%; right: auto; width: 1920dp; margin-left: -960dp; }
	body.iw-169 .cb-wing { display: block; }
	body.iw-169 .cb-wing-l { margin-right: 936dp; }
	body.iw-169 .cb-wing-r { margin-left: 936dp; }
	body.iw-169 .cb-radar { padding-left: 16dp; }
	body.iw-169 .cb-radar .cb-skin { left: 6dp; }
	body.iw-169 .cb-unit .cb-skin { right: 6dp; }
	body.iw-169 .cb-tower { right: 8dp; }
}

