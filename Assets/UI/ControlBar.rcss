.cb-slot.cb-sci.off .cb-art img { image-color: #50545C; }

.cb-c0 { left: 18dp; }
.cb-c1 { left: 120dp; }
.cb-c2 { left: 222dp; }
.cb-c3 { left: 324dp; }
.cb-c4 { left: 426dp; }
.cb-r1 { top: 54dp; }
.cb-r30 { top: 178dp; }
.cb-r31 { top: 260dp; }
.cb-r32 { top: 342dp; }
.cb-r8 { top: 466dp; }

.cb-owned
{
	display: block;
	position: absolute;
	right: 5dp;
	bottom: 4dp;
	font-size: 16dp;
	line-height: 16dp;
	font-weight: bold;
	color: #7CDA5C;
	font-effect: outline(1dp #000000D0);
}

.cb-sci-close
{
	display: block;
	position: absolute;
	left: 450dp;
	top: 480dp;
	width: 60dp;
	height: 50dp;
}

/* ---- The help box: Pro's, over the radar; it never takes the mouse ------------------------------------- */
.cb-tip
{
	left: 0;
	bottom: 360dp;
	width: 512dp;
	min-height: 90dp;
	padding: 8dp 16dp 12dp 16dp;
	pointer-events: none;
}

.cb-tip-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-tip-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 16dp;
	line-height: 24dp;
	font-weight: bold;
	color: #FFFFFF;
}

.cb-tip-key
{
	flex: 0 0 auto;
	min-width: 12dp;
	height: 18dp;
	padding: 0 5dp;
	margin-left: 10dp;
	font-size: 12dp;
	line-height: 18dp;
	font-weight: bold;
	text-align: center;
	color: #F2F2E8;
	background-color: #0C0E10E0;
	border: 1dp #7D8C99;
}

.cb-tip-cost
{
	display: block;
	margin-top: 4dp;
	font-size: 15dp;
	line-height: 20dp;
	color: #F0D458;
}

.cb-tip-desc
{
	display: block;
	margin-top: 6dp;
	font-size: 14dp;
	line-height: 20dp;
	white-space: pre-line;
	color: #D0D6DC;
}

/* ---- Observers: Pro's observer bar ----------------------------------------------------------------------- */
body.neutral .cb-radar { width: 394dp; }

body.neutral .cb-main
{
	left: 327dp;
	width: 508dp;
	height: 340dp;
	margin-left: 0;
}

/* the player window is the bottom 216dp; above it the box covers the radar's button column */
body.neutral .cb-money { left: 233dp; top: 172dp; width: 260dp; height: 34dp; line-height: 34dp; text-align: right; padding-right: 4dp; box-sizing: border-box; }
body.neutral .cb-power { left: 5dp; top: 153dp; width: 490dp; }
body.neutral .cb-power-value, body.neutral .cb-replay { display: none; }
body.neutral .cb-grid, body.neutral .cb-task { display: none; }
body.neutral .cb-observers, body.neutral .cb-observed { top: 172dp; }
body.neutral .cb-obs-head { width: 228dp; }

/* the buttons in the radar's column (Pro's ButtonPlayer places), Back in the window's foot */
body.neutral .cb-side-btn { left: 7dp; width: 45dp; height: 30dp; }
body.neutral .cb-options { top: 15dp; }
body.neutral .cb-chat { top: 47dp; }
body.neutral .cb-worker { top: 79dp; }
body.neutral .cb-beacon-btn { top: 111dp; }
body.neutral .cb-back { top: 303dp; }
body.neutral .cb-side-btn.cb-minmax { left: 204dp; top: 8dp; width: 91dp; height: 31dp; }
body.neutral .cb-side-btn.cb-general { left: 204dp; top: 46dp; width: 91dp; height: 31dp; }

/* ---- Collapsed (the min/max button, CONTROL_BAR_STAGE_LOW): the panels sink into the screen's edge, leaving
   the top of the production panel (the funds, the power meter, the side buttons in a row) and the general's
   tab; their art is drawn from the top and cut at the screen's edge ------------------------------------- */
body.low .cb-radar, body.low .cb-powers, body.low .cb-unit-box { display: none; }
body.low .cb-main { height: 92dp; }
body.low .cb-grid, body.low .cb-task, body.low .cb-observers, body.low .cb-observed { display: none; }
body.low .cb-worker { left: 75dp; top: 55dp; }
body.low .cb-beacon-btn { left: 133dp; top: 55dp; }
body.low .cb-chat { left: 191dp; top: 55dp; }
body.low .cb-unit { height: 78dp; }
body.low .cb-tip { bottom: 110dp; }
body.low .cb-science { bottom: 110dp; }
body.low.neutral .cb-radar { display: block; }
body.low.neutral .cb-main { height: 340dp; }
body.low.neutral .cb-worker { left: 7dp; top: 79dp; }
body.low.neutral .cb-beacon-btn { left: 7dp; top: 111dp; }
body.low.neutral .cb-chat { left: 7dp; top: 47dp; }
body.low.neutral .cb-tip { bottom: 360dp; }

/* ---- 5:4 and 4:3: the production panel next to a slightly smaller radar --------------------------------- */
@media (max-aspect-ratio: 29/20)
{
	.cb-radar { width: 316dp; height: 316dp; }
	.cb-radar-map { left: 5dp; top: 12dp; width: 299dp; height: 299dp; }
	.cb-alarm { left: 256dp; width: 60dp; height: 60dp; }
	.cb-main { left: 316dp; margin-left: 0; }
	.cb-science { left: 412dp; margin-left: 0; }
	.cb-tip { bottom: 336dp; }
	/* the observer bar fits as it is */
	body.neutral .cb-radar { width: 394dp; height: 340dp; }
	body.neutral .cb-radar-map { left: 5dp; top: 13dp; width: 322dp; height: 322dp; }
	body.neutral .cb-main { left: 327dp; }
	body.neutral .cb-tip { bottom: 360dp; }
}

/* ---- Wide screens: past 21:9 (43:18, 3440x1440) the dock stops and centres. The interface width option's
   21:9 is the same band, so only its 16:9 needs its own rule (RmlInterfaceArea.h sets body.iw-169). ------- */
@media (min-aspect-ratio: 12/5)
{
	.cb-dock { left: 50%; right: auto; width: 2580dp; margin-left: -1290dp; }
}

@media (min-aspect-ratio: 161/90)
{
	body.iw-169 .cb-dock { left: 50%; right: auto; width: 1920dp; margin-left: -960dp; }
}

