/* ---- Skins: which sprite draws what, per faction ---------------------------------------------------- */
/* ---- usa ---- */
body.usa .cb-rail { decorator: vertical-gradient(#8CA2B8 #1E2833); border-top: 1dp #000000; }
body.usa .cb-wing-l { decorator: ninepatch(cb-usa-wing-l, cb-usa-wing-l-in, 1); }
body.usa .cb-wing-r { decorator: ninepatch(cb-usa-tab, cb-usa-tab-in, 1); }
body.usa .cb-radar { decorator: ninepatch(cb-usa-frame-l, cb-usa-frame-l-in, 1); }
body.usa .cb-main { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1); }
body.usa .cb-unit { decorator: ninepatch(cb-usa-frame-r, cb-usa-frame-r-in, 1); }
body.usa .cb-tab { decorator: ninepatch(cb-usa-tab, cb-usa-tab-in, 1); }
body.usa .cb-money { decorator: ninepatch(cb-usa-notch, cb-usa-notch-in, 1); }
body.usa .cb-powers, body.usa .cb-science, body.usa .cb-tip { decorator: ninepatch(cb-usa-box, cb-usa-box-in, 1); }
body.usa .cb-plate { decorator: ninepatch(cb-usa-plate, cb-usa-plate-in, 1); }
body.usa .cb-ear { decorator: ninepatch(cb-usa-ear, cb-usa-ear-in, 1); }
body.usa .cb-radar-well, body.usa .cb-power-bar, body.usa .cb-task-bar, body.usa .cb-exp, body.usa .cb-sci-exp, body.usa .cb-slot { decorator: ninepatch(cb-usa-well, cb-usa-well-in, 1); }
body.usa .cb-power-ticks { decorator: image(cb-usa-ticks fill); }
body.usa .cb-slot.live, body.usa .cb-side-btn, body.usa .cb-text-btn, body.usa .cb-portrait, body.usa .cb-upgrade.owned { decorator: ninepatch(cb-usa-btn-normal, cb-usa-btn-normal-in, 1); }
body.usa .cb-upgrade { decorator: ninepatch(cb-usa-btn-disabled, cb-usa-btn-disabled-in, 1); }
body.usa .cb-slot.live:hover, body.usa .cb-slot.live.flash, body.usa .cb-side-btn:hover, body.usa .cb-text-btn:hover { decorator: ninepatch(cb-usa-btn-hover, cb-usa-btn-hover-in, 1); }
