/* ---- every look ---- */
.cb-tip { decorator: image(cb-common-help-foot scale-none left bottom), image(cb-common-help scale-none left top); }
.cb-sci-close { decorator: image(cb-common-close fill); }
.cb-sci-close:hover { decorator: image(cb-common-close-h fill); }
.cb-sci-close:active { decorator: image(cb-common-close-p fill); }
body.usa .cb-exp-fill { background-color: #2C8B65; }
body.china .cb-exp-fill { background-color: #716E66; }
body.gla .cb-exp-fill { background-color: #7C3E00; }
body.neutral .cb-exp-fill { background-color: #2C8B65; }
