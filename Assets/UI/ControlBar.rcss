/* ---- Skins: which sprite draws what, per faction ---------------------------------------------------- */
/* ---- usa ---- */
body.usa .cb-wing-l { decorator: ninepatch(cb-usa-wing-l, cb-usa-wing-l-in, 1); }
body.usa .cb-wing-r { decorator: ninepatch(cb-usa-wing-r, cb-usa-wing-r-in, 1); }
body.usa .cb-radar .cb-skin { decorator: image(cb-usa-body-radar-l fill); }
body.usa .cb-radar .cb-frame { decorator: ninepatch(cb-usa-frame-l, cb-usa-frame-l-in, 1); }
body.usa .cb-radar-bezel { decorator: ninepatch(cb-usa-bezel, cb-usa-bezel-in, 1); }
body.usa .cb-main .cb-skin { decorator: image(cb-usa-body-main fill); }
body.usa .cb-main .cb-frame { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1); }
body.usa .cb-unit .cb-skin { decorator: image(cb-usa-body-unit-r fill); }
body.usa .cb-unit .cb-frame { decorator: ninepatch(cb-usa-frame-r, cb-usa-frame-r-in, 1); }
body.usa .cb-tab, body.usa .cb-powers { decorator: ninepatch(cb-usa-tower-r, cb-usa-tower-r-in, 1); }
body.usa .cb-money { decorator: ninepatch(cb-usa-notch, cb-usa-notch-in, 1); }
body.usa .cb-science, body.usa .cb-tip { decorator: ninepatch(cb-usa-box, cb-usa-box-in, 1); }
body.usa .cb-plate { decorator: ninepatch(cb-usa-plate, cb-usa-plate-in, 1); }
body.usa .cb-fin { decorator: ninepatch(cb-usa-fin, cb-usa-fin-in, 1); }
body.usa .cb-head, body.usa .cb-strip { decorator: ninepatch(cb-usa-channel, cb-usa-channel-in, 1); }
body.usa .cb-head-vent, body.usa .cb-vent { decorator: image(cb-usa-vent fill); }
body.usa .cb-tag { background-color: #96B8D8; }
body.usa .cb-head-label, body.usa .cb-power-label, body.usa .cb-sci-tier, body.usa .cb-beacon-label, body.usa .cb-obs-label { color: #8EB2CE; }
body.usa .cb-power-bar, body.usa .cb-task-bar, body.usa .cb-exp, body.usa .cb-sci-exp, body.usa .cb-slot, body.usa .cb-cell { decorator: ninepatch(cb-usa-slot, cb-usa-slot-in, 1); }
body.usa .cb-power-seg { decorator: image(cb-usa-seg-h fill); }
body.usa .cb-exp-seg { decorator: image(cb-usa-seg-v fill); }
