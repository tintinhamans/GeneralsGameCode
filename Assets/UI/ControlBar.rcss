body.usa .cb-slot.live.off, body.usa .cb-side-btn.off, body.usa .cb-text-btn.off { decorator: ninepatch(cb-usa-btn-disabled, cb-usa-btn-disabled-in, 1); }
body.usa .cb-slot.live.checked, body.usa .cb-slot.cb-sci.buy, body.usa .cb-general.lit { decorator: ninepatch(cb-usa-btn-checked, cb-usa-btn-checked-in, 1); }
body.usa .cb-power-label, body.usa .cb-sci-tier, body.usa .cb-beacon-label, body.usa .cb-obs-label { color: #8FB4D6; }
