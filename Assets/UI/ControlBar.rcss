/*
	ControlBar.rcss -- the in-game control bar (ControlBar.rml, RmlControlBarScreen), laid out after Control Bar
	Pro (TheSuperHackers, MIT): a radar panel bottom left, the command panel bottom centre with the money on a
	notch above it and the buttons round the bar down its left side, the selection bottom right with the
	general's tab over it and the powers column above that; the tooltip over the radar, the promotions over the
	grid. Sizes follow Pro's at 1080 lines and are in dp, so they keep the same share of the screen height at
	every resolution.

	The look is our own art on the faction: steel blue for the USA, red and gold for China, tan and rust for
	the GLA, the template's blue and green for observers (and any other side). The chamfered metal frames,
	inset wells, bevelled button frames, notch, tab, wings and ribbon plates are ninepatch sprites from
	Textures/ControlBar/cb_<faction>.png (generated art, 2 px per dp); fills are gradients.

	Wide screens: the dock (everything but the rail) spans the screen up to 21:9 and is centred beyond it, the
	wings and the rail carrying the bar out to the edges. The interface width option narrows it further
	(body.iw-169). 5:4 and 4:3 move the command panel right next to the radar.

	Buttons (.cb-slot) are 5:4 like the cameo art: a dark well, the cameo in the frame's window, the veterancy
	art on it, the clock sweeping down from the top with a lit edge, the hotkey on a badge bottom left, a count
	top right, and the command's border kind as a thin line along the window's top (build blue, upgrade
	orange, action teal, system yellow, as the .wnd borders).
*/

body.cb
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: -1; /* under every other in-game document (menus, popups) */
	font-family: "Noto Sans";
	font-size: 16dp;
	color: #EEF1FA;
}

/* ---- The rail and the dock ------------------------------------------------------------------------- */
.cb-rail
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 10dp;
	pointer-events: none;
}

.cb-dock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	pointer-events: none;
}

/* Wings: the bar's extension from the screen edges to the dock's ends, shown when the dock is narrower
   than the screen. Each runs from its edge to the middle less half the dock (plus 24dp under the panel). */
.cb-wing
{
	display: none;
	position: absolute;
	bottom: 0;
	height: 48dp;
	pointer-events: none;
}

.cb-wing-l { left: 0; right: 50%; margin-right: 1266dp; }
.cb-wing-r { left: 50%; right: 0; margin-left: 1266dp; }

/* ---- Panels ----------------------------------------------------------------------------------------- */
.cb-panel
{
	display: block;
	position: absolute;
	bottom: 0;
	box-sizing: border-box;
	pointer-events: auto;
}

/* the faction ribbon on a rim */
.cb-plate
{
	display: block;
	position: absolute;
	top: 1dp;
	height: 7dp;
	width: 80dp;
	pointer-events: none;
}

/* ---- Radar ------------------------------------------------------------------------------------------ */
.cb-radar
{
	left: 0;
	width: 332dp;
	height: 332dp;
	padding: 28dp 22dp 8dp 8dp;
}

.cb-plate-radar { left: 120dp; }

.cb-radar-well
{
	display: block;
	position: relative;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
	padding: 4dp;
}

/* the engine draws the radar here (RmlRadarElement) */
.cb-radar-map
{
	display: block;
	position: absolute;
	left: 4dp;
	top: 4dp;
	right: 4dp;
	bottom: 4dp;
}

/* under attack: a red line inside the well, blinking with the .wnd's WinUAttack light */
.cb-radar.alert .cb-radar-well { border: 2dp #FF5050; }

/* ---- Centre: the notch, the power strip, the side buttons and the grid ---------------------------- */
.cb-centre
{
	display: block;
	position: absolute;
	left: 50%;
	bottom: 0;
	width: 768dp;
	margin-left: -384dp;
	height: 250dp;
	pointer-events: none;
}

.cb-main
{
	left: 10dp;
	width: 748dp;
	height: 210dp;
	padding: 26dp 20dp 6dp 20dp;
}

.cb-plate-ml { left: 150dp; }

/* brackets bolted to the command panel's sides */
.cb-ear
{
	display: block;
	position: absolute;
	bottom: 94dp;
	width: 12dp;
	height: 48dp;
	pointer-events: none;
}

.cb-ear-l { left: 1dp; }
.cb-ear-r { right: 1dp; }
.cb-plate-mr { right: 150dp; }

.cb-notch-row
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 48dp;
	pointer-events: none;
}

.cb-money
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 236dp;
	height: 48dp;
	padding: 8dp 50dp 0 50dp;
	font-size: 28dp;
	line-height: 34dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-align: center;
	white-space: nowrap;
	color: #D1FD04;
	font-effect: glow(0dp 3dp 0dp 0dp #000000C0);
	pointer-events: auto;
}

.cb-strip
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin-bottom: 8dp;
}

.cb-strip-fill { flex: 1 1 auto; }

.cb-power
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	white-space: nowrap;
}

.cb-power-label
{
	flex: 0 0 auto;
	font-size: 13dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	margin-right: 10dp;
}

/* the gauge: a well, the supply fill, the scale's ticks and the consumption needle */
.cb-power-bar
{
	display: block;
	position: relative;
	flex: 1 1 auto;
	height: 20dp;
}

.cb-power-fill
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 3dp;
	height: 14dp;
	max-width: 100%;
	decorator: vertical-gradient(#E6FF6A #8FB000);
}

.cb-power.low-power .cb-power-fill { decorator: vertical-gradient(#FFF08A #C9A814); }
.cb-power.no-power .cb-power-fill { decorator: vertical-gradient(#FF8A8A #C01818); }

.cb-power-ticks
{
	display: block;
	position: absolute;
	left: 3dp;
	right: 3dp;
	top: 3dp;
	height: 14dp;
}

/* the needle stands at the end of a track as long as the consumption */
.cb-power-rail
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 0;
	bottom: 0;
	max-width: 100%;
}

.cb-power-needle
{
	display: block;
	position: absolute;
	right: 0;
	top: 0;
	width: 4dp;
	height: 20dp;
	box-sizing: border-box;
	background-color: #FFFFFF;
	border: 1dp #000000;
}

.cb-power-value
{
	flex: 0 0 auto;
	min-width: 76dp;
	font-size: 17dp;
	font-weight: bold;
	text-align: right;
	margin-left: 10dp;
	color: #EEF1FA;
}

.cb-power.no-power .cb-power-value { color: #FF7070; }
.cb-power.low-power .cb-power-value { color: #FFE680; }

/* a replay plays */
.cb-replay
{
	flex: 0 0 auto;
	height: 20dp;
	padding: 0 8dp;
	margin-left: 12dp;
	font-size: 13dp;
	line-height: 20dp;
	font-weight: bold;
	letter-spacing: 2dp;
	color: #0E1400;
	background-color: #D1FD04;
}

.cb-body
{
	display: flex;
	flex-direction: row;
	height: 148dp;
}

/* Round the bar: Pro's column left of the grid. */
.cb-side
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 60dp;
	height: 148dp;
	margin-right: 4dp;
}

.cb-side-btn
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 60dp;
	height: 34dp;
	margin-bottom: 4dp;
	text-align: center;
	background-color: #04060A;
	color: #D6DCEA;
}

.cb-glyph
{
	display: block;
	font-size: 19dp;
	line-height: 34dp;
}

.cb-side-btn:hover { color: #D1FD04; }
.cb-side-btn.off { color: #5A6072; }

.cb-badge
{
	display: block;
	position: absolute;
	right: 3dp;
	top: 3dp;
	min-width: 10dp;
	height: 16dp;
	padding: 0 4dp;
	font-size: 13dp;
	line-height: 16dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #D1FD04;
}

/* ButtonCommand01..14: two rows, filled a column at a time. */
.cb-grid
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-slot
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 88dp;
	height: 70dp;
	margin: 0 4dp 4dp 0;
}

.cb-slot.live { background-color: #04060A; }
.cb-slot.live.flash { background-color: #3A4A08; }

/* the frame's window */
.cb-win
{
	display: block;
	position: absolute;
	left: 5dp;
	top: 5dp;
	right: 5dp;
	bottom: 5dp;
	overflow: hidden;
	clip: always;
}

/* the command's border kind along the window's top */
.cb-slot.live.b1 .cb-win { border-top: 2dp #6D86FF; }
.cb-slot.live.b2 .cb-win { border-top: 2dp #F07A1A; }
.cb-slot.live.b3 .cb-win { border-top: 2dp #36D8B2; }
.cb-slot.live.b4 .cb-win { border-top: 2dp #E8D440; }

.cb-art, .cb-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-art mappedimage, .cb-vet mappedimage, .cb-portrait mappedimage, .cb-upgrade mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.cb-slot.off .cb-art img { image-color: #50546A; }
.cb-slot.poor .cb-art img { image-color: #9A9A9A; }

/* the clock: what is still to go darkens from the top, its edge lit */
.cb-clock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	decorator: vertical-gradient(#000000B8 #000000D8);
	border-bottom: 2dp #D1FD04;
}

.cb-key
{
	display: block;
	position: absolute;
	left: 6dp;
	bottom: 6dp;
	min-width: 12dp;
	height: 18dp;
	padding: 0 4dp;
	font-size: 14dp;
	line-height: 18dp;
	font-weight: bold;
	text-align: center;
	color: #FFFFFF;
	background-color: #04060AE0;
}

.cb-slot.live:hover .cb-key { color: #0E1400; background-color: #D1FD04; }
.cb-slot.off .cb-key { color: #7079A0; }

.cb-text
{
	display: block;
	position: absolute;
	right: 6dp;
	top: 6dp;
	font-size: 18dp;
	line-height: 20dp;
	font-weight: bold;
	color: #FFFFFF;
	font-effect: outline(2dp #000000);
}

/* Under construction and OCL timers */
.cb-task
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-slot.cb-task-slot { flex: 0 0 auto; margin: 0 20dp 0 0; }

.cb-task-info
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-task-text
{
	display: block;
	font-size: 22dp;
	line-height: 28dp;
	font-weight: bold;
	color: #EEF1FA;
}

.cb-task-bar
{
	display: block;
	position: relative;
	height: 20dp;
	margin-top: 12dp;
	box-sizing: border-box;
	padding: 3dp;
}

.cb-task-fill
{
	display: block;
	height: 100%;
	decorator: vertical-gradient(#E6FF6A #8FB000);
}

/* A beacon: the delete button and the message entry. */
.cb-beacon { align-items: center; }

.cb-text-btn
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 38dp;
	padding: 0 16dp;
	font-size: 16dp;
	line-height: 38dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #EEF1FA;
	background-color: #04060A;
}

.cb-text-btn:hover { color: #D1FD04; }
.cb-text-btn.off { color: #5A6072; }

.cb-beacon-delete { margin-right: 20dp; }

.cb-beacon-entry
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-beacon-label
{
	display: block;
	font-size: 14dp;
	line-height: 20dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	margin-bottom: 6dp;
}

.cb-beacon-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

input.cb-input
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	box-sizing: border-box;
	height: 38dp;
	padding: 0 10dp;
	margin-right: 8dp;
	font-size: 18dp;
	line-height: 36dp;
	color: #EEF1FA;
	background-color: #020305;
	border: 1dp #FFFFFF30;
}

input.cb-input:focus { border-color: #D1FD04; }

/* ---- The general's tab over the selection: rank, promotions, min/max ----------------------------- */
.cb-tab
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	right: 0;
	bottom: 238dp;
	box-sizing: border-box;
	height: 46dp;
	padding: 8dp 8dp 0 46dp;
	pointer-events: auto;
}

.cb-rank
{
	display: block;
	flex: 0 0 auto;
	width: 96dp;
	margin-right: 6dp;
	font-size: 18dp;
	line-height: 24dp;
	letter-spacing: 1dp;
	white-space: nowrap;
	color: #FFFFFF26;
}

.cb-star.on { color: #D1FD04; }

.cb-side-btn.cb-general, .cb-side-btn.cb-minmax
{
	flex: 0 0 auto;
	width: 52dp;
	height: 32dp;
	margin: 0 0 0 4dp;
}

.cb-side-btn.cb-minmax { width: 40dp; }
.cb-general .cb-glyph, .cb-minmax .cb-glyph { line-height: 32dp; }
.cb-general.lit { color: #0E1400; background-color: #D1FD04; }
.cb-general.lit .cb-badge { color: #D1FD04; background-color: #0E1400; }

/* ---- The selection ------------------------------------------------------------------------------------ */
.cb-unit
{
	right: 0;
	width: 308dp;
	height: 248dp;
	padding: 26dp 14dp 6dp 18dp;
}

.cb-plate-unit { left: 150dp; }

.cb-unit-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin-bottom: 4dp;
}

.cb-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 16dp;
	line-height: 22dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	color: #FFFFFF;
}

.cb-count
{
	flex: 0 0 auto;
	font-size: 16dp;
	font-weight: bold;
	color: #D1FD04;
	margin-left: 8dp;
}

.cb-unit-body
{
	display: flex;
	flex-direction: row;
	height: 188dp;
}

/* Pro's 3 x 3 cells: the portrait takes four, the upgrades the right column and the bottom row */
.cb-cells
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 243dp;
	height: 188dp;
}

.cb-portrait
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 158dp;
	height: 124dp;
	background-color: #04060A;
}

.cb-portrait .cb-win { left: 5dp; top: 5dp; right: 5dp; bottom: 5dp; }

.cb-portrait-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.cb-upgrades
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-upgrade
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	width: 78dp;
	height: 62dp;
	background-color: #04060A;
}

.cb-up0 { left: 162dp; top: 0; }
.cb-up1 { left: 162dp; top: 63dp; }
.cb-up2 { left: 162dp; top: 126dp; }
.cb-up3 { left: 81dp; top: 126dp; }
.cb-up4 { left: 0; top: 126dp; }

.cb-upgrade img { image-color: #4A4F66; }
.cb-upgrade.owned img { image-color: #FFFFFF; }

/* the build queue: nine cells, three by three */
.cb-queue
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	position: absolute;
	left: 0;
	top: 0;
	width: 243dp;
	height: 188dp;
}

.cb-slot.cb-qslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 3dp 1dp 0;
}

/* a movie a script plays in the portrait, over the selection */
.cb-cameo-movie
{
	display: block;
	position: absolute;
	left: 5dp;
	top: 5dp;
	width: 148dp;
	height: 114dp;
	background-color: #000000;
}

/* Several things selected: how many. */
.cb-multi
{
	display: block;
	position: absolute;
	left: 0;
	top: 20dp;
	width: 240dp;
	font-size: 64dp;
	line-height: 120dp;
	font-weight: bold;
	text-align: center;
	color: #EEF1FA;
}

.cb-multi-x { font-size: 40dp; color: #D1FD04; margin-right: 4dp; }

/* Nothing selected: the side's emblem, faint. */
.cb-emblem
{
	display: block;
	position: absolute;
	left: 50dp;
	top: 24dp;
	width: 140dp;
	height: 140dp;
	opacity: 0.16;
}

.cb-emblem-img { display: block; width: 140dp; height: 140dp; }

/* the general's experience: Pro's upright gauge at the right edge */
.cb-exp
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 18dp;
	height: 188dp;
	margin-left: 12dp;
	box-sizing: border-box;
	padding: 3dp;
}

.cb-exp-fill
{
	display: block;
	position: absolute;
	left: 3dp;
	right: 3dp;
	bottom: 3dp;
	max-height: 182dp;
	decorator: vertical-gradient(#E6FF6A #8FB000);
}

.cb-exp-marks
{
	display: block;
	position: absolute;
	left: 3dp;
	right: 3dp;
	top: 3dp;
	bottom: 3dp;
	border-top: 1dp #00000000;
}

/* ---- The general's powers: a column at the right edge above the tab ------------------------------------ */
.cb-powers
{
	right: 0;
	bottom: 292dp;
	width: 104dp;
	padding: 16dp 10dp 10dp 16dp;
}

.cb-slot.cb-pslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 0 4dp 0;
}

/* ready count: the bigger number */
.cb-pslot .cb-text { color: #D1FD04; }

/* ---- The promotions panel: over the grid, the tiers of the side's sciences ---------------------------- */
.cb-science
{
	left: 50%;
	margin-left: -268dp;
	bottom: 252dp;
	width: 536dp;
	padding: 18dp 24dp 20dp 24dp;
}

.cb-sci-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-sci-title
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 24dp;
	line-height: 30dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #FFFFFF;
}

.cb-sci-points
{
	flex: 0 0 auto;
	height: 28dp;
	padding: 0 10dp;
	font-size: 19dp;
	line-height: 28dp;
	font-weight: bold;
	color: #0E1400;
	background-color: #D1FD04;
}

.cb-sci-star { margin-right: 4dp; }

.cb-sci-exp
{
	display: block;
	height: 12dp;
	margin: 10dp 0 4dp 0;
	box-sizing: border-box;
	padding: 3dp;
}

.cb-sci-exp-fill
{
	display: block;
	height: 100%;
	decorator: vertical-gradient(#E6FF6A #8FB000);
}

.cb-sci-tier
{
	display: block;
	margin: 12dp 0 6dp 0;
	font-size: 14dp;
	line-height: 18dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
}

.cb-sci-row
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

/* the rank 3 tier: five columns of three, filled a column at a time like the .wnd */
.cb-sci-rank3
{
	flex-direction: column;
	height: 222dp;
	align-content: flex-start;
}

.cb-slot.cb-sci { margin: 0 6dp 4dp 0; }
.cb-slot.cb-sci.buy { background-color: #2A3310; }

.cb-owned
{
	display: block;
	position: absolute;
	right: 5dp;
	bottom: 5dp;
	width: 20dp;
	height: 20dp;
	font-size: 15dp;
	line-height: 20dp;
	font-weight: bold;
	text-align: center;
	color: #04120E;
	background-color: #36D8B2;
}

.cb-sci-foot
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 10dp;
}

/* ---- Build tooltip: over the radar, where Pro puts it; it never takes the mouse ------------------------ */
.cb-tip
{
	left: 8dp;
	bottom: 344dp;
	width: 440dp;
	padding: 16dp 20dp 18dp 20dp;
	pointer-events: none;
}

.cb-tip-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-tip-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 20dp;
	line-height: 26dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	color: #FFFFFF;
}

.cb-tip-key
{
	flex: 0 0 auto;
	min-width: 16dp;
	height: 24dp;
	padding: 0 6dp;
	margin-left: 10dp;
	font-size: 16dp;
	line-height: 24dp;
	font-weight: bold;
	text-align: center;
	color: #0E1400;
	background-color: #D1FD04;
}

.cb-tip-cost
{
	display: block;
	margin-top: 4dp;
	font-size: 18dp;
	line-height: 24dp;
	font-weight: bold;
	color: #D1FD04;
}

.cb-tip-desc
{
	display: block;
	margin-top: 8dp;
	padding-top: 8dp;
	border-top: 1dp #FFFFFF22;
	font-size: 17dp;
	line-height: 22dp;
	white-space: pre-line;
	color: #C4CAD8;
}

/* ---- Observing ------------------------------------------------------------------------------------ */
.cb-observers
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-obs-player
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: 312dp;
	height: 34dp;
	margin: 0 8dp 3dp 0;
	padding: 0 8dp 0 3dp;
	background-color: #04060AE0;
	border-left: 3dp #FFFFFF30;
}

.cb-obs-player:hover { border-left-color: #D1FD04; background-color: #1A2208; }

.cb-obs-side
{
	display: block;
	flex: 0 0 auto;
	width: 34dp;
	height: 28dp;
	margin-right: 8dp;
}

.cb-obs-side mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 16dp;
	line-height: 22dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.cb-observed
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-obs-flag
{
	display: block;
	flex: 0 0 auto;
	width: 72dp;
	height: 120dp;
	margin-right: 16dp;
}

.cb-obs-flag mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-main
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-title
{
	display: block;
	font-size: 22dp;
	line-height: 28dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-bottom: 10dp;
}

.cb-obs-stats
{
	display: flex;
	flex-direction: row;
}

.cb-obs-stat
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-value
{
	display: block;
	font-size: 28dp;
	line-height: 32dp;
	font-weight: bold;
	color: #D1FD04;
}

.cb-obs-label
{
	display: block;
	white-space: pre-line;
	font-size: 13dp;
	line-height: 16dp;
	font-weight: bold;
	text-transform: uppercase;
}

.cb-obs-back { margin: 0 4dp 0 12dp; }

/* ---- Collapsed (the min/max button, CONTROL_BAR_STAGE_LOW): the notch, the power strip, the buttons ---- */
body.low .cb-radar, body.low .cb-unit, body.low .cb-powers { display: none; }
body.low .cb-main { height: 96dp; }
body.low .cb-grid, body.low .cb-task, body.low .cb-observers, body.low .cb-observed { display: none; }
body.low .cb-body { height: 40dp; }
body.low .cb-side { flex-direction: row; width: auto; height: 40dp; }
body.low .cb-side-btn { margin: 0 6dp 0 0; }
body.low .cb-tab { bottom: 0; }
body.low .cb-tip { bottom: 140dp; }
body.low .cb-science { bottom: 140dp; }

/* ---- 5:4 and 4:3: the command panel next to the radar, which gets a little smaller ------------------- */
@media (max-aspect-ratio: 29/20)
{
	.cb-radar { width: 280dp; height: 280dp; }
	.cb-centre { left: 274dp; margin-left: 0; }
	.cb-ear { display: none; }
	.cb-science { left: 390dp; margin-left: 0; }
	.cb-tip { bottom: 292dp; }
}

/* ---- Wide screens: past 21:9 (43:18, 3440x1440) the dock stops and centres; the wings carry the bar out to
   the edges. The interface width option's 21:9 is the same band, so only its 16:9 needs its own rule
   (RmlUiManager's body.iw-169). ------------------------------------------------------------------------ */
@media (min-aspect-ratio: 12/5)
{
	.cb-dock { left: 50%; right: auto; width: 2580dp; margin-left: -1290dp; }
	.cb-wing { display: block; }
}

@media (min-aspect-ratio: 161/90)
{
	body.iw-169 .cb-dock { left: 50%; right: auto; width: 1920dp; margin-left: -960dp; }
	body.iw-169 .cb-wing { display: block; }
	body.iw-169 .cb-wing-l { margin-right: 936dp; }
	body.iw-169 .cb-wing-r { margin-left: 936dp; }
}

