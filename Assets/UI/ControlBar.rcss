body.china .cb-power-bar, body.china .cb-task-bar, body.china .cb-exp, body.china .cb-sci-exp, body.china .cb-slot, body.china .cb-cell { decorator: ninepatch(cb-china-slot, cb-china-slot-in, 1); }
