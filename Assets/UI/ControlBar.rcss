/*
	ControlBar.rcss -- the in-game control bar (ControlBar.rml, RmlControlBarScreen) in Control Bar Pro's art and
	layout (TheSuperHackers/GeneralsControlBar, MIT; see Textures/ControlBar/README.md): the radar bottom left, the
	production panel bottom centre (the funds in its notch, the power meter, the buttons down its left side and
	the command grid in its wells), the selection bottom right under the general's tab, the general's powers in
	trays up the right edge, the promotions window over the grid and the help box over the radar. Observers get
	Pro's observer bar: a wider radar with a button column and the player window beside it.

	Every piece is one image at Pro's size (its 3840x2160 art at 2 px per dp), and everything on it sits where
	Pro's .wnd and ControlBarScheme.ini put it, in dp from the piece's top left. Nothing here sets a z-index:
	the pieces and what is on them stack in document order.

	Wide screens: the dock spans the screen up to 21:9 and is centred beyond it; the interface width option's
	16:9 narrows it further (body.iw-169, RmlInterfaceArea.h). 5:4 and 4:3 move the production panel right next
	to a slightly smaller radar.

	Buttons (.cb-slot): the cameo with a hairline in the command's border kind (Pro's scheme colours: build
	blue, upgrade orange, action green, system yellow), the veterancy art, the clock darkening what is still to
	go, the hotkey on a small dark plate bottom left and a count top right.
*/

body.cb
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: -1; /* under every other in-game document (menus, popups) */
	font-family: "Noto Sans";
	font-size: 15dp;
	color: #E6E8EA;
}

.cb-dock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	pointer-events: none;
}

.cb-panel
{
	display: block;
	position: absolute;
	bottom: 0;
	box-sizing: border-box;
	pointer-events: auto;
}

/* ---- Radar ------------------------------------------------------------------------------------------ */
.cb-radar
{
	left: 0;
	width: 340dp;
	height: 340dp;
}

/* the engine draws the radar here (RmlRadarElement): Pro's LeftHUD */
.cb-radar-map
{
	display: block;
	position: absolute;
	left: 5dp;
	top: 13dp;
	width: 322dp;
	height: 322dp;
}

/* under attack: Pro's corner light */
.cb-alarm
{
	display: block;
	position: absolute;
	left: 276dp;
	top: 0;
	width: 64dp;
	height: 64dp;
	pointer-events: none;
}

/* ---- Production: the funds, the power meter, the side buttons and the grid ------------------------------ */
.cb-main
{
	left: 50%;
	width: 734dp;
	height: 210dp;
	margin-left: -367dp;
	pointer-events: none;
}

.cb-money
{
	display: block;
	position: absolute;
	left: 302dp;
	top: 9dp;
	width: 132dp;
	height: 25dp;
	font-size: 17dp;
	line-height: 25dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-align: center;
	white-space: nowrap;
	color: #F2F2E8;
	pointer-events: auto;
}

/* the power meter: what is made, and the needle at what is used */
.cb-power
{
	display: block;
	position: absolute;
	left: 13dp;
	top: 34dp;
	width: 708dp;
	height: 14dp;
	pointer-events: auto;
}

.cb-power-fill
{
	display: block;
	position: absolute;
	left: 0;
	top: 2dp;
	height: 10dp;
	max-width: 100%;
	decorator: vertical-gradient(#7CDA5C #2F8A2C);
}

.cb-power.low-power .cb-power-fill { decorator: vertical-gradient(#F0D458 #A88A1C); }
.cb-power.no-power .cb-power-fill { decorator: vertical-gradient(#F06A50 #9A2A1C); }

.cb-power-rail
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	max-width: 100%;
}

.cb-power-needle
{
	display: block;
	position: absolute;
	right: -1dp;
	top: 0;
	width: 3dp;
	height: 14dp;
	box-sizing: border-box;
	background-color: #F2F4F7;
	border: 1dp #000000;
}

/* the figures, over the battlefield left of the notch */
.cb-power-value
{
	display: block;
	position: absolute;
	left: 13dp;
	top: 4dp;
	width: 272dp;
	height: 22dp;
	font-size: 13dp;
	line-height: 22dp;
	font-weight: bold;
	text-align: right;
	white-space: nowrap;
	color: #D8DCD0;
	font-effect: outline(1dp #000000E0);
}

.cb-power-value.low-power { color: #F0D458; }
.cb-power-value.no-power { color: #F07A60; }

/* a replay plays: right of the notch */
.cb-replay
{
	display: block;
	position: absolute;
	left: 450dp;
	top: 6dp;
	height: 18dp;
	padding: 0 6dp;
	font-size: 11dp;
	line-height: 18dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #F2F2E8;
	background-color: #0C0E10D0;
	border: 1dp #7D8C99;
}

/* Options, idle workers, beacon, diplomacy: Pro's buttons down the panel's left side */
.cb-side-btn
{
	display: block;
	position: absolute;
	width: 54dp;
	height: 35dp;
	pointer-events: auto;
}

.cb-options { left: 17dp; top: 55dp; }
.cb-worker { left: 17dp; top: 92dp; }
.cb-beacon-btn { left: 17dp; top: 129dp; }
.cb-chat { left: 17dp; top: 166dp; }

.cb-badge
{
	display: block;
	position: absolute;
	right: 2dp;
	top: 2dp;
	min-width: 8dp;
	height: 14dp;
	padding: 0 3dp;
	font-size: 11dp;
	line-height: 14dp;
	font-weight: bold;
	text-align: center;
	color: #FFFFFF;
	background-color: #0C0E10E6;
	border: 1dp #7D8C99;
}

/* ButtonCommand01..14: two rows in the panel's wells, filled a column at a time */
.cb-grid
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	position: absolute;
	left: 76dp;
	top: 56dp;
	width: 644dp;
	height: 148dp;
	pointer-events: auto;
}

.cb-slot
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 88dp;
	height: 70dp;
	margin: 0 4dp 4dp 0;
}

/* the cameo's window; its hairline is the command's border kind */
.cb-win
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	overflow: hidden;
	clip: always;
}

.cb-slot.live .cb-win { border: 1dp #000000; }
.cb-slot.live.b1 .cb-win { border-color: #5B92FF; }
.cb-slot.live.b2 .cb-win { border-color: #D06C00; }
.cb-slot.live.b3 .cb-win { border-color: #00DE01; }
.cb-slot.live.b4 .cb-win { border-color: #FFF005; }

.cb-art, .cb-vet, .cb-hl
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-art mappedimage, .cb-vet mappedimage, .cb-portrait mappedimage, .cb-upgrade mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.cb-slot.off .cb-art img { image-color: #50545C; }
.cb-slot.poor .cb-art img { image-color: #8E8E8E; }

/* the clock: what is still to go darkens from the top */
.cb-clock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	background-color: #000000A0;
	border-bottom: 1dp #FFFFFF60;
}

/* the light over the cameo: hover, pressed, flashing, checked */
.cb-slot.live:hover .cb-hl { background-color: #FFFFFF2C; }
.cb-slot.live:active .cb-hl { background-color: #00000060; }
.cb-slot.live.flash .cb-hl { background-color: #FFFFFF40; }
.cb-slot.live.checked .cb-hl { border: 2dp #FFF005; }
.cb-slot.live.off:hover .cb-hl { background-color: transparent; }

/* the hotkey: a small dark plate with a steel edge, bottom left */
.cb-key
{
	display: block;
	position: absolute;
	left: 3dp;
	bottom: 3dp;
	min-width: 9dp;
	height: 15dp;
	padding: 0 3dp;
	font-size: 12dp;
	line-height: 15dp;
	font-weight: bold;
	text-align: center;
	color: #F2F2E8;
	background-color: #0C0E10E0;
	border: 1dp #7D8C99;
}

.cb-slot.live:hover .cb-key { border-color: #E6EAEE; }
.cb-slot.off .cb-key { color: #8A9098; border-color: #4A525A; }

.cb-text
{
	display: block;
	position: absolute;
	right: 5dp;
	top: 4dp;
	font-size: 15dp;
	line-height: 16dp;
	font-weight: bold;
	color: #FFFFFF;
	font-effect: outline(1dp #000000E0);
}

/* Under construction, OCL timers and beacons: Pro's dark overlay over the grid (the side buttons stay usable) */
.cb-task
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	left: 74dp;
	top: 51dp;
	width: 647dp;
	height: 154dp;
	box-sizing: border-box;
	padding: 0 32dp 0 40dp;
	background-color: #0A0C0EB8;
	pointer-events: auto;
}

.cb-slot.cb-task-slot { flex: 0 0 auto; margin: 0 20dp 0 0; }

.cb-task-info
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-task-text
{
	display: block;
	font-size: 17dp;
	line-height: 24dp;
	color: #E6E8EA;
}

.cb-task-bar
{
	display: block;
	position: relative;
	height: 15dp;
	margin-top: 10dp;
	box-sizing: border-box;
	padding: 2dp;
	background-color: #000000;
	border: 1dp #5A6670;
}

.cb-task-fill
{
	display: block;
	height: 100%;
	decorator: vertical-gradient(#7CDA5C #2F8A2C);
}

.cb-text-btn
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 35dp;
	padding: 0 16dp;
	font-size: 13dp;
	line-height: 33dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #E6E8EA;
	decorator: vertical-gradient(#4A5660 #262E34);
	border: 1dp #8A98A4;
}

.cb-text-btn:hover { decorator: vertical-gradient(#5E6C78 #323C44); color: #FFFFFF; }
.cb-text-btn:active { decorator: vertical-gradient(#1E2428 #343E46); }
.cb-text-btn.off { color: #6A7078; border-color: #4A525A; }

.cb-beacon-delete { margin-right: 20dp; }

.cb-beacon-entry
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-beacon-label
{
	display: block;
	margin-bottom: 6dp;
	font-size: 12dp;
	line-height: 14dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #AEB6BE;
}

.cb-beacon-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

input.cb-input
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	box-sizing: border-box;
	height: 35dp;
	padding: 0 10dp;
	margin-right: 8dp;
	font-size: 16dp;
	line-height: 33dp;
	color: #E6E8EA;
	background-color: #050607;
	border: 1dp #5A6670;
}

input.cb-input:focus { border-color: #C8D4DE; }

/* ---- Observing: Pro's player window beside the radar ----------------------------------------------------- */
.cb-observers
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	position: absolute;
	left: 7dp;
	top: 48dp;
	width: 488dp;
	height: 122dp;
	pointer-events: auto;
}

.cb-obs-player
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: 242dp;
	height: 29dp;
	margin: 0 2dp 1dp 0;
	padding: 0 6dp 0 3dp;
}

.cb-obs-player:hover { background-color: #FFFFFF18; }

.cb-obs-side
{
	display: block;
	flex: 0 0 auto;
	width: 34dp;
	height: 23dp;
	margin-right: 8dp;
}

.cb-obs-side mappedimage, .cb-obs-flag mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 15dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.cb-observed
{
	display: block;
	position: absolute;
	left: 7dp;
	top: 48dp;
	width: 488dp;
	height: 122dp;
}

.cb-obs-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 362dp;
	height: 34dp;
}

.cb-obs-flag
{
	display: block;
	flex: 0 0 auto;
	width: 40dp;
	height: 26dp;
	margin: 0 8dp 0 2dp;
}

.cb-obs-title
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 17dp;
	line-height: 24dp;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.cb-obs-stats
{
	display: flex;
	flex-direction: row;
	margin-top: 2dp;
}

.cb-obs-stat
{
	display: block;
	width: 120dp;
	margin-right: 2dp;
	text-align: center;
}

.cb-obs-label
{
	display: block;
	height: 50dp;
	font-size: 12dp;
	line-height: 16dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	white-space: pre-line;
	color: #AEB6BE;
	padding-top: 8dp;
	box-sizing: border-box;
}

.cb-obs-value
{
	display: block;
	height: 34dp;
	font-size: 22dp;
	line-height: 34dp;
	color: #F2F2E8;
}

/* ---- The selection ------------------------------------------------------------------------------------ */
.cb-unit
{
	right: 0;
	width: 295dp;
	height: 286dp;
	pointer-events: none;
}

/* name and rank, over the battlefield left of the general's tab */
.cb-unit-head
{
	display: block;
	position: absolute;
	left: 0;
	top: 6dp;
	width: 196dp;
	height: 68dp;
	font-effect: outline(1dp #000000E0);
}

.cb-name
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 4dp;
	height: 24dp;
	font-size: 14dp;
	line-height: 24dp;
	font-weight: bold;
	letter-spacing: 1dp;
	text-transform: uppercase;
	text-align: right;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	color: #F2F2E8;
}

.cb-count { margin-left: 8dp; color: #C8CED6; }

.cb-rank
{
	display: block;
	position: absolute;
	right: 0;
	top: 40dp;
	height: 22dp;
	font-size: 16dp;
	line-height: 22dp;
	letter-spacing: 2dp;
	white-space: nowrap;
	color: #FFFFFF38;
	pointer-events: auto;
}

.cb-star.on { color: #FFD84A; }

/* the general's tab: min/max and the promotions */
.cb-side-btn.cb-minmax { left: 204dp; top: 8dp; width: 91dp; height: 31dp; }
.cb-side-btn.cb-general { left: 204dp; top: 46dp; width: 91dp; height: 31dp; }

.cb-unit-box
{
	display: block;
	position: absolute;
	left: 0;
	top: 76dp;
	width: 295dp;
	height: 210dp;
	pointer-events: auto;
}

/* Nothing selected: the side's logo (Pro's RightHUDImage) */
.cb-emblem
{
	display: block;
	position: absolute;
	left: 17dp;
	top: 17dp;
	width: 229dp;
	height: 184dp;
}

/* Several things selected: how many, on the portrait's place */
.cb-multi
{
	display: block;
	position: absolute;
	left: 18dp;
	top: 18dp;
	width: 151dp;
	height: 121dp;
	font-size: 44dp;
	line-height: 121dp;
	text-align: center;
	color: #F2F2E8;
}

.cb-multi-x { font-size: 26dp; color: #9AA2AC; margin-right: 4dp; }

.cb-portrait
{
	display: block;
	position: absolute;
	left: 18dp;
	top: 18dp;
	width: 151dp;
	height: 121dp;
}

.cb-portrait .cb-win { border: 1dp #000000; }

.cb-portrait-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.cb-upgrades
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-upgrade
{
	display: block;
	position: absolute;
	width: 75dp;
	height: 60dp;
}

.cb-upgrade .cb-win { border: 1dp #000000; }
.cb-up0 { left: 170dp; top: 18dp; }
.cb-up1 { left: 170dp; top: 79dp; }
.cb-up2 { left: 170dp; top: 140dp; }
.cb-up3 { left: 94dp; top: 140dp; }
.cb-up4 { left: 18dp; top: 140dp; }

.cb-upgrade img { image-color: #4A4E56; }
.cb-upgrade.owned img { image-color: #FFFFFF; }

/* the build queue: Pro's nine cells, three by three */
.cb-queue
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-slot.cb-qslot
{
	position: absolute;
	width: 75dp;
	height: 60dp;
	margin: 0;
}

.cb-cell0 { left: 18dp; top: 18dp; }
.cb-cell1 { left: 94dp; top: 18dp; }
.cb-cell2 { left: 170dp; top: 18dp; }
.cb-cell3 { left: 18dp; top: 79dp; }
.cb-cell4 { left: 94dp; top: 79dp; }
.cb-cell5 { left: 170dp; top: 79dp; }
.cb-cell6 { left: 18dp; top: 140dp; }
.cb-cell7 { left: 94dp; top: 140dp; }
.cb-cell8 { left: 170dp; top: 140dp; }

/* a movie a script plays in the portrait */
.cb-cameo-movie
{
	display: block;
	position: absolute;
	left: 18dp;
	top: 18dp;
	width: 151dp;
	height: 121dp;
	background-color: #000000;
}

/* the general's experience: Pro's gauge, filling from the bottom under its frame */
.cb-exp
{
	display: block;
	position: absolute;
	left: 250dp;
	top: 17dp;
	width: 36dp;
	height: 184dp;
}

.cb-exp-well
{
	display: block;
	position: absolute;
	left: 5dp;
	top: 36dp;
	width: 26dp;
	height: 140dp;
}

.cb-exp-fill
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	max-height: 100%;
}

.cb-exp-fg
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

/* ---- The general's powers: Pro's trays up the right edge, the lowest the largest ------------------------- */
.cb-powers
{
	display: block;
	position: absolute;
	right: 0;
	top: 0;
	bottom: 0;
	width: 119dp;
	pointer-events: none;
}

.cb-tray
{
	display: block;
	position: absolute;
	right: 0;
	width: 119dp;
	height: 92dp;
	pointer-events: auto;
}

.cb-tray0 { bottom: 292dp; height: 110dp; }
.cb-tray1 { bottom: 379dp; }
.cb-tray2 { bottom: 448dp; }
.cb-tray3 { bottom: 517dp; }
.cb-tray4 { bottom: 586dp; }
.cb-tray5 { bottom: 655dp; }
.cb-tray6 { bottom: 724dp; }
.cb-tray7 { bottom: 793dp; }
.cb-tray8 { bottom: 862dp; }
.cb-tray9 { bottom: 931dp; }
.cb-tray10 { bottom: 1000dp; }

.cb-slot.cb-pslot
{
	position: absolute;
	left: 35dp;
	top: 25dp;
	width: 75dp;
	height: 60dp;
	margin: 0;
}

/* ---- The promotions: Pro's window over the grid --------------------------------------------------------- */
.cb-science
{
	left: 50%;
	margin-left: -271dp;
	bottom: 302dp;
	width: 542dp;
	height: 598dp;
}

.cb-sci-tier, .cb-sci-title
{
	display: block;
	position: absolute;
	height: 28dp;
	font-size: 13dp;
	line-height: 28dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	text-align: center;
	white-space: nowrap;
	color: #C8D0D8;
}

.cb-sci-t1 { left: 13dp; top: 17dp; width: 516dp; }
.cb-sci-t3 { left: 17dp; top: 141dp; width: 508dp; }
.cb-sci-t8 { left: 17dp; top: 429dp; width: 508dp; }
.cb-sci-title { left: 13dp; top: 553dp; width: 516dp; font-size: 15dp; color: #F2F2E8; }

.cb-sci-points
{
	display: block;
	position: absolute;
	left: 450dp;
	top: 68dp;
	width: 60dp;
	height: 50dp;
	font-size: 24dp;
	line-height: 50dp;
