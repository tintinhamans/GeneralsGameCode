/* ---- Skins: which sprite draws what, per faction ---------------------------------------------------- */
/* ---- usa ---- */
body.usa .cb-wing-l { decorator: ninepatch(cb-usa-wing-l, cb-usa-wing-l-in, 1); }
body.usa .cb-wing-r { decorator: ninepatch(cb-usa-wing-r, cb-usa-wing-r-in, 1); }
body.usa .cb-radar { decorator: ninepatch(cb-usa-frame-l, cb-usa-frame-l-in, 1), image(cb-usa-body-radar-l fill); }
body.usa .cb-radar-bezel { decorator: ninepatch(cb-usa-bezel, cb-usa-bezel-in, 1); }
body.usa .cb-main { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1), image(cb-usa-body-main fill); }
body.usa .cb-unit { decorator: ninepatch(cb-usa-frame-r, cb-usa-frame-r-in, 1), image(cb-usa-body-unit-r fill); }
body.usa .cb-tower { decorator: ninepatch(cb-usa-tower-r, cb-usa-tower-r-in, 1); }
body.usa .cb-money { decorator: ninepatch(cb-usa-inset, cb-usa-inset-in, 1); }
body.usa .cb-science, body.usa .cb-tip { decorator: ninepatch(cb-usa-box, cb-usa-box-in, 1); }
body.usa .cb-power-bar, body.usa .cb-task-bar, body.usa .cb-exp, body.usa .cb-sci-exp, body.usa .cb-slot, body.usa .cb-cell { decorator: ninepatch(cb-usa-slot, cb-usa-slot-in, 1); }
body.usa .cb-power-seg { decorator: image(cb-usa-seg-h fill); }
body.usa .cb-exp-seg { decorator: image(cb-usa-seg-v fill); }
body.usa .cb-slot.live, body.usa .cb-side-btn, body.usa .cb-text-btn, body.usa .cb-portrait, body.usa .cb-upgrade.owned { decorator: ninepatch(cb-usa-btn-normal, cb-usa-btn-normal-in, 1); }
body.usa .cb-upgrade { decorator: ninepatch(cb-usa-btn-disabled, cb-usa-btn-disabled-in, 1); }
body.usa .cb-slot.live:hover, body.usa .cb-slot.live.flash, body.usa .cb-side-btn:hover, body.usa .cb-text-btn:hover { decorator: ninepatch(cb-usa-btn-hover, cb-usa-btn-hover-in, 1); }
body.usa .cb-slot.live:active, body.usa .cb-side-btn:active, body.usa .cb-text-btn:active { decorator: ninepatch(cb-usa-btn-pressed, cb-usa-btn-pressed-in, 1); }
body.usa .cb-slot.live.off, body.usa .cb-side-btn.off, body.usa .cb-text-btn.off { decorator: ninepatch(cb-usa-btn-disabled, cb-usa-btn-disabled-in, 1); }
body.usa .cb-slot.live.checked { decorator: ninepatch(cb-usa-btn-checked, cb-usa-btn-checked-in, 1); }
body.usa .cb-slot.cb-sci.buy, body.usa .cb-general.lit { decorator: ninepatch(cb-usa-btn-hover, cb-usa-btn-hover-in, 1); }
@media (min-aspect-ratio: 12/5)
{
	body.usa .cb-radar { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1), image(cb-usa-body-radar-c fill); }
	body.usa .cb-unit { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1), image(cb-usa-body-unit-c fill); }
	body.usa .cb-tower { decorator: ninepatch(cb-usa-tower-c, cb-usa-tower-c-in, 1); }
}
@media (min-aspect-ratio: 161/90)
{
	body.usa.iw-169 .cb-radar { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1), image(cb-usa-body-radar-c fill); }
	body.usa.iw-169 .cb-unit { decorator: ninepatch(cb-usa-frame-c, cb-usa-frame-c-in, 1), image(cb-usa-body-unit-c fill); }
	body.usa.iw-169 .cb-tower { decorator: ninepatch(cb-usa-tower-c, cb-usa-tower-c-in, 1); }
}

/* ---- china ---- */
body.china .cb-wing-l { decorator: ninepatch(cb-china-wing-l, cb-china-wing-l-in, 1); }
body.china .cb-wing-r { decorator: ninepatch(cb-china-wing-r, cb-china-wing-r-in, 1); }
