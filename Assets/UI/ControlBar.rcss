body.china .cb-exp-seg { decorator: image(cb-china-seg-v fill); }
body.china .cb-slot.live, body.china .cb-side-btn, body.china .cb-text-btn, body.china .cb-portrait, body.china .cb-upgrade.owned { decorator: ninepatch(cb-china-btn-normal, cb-china-btn-normal-in, 1); }
body.china .cb-upgrade { decorator: ninepatch(cb-china-btn-disabled, cb-china-btn-disabled-in, 1); }
body.china .cb-slot.live:hover, body.china .cb-slot.live.flash, body.china .cb-side-btn:hover, body.china .cb-text-btn:hover { decorator: ninepatch(cb-china-btn-hover, cb-china-btn-hover-in, 1); }
body.china .cb-slot.live:active, body.china .cb-side-btn:active, body.china .cb-text-btn:active { decorator: ninepatch(cb-china-btn-pressed, cb-china-btn-pressed-in, 1); }
body.china .cb-slot.live.off, body.china .cb-side-btn.off, body.china .cb-text-btn.off { decorator: ninepatch(cb-china-btn-disabled, cb-china-btn-disabled-in, 1); }
body.china .cb-slot.live.checked { decorator: ninepatch(cb-china-btn-checked, cb-china-btn-checked-in, 1); }
body.china .cb-slot.cb-sci.buy, body.china .cb-general.lit { decorator: ninepatch(cb-china-btn-hover, cb-china-btn-hover-in, 1); }
@media (min-aspect-ratio: 12/5)
{
