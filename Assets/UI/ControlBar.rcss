body.neutral .cb-slot.cb-sci.buy, body.neutral .cb-general.lit { decorator: ninepatch(cb-neutral-btn-hover, cb-neutral-btn-hover-in, 1); }
@media (min-aspect-ratio: 12/5)
{
	body.neutral .cb-radar { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral .cb-unit { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral .cb-tab { decorator: ninepatch(cb-neutral-notch, cb-neutral-notch-in, 1); }
}
@media (min-aspect-ratio: 161/90)
{
	body.neutral.iw-169 .cb-radar { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral.iw-169 .cb-unit { decorator: ninepatch(cb-neutral-frame-c, cb-neutral-frame-c-in, 1); }
	body.neutral.iw-169 .cb-tab { decorator: ninepatch(cb-neutral-notch, cb-neutral-notch-in, 1); }
}
