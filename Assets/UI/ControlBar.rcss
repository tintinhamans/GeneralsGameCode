/*
	ControlBar.rcss -- the in-game control bar (ControlBar.rml, RmlControlBarScreen), laid out after Control Bar
	Pro (TheSuperHackers, MIT): a radar panel bottom left, the command panel bottom centre with the money on a
	notch above it and the buttons round the bar down its left side, the selection bottom right with the
	general's tab over it and the powers column above that; the tooltip over the radar, the promotions over the
	grid. Sizes follow Pro's at 1080 lines and are in dp, so they keep the same share of the screen height at
	every resolution.

	The look is an instrument panel: graphite plates with a restrained bevel and precise corner cuts, recessed
	wells, hairline button frames, small caps labels and plain numerals (Noto Sans figures are tabular). The
	side shows only as a muted line inside each plate's top edge and a small tag by the selection's name:
	steel blue for the USA, red for China, tan for the GLA, blue-grey for observers (and any other side). The
	plates, wells, frames, notch, tab and wings are ninepatch sprites from Textures/ControlBar/cb_<faction>.png
	(generated art, 2 px per dp).

	Wide screens: the dock (everything but the rail and the wings) spans the screen up to 21:9 and is centred
	beyond it, the wings and the rail carrying the bar out to the edges. The interface width option narrows it
	further (body.iw-169, RmlInterfaceArea.h). 5:4 and 4:3 move the command panel right next to the radar.

	Buttons (.cb-slot) are 5:4 like the cameo art: a recess, the cameo in the frame's window, the veterancy art
	on it, the clock darkening what is still to go from the top, the hotkey small bottom left, a count top right,
	and the command's border kind as a hairline along the window's top (build blue, upgrade orange, action teal,
	system yellow, as the .wnd borders, muted).
*/

body.cb
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: -1; /* under every other in-game document (menus, popups) */
	font-family: "Noto Sans";
	font-size: 15dp;
	color: #D8DDE4;
}

/* ---- The rail, the wings and the dock ------------------------------------------------------------ */
.cb-rail
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	bottom: 0;
	height: 8dp;
	pointer-events: none;
	decorator: vertical-gradient(#2C3036 #131519);
	border-top: 1dp #06070A;
}

.cb-dock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	pointer-events: none;
}

/* Wings: the bar's extension from the screen edges to the dock's ends, shown when the dock is narrower
   than the screen. Each runs from its edge to the middle less half the dock (plus 24dp under the panel). */
.cb-wing
{
	display: none;
	position: absolute;
	bottom: 0;
	height: 36dp;
	pointer-events: none;
}

.cb-wing-l { left: 0; right: 50%; margin-right: 1266dp; }
.cb-wing-r { left: 50%; right: 0; margin-left: 1266dp; }

/* ---- Panels ----------------------------------------------------------------------------------------- */
.cb-panel
{
	display: block;
	position: absolute;
	bottom: 0;
	box-sizing: border-box;
	pointer-events: auto;
}

/* small caps labels */
.cb-power-label, .cb-sci-tier, .cb-beacon-label, .cb-obs-label
{
	font-size: 12dp;
	line-height: 16dp;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #8A929C;
}

/* ---- Radar ------------------------------------------------------------------------------------------ */
.cb-radar
{
	left: 0;
	width: 332dp;
	height: 332dp;
	padding: 18dp 14dp 6dp 6dp;
}

.cb-radar-well
{
	display: block;
	position: relative;
	width: 100%;
	height: 100%;
	box-sizing: border-box;
}

/* the engine draws the radar here (RmlRadarElement) */
.cb-radar-map
{
	display: block;
	position: absolute;
	left: 3dp;
	top: 3dp;
	right: 3dp;
	bottom: 3dp;
}

/* under attack: a red hairline inside the well, blinking with the .wnd's WinUAttack light */
.cb-radar.alert .cb-radar-well { border: 1dp #D04848; }

/* ---- Centre: the notch, the power strip, the side buttons and the grid ---------------------------- */
.cb-centre
{
	display: block;
	position: absolute;
	left: 50%;
	bottom: 0;
	width: 768dp;
	margin-left: -384dp;
	height: 240dp;
	pointer-events: none;
}

.cb-main
{
	left: 10dp;
	width: 748dp;
	height: 208dp;
	padding: 18dp 18dp 6dp 18dp;
}

.cb-notch-row
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	height: 40dp;
	pointer-events: none;
}

.cb-money
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	min-width: 200dp;
	height: 40dp;
	padding: 6dp 32dp 0 32dp;
	font-size: 22dp;
	line-height: 30dp;
	letter-spacing: 1dp;
	text-align: center;
	white-space: nowrap;
	color: #E4E8EE;
	pointer-events: auto;
}

.cb-strip
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin-bottom: 8dp;
}

.cb-strip-fill { flex: 1 1 auto; }

.cb-power
{
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 1 1 auto;
	white-space: nowrap;
}

.cb-power-label { flex: 0 0 auto; margin-right: 10dp; }

/* the gauge: a recess, the supply fill, the scale's ticks and the consumption needle */
.cb-power-bar
{
	display: block;
	position: relative;
	flex: 1 1 auto;
	height: 14dp;
}

.cb-power-fill
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 2dp;
	height: 10dp;
	max-width: 100%;
	background-color: #7C9C48;
}

.cb-power.low-power .cb-power-fill { background-color: #B89A3C; }
.cb-power.no-power .cb-power-fill { background-color: #A8463E; }

.cb-power-ticks
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	top: 2dp;
	height: 10dp;
}

/* the needle stands at the end of a track as long as the consumption */
.cb-power-rail
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 0;
	bottom: 0;
	max-width: 100%;
}

.cb-power-needle
{
	display: block;
	position: absolute;
	right: 0;
	top: 0;
	width: 2dp;
	height: 14dp;
	background-color: #F2F4F7;
}

.cb-power-value
{
	flex: 0 0 auto;
	min-width: 72dp;
	font-size: 15dp;
	text-align: right;
	margin-left: 10dp;
	color: #C8CED6;
}

.cb-power.no-power .cb-power-value { color: #D87068; }
.cb-power.low-power .cb-power-value { color: #D8C070; }

/* a replay plays */
.cb-replay
{
	flex: 0 0 auto;
	height: 16dp;
	padding: 0 6dp;
	margin-left: 12dp;
	font-size: 11dp;
	line-height: 16dp;
	letter-spacing: 2dp;
	color: #D1FD04;
	border: 1dp #D1FD0480;
}

.cb-body
{
	display: flex;
	flex-direction: row;
	height: 148dp;
}

/* Round the bar: Pro's column left of the grid. */
.cb-side
{
	display: flex;
	flex-direction: column;
	flex: 0 0 auto;
	width: 60dp;
	height: 148dp;
	margin-right: 4dp;
}

.cb-side-btn
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 60dp;
	height: 34dp;
	margin-bottom: 4dp;
	text-align: center;
	background-color: #0C0D10;
	color: #A8AFB8;
}

.cb-glyph
{
	display: block;
	font-family: "Segoe UI Symbol"; /* the monochrome symbols; the emoji font would colour them */
	font-size: 16dp;
	line-height: 34dp;
}

.cb-side-btn:hover { color: #D1FD04; }
.cb-side-btn.off { color: #4A4E55; }

.cb-badge
{
	display: block;
	position: absolute;
	right: 3dp;
	top: 3dp;
	min-width: 8dp;
	height: 13dp;
	padding: 0 3dp;
	font-size: 11dp;
	line-height: 13dp;
	color: #D1FD04;
	background-color: #0C0D10E6;
	border: 1dp #D1FD0470;
}

/* ButtonCommand01..14: two rows, filled a column at a time. */
.cb-grid
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-slot
{
	display: block;
	position: relative;
	box-sizing: border-box;
	width: 88dp;
	height: 70dp;
	margin: 0 4dp 4dp 0;
}

.cb-slot.live { background-color: #0C0D10; }
.cb-slot.live.flash { background-color: #2A3212; }

/* the frame's window */
.cb-win
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 2dp;
	right: 2dp;
	bottom: 2dp;
	overflow: hidden;
	clip: always;
}

/* the command's border kind along the window's top */
.cb-slot.live.b1 .cb-win { border-top: 1dp #6A7CC8; }
.cb-slot.live.b2 .cb-win { border-top: 1dp #C0773A; }
.cb-slot.live.b3 .cb-win { border-top: 1dp #4AA890; }
.cb-slot.live.b4 .cb-win { border-top: 1dp #B8A850; }

.cb-art, .cb-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-art mappedimage, .cb-vet mappedimage, .cb-portrait mappedimage, .cb-upgrade mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.cb-slot.off .cb-art img { image-color: #4E525C; }
.cb-slot.poor .cb-art img { image-color: #8E8E8E; }

/* the clock: what is still to go darkens from the top, a hairline at its edge */
.cb-clock
{
	display: block;
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	background-color: #000000A6;
	border-bottom: 1dp #FFFFFF70;
}

.cb-key
{
	display: block;
	position: absolute;
	left: 4dp;
	bottom: 3dp;
	font-size: 12dp;
	line-height: 14dp;
	letter-spacing: 1dp;
	color: #E4E8EE;
	font-effect: outline(1dp #000000D0);
}

.cb-slot.live:hover .cb-key { color: #D1FD04; }
.cb-slot.off .cb-key { color: #7A808A; }

.cb-text
{
	display: block;
	position: absolute;
	right: 5dp;
	top: 3dp;
	font-size: 14dp;
	line-height: 16dp;
	color: #F2F4F7;
	font-effect: outline(1dp #000000D0);
}

/* Under construction and OCL timers */
.cb-task
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-slot.cb-task-slot { flex: 0 0 auto; margin: 0 20dp 0 0; }

.cb-task-info
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-task-text
{
	display: block;
	font-size: 17dp;
	line-height: 24dp;
	color: #E4E8EE;
}

.cb-task-bar
{
	display: block;
	position: relative;
	height: 12dp;
	margin-top: 10dp;
	box-sizing: border-box;
	padding: 2dp;
}

.cb-task-fill
{
	display: block;
	height: 100%;
	background-color: #7C9C48;
}

/* A beacon: the delete button and the message entry. */
.cb-beacon { align-items: center; }

.cb-text-btn
{
	display: block;
	flex: 0 0 auto;
	box-sizing: border-box;
	height: 34dp;
	padding: 0 14dp;
	font-size: 13dp;
	line-height: 34dp;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	color: #C8CED6;
	background-color: #0C0D10;
}

.cb-text-btn:hover { color: #D1FD04; }
.cb-text-btn.off { color: #4A4E55; }

.cb-beacon-delete { margin-right: 20dp; }

.cb-beacon-entry
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 12dp;
}

.cb-beacon-label { display: block; margin-bottom: 6dp; }

.cb-beacon-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

input.cb-input
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
	box-sizing: border-box;
	height: 34dp;
	padding: 0 10dp;
	margin-right: 8dp;
	font-size: 16dp;
	line-height: 32dp;
	color: #E4E8EE;
	background-color: #08090B;
	border: 1dp #3A3F46;
}

input.cb-input:focus { border-color: #D1FD04; }

/* ---- The general's tab over the selection: rank, promotions, min/max ----------------------------- */
.cb-tab
{
	display: flex;
	flex-direction: row;
	align-items: center;
	position: absolute;
	right: 0;
	bottom: 240dp;
	box-sizing: border-box;
	height: 40dp;
	padding: 6dp 8dp 0 42dp;
	pointer-events: auto;
}

.cb-rank
{
	display: block;
	flex: 0 0 auto;
	width: 84dp;
	margin-right: 6dp;
	font-size: 14dp;
	line-height: 20dp;
	letter-spacing: 2dp;
	white-space: nowrap;
	color: #FFFFFF1C;
}

.cb-star.on { color: #C8D0DA; }

.cb-side-btn.cb-general, .cb-side-btn.cb-minmax
{
	flex: 0 0 auto;
	width: 46dp;
	height: 26dp;
	margin: 0 0 0 4dp;
}

.cb-side-btn.cb-minmax { width: 34dp; }
.cb-general .cb-glyph, .cb-minmax .cb-glyph { font-size: 14dp; line-height: 26dp; }
.cb-general.lit { color: #D1FD04; }
.cb-general .cb-badge { right: 2dp; top: 2dp; }

/* ---- The selection ------------------------------------------------------------------------------------ */
.cb-unit
{
	right: 0;
	width: 308dp;
	height: 248dp;
	padding: 18dp 14dp 6dp 18dp;
}

.cb-unit-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
	height: 22dp;
	margin-bottom: 8dp;
}

/* the side's small tag by the name */
.cb-tag
{
	display: block;
	flex: 0 0 auto;
	width: 3dp;
	height: 14dp;
	margin-right: 8dp;
}

.cb-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 14dp;
	line-height: 22dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	color: #E4E8EE;
}

.cb-count
{
	flex: 0 0 auto;
	font-size: 15dp;
	color: #C8CED6;
	margin-left: 8dp;
}

.cb-unit-body
{
	display: flex;
	flex-direction: row;
	height: 188dp;
}

/* Pro's 3 x 3 cells: the portrait takes four, the upgrades the right column and the bottom row */
.cb-cells
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 243dp;
	height: 188dp;
}

.cb-portrait
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 158dp;
	height: 124dp;
	background-color: #0C0D10;
}

.cb-portrait .cb-win { left: 2dp; top: 2dp; right: 2dp; bottom: 2dp; }

.cb-portrait-vet
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.cb-upgrades
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
}

.cb-upgrade
{
	display: block;
	position: absolute;
	box-sizing: border-box;
	width: 78dp;
	height: 62dp;
	background-color: #0C0D10;
}

.cb-up0 { left: 162dp; top: 0; }
.cb-up1 { left: 162dp; top: 63dp; }
.cb-up2 { left: 162dp; top: 126dp; }
.cb-up3 { left: 81dp; top: 126dp; }
.cb-up4 { left: 0; top: 126dp; }

.cb-upgrade img { image-color: #464A52; }
.cb-upgrade.owned img { image-color: #FFFFFF; }

/* the build queue: nine cells, three by three */
.cb-queue
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	align-content: flex-start;
	position: absolute;
	left: 0;
	top: 0;
	width: 243dp;
	height: 188dp;
}

.cb-slot.cb-qslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 3dp 1dp 0;
}

/* a movie a script plays in the portrait, over the selection */
.cb-cameo-movie
{
	display: block;
	position: absolute;
	left: 2dp;
	top: 2dp;
	width: 154dp;
	height: 120dp;
	background-color: #000000;
}

/* Several things selected: how many. */
.cb-multi
{
	display: block;
	position: absolute;
	left: 0;
	top: 30dp;
	width: 243dp;
	font-size: 48dp;
	line-height: 100dp;
	text-align: center;
	color: #E4E8EE;
}

.cb-multi-x { font-size: 30dp; color: #8A929C; margin-right: 6dp; }

/* Nothing selected: the side's emblem, faint and grey. */
.cb-emblem
{
	display: block;
	position: absolute;
	left: 60dp;
	top: 30dp;
	width: 120dp;
	height: 120dp;
	opacity: 0.08;
}

.cb-emblem-img { display: block; width: 120dp; height: 120dp; }
.cb-emblem img { image-color: #B0B0B0; }

/* the general's experience: Pro's upright gauge at the right edge */
.cb-exp
{
	display: block;
	position: relative;
	flex: 0 0 auto;
	width: 12dp;
	height: 188dp;
	margin-left: 15dp;
	box-sizing: border-box;
	padding: 2dp;
}

.cb-exp-fill
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	bottom: 2dp;
	max-height: 184dp;
	background-color: #8C9A6A;
}

.cb-exp-marks
{
	display: block;
	position: absolute;
	left: 2dp;
	right: 2dp;
	top: 2dp;
	bottom: 2dp;
}

/* ---- The general's powers: a column at the right edge above the tab ------------------------------------ */
.cb-powers
{
	right: 0;
	bottom: 290dp;
	width: 100dp;
	padding: 14dp 10dp 8dp 12dp;
}

.cb-slot.cb-pslot
{
	width: 78dp;
	height: 62dp;
	margin: 0 0 4dp 0;
}

/* ---- The promotions panel: over the grid, the tiers of the side's sciences ---------------------------- */
.cb-science
{
	left: 50%;
	margin-left: -268dp;
	bottom: 252dp;
	width: 536dp;
	padding: 16dp 22dp 18dp 22dp;
}

.cb-sci-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-sci-title
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 17dp;
	line-height: 26dp;
	font-weight: bold;
	letter-spacing: 3dp;
	text-transform: uppercase;
	color: #E4E8EE;
}

.cb-sci-points
{
	flex: 0 0 auto;
	height: 22dp;
	padding: 0 8dp;
	font-size: 14dp;
	line-height: 22dp;
	color: #D1FD04;
	border: 1dp #D1FD0480;
}

.cb-sci-star { margin-right: 4dp; }

.cb-sci-exp
{
	display: block;
	height: 8dp;
	margin: 10dp 0 4dp 0;
	box-sizing: border-box;
	padding: 2dp;
}

.cb-sci-exp-fill
{
	display: block;
	height: 100%;
	background-color: #8C9A6A;
}

.cb-sci-tier
{
	display: block;
	margin: 12dp 0 6dp 0;
}

.cb-sci-row
{
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}

/* the rank 3 tier: five columns of three, filled a column at a time like the .wnd */
.cb-sci-rank3
{
	flex-direction: column;
	height: 222dp;
	align-content: flex-start;
}

.cb-slot.cb-sci { margin: 0 6dp 4dp 0; }

.cb-owned
{
	display: block;
	position: absolute;
	right: 4dp;
	bottom: 3dp;
	font-size: 13dp;
	line-height: 14dp;
	color: #6CC0A8;
	font-effect: outline(1dp #000000D0);
}

.cb-sci-foot
{
	display: flex;
	flex-direction: row;
	justify-content: flex-end;
	margin-top: 10dp;
}

/* ---- Build tooltip: over the radar, where Pro puts it; it never takes the mouse ------------------------ */
.cb-tip
{
	left: 8dp;
	bottom: 344dp;
	width: 420dp;
	padding: 14dp 18dp 16dp 18dp;
	pointer-events: none;
}

.cb-tip-head
{
	display: flex;
	flex-direction: row;
	align-items: center;
}

.cb-tip-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 15dp;
	line-height: 22dp;
	font-weight: bold;
	letter-spacing: 2dp;
	text-transform: uppercase;
	color: #E4E8EE;
}

.cb-tip-key
{
	flex: 0 0 auto;
	min-width: 12dp;
	height: 18dp;
	padding: 0 4dp;
	margin-left: 10dp;
	font-size: 12dp;
	line-height: 18dp;
	text-align: center;
	color: #C8CED6;
	border: 1dp #4A5058;
}

.cb-tip-cost
{
	display: block;
	margin-top: 4dp;
	font-size: 15dp;
	line-height: 20dp;
	color: #C8D6A0;
}

.cb-tip-desc
{
	display: block;
	margin-top: 8dp;
	padding-top: 8dp;
	border-top: 1dp #FFFFFF18;
	font-size: 14dp;
	line-height: 20dp;
	white-space: pre-line;
	color: #A6AEB8;
}

/* ---- Observing ------------------------------------------------------------------------------------ */
.cb-observers
{
	display: flex;
	flex-direction: column;
	flex-wrap: wrap;
	align-content: flex-start;
	width: 644dp;
	height: 148dp;
}

.cb-obs-player
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	width: 314dp;
	height: 34dp;
	margin: 0 8dp 3dp 0;
	padding: 0 8dp 0 3dp;
	background-color: #0C0D10E6;
	border-left: 2dp #FFFFFF22;
}

.cb-obs-player:hover { border-left-color: #D1FD04; background-color: #16181C; }

.cb-obs-side
{
	display: block;
	flex: 0 0 auto;
	width: 32dp;
	height: 26dp;
	margin-right: 8dp;
}

.cb-obs-side mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-name
{
	flex: 1 1 0%;
	min-width: 0;
	font-size: 15dp;
	line-height: 22dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.cb-observed
{
	display: flex;
	flex-direction: row;
	align-items: center;
	width: 644dp;
	height: 148dp;
}

.cb-obs-flag
{
	display: block;
	flex: 0 0 auto;
	width: 64dp;
	height: 106dp;
	margin-right: 16dp;
}

.cb-obs-flag mappedimage { display: block; width: 100%; height: 100%; }

.cb-obs-main
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-title
{
	display: block;
	font-size: 17dp;
	line-height: 24dp;
	font-weight: bold;
	letter-spacing: 1dp;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	margin-bottom: 10dp;
}

.cb-obs-stats
{
	display: flex;
	flex-direction: row;
}

.cb-obs-stat
{
	display: block;
	flex: 1 1 0%;
	min-width: 0;
}

.cb-obs-value
{
	display: block;
	font-size: 24dp;
	line-height: 30dp;
	color: #E4E8EE;
}

.cb-obs-label { display: block; white-space: pre-line; }

.cb-obs-back { margin: 0 4dp 0 12dp; }

/* ---- Collapsed (the min/max button, CONTROL_BAR_STAGE_LOW): the notch, the power strip, the buttons ---- */
body.low .cb-radar, body.low .cb-unit, body.low .cb-powers { display: none; }
body.low .cb-main { height: 94dp; }
body.low .cb-grid, body.low .cb-task, body.low .cb-observers, body.low .cb-observed { display: none; }
body.low .cb-body { height: 40dp; }
body.low .cb-side { flex-direction: row; width: auto; height: 40dp; }
body.low .cb-side-btn { margin: 0 6dp 0 0; }
body.low .cb-tab { bottom: 0; }
body.low .cb-tip { bottom: 140dp; }
body.low .cb-science { bottom: 140dp; }

/* ---- 5:4 and 4:3: the command panel next to the radar, which gets a little smaller ------------------- */
@media (max-aspect-ratio: 29/20)
{
	.cb-radar { width: 280dp; height: 280dp; }
	.cb-centre { left: 274dp; margin-left: 0; }
	.cb-science { left: 390dp; margin-left: 0; }
	.cb-tip { bottom: 292dp; }
}

/* ---- Wide screens: past 21:9 (43:18, 3440x1440) the dock stops and centres; the wings carry the bar out to
   the edges. The interface width option's 21:9 is the same band, so only its 16:9 needs its own rule
   (RmlInterfaceArea.h sets body.iw-169). ------------------------------------------------------------------ */
@media (min-aspect-ratio: 12/5)
{
	.cb-dock { left: 50%; right: auto; width: 2580dp; margin-left: -1290dp; }
	.cb-wing { display: block; }
}

@media (min-aspect-ratio: 161/90)
{
	body.iw-169 .cb-dock { left: 50%; right: auto; width: 1920dp; margin-left: -960dp; }
	body.iw-169 .cb-wing { display: block; }
	body.iw-169 .cb-wing-l { margin-right: 936dp; }
	body.iw-169 .cb-wing-r { margin-left: 936dp; }
}

