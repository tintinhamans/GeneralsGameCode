/*
	LoadScreen.rcss -- pieces shared by the network load screens (MapTransfer.rml,
	MultiplayerLoad.rml, GameSpyLoad.rml). Positions are body percentages of the .wnd's
	800x600 space, so the layout stretches the way the original does at any aspect ratio;
	row heights are dp because dp follows screen height like the vertical percentages do.
*/

body
{
	width: 100%;
	height: 100%;
}

.load-frame
{
	position: absolute;
	background-color: rgba(2, 2, 2, 129);
}

.load-title-line
{
	position: absolute;
	height: 0dp;
	border-top: 2dp #2F37A8;
}

.load-title
{
	position: absolute;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	padding-left: 8dp;
	padding-bottom: 6dp;
	box-sizing: border-box;
	font-size: 40dp;
	color: #FFFFFF;
}

.load-column
{
	position: absolute;
	box-sizing: border-box;
	background-color: #000000;
}

.load-column-title
{
	position: absolute;
	top: 0dp;
	height: 44dp;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 26dp;
	color: #FFFFFF;
	white-space: nowrap;
}

/* One line per player; the data-for wrapper is display:block so unused rows collapse. The pitch
   is the wrapper's fixed height, so no row has a trailing margin to overflow the column. */
.load-line
{
	display: block;
	height: 43dp;
}

.load-cell
{
	box-sizing: border-box;
	height: 36dp;
	padding: 6dp 8dp 0dp 8dp;
	font-size: 17dp;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
}

.load-cell.boxed
{
	background-color: rgba(2, 2, 2, 200);
	border: 2dp #2F37A8;
	text-align: center;
}

.load-bar
{
	display: flex;
	width: 100%;
	box-sizing: border-box;
	height: 36dp;
	background-color: rgba(2, 2, 2, 200);
	border: 2dp #2F37A8;
}

/* Bars the .wnd hides (host, or a player who already has the map) keep their slot. */
.load-bar.invisible
{
	visibility: hidden;
}

.load-bar-fill
{
	flex: 0 0 auto;
}

/* ---- Top half shared by the multiplayer and online screens -------------------------------
   Local general name, portrait, features text and the map preview with start markers. */
.load-name
{
	position: absolute;
	left: 7%;
	top: 7.333%;
	width: 56.1%;
	height: 5.5%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 42dp;
	color: #FFFFFF;
	white-space: nowrap;
}

/* Flex parents: block containers don't resolve the percent size of an image child here. */
.load-portrait
{
	position: absolute;
	left: 7.5%;
	top: 19.667%;
	width: 27.375%;
	height: 33.833%;
	display: flex;
}

.load-portrait mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-features
{
	position: absolute;
	left: 35.75%;
	top: 20%;
	width: 29.625%;
	height: 33.167%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
	font-size: 20dp;
	font-weight: bold;
	color: #FFFFFF;
}

.load-map
{
	position: absolute;
	left: 66.25%;
	top: 20%;
	width: 26.625%;
	height: 33.333%;
	display: flex;
	background-color: #000000;
}

.load-map mappreview
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-marker-layer
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
}

.load-marker
{
	position: absolute;
	width: 30dp;
	height: 30dp;
	margin-left: -15dp;
	margin-top: -15dp;
	display: flex;
}

.load-marker mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-marker-label
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
	font-size: 15dp;
	font-weight: bold;
}

/* ---- Player table pieces --------------------------------------------------------------- */
.load-head
{
	position: absolute;
	height: 4.667%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 20dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
}

.load-rows
{
	position: absolute;
}

.load-row
{
	display: block;
	position: relative;
	height: 43dp;
}

.load-row .load-cell,
.load-row .load-bar
{
	position: absolute;
	top: 0dp;
}

.load-row .load-cell
{
	padding-left: 4dp;
}
