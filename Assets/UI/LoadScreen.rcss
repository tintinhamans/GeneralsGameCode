/*
	LoadScreen.rcss -- pieces shared by the network load screens (MapTransfer.rml,
	MultiplayerLoad.rml, GameSpyLoad.rml) and the movie load screens (SinglePlayerLoadScreen.rml,
	ChallengeLoadScreen.rml; see the end of this sheet). Positions are body percentages of the .wnd's
	800x600 space, so the layout stretches the way the original does at any aspect ratio;
	row heights are dp because dp follows screen height like the vertical percentages do.
*/

body
{
	width: 100%;
	height: 100%;
}

.load-frame
{
	position: absolute;
	background-color: rgba(2, 2, 2, 129);
}

.load-title-line
{
	position: absolute;
	height: 0dp;
	border-top: 2dp #2F37A8;
}

.load-title
{
	position: absolute;
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	padding-left: 8dp;
	padding-bottom: 6dp;
	box-sizing: border-box;
	font-size: 40dp;
	color: #FFFFFF;
}

.load-column
{
	position: absolute;
	box-sizing: border-box;
	background-color: #000000;
}

.load-column-title
{
	position: absolute;
	top: 0dp;
	height: 44dp;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 26dp;
	color: #FFFFFF;
	white-space: nowrap;
}

/* One line per player; the data-for wrapper is display:block so unused rows collapse. The pitch
   is the wrapper's fixed height, so no row has a trailing margin to overflow the column. */
.load-line
{
	display: block;
	height: 43dp;
}

.load-cell
{
	box-sizing: border-box;
	height: 36dp;
	padding: 6dp 8dp 0dp 8dp;
	font-size: 16dp;
	color: #FFFFFF;
	white-space: nowrap;
	overflow: hidden;
}

.load-cell.boxed
{
	background-color: rgba(2, 2, 2, 200);
	border: 2dp #2F37A8;
	text-align: center;
}

.load-bar
{
	display: flex;
	width: 100%;
	box-sizing: border-box;
	height: 36dp;
	background-color: rgba(2, 2, 2, 200);
	border: 2dp #2F37A8;
}

/* Bars the .wnd hides (host, or a player who already has the map) keep their slot. */
.load-bar.invisible
{
	visibility: hidden;
}

.load-bar-fill
{
	flex: 0 0 auto;
}

/* ---- Top half shared by the multiplayer and online screens -------------------------------
   Local general name, portrait, features text and the map preview with start markers. */
.load-name
{
	position: absolute;
	left: 7%;
	top: 7.333%;
	width: 56.1%;
	height: 5.5%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 40dp;
	color: #FFFFFF;
	white-space: nowrap;
}

/* Flex parents: block containers don't resolve the percent size of an image child here. */
.load-portrait
{
	position: absolute;
	left: 7.5%;
	top: 19.667%;
	width: 27.375%;
	height: 33.833%;
	display: flex;
}

.load-portrait mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-features
{
	position: absolute;
	left: 35.75%;
	top: 20%;
	width: 29.625%;
	height: 33.167%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
}

.load-map
{
	position: absolute;
	left: 66.25%;
	top: 20%;
	width: 26.625%;
	height: 33.333%;
	display: flex;
	background-color: #000000;
}

.load-map mappreview
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-marker-layer
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
}

.load-marker
{
	position: absolute;
	width: 30dp;
	height: 30dp;
	margin-left: -15dp;
	margin-top: -15dp;
	display: flex;
}

.load-marker mappedimage
{
	display: block;
	width: 100%;
	height: 100%;
}

.load-marker-label
{
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	text-align: center;
	font-size: 13dp;
	font-weight: bold;
}

/* ---- Player table pieces --------------------------------------------------------------- */
.load-head
{
	position: absolute;
	height: 4.667%;
	display: flex;
	flex-direction: column;
	justify-content: center;
	font-size: 18dp;
	font-weight: bold;
	color: #FFFFFF;
	white-space: nowrap;
}

.load-rows
{
	position: absolute;
}

.load-row
{
	display: block;
	position: relative;
	height: 43dp;
}

.load-row .load-cell,
.load-row .load-bar
{
	position: absolute;
	top: 0dp;
}

.load-row .load-cell
{
	padding-left: 4dp;
}

/* ---- Movie load screens ----------------------------------------------------------------
   SinglePlayerLoadScreen.rml and ChallengeLoadScreen.rml. Their art and movies are 4:3 pictures,
   so everything sits on a 4:3 stage centred on the screen instead of being stretched: black at the
   sides of wider screens, as the engine shows its full-screen movies. The stage is 1440dp wide
   (4:3 of the 1080dp height) and narrows to the screen on narrower aspects. Positions inside it
   are percentages of the .wnd's 800x600 rects. */
body.ls-screen
{
	display: flex;
	flex-direction: row;
	justify-content: center;
	background-color: #000000;
}

.ls-stage
{
	position: relative;
	flex: 0 0 auto;
	width: 1440dp;
	max-width: 100%;
	height: 100%;
}

/* Art or movie over the whole stage. A movie keeps its aspect on black. */
.ls-fill
{
	display: block;
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.ls-movie
{
	background-color: #000000;
}

.ls-movie video
{
	display: block;
	width: 100%;
	height: 100%;
}

/* Load bar, drawn like the engine's image progress bar: 20px end caps with a tiled middle between
   them (.framed only), the bar inset 10px from the sides and 5px from top and bottom, the done part
   in the bar art and the rest in the powered down art. The bar pieces are 3px wide and cannot be
   tiled from the sprites, so their 11 rows of color are drawn here. */
.ls-bar
{
	position: absolute;
}

.ls-bar-cap,
.ls-bar-mid
{
	display: none;
}

.ls-bar.framed .ls-bar-cap
{
	display: block;
	position: absolute;
	top: 0;
	width: 20px;
	height: 100%;
}

.ls-bar-cap-l { left: 0; }
.ls-bar-cap-r { right: 0; }

/* LoadingBar_C only varies vertically, so stretching it along the bar shows the same lines */
.ls-bar.framed .ls-bar-mid
{
	display: block;
	position: absolute;
	left: 20px;
	right: 20px;
	top: 0;
	height: 100%;
	decorator: tiled-horizontal(LoadingBar_C, LoadingBar_C, LoadingBar_C);
}

.ls-bar-track
{
	position: absolute;
	left: 10px;
	right: 10px;
	top: 5px;
	bottom: 5px;
}

.ls-bar-fill
{
	position: absolute;
	left: 0;
	top: 0;
	height: 100%;
}

.ls-bar-rows
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
}

.ls-bar-rows div
{
	display: block;
	height: 9.0909%;
}

/* LoadingBar_DePowered */
.ls-bar-rest div:nth-child(1) { background-color: #323232; }
.ls-bar-rest div:nth-child(2) { background-color: #3B3B3B; }
.ls-bar-rest div:nth-child(3) { background-color: #535353; }
.ls-bar-rest div:nth-child(4) { background-color: #757575; }
.ls-bar-rest div:nth-child(5) { background-color: #8A8A8A; }
.ls-bar-rest div:nth-child(6) { background-color: #898989; }
.ls-bar-rest div:nth-child(7) { background-color: #747476; }
.ls-bar-rest div:nth-child(8) { background-color: #515152; }
.ls-bar-rest div:nth-child(9) { background-color: #3B3B3D; }
.ls-bar-rest div:nth-child(10) { background-color: #303030; }
.ls-bar-rest div:nth-child(11) { background-color: #000000; }

/* LoadingBar_Progress, the .wnd's own */
.ls-bar-done div:nth-child(1) { background-color: #0B1516; }
.ls-bar-done div:nth-child(2) { background-color: #1E2BDB; }
.ls-bar-done div:nth-child(3) { background-color: #202DE2; }
.ls-bar-done div:nth-child(4) { background-color: #3441FF; }
.ls-bar-done div:nth-child(5) { background-color: #7881FF; }
.ls-bar-done div:nth-child(6) { background-color: #DCDFFF; }
.ls-bar-done div:nth-child(7) { background-color: #DCDFFF; }
.ls-bar-done div:nth-child(8) { background-color: #A4AAFF; }
.ls-bar-done div:nth-child(9) { background-color: #717AFF; }
.ls-bar-done div:nth-child(10) { background-color: #2E3BF8; }
.ls-bar-done div:nth-child(11) { background-color: #000000; }

/* LoadingBar_ProgressCenter1 (China), 2 (USA) and 3 (GLA): the same white middle, their own colour around it */
.ls-bar.center1 .ls-bar-done div:nth-child(1),
.ls-bar.center2 .ls-bar-done div:nth-child(1),
.ls-bar.center3 .ls-bar-done div:nth-child(1) { background-color: #000000; }

.ls-bar.center1 .ls-bar-done div:nth-child(2),
.ls-bar.center1 .ls-bar-done div:nth-child(3),
.ls-bar.center1 .ls-bar-done div:nth-child(10) { background-color: #FF0000; }
.ls-bar.center1 .ls-bar-done div:nth-child(4),
.ls-bar.center1 .ls-bar-done div:nth-child(9) { background-color: #FF4545; }
.ls-bar.center1 .ls-bar-done div:nth-child(5),
.ls-bar.center1 .ls-bar-done div:nth-child(8) { background-color: #FCA7A7; }

.ls-bar.center2 .ls-bar-done div:nth-child(2),
.ls-bar.center2 .ls-bar-done div:nth-child(3),
.ls-bar.center2 .ls-bar-done div:nth-child(10) { background-color: #4368FE; }
.ls-bar.center2 .ls-bar-done div:nth-child(4),
.ls-bar.center2 .ls-bar-done div:nth-child(9) { background-color: #7590FD; }
.ls-bar.center2 .ls-bar-done div:nth-child(5),
.ls-bar.center2 .ls-bar-done div:nth-child(8) { background-color: #B5C3FB; }

.ls-bar.center3 .ls-bar-done div:nth-child(2),
.ls-bar.center3 .ls-bar-done div:nth-child(3),
.ls-bar.center3 .ls-bar-done div:nth-child(10) { background-color: #3ED12E; }
.ls-bar.center3 .ls-bar-done div:nth-child(4),
.ls-bar.center3 .ls-bar-done div:nth-child(9) { background-color: #74FB65; }
.ls-bar.center3 .ls-bar-done div:nth-child(5),
.ls-bar.center3 .ls-bar-done div:nth-child(8) { background-color: #AFFCA7; }
