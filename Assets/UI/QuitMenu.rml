<rml>
<head>
	<title>QuitMenu</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		/* Over live gameplay: a compact card on a light scrim, no ruler frame, so the battle stays in
		   view (a multiplayer game keeps running behind it). Return to the game leads; Exit sits apart.
		   It speaks the control bar's instrument-panel look: graphite, hairlines, small caps. */
		.quit-card { width: 400dp; background-color: #15171BF4; border: 1dp #34383F; border-top: 1dp #8A929C; }
		.quit-card .modal-head { padding: 20dp 24dp 0 24dp; }
		.quit-card .modal-title { font-size: 16dp; line-height: 22dp; letter-spacing: 4dp; color: #E4E8EE; border-left: 2dp #8A929C; padding-left: 12dp; }
		.quit-list { display: flex; flex-direction: column; padding: 18dp 24dp 22dp 24dp; }
		.screen .quit-list button { display: block; width: 100%; height: 42dp; line-height: 40dp; margin-top: 6dp; text-align: left; padding: 0 18dp; font-size: 14dp; letter-spacing: 2dp; color: #C8CED6; background-color: #1D2025; border: 1dp #34383F; }
		.screen .quit-list button:hover { color: #D1FD04; background-color: #23272D; border-color: #D1FD04; }
		.screen .quit-list button:active { color: #D1FD04; background-color: #111316; border-color: #A8CC00; }
		.screen .quit-list button[disabled], .screen .quit-list button[disabled]:hover { color: #4A4E55; background-color: #17191D; border-color: #26292E; }
		.screen .quit-list button.btn-cta { margin-top: 0; margin-bottom: 6dp; height: 50dp; line-height: 48dp; min-width: 0; text-align: center; font-size: 15dp; letter-spacing: 3dp; color: #E4E8EE; decorator: none; background-color: #262A30; border: 1dp #5A616A; }
		.screen .quit-list button.btn-cta:hover { color: #D1FD04; border-color: #D1FD04; decorator: none; }
		.screen .quit-list button.quit-exit { margin-top: 16dp; color: #D08A84; border-color: #5A3230; background-color: #1D1718; }
		.screen .quit-list button.quit-exit:hover { color: #FFFFFF; background-color: #4A2224; border-color: #B8544C; }
		.quit-sep { display: block; height: 1dp; margin-top: 16dp; background-color: #FFFFFF14; }
	</style>
</head>
<body class="screen modal over-game" data-model="quitmenu">
	<div class="modal-card quit-card">
		<div class="modal-head">
			<div class="modal-heading">
				<div class="modal-title"><gametext key="GO:GUI:GameMenu"/></div>
			</div>
		</div>
		<div class="quit-list">
			<button class="btn-cta" data-event-click="return_to_game"><gametext key="GUI:ReturnToGame"/></button>
			<button data-event-click="options" data-attrif-disabled="options_disabled"><gametext key="GUI:Options"/></button>
			<button data-if="show_saveload" data-event-click="save_load" data-attrif-disabled="saveload_disabled"><gametext key="GUI:SaveAndLoad"/></button>
			<button data-event-click="restart" data-attrif-disabled="restart_disabled">{{restart_label}}</button>
			<div class="quit-sep"></div>
			<button class="quit-exit" data-event-click="exit">{{exit_label}}</button>
		</div>
	</div>
</body>
</rml>
