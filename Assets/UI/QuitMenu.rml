<rml>
<head>
	<title>QuitMenu</title>
	<link type="text/rcss" href="common.rcss"/>
	<style>
		/* Over live gameplay: a compact card on a light scrim, no ruler frame, so the battle stays in
		   view (a multiplayer game keeps running behind it). Return to the game leads; Exit sits apart. */
		.quit-card { width: 440dp; }
		.quit-list { display: flex; flex-direction: column; padding: 20dp 28dp 24dp 28dp; }
		.screen .quit-list button { display: block; width: 100%; margin-top: 10dp; text-align: left; padding: 0 22dp; }
		.screen .quit-list button.btn-cta { margin-top: 0; margin-bottom: 8dp; height: 60dp; line-height: 56dp; min-width: 0; text-align: center; font-size: 22dp; }
		.screen .quit-list button.quit-exit { margin-top: 18dp; color: #FF8C8C; border-color: #FF505046; background-color: #2A0A0ED2; }
		.screen .quit-list button.quit-exit:hover { color: #FFFFFF; background-color: #7A1A22E6; border-color: #FF5050; }
		.quit-sep { display: block; height: 1dp; margin-top: 18dp; background-color: #8080FF1E; }
	</style>
</head>
<body class="screen modal over-game" data-model="quitmenu">
	<div class="modal-card quit-card">
		<div class="modal-head">
			<div class="modal-heading">
				<div class="modal-title"><gametext key="GUI:GOGameMenu"/></div>
			</div>
		</div>
		<div class="quit-list">
			<button class="btn-cta" data-event-click="return_to_game"><gametext key="GUI:ReturnToGame"/></button>
			<button data-event-click="options" data-attrif-disabled="options_disabled"><gametext key="GUI:Options"/></button>
			<button data-if="show_saveload" data-event-click="save_load" data-attrif-disabled="saveload_disabled"><gametext key="GUI:SaveAndLoad"/></button>
			<button data-event-click="restart" data-attrif-disabled="restart_disabled">{{restart_label}}</button>
			<div class="quit-sep"></div>
			<button class="quit-exit" data-event-click="exit">{{exit_label}}</button>
		</div>
	</div>
</body>
</rml>
