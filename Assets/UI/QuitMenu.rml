<rml>
<head>
	<title>QuitMenu</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ShellCommon.rcss"/>
	<style>
		/* Over live gameplay: a compact card on a light scrim, no ruler frame, so the battle stays in
		   view (a multiplayer game keeps running behind it). Return to the game leads; Exit sits apart.
		   Ronin @feature 22/11/2026 DX9: in the Ice Console's rules, as the shell (was graphite with the
		   yellow-green hover): navy plate, line-blue hairlines, ice and a blue glow when lit; Exit a muted red. */
		.quit-card { width: 420dp; background-color: #070A1AF2; border: 1dp #4F86FF73; }
		.quit-card .modal-head { padding: 22dp 26dp 0 26dp; }
		.quit-card .modal-title { font-family: "Exo 2"; font-weight: 300; font-size: 22dp; line-height: 28dp; letter-spacing: 5dp; text-transform: uppercase; color: #EEF3FF; border-left: 2dp #D8EAFF; padding-left: 14dp; }
		.quit-list { display: flex; flex-direction: column; padding: 18dp 26dp 24dp 26dp; }
		.screen .quit-list button { display: block; width: 100%; height: 44dp; line-height: 42dp; margin-top: 8dp; text-align: left; padding: 0 18dp; font-family: "Exo 2"; font-weight: normal; font-size: 16dp; letter-spacing: 3dp; text-transform: uppercase; color: #EEF3FF; background-color: #040A1CB8; border: 1dp #4F86FF73; decorator: none; }
		.screen .quit-list button:hover { color: #D8EAFF; background-color: #0B1D45CC; border-color: #D8EAFF; decorator: horizontal-gradient(#4F86FF38 #4F86FF10); font-effect: glow(2dp 10dp 0dp 0dp #4F86FFB0); }
		.screen .quit-list button:active { color: #D8EAFF; background-color: #0B1D45E6; border-color: #8FB4FF; decorator: none; }
		.screen .quit-list button[disabled], .screen .quit-list button[disabled]:hover { color: #56627F; background-color: #040A1C80; border-color: #4F86FF26; decorator: none; font-effect: none; }
		.screen .quit-list button.btn-cta { margin-top: 0; margin-bottom: 8dp; height: 52dp; line-height: 50dp; min-width: 0; text-align: center; font-size: 17dp; letter-spacing: 4dp; color: #FFFFFF; border: 1dp #8FB4FF; decorator: vertical-gradient(#2F6BE0E0 #173E96E0); }
		.screen .quit-list button.btn-cta:hover { color: #D8EAFF; border-color: #D8EAFF; decorator: vertical-gradient(#3B7AF0F0 #1E4AA8F0); }
		.screen .quit-list button.quit-exit { margin-top: 18dp; color: #E0A09A; background-color: #1A0D10B8; border-color: #B8544C66; }
		.screen .quit-list button.quit-exit:hover { color: #FFFFFF; background-color: #4A2224D0; border-color: #E07068; decorator: none; font-effect: none; }
		.quit-sep { display: block; height: 0; margin-top: 18dp; border-top: 1dp #4F86FF40; }	/* a border: a 1dp fill can miss every row below 1080 lines */
	</style>
</head>
<body class="screen modal over-game" data-model="quitmenu">
	<div class="modal-card quit-card">
		<div class="modal-head">
			<div class="modal-heading">
				<div class="modal-title">Game Menu</div>
			</div>
		</div>
		<div class="quit-list">
			<button class="btn-cta" data-event-click="return_to_game"><gametext key="GUI:ReturnToGame"/></button>
			<button data-event-click="options" data-attrif-disabled="options_disabled"><gametext key="GUI:Options"/></button>
			<button data-if="show_saveload" data-event-click="save_load" data-attrif-disabled="saveload_disabled"><gametext key="GUI:SaveAndLoad"/></button>
			<button data-event-click="restart" data-attrif-disabled="restart_disabled">{{restart_label}}</button>
			<div class="quit-sep"></div>
			<button class="quit-exit" data-event-click="exit">{{exit_label}}</button>
		</div>
	</div>
</body>
</rml>
