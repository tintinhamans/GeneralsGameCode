<rml>
<head>
	<title>OnlineGameSetup</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="GameSetup.rcss"/>
	<link type="text/rcss" href="OnlineGameSetup.rcss"/>
</head>
<body class="shell" data-model="onlinegamesetup">
	<mappedimage class="shell-background" name="MainMenuRuler"/>

	<div class="shell-frame">
		<div class="shell-title-bar">{{game_name}}</div>

		<div class="setup-body">
			<div class="scroll-container slot-list">
				<div class="slot-row slot-header">
					<div class="slot-occupant"><gametext key="GUI:Players"/></div>
					<div class="slot-color"><gametext key="GUI:Color"/></div>
					<div class="slot-faction"><gametext key="GUI:Faction"/></div>
					<div class="slot-team"><gametext key="GUI:Team"/></div>
					<div class="slot-accept"></div>
				</div>
				<div class="slot-row" data-for="row : slots">
					<div class="slot-occupant occupant-cell">
						<!-- WOLGameSetupMenu.cpp's staticTextPlayer/comboBoxPlayer are mutually exclusive: the
						     host always sees the combo (its edit box shows the occupant's name for human slots),
						     a client only sees the combo for non-human slots and a static name label for human
						     ones (staticTextPlayer[i]->winHide(TRUE) only when bIsHost, WOLGameSetupMenu.cpp:1223-1224).
						     Showing both here duplicated the name; data-if keeps them exclusive like the .wnd. -->
						<select data-if="is_host || !row.is_human_occupant" data-value="row.occupant_state" data-attrif-disabled="!row.can_edit_occupant"
							data-event-change="slot_occupant_changed(row.slot_index)">
							<option value="0"><gametext key="GUI:Open"/></option>
							<option value="1"><gametext key="GUI:Closed"/></option>
							<option value="2"><gametext key="GUI:EasyAI"/></option>
							<option value="3"><gametext key="GUI:MediumAI"/></option>
							<option value="4"><gametext key="GUI:HardAI"/></option>
							<option value="5" data-if="row.is_human_occupant">{{row.occupant_label}}</option>
						</select>
						<div class="conn-indicator" data-if="row.is_human_occupant" data-class-connected="row.is_connected"
							data-attr-data-tooltip-text="row.connection_tooltip"></div>
						<div class="slot-name" data-if="row.is_human_occupant &amp;&amp; !is_host">{{row.player_name}}</div>
					</div>
					<div class="slot-color">
						<select data-value="row.color" data-attrif-disabled="!row.can_edit || !row.is_occupied"
							data-event-change="slot_color_changed(row.slot_index)">
							<option data-for="opt : row.color_options" data-attr-value="opt.value"><span class="color-swatch" data-style-background-color="opt.swatch"></span>{{opt.label}}</option>
						</select>
					</div>
					<!-- Every slot -- human or AI -- gets the same faction select (WOLGameSetupMenu.cpp keeps one
					     comboBoxPlayerTemplate[i] per slot, no separate read-only label for human rows), so
					     every row's Army cell lines up under the same column instead of a plain-text div
					     sitting flush left of where the select's own text starts. can_edit already gates it
					     the same way the .wnd's combo enable state does: the host can edit any slot, a
					     non-host only their own (GameSetupSlotRow::m_canEdit). -->
					<select class="slot-faction" data-value="row.player_template"
						data-attrif-disabled="!row.can_edit || !row.is_occupied" data-attr-data-tooltip-text="row.faction_tooltip"
						data-event-change="slot_faction_changed(row.slot_index)">
						<option data-for="opt : faction_options" data-attr-value="opt.value">{{opt.label}}</option>
					</select>
					<select class="slot-team" data-value="row.team_number" data-attrif-disabled="!row.can_edit || !row.is_occupied"
						data-event-change="slot_team_changed(row.slot_index)">
						<option value="-1"><gametext key="Team:0"/></option>
						<option value="0"><gametext key="Team:1"/></option>
						<option value="1"><gametext key="Team:2"/></option>
						<option value="2"><gametext key="Team:3"/></option>
						<option value="3"><gametext key="Team:4"/></option>
					</select>
					<div class="slot-accept" data-if="row.show_accept" data-class-accepted="row.accepted" data-tooltip="TOOLTIP:GameAcceptance"></div>
				</div>
			</div>

			<div class="side-panel">
				<div class="map-preview">
					<mappreview class="map-preview-image" data-attr-map="map_name" data-if="map_found"/>
					<div class="map-not-found" data-if="!map_found"><gametext key="GUI:CantFindMap"/></div>
					<div data-for="marker : start_markers">
						<div class="start-marker" data-if="marker.used"
							data-style-left="marker.x_style" data-style-top="marker.y_style"
							data-event-click="start_marker_clicked(marker.position)"
							data-event-mousedown="start_marker_mousedown(marker.position)">
							<div class="start-marker-dot" data-class-occupied="marker.is_occupied" data-style-background-color="marker.color_hex"></div>
							<div class="start-marker-label" data-if="marker.is_occupied">{{marker.occupant_label}}</div>
						</div>
					</div>
				</div>
				<div class="map-display-name">{{map_display_text}}</div>
				<button data-attrif-disabled="!is_host || settings_locked" data-event-click="select_map" data-tooltip="Tooltip:SelectMap"><gametext key="GUI:SelectMap"/></button>

				<div class="row">
					<div class="label"><gametext key="GUI:StartingMoney"/></div>
					<select class="control" data-value="starting_cash" data-attrif-disabled="!cash_and_sw_enabled || settings_locked"
						data-event-change="starting_cash_changed" data-tooltip="TOOLTIP:StartingMoney">
						<option data-for="opt : starting_cash_options" data-attr-value="opt.value">{{opt.label}}</option>
					</select>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:LimitSuperweapons"/></div>
					<input class="control checkbox" type="checkbox" data-checked="superweapons_restricted" data-attrif-disabled="!cash_and_sw_enabled || settings_locked"
						data-event-change="superweapons_changed" data-tooltip="TOOLTIP:LimitSuperweapons"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:LimitArmies"/></div>
					<input class="control checkbox" type="checkbox" disabled="disabled" data-checked="limit_armies" data-tooltip="TOOLTIP:LimitArmies"/>
				</div>
				<div class="row">
					<div class="label"><gametext key="GUI:UseStats"/></div>
					<input class="control checkbox" type="checkbox" disabled="disabled" data-checked="use_stats" data-tooltip="TOOLTIP:UseStatsOn" data-if="use_stats"/>
					<input class="control checkbox" type="checkbox" disabled="disabled" data-checked="use_stats" data-tooltip="TOOLTIP:UseStatsOff" data-if="!use_stats"/>
				</div>
			</div>
		</div>

		<div class="chat">
			<scrolllog class="chat-log">
				<div class="chat-line" data-for="line : chat_lines"><span data-style-color="line.color">{{line.text}}</span></div>
			</scrolllog>
			<div class="chat-entry">
				<input type="text" class="chat-input" maxlength="128" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
				<button class="icon-btn" data-event-click="chat_entry_committed" data-tooltip="TOOLTIP:EmoteButton"><mappedimage name="ReturnButton"/></button>
			</div>
		</div>

		<div class="footer footer-split">
			<button class="button-lg" data-attrif-disabled="!start_enabled" data-event-click="start">
				<gametext key="GUI:Start" data-if="is_host"/>
				<gametext key="GUI:Accept" data-if="!is_host"/>
			</button>
			<button class="button-lg" data-attrif-disabled="!communicator_enabled" data-event-click="communicator_clicked">{{communicator_label}}</button>
			<button class="button-lg" data-attrif-disabled="!back_enabled" data-event-click="back"><gametext key="GUI:Back"/></button>
		</div>
	</div>
</body>
</rml>
