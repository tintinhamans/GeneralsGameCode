<rml>
<head>
	<title>OnlineGameSetup</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="NetworkGameSetup.rcss"/>
	<link type="text/rcss" href="OnlineGameSetup.rcss"/>
</head>
<body class="screen dock-host" data-model="onlinegamesetup">
	<div class="screen-ruler"><div class="rs rs-top"><div></div><div></div><div></div><div></div></div><div class="rs rs-bottom"><div></div><div></div><div></div><div></div></div><div class="rs rs-left"><div></div><div></div></div><div class="rs rs-right"><div></div><div></div></div><div class="rc rc-tl"><div></div></div><div class="rc rc-tr"><div></div></div><div class="rc rc-bl"><div></div></div><div class="rc rc-br"><div></div></div></div>

	<div class="screen-frame">
		<div class="screen-header">
			<div class="screen-heading">
				<div class="screen-crumb"><gametext key="GUI:CustomMatch"/><span class="crumb-sep">&#8250;</span></div>
				<div class="screen-title ns-title">{{game_name}}</div>
			</div>
			<!-- Rules the host set when creating the game: shown here, never edited. -->
			<div class="screen-header-aside ns-rules">
				<div class="rule" data-class-on="limit_armies" data-tooltip="TOOLTIP:LimitArmies"><span class="rule-box"></span><gametext key="GUI:LimitArmies"/></div>
				<div class="rule on" data-if="use_stats" data-tooltip="TOOLTIP:UseStatsOn"><span class="rule-box"></span><gametext key="GUI:UseStats"/></div>
				<div class="rule" data-if="!use_stats" data-tooltip="TOOLTIP:UseStatsOff"><span class="rule-box"></span><gametext key="GUI:UseStats"/></div>
			</div>
		</div>

		<div class="screen-body">
			<!-- One card per slot, two across: the skirmish card plus who is ready, the host, and each
			     remote player's connection. Only the host picks occupants (Open or Closed on a player's
			     select kicks them); everyone edits their own slot, the host the AI slots too. What this
			     machine cannot edit reads as text. -->
			<div class="col col-main">
				<div class="pc-grid ns-cards scroll-container">
					<div class="player-card" data-for="row : slots" data-class-pc-compact="!row.is_occupied" data-class-human="row.is_human_occupant"
						data-style-border-left-color="!row.is_occupied ? '#8080FF28' : (row.color &lt; 0 ? '#7079A0' : row.color_hex)">
						<div class="pc-top">
							<div class="pc-slot-no" data-if="!row.is_occupied">{{row.slot_index + 1}}</div>
							<div class="pc-badge" data-if="row.is_occupied">
								<div data-for="opt : faction_options"><mappedimage data-if="opt.value == row.player_template &amp;&amp; opt.icon != ''" data-attr-name="opt.icon"/><span data-if="opt.value == row.player_template &amp;&amp; opt.icon == ''">?</span></div>
							</div>
							<div class="pc-who">
								<!-- The SLOT_PLAYER option keeps a player's value matched: RmlUi fires a phantom
								     change (a kick) for a select whose value has no option. -->
								<select data-if="row.can_edit_occupant" data-value="row.occupant_state" data-attrif-disabled="settings_locked"
									data-event-change="slot_occupant_changed(row.slot_index)">
									<option value="0"><gametext key="GUI:Open"/></option>
									<option value="1"><gametext key="GUI:Closed"/></option>
									<option value="2"><gametext key="GUI:EasyAI"/></option>
									<option value="3"><gametext key="GUI:MediumAI"/></option>
									<option value="4"><gametext key="GUI:HardAI"/></option>
									<option class="occ-player" value="5" disabled="disabled">{{row.occupant_label}}</option>
								</select>
								<div class="pc-name" data-if="!row.can_edit_occupant &amp;&amp; row.is_human_occupant">{{row.player_name}}</div>
								<div class="pc-state" data-if="!row.can_edit_occupant &amp;&amp; !row.is_human_occupant"><gametext key="GUI:Open" data-if="row.occupant_state == 0"/><gametext key="GUI:Closed" data-if="row.occupant_state == 1"/><gametext key="GUI:EasyAI" data-if="row.occupant_state == 2"/><gametext key="GUI:MediumAI" data-if="row.occupant_state == 3"/><gametext key="GUI:HardAI" data-if="row.occupant_state == 4"/></div>
							</div>
							<div class="pc-status" data-if="row.is_human_occupant">
								<div class="conn" data-if="!row.is_local" data-class-connected="row.is_connected" data-attr-data-tooltip-text="row.connection_tooltip"><span class="conn-dot"></span><span class="conn-ms" data-if="row.latency_ms &gt;= 0">{{row.latency_ms}} ms</span></div>
								<div class="chip-label warn" data-if="!row.has_map"><gametext key="GUI:GONoMap"/></div>
								<div class="chip-label accent" data-if="row.is_host_slot"><gametext key="GUI:GOHost"/></div>
								<div class="chip-label good" data-if="!row.is_host_slot &amp;&amp; row.accepted" data-tooltip="TOOLTIP:GameAcceptance"><gametext key="GUI:GOReady"/></div>
							</div>
							<div class="pc-add" data-if="!row.is_occupied &amp;&amp; row.can_edit_occupant">
								<div class="pc-add-label overline"><gametext key="GUI:GOAddAI"/></div>
								<button data-attrif-disabled="settings_locked" data-event-click="slot_occupant_picked(row.slot_index, 2)" data-tooltip="GUI:EasyAI"><span class="pc-plus">+</span><gametext key="GUI:EasyCaps"/></button>
								<button data-attrif-disabled="settings_locked" data-event-click="slot_occupant_picked(row.slot_index, 3)" data-tooltip="GUI:MediumAI"><span class="pc-plus">+</span><gametext key="GUI:MediumDifficultyCaps"/></button>
								<button data-attrif-disabled="settings_locked" data-event-click="slot_occupant_picked(row.slot_index, 4)" data-tooltip="GUI:HardAI"><span class="pc-plus">+</span><gametext key="GUI:HardCaps"/></button>
							</div>
							<div class="pc-spot" data-if="row.is_occupied" data-class-random="row.start_position &lt; 0" data-style-border-color="row.start_position &lt; 0 ? '#8080FF46' : (row.color &lt; 0 ? '#A9B1CF' : row.color_hex)">{{row.start_position &lt; 0 ? '?' : row.start_position + 1}}</div>
						</div>
						<div class="pc-line" data-if="row.is_occupied">
							<select class="army-select" data-if="row.can_edit" data-value="row.player_template" data-attr-data-tooltip-text="row.faction_tooltip" data-attrif-disabled="settings_locked"
								data-event-change="slot_faction_changed(row.slot_index)">
								<option data-for="opt : faction_options" data-attr-value="opt.value"><mappedimage class="army-icon" data-if="opt.icon != ''" data-attr-name="opt.icon"/><span class="army-icon army-random" data-if="opt.icon == ''">?</span><span class="army-name">{{opt.label}}</span></option>
							</select>
							<div class="army-ro" data-if="!row.can_edit" data-attr-data-tooltip-text="row.faction_tooltip"><div data-for="opt : faction_options"><mappedimage class="army-icon" data-if="opt.value == row.player_template &amp;&amp; opt.icon != ''" data-attr-name="opt.icon"/><span class="army-icon army-random" data-if="opt.value == row.player_template &amp;&amp; opt.icon == ''">?</span></div><span class="army-ro-label">{{row.faction_label}}</span></div>
							<div class="seg team-seg">
								<button class="seg-item" data-class-on="row.team_number == -1" data-attrif-disabled="!row.can_edit || settings_locked" data-event-click="slot_team_picked(row.slot_index, -1)"><gametext key="Team:0"/></button>
								<button class="seg-item" data-class-on="row.team_number == 0" data-attrif-disabled="!row.can_edit || settings_locked" data-event-click="slot_team_picked(row.slot_index, 0)"><gametext key="Team:1"/></button>
								<button class="seg-item" data-class-on="row.team_number == 1" data-attrif-disabled="!row.can_edit || settings_locked" data-event-click="slot_team_picked(row.slot_index, 1)"><gametext key="Team:2"/></button>
								<button class="seg-item" data-class-on="row.team_number == 2" data-attrif-disabled="!row.can_edit || settings_locked" data-event-click="slot_team_picked(row.slot_index, 2)"><gametext key="Team:3"/></button>
								<button class="seg-item" data-class-on="row.team_number == 3" data-attrif-disabled="!row.can_edit || settings_locked" data-event-click="slot_team_picked(row.slot_index, 3)"><gametext key="Team:4"/></button>
							</div>
						</div>
						<div class="pc-line" data-if="row.is_occupied">
							<div class="swatches">
								<button class="swatch" data-for="opt : row.color_options" data-class-random="opt.value &lt; 0" data-class-on="opt.value == row.color"
									data-class-taken="opt.taken" data-attrif-disabled="!row.can_edit || opt.taken || settings_locked"
									data-event-click="slot_color_picked(row.slot_index, opt.value)"><span class="chip"
									data-style-background-color="opt.value &lt; 0 ? '#141A3E' : opt.swatch"><span data-if="opt.value &lt; 0">?</span></span></button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- The map and the host's options over the chat. -->
			<div class="col col-side">
				<div class="surface map-card">
					<div class="map-frame">
						<mappreview class="map-image" data-attr-map="map_name" data-if="map_found">
							<div data-for="marker : start_markers">
								<div class="marker" data-if="marker.used" data-class-occupied="marker.is_occupied"
									data-style-left="marker.x_style" data-style-top="marker.y_style"
									data-event-click="start_marker_clicked(marker.position)"
									data-event-mousedown="start_marker_mousedown(marker.position)">
									<div class="marker-dot" data-style-background-color="marker.color_hex">{{marker.position + 1}}</div>
									<div class="marker-label" data-if="marker.is_occupied"><span>{{marker.occupant_label}}</span></div>
								</div>
							</div>
						</mappreview>
						<div class="map-missing" data-if="!map_found"><gametext key="GUI:CantFindMap"/></div>
					</div>
					<div class="map-row">
						<div class="map-name">{{map_display_text}}</div>
						<button class="btn-small" data-if="is_host" data-attrif-disabled="settings_locked" data-event-click="select_map" data-tooltip="Tooltip:SelectMap"><gametext key="GUI:SelectMap"/></button>
					</div>
					<div class="ns-options">
						<div class="opt-label"><gametext key="GUI:StartingMoney"/></div>
						<div class="seg cash-seg" data-if="starting_cash_options.size &lt;= 4" data-tooltip="TOOLTIP:StartingMoney">
							<button class="seg-item" data-for="opt : starting_cash_options" data-class-on="opt.value == starting_cash"
								data-attrif-disabled="!cash_and_sw_enabled || settings_locked" data-event-click="starting_cash_picked(opt.value)">{{opt.label}}</button>
						</div>
						<select class="seg-overflow" data-if="starting_cash_options.size &gt; 4" data-attr-value="starting_cash" data-attrif-disabled="!cash_and_sw_enabled || settings_locked"
							data-event-change="starting_cash_selected" data-tooltip="TOOLTIP:StartingMoney">
							<option data-for="opt : starting_cash_options" data-attr-value="opt.value">{{opt.label}}</option>
						</select>
						<label class="check" data-tooltip="TOOLTIP:LimitSuperweapons">
							<input class="checkbox" type="checkbox" data-checked="superweapons_restricted" data-attrif-disabled="!cash_and_sw_enabled || settings_locked"
								data-event-change="superweapons_changed"/>
							<gametext key="GUI:LimitSuperweapons"/>
						</label>
					</div>
				</div>

				<div class="surface chat-card">
					<scrolllog class="chat-log">
						<div class="chat-line" data-for="line : chat_lines"><span data-style-color="line.color">{{line.text}}</span></div>
					</scrolllog>
					<div class="chat-entry">
						<input type="text" class="chat-input" maxlength="128" data-value="chat_entry_text" data-event-change="chat_entry_committed"/>
						<button class="icon-btn" data-event-click="send_chat" data-tooltip="TOOLTIP:EmoteButton"><mappedimage name="ReturnButton"/></button>
					</div>
				</div>
			</div>
		</div>

		<div class="action-bar">
			<button class="btn-back" data-attrif-disabled="!back_enabled" data-event-click="back"><span class="chevron">&#8249;</span><gametext key="GUI:Back"/></button>
			<!-- Where the start stands: the host's match-start countdown, or a client that accepted and
			     waits on the host. -->
			<div class="ns-state countdown" data-if="countdown_seconds &gt;= 0">
				<div class="overline"><gametext key="GUI:GOStartingIn"/></div>
				<div class="ns-count pulse">{{countdown_seconds}}</div>
			</div>
			<div class="ns-state" data-if="countdown_seconds &lt; 0 &amp;&amp; !is_host &amp;&amp; local_accepted">
				<div class="chip-label good"><gametext key="GUI:GOReady"/></div>
				<div class="ns-state-text"><gametext key="GUI:GOWaitingForHost"/></div>
			</div>
			<div class="spacer"></div>
			<button data-attrif-disabled="!communicator_enabled" data-event-click="communicator_clicked">{{communicator_label}}</button>
			<button class="btn-cta" data-attrif-disabled="!start_enabled" data-event-click="start"><gametext key="GUI:Start" data-if="is_host"/><gametext key="GUI:Accept" data-if="!is_host"/></button>
		</div>
	</div>
</body>
</rml>
