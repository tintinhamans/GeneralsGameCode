/*
	GameSetup.rcss -- shared pieces of the game setup screens (skirmish, LAN, online) and the map
	select screens: the slot table, the options panels under it, the map preview with its
	start-position markers, and the map list rows. Sizes follow the tokens in common.rcss.

	Setup screen layout, loosely the .wnd arrangement (slot table top left, map preview top right,
	game options under the slots, chat along the bottom):

		<div class="setup-body">
			<div class="setup-main">
				<div class="slot-table"> .slot-row.slot-header, then one .slot-row per slot </div>
				<div class="setup-lower"> one or more .panel-box option groups (.row grids) </div>
			</div>
			<div class="side-panel"> .map-preview, .map-display-name, Select Map button </div>
		</div>

	One slot row (the cells hold full-width controls so every row lines up under the header):

		<div class="slot-row" data-for="row : slots" data-class-empty="!row.is_occupied">
			<div class="slot-occupant"> <select> Open/Closed/AI, or .slot-name for a human </div>
			<div class="slot-color"> <select> over row.color_options, each option
				<span class="color-swatch" data-style-background-color="opt.swatch"/>{{opt.label}} </div>
			<div class="slot-faction"> <select> over faction_options </div>
			<div class="slot-team"> <select> Team:0..Team:4 </div>
		</div>

	Every select must always have an option matching its bound value: RmlUi selects the first
	option when nothing matches and dispatches "change" for it, which the screens would apply to
	the game. Hence the hidden SLOT_PLAYER occupant option on human rows and the Random entries in
	the colour and faction lists.

	x_style/y_style of a start marker are pre-formatted CSS lengths ("12.500%"): RmlUi can't
	interpolate "{{expr}}" inside style="..." and data-style-<prop> takes one expression.
	start_markers is always MAX_SLOTS entries (a bound array must never shrink in place), so unused
	positions are hidden with data-if="marker.used" on a child of a plain data-for wrapper.

	Map list row (see RmlSkirmishMapSelectScreen::MapEntryModel):

		<div class="list-row flex map-row" data-for="entry : maps" data-class-selected="entry.is_selected"
			data-event-click="map_selected(entry.map_name)" data-event-dblclick="map_activated(entry.map_name)">
			<mappedimage class="map-star" data-attr-name="entry.star_image" data-if="entry.has_star_image"/>
			<div class="map-name">{{entry.display_name}}</div>
			<div class="map-players">{{entry.num_players}}</div>
		</div>
*/

/* ---- Setup screen layout ------------------------------------------------------------------ */
.setup-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 auto;
	min-height: 0;
}

.setup-main
{
	display: flex;
	flex-direction: column;
	flex: 1 1 0%;
	min-width: 0;
	margin-right: 16dp;
}

.map-select-body
{
	display: flex;
	flex-direction: row;
	flex: 1 1 0%;
	min-height: 0;
}

/* The lobby player lists reuse this for a scrolling column. */
.slot-list
{
	flex: 1 1 auto;
	margin-right: 16dp;
	min-height: 0;
}

.map-list
{
	flex: 1 1 0%;
	min-width: 0;
	min-height: 0;
	margin-right: 16dp;
}

.side-panel
{
	flex: 0 0 auto;
	width: 384dp;
	display: flex;
	flex-direction: column;
}

.side-panel > button
{
	display: block;
}

/* Option groups under the slot table, side by side and as tall as the tallest group. */
.setup-lower
{
	display: flex;
	flex-direction: row;
	flex: 0 0 auto;
	margin-top: 16dp;
}

.setup-lower > .panel-box
{
	flex: 1 1 0%;
	min-width: 0;
	max-width: 720dp;
	margin-right: 16dp;
}

.setup-lower > .panel-box:last-child
{
	margin-right: 0;
}

.setup-lower .row:last-child
{
	margin-bottom: 0;
}

.setup-lower .row > .label
{
	flex-basis: 48%;
}

/* ---- Slot table --------------------------------------------------------------------------
   Header plus eight rows of 40dp, growing to 58dp when the screen has the height to spare, so
   the table fills the space over the option groups instead of leaving it empty. Columns share
   the width 3 : 2.2 : 3 : 1.4 (players, colour, army, team) with an 8dp gutter; LAN/online add
   a fixed accept column. */
.slot-table
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

.slot-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	box-sizing: border-box;
	flex: 1 1 40dp;
	min-height: 40dp;
	max-height: 58dp;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.slot-row.slot-header
{
	flex: 0 0 32dp;
	min-height: 32dp;
	height: 32dp;
	font-size: 18dp;
	font-weight: bold;
	color: #8080FF;
	border-bottom: 1dp #2F37A8;
}

.slot-occupant, .slot-color, .slot-faction, .slot-team
{
	box-sizing: border-box;
	min-width: 0;
	margin-right: 8dp;
}

.slot-occupant { flex: 3 1 0%; }
.slot-color { flex: 2.2 1 0%; }
.slot-faction { flex: 3 1 0%; }
.slot-team { flex: 1.4 1 0%; }

.slot-row select
{
	width: 100%;
}

.slot-name
{
	box-sizing: border-box;
	height: 32dp;
	line-height: 32dp;
	padding: 0 9dp;
	color: #FFFFFF;
	font-weight: bold;
	white-space: nowrap;
	overflow: hidden;
}

/* Open and closed slots: nothing to set but the occupant, so the rest of the row recedes. */
.slot-row.empty .slot-color,
.slot-row.empty .slot-faction,
.slot-row.empty .slot-team
{
	opacity: 0.45;
}

/* Per-slot accept indicator (only the local slot shows one). */
.slot-accept
{
	flex: 0 0 auto;
	width: 18dp;
	height: 18dp;
	box-sizing: border-box;
	border: 1dp #2F37A8;
	background-color: rgba(255, 255, 255, 40);
}

.slot-row.slot-header .slot-accept
{
	border-width: 0;
	background-color: transparent;
}

.slot-accept.hidden
{
	visibility: hidden;
}

.slot-accept.accepted
{
	background-color: #40C040;
	border-color: #FFFFFF;
}

/* ---- Map preview + start-position markers ------------------------------------------------
   Square, the side panel's full width. */
.map-preview
{
	box-sizing: border-box;
	position: relative;
	flex: 0 0 auto;
	width: 384dp;
	height: 384dp;
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 191);
}

.map-preview-image
{
	display: block;
	width: 100%;
	height: 100%;
}

.map-not-found
{
	width: 100%;
	height: 100%;
	display: flex;
	align-items: center;
	justify-content: center;
	text-align: center;
	color: #C0C0C0;
}

.map-display-name
{
	flex: 0 0 auto;
	margin: 8dp 0 12dp 0;
	color: #C0C0C0;
}

.start-marker
{
	position: absolute;
	width: 20dp;
	height: 20dp;
	margin-left: -10dp;
	margin-top: -10dp;
	text-align: center;
}

.start-marker-dot
{
	display: block;
	box-sizing: border-box;
	margin: 1dp auto 0 auto;
	width: 18dp;
	height: 18dp;
	border: 2dp #FFFFFF;
	background-color: rgba(255, 255, 255, 60);
}

.start-marker:hover .start-marker-dot
{
	border-color: #BAFF0C;
}

.start-marker-dot.occupied
{
	border-color: #8080FF;
}

.start-marker-label
{
	display: block;
	margin-left: -60dp;
	margin-right: -60dp;
	text-align: center;
	font-size: 13dp;
	color: #FFFFFF;
	font-effect: shadow(1dp 1dp #000000);
	white-space: nowrap;
}

/* ---- Map-list rows ----------------------------------------------------------------------- */
/* On top of common.rcss's .list-row.flex. */
.map-star
{
	flex: 0 0 auto;
	width: 18dp;
	height: 18dp;
	margin-right: 8dp;
}

.map-name
{
	flex: 1 1 auto;
	color: #FFFFFF;
}

.map-players
{
	flex: 0 0 auto;
	width: 40dp;
	text-align: center;
	color: #C0C0C0;
}

/* Beside the expanded social dock on 5:4 and 4:3: a smaller map so the slot table keeps its width. */
@media (max-aspect-ratio: 3/2)
{
	.dock-open .side-panel { width: 260dp; }
	.dock-open .map-preview { width: 260dp; height: 260dp; }
}
