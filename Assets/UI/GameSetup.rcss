/*
	GameSetup.rcss -- shared markup/styles for skirmish-style game setup and map-select screens
	(slot rows, map preview + start-position markers, map-list rows). Built for
	SkirmishGameOptions.rml/SkirmishMapSelect.rml; LAN/online lobby and map-select screens can
	reuse the same classes over the same GameSetupData/SkirmishSetupActions/MapUtil-shaped data by
	copying the "slot-row"/"map-preview"/"start-marker"/"map-row" markup blocks below.

	Reusable markup block (copy per screen, one <div class="slot-row" data-for="row : slots"> per
	setup document):

		<div class="slot-row" data-for="row : slots">
			<select class="slot-occupant" data-value="row.occupant_state" data-attr-disabled="!row.can_edit_occupant"
				data-event-change="slot_occupant_changed(row.slot_index)">
				<option value="0"><gametext key="GUI:Open"/></option>
				<option value="1"><gametext key="GUI:Closed"/></option>
				<option value="2"><gametext key="GUI:EasyAI"/></option>
				<option value="3"><gametext key="GUI:MediumAI"/></option>
				<option value="4"><gametext key="GUI:HardAI"/></option>
			</select>
			<div class="slot-name" data-if="row.is_human_occupant">{{row.player_name}}</div>
			<select class="slot-faction" data-value="row.player_template" data-attr-disabled="!row.can_edit || !row.is_occupied"
				data-event-change="slot_faction_changed(row.slot_index)">
				<option data-for="opt : faction_options" data-attr-value="opt.value">{{opt.label}}</option>
			</select>
			<select class="slot-color" data-value="row.color" data-attr-disabled="!row.can_edit || !row.is_occupied"
				data-event-change="slot_color_changed(row.slot_index)">
				<option data-for="opt : color_options" data-attr-value="opt.value" data-style-background-color="opt.label">&#160;</option>
			</select>
			<select class="slot-team" data-value="row.team_number" data-attr-disabled="!row.can_edit || !row.is_occupied"
				data-event-change="slot_team_changed(row.slot_index)">
				<option value="-1"><gametext key="GUI:NoTeam"/></option>
				<option value="0">1</option><option value="1">2</option><option value="2">3</option><option value="3">4</option>
			</select>
		</div>

		<div class="map-preview">
			<mappreview class="map-preview-image" data-attr-map="map_name"/>
			<div data-for="marker : start_markers">
				<div class="start-marker" data-if="marker.used"
					data-style-left="marker.x_style" data-style-top="marker.y_style"
					data-event-click="start_marker_clicked(marker.position)">
					<div class="start-marker-dot" data-class-occupied="marker.is_occupied"
						data-style-background-color="marker.color_hex"></div>
					<div class="start-marker-label" data-if="marker.is_occupied">{{marker.occupant_label}}</div>
				</div>
			</div>
		</div>

	x_style/y_style are pre-formatted CSS length strings ("12.500%"), not raw numbers: RmlUi can't
	interpolate "{{expr}}" inside a style="..." attribute (that's parsed as a literal RCSS property
	value), and data-style-<prop> bindings take one expression value, not string concatenation --
	see RmlSkirmishSetupScreen::StartMarkerModel.

	start_markers is always MAX_SLOTS entries (see GameSetupData::m_startPositionMarkers): a bound
	RmlUi array must never change size in place, so unused positions are hidden with data-if
	("marker.used") on a child instead of shrinking the array. data-for and data-if are both
	structural views and can't share one element, hence the plain wrapper div.

	Reusable map-list row (copy per screen, one <div class="map-row" data-for="entry : maps"> per
	map-select-style document -- see RmlSkirmishMapSelectScreen::MapEntryModel):

		<div class="map-row" data-for="entry : maps" data-class-selected="entry.is_selected"
			data-event-click="map_selected(entry.map_name)" data-event-dblclick="map_activated(entry.map_name)">
			<mappedimage class="map-star" data-attr-name="entry.star_image" data-if="entry.has_star_image"/>
			<div class="map-name">{{entry.display_name}}</div>
			<div class="map-players">{{entry.num_players}}</div>
		</div>

	star_image is a TheMappedImageCollection name ("Star-Bronze"/"Star-Silver"/"Star-Gold"/
	"RedYell_Star"), only set for multiplayer maps with an endurance medal -- same tiering as
	MapUtil.cpp's addMapEntryToMapListbox().
*/

/* ---- Slot rows ------------------------------------------------------------------------- */
.slot-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 3dp 0;
	min-height: 26dp;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.slot-row > select,
.slot-row > .slot-name,
.slot-row > .color-select
{
	box-sizing: border-box;
	margin-right: 6dp;
}

/* Proportional columns so the table fills the whole slot-list width instead of leaving a dead gap
   after a handful of fixed-dp columns (task: "the slot table must use the whole left region").
   .slot-name substitutes for .slot-occupant on the host's own row (a name, not a select), so it
   matches its width exactly to keep every row's cells aligned under the header. */
/* percentages sum to under 100% to leave room for the 6dp margin-right between columns above */
.slot-occupant, .slot-name { width: 34%; }
.slot-faction { width: 32%; }
.slot-color { width: 11%; }
.slot-team { width: 19%; }
.slot-name { color: #FFFFFF; font-weight: bold; }

/* Color-slot swatch: an inner element carrying the data-style-background-color instead of the
   <option>/selectvalue itself, so the colour survives RmlUi's <select> copying the chosen
   option's content into its internal selectvalue element (task: "make the swatch survive that"). */
.color-swatch
{
	display: block;
	width: 100%;
	height: 14dp;
	border: 1dp rgba(255, 255, 255, 80);
}

/* RmlUi's internal selectvalue box doesn't reliably size itself to its <select>'s own content
   width (it can end up sized off the widest cloned option instead), so a full-width .color-swatch
   cloned into it can bleed past the select's right edge into the next column. Rather than rely on
   that box, hide the cloned swatch when it's sitting inside selectvalue (it's still shown normally
   in the open dropdown list, where it's a real descendant of each <option>) and paint the current
   colour with a plain overlay div sized off the wrapper instead, which lays out like any other
   block and can't escape it. */
.color-select
{
	position: relative;
}

.color-select > select
{
	width: 100%;
	box-sizing: border-box;
}

.color-select > select selectvalue .color-swatch
{
	display: none;
}

.color-select > .color-chip
{
	position: absolute;
	left: 1dp;
	top: 1dp;
	right: 1dp;
	bottom: 1dp;
	pointer-events: none;
}

/* common.rcss's .row/.label/.control assume a wide options panel (.label flex-grows, .control is a
   fixed 220dp); the 280dp side-panel here is too narrow for that, so the label wraps/overlaps the
   control. Shrink the label to its own text and let the control take what's left instead. */
.side-panel .row > .label
{
	flex: 0 0 auto;
	width: auto;
	margin-right: 8dp;
	white-space: nowrap;
}

.side-panel .row > .control
{
	flex: 1 1 auto;
	width: auto;
	min-width: 0;
}

/* ---- Map preview + start-position markers ----------------------------------------------
   Fixed square, larger than before (was 256dp) now that side panels have more room on a
   full shell screen; RmlUi's flex layout doesn't reliably support percentage-of-width
   padding tricks for a responsive aspect box, so this stays a fixed dp size. */
.map-preview
{
	box-sizing: border-box;
	position: relative;
	width: 320dp;
	height: 320dp;
	border: 1dp #2F37A8;
	background-color: rgba(2, 2, 2, 191);
}

.map-preview-image
{
	display: block;
	width: 100%;
	height: 100%;
}

.start-marker
{
	position: absolute;
	width: 20dp;
	height: 20dp;
	margin-left: -10dp;
	margin-top: -10dp;
	text-align: center;
}

.start-marker-dot
{
	width: 16dp;
	height: 16dp;
	border: 1dp #FFFFFF;
	background-color: rgba(255, 255, 255, 60);
}

.start-marker-dot.occupied
{
	border-color: #8080FF;
}

.start-marker-label
{
	font-size: 11dp;
	color: #FFFFFF;
	white-space: nowrap;
}

/* ---- Map-list rows ----------------------------------------------------------------------- */
.map-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4dp 6dp;
	min-height: 24dp;
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.map-row:hover
{
	background-color: rgba(47, 55, 168, 60);
}

.map-row.selected
{
	background-color: rgba(47, 55, 168, 120);
	border: 1dp #8080FF;
}

.map-star
{
	width: 16dp;
	height: 16dp;
	margin-right: 6dp;
}

.map-name
{
	flex: 1 1 auto;
	color: #FFFFFF;
}

.map-players
{
	width: 30dp;
	text-align: center;
	color: #C0C0C0;
}
