			<div class="cb-slot cb-sci cb-r8 cb-c1" data-cb="g20" data-alias-s="sciences[20]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div>
