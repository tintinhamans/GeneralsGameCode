	</div>

	<!-- The general's promotions (GeneralsExpPoints.wnd): the rank, points to spend and the three tiers -->
	<div class="cb-panel cb-science" id="cb-science" data-if="science_shown">
		<div class="cb-sci-head">
			<div class="cb-sci-title">{{science_title}}</div>
			<div class="cb-sci-points" data-if="science_points &gt; 0"><span class="cb-sci-star">&#9733;</span>{{science_points}}</div>
		</div>
		<div class="cb-sci-exp"><div class="cb-exp-fill" data-style-width="experience"></div></div>
		<div class="cb-sci-tier"><gametext key="GUI:Rank1Required"/></div>
		<div class="cb-sci-row"><div class="cb-slot cb-sci" data-cb="g0" data-alias-s="sciences[0]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g1" data-alias-s="sciences[1]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g2" data-alias-s="sciences[2]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g3" data-alias-s="sciences[3]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div></div>
		<div class="cb-sci-tier"><gametext key="GUI:Rank3Required"/></div>
		<div class="cb-sci-row cb-sci-rank3"><div class="cb-slot cb-sci" data-cb="g4" data-alias-s="sciences[4]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g5" data-alias-s="sciences[5]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g6" data-alias-s="sciences[6]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g7" data-alias-s="sciences[7]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g8" data-alias-s="sciences[8]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g9" data-alias-s="sciences[9]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g10" data-alias-s="sciences[10]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g11" data-alias-s="sciences[11]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g12" data-alias-s="sciences[12]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g13" data-alias-s="sciences[13]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g14" data-alias-s="sciences[14]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g15" data-alias-s="sciences[15]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g16" data-alias-s="sciences[16]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g17" data-alias-s="sciences[17]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g18" data-alias-s="sciences[18]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div></div>
		<div class="cb-sci-tier"><gametext key="GUI:Rank8Required"/></div>
		<div class="cb-sci-row"><div class="cb-slot cb-sci" data-cb="g19" data-alias-s="sciences[19]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g20" data-alias-s="sciences[20]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g21" data-alias-s="sciences[21]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g22" data-alias-s="sciences[22]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div></div>
		<div class="cb-sci-foot"><div class="cb-text-btn" data-cb="g23" data-alias-s="sciences[23]"><gametext key="GUI:CloseExpScreen"/></div></div>
	</div>

	<!-- The build tooltip over the grid (ControlBarPopupDescription.wnd): name, hotkey, cost, then what it does and what it
	     still needs, as ControlBar::populateBuildTooltipLayout() words it. -->
	<div class="cb-tip" data-if="tooltip_shown">
		<div class="cb-tip-head">
			<div class="cb-tip-name">{{tooltip_name}}</div>
			<div class="cb-tip-key" data-if="tooltip_key != ''">{{tooltip_key}}</div>
		</div>
		<div class="cb-tip-cost" data-if="tooltip_cost != ''">{{tooltip_cost}}</div>
		<div class="cb-tip-desc" data-if="tooltip_description != ''">{{tooltip_description}}</div>
	</div>

	<!-- The selection: portrait, name, veterancy and upgrades, or the build queue, bottom right -->
	<div class="cb-panel cb-unit" data-if="portrait_shown || queue_shown || select_count &gt; 1 || cameo_movie" data-class-narrow="!queue_shown &amp;&amp; !upgrades[0].shown">
		<div class="cb-unit-head">
			<div class="cb-name" data-if="portrait_shown || queue_shown">{{name}}</div>
			<div class="cb-count" data-if="select_count &gt; 1 &amp;&amp; (portrait_shown || queue_shown)">&#215;{{select_count}}</div>
		</div>
		<div class="cb-multi" data-if="!portrait_shown &amp;&amp; !queue_shown"><span class="cb-multi-x">&#215;</span>{{select_count}}</div>
		<div class="cb-unit-body" data-if="portrait_shown">
			<div class="cb-portrait">
				<mappedimage data-if="portrait != ''" data-attr-name="portrait"/>
				<div class="cb-portrait-vet" data-if="portrait_overlay != ''"><mappedimage data-attr-name="portrait_overlay"/></div>
			</div>
			<div class="cb-upgrades">
				<div class="cb-upgrade" data-for="u : upgrades" data-if="u.shown" data-class-owned="u.owned"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div>
			</div>
		</div>
		<video class="cb-cameo-movie" source="cameo-movie" fit="cover" data-if="cameo_movie"></video>
		<div class="cb-queue" data-if="queue_shown">
			<div class="cb-slot cb-qslot" data-cb="q0" data-alias-s="queue[0]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div>
			<div class="cb-slot cb-qslot" data-cb="q1" data-alias-s="queue[1]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div>
			<div class="cb-slot cb-qslot" data-cb="q2" data-alias-s="queue[2]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div>
			<div class="cb-slot cb-qslot" data-cb="q3" data-alias-s="queue[3]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div>
			<div class="cb-slot cb-qslot" data-cb="q4" data-alias-s="queue[4]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div>
			<div class="cb-slot cb-qslot" data-cb="q5" data-alias-s="queue[5]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div>
