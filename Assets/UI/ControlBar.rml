<rml>
<head>
	<title>ControlBar</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ControlBar.rcss"/>
</head>
<!-- The in-game control bar (RmlControlBarScreen), a view over ControlBar.wnd, which stays the model. The
     body takes no pointer events: only the panels do, so the battlefield keeps every other click. Each
     button carries data-cb (c = command slot, q = queue, s = side, x = context button) for the view's
     listener, which hands the pointer to the .wnd button behind it. -->
<body class="cb" data-model="controlbar" data-class-low="low" data-class-usa="side == 'usa'" data-class-china="side == 'china'" data-class-gla="side == 'gla'">

	<!-- Radar, bottom left -->
	<div class="cb-panel cb-radar" data-class-alert="radar_alert">
		<div class="cb-radar-well" data-class-dark="!has_radar"><radar class="cb-radar-map" data-world-middle="1"></radar></div>
	</div>

	<!-- Money, power, the command grid and the buttons round the bar, bottom centre -->
	<div class="cb-panel cb-main">
		<div class="cb-strip">
			<div class="cb-money" data-cb="i0" data-if="money_shown">{{money}}</div>
			<div class="cb-power" data-cb="i1" data-if="power_shown" data-class-low-power="power_state == 1" data-class-no-power="power_state == 2">
				<div class="cb-power-label"><gametext key="CONTROLBAR:Power"/></div>
				<div class="cb-power-bar"><div class="cb-power-track"></div><div class="cb-power-fill" data-style-width="power_fill"></div><div class="cb-power-rail"><div class="cb-power-needle" data-style-left="power_needle"></div></div></div>
				<div class="cb-power-value">{{power_text}}</div>
			</div>
			<div class="cb-replay" data-if="replay"><gametext key="GO:GUI:HudReplay"/></div>
			<div class="cb-rank" data-cb="i2" data-if="!observer_list_shown &amp;&amp; !observer_info_shown">
				<div class="cb-rank-stars"><span class="cb-star" data-class-on="rank &gt;= 1">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 2">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 3">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 4">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 5">&#9733;</span></div>
				<div class="cb-exp"><div class="cb-exp-fill" data-style-width="experience"></div></div>
			</div>
		</div>
		<div class="cb-body">
			<!-- ButtonCommand01..14: two rows, filled column by column like the .wnd -->
			<div class="cb-grid" data-if="context != 'construction' &amp;&amp; context != 'ocl' &amp;&amp; context != 'beacon' &amp;&amp; !observer_list_shown &amp;&amp; !observer_info_shown">
				<div class="cb-slot" data-cb="c0" data-alias-s="commands[0]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c1" data-alias-s="commands[1]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c2" data-alias-s="commands[2]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c3" data-alias-s="commands[3]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c4" data-alias-s="commands[4]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c5" data-alias-s="commands[5]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c6" data-alias-s="commands[6]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c7" data-alias-s="commands[7]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c8" data-alias-s="commands[8]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c9" data-alias-s="commands[9]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c10" data-alias-s="commands[10]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c11" data-alias-s="commands[11]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c12" data-alias-s="commands[12]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c13" data-alias-s="commands[13]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			</div>

			<!-- Under construction and OCL timers: what is going on, its progress, and the one button -->
			<div class="cb-task" data-if="context == 'construction' || context == 'ocl'">
				<div class="cb-slot cb-task-slot" data-cb="x0" data-if="context == 'construction'" data-alias-s="context_buttons[0]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
				<div class="cb-slot cb-task-slot" data-cb="x1" data-if="context == 'ocl'" data-alias-s="context_buttons[1]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
				<div class="cb-task-info">
					<div class="cb-task-text">{{context_text}}</div>
					<div class="cb-task-bar" data-if="context_has_percent"><div class="cb-task-fill" data-style-width="context_percent"></div></div>
				</div>
			</div>

			<!-- Observing: the players to look at (ButtonPlayer0..7) -->
			<div class="cb-observers" data-if="observer_list_shown">
				<div class="cb-obs-player" data-for="p : observer_players" data-if="p.shown" data-attr-data-cb="'o' + it_index">
					<div class="cb-obs-side"><mappedimage data-if="p.icon != ''" data-attr-name="p.icon"/></div>
					<div class="cb-obs-name" data-style-color="p.color">{{p.name}}</div>
				</div>
			</div>

			<!-- Observing a player: name, flag, units, buildings, kills, losses and Back -->
			<div class="cb-observed" data-if="observer_info_shown">
				<div class="cb-obs-flag"><mappedimage data-if="observer_flag != ''" data-attr-name="observer_flag"/></div>
				<div class="cb-obs-main">
					<div class="cb-obs-title" data-style-color="observer_color">{{observer_name}}</div>
					<div class="cb-obs-stats">
						<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_units}}</div><div class="cb-obs-label"><gametext key="GUI:Units"/></div></div>
						<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_buildings}}</div><div class="cb-obs-label"><gametext key="GUI:Buildings"/></div></div>
						<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_kills}}</div><div class="cb-obs-label"><gametext key="GUI:UnitsKilled"/></div></div>
						<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_losses}}</div><div class="cb-obs-label"><gametext key="GUI:UnitsLost"/></div></div>
					</div>
				</div>
				<div class="cb-text-btn cb-obs-back" data-cb="o8" data-alias-s="observer_buttons[8]" data-if="s.shown"><gametext key="GUI:ControlBarBack"/></div>
			</div>

			<!-- A beacon: delete it, and for our own its message (EditBeaconText; Enter sends it) -->
			<div class="cb-task cb-beacon" data-if="context == 'beacon'">
				<div class="cb-text-btn cb-beacon-delete" data-cb="x2" data-alias-s="context_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:DeleteBeacon"/></div>
				<div class="cb-beacon-entry" data-if="beacon_editable">
					<div class="cb-beacon-label"><gametext key="GUI:BeaconLabel"/></div>
					<div class="cb-beacon-row">
						<input type="text" id="cb-beacon-text" class="cb-input" maxlength="64" data-value="beacon_text" data-event-change="beacon_change"/>
						<div class="cb-text-btn" data-cb="x3" data-alias-s="context_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:Clear"/></div>
					</div>
				</div>
			</div>

			<!-- Round the bar: menu, idle workers, beacon, diplomacy, the general's promotions, collapse -->
			<div class="cb-side">
				<div class="cb-side-btn" data-cb="s0" data-alias-s="side_buttons[0]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9776;</span></div>
				<div class="cb-side-btn" data-cb="s1" data-alias-s="side_buttons[1]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9874;</span><span class="cb-badge" data-if="s.text != ''">{{s.text}}</span></div>
				<div class="cb-side-btn" data-cb="s2" data-alias-s="side_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9873;</span></div>
				<div class="cb-side-btn" data-cb="s3" data-alias-s="side_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9993;</span></div>
				<div class="cb-side-btn cb-general" data-cb="s4" data-alias-s="side_buttons[4]" data-if="s.shown" data-class-off="!s.enabled" data-class-lit="general_lit"><span class="cb-glyph">&#9733;</span><span class="cb-badge" data-if="science_points &gt; 0">{{science_points}}</span></div>
				<div class="cb-side-btn" data-cb="s5" data-alias-s="side_buttons[5]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph" data-if="!low">&#9662;</span><span class="cb-glyph" data-if="low">&#9652;</span></div>
			</div>
		</div>
	</div>

	<!-- The general's powers, down the left edge above the chat line (GenPowersShortcutBar*.wnd) -->
	<div class="cb-panel cb-powers" data-if="shortcuts_shown">
		<div class="cb-slot cb-pslot" data-cb="p0" data-alias-s="shortcuts[0]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p1" data-alias-s="shortcuts[1]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p2" data-alias-s="shortcuts[2]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p3" data-alias-s="shortcuts[3]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p4" data-alias-s="shortcuts[4]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p5" data-alias-s="shortcuts[5]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p6" data-alias-s="shortcuts[6]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		<div class="cb-slot cb-pslot" data-cb="p7" data-alias-s="shortcuts[7]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
