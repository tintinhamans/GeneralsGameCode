<rml>
<head>
	<title>ControlBar</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ControlBar.rcss"/>
</head>
<!-- The in-game control bar (RmlControlBarScreen), a view over ControlBar.wnd, which stays the model. The
     body takes no pointer events: only the panels do, so the battlefield keeps every other click. Each
     button carries data-cb (c = command slot, q = queue, s = side, x = context button) for the view's
     listener, which hands the pointer to the .wnd button behind it. The faction class picks the art,
     Control Bar Pro's (Textures/ControlBar/README.md); observers get Pro's observer bar. -->
<body class="cb" data-model="controlbar" data-class-low="low" data-class-usa="!observer &amp;&amp; side != 'china' &amp;&amp; side != 'gla'" data-class-china="!observer &amp;&amp; side == 'china'" data-class-gla="!observer &amp;&amp; side == 'gla'" data-class-neutral="observer">

	<!-- The full width, or a centred band on wide screens -->
	<div class="cb-dock">

		<!-- Radar, bottom left; the engine draws the map into the screen (RmlRadarElement) -->
		<div class="cb-panel cb-radar" data-class-alert="radar_alert">
			<radar class="cb-radar-map" data-world-middle="1" data-class-dark="!has_radar"></radar>
			<div class="cb-alarm" data-if="radar_alert"></div>
		</div>

		<!-- The production panel, bottom centre: the funds in the notch, the power meter, the buttons down its
		     left side and the command grid; for observers Pro's player window next to the radar -->
		<div class="cb-panel cb-main">
			<div class="cb-money" data-cb="i0" data-if="money_shown">{{money}}</div>
			<div class="cb-power" data-cb="i1" data-if="power_shown" data-class-low-power="power_state == 1" data-class-no-power="power_state == 2">
				<div class="cb-power-fill" data-style-width="power_fill"></div>
				<div class="cb-power-rail" data-style-width="power_needle"><div class="cb-power-needle"></div></div>
			</div>
			<div class="cb-power-value" data-if="power_shown" data-class-low-power="power_state == 1" data-class-no-power="power_state == 2">{{power_text}}</div>
			<div class="cb-replay" data-if="replay"><gametext key="GO:GUI:HudReplay"/></div>

			<!-- Options, idle workers, beacon, diplomacy -->
			<div class="cb-side-btn cb-options" data-cb="s0" data-alias-s="side_buttons[0]" data-if="s.shown" data-class-off="!s.enabled"></div>
			<div class="cb-side-btn cb-worker" data-cb="s1" data-alias-s="side_buttons[1]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-badge" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-side-btn cb-beacon-btn" data-cb="s2" data-alias-s="side_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"></div>
			<div class="cb-side-btn cb-chat" data-cb="s3" data-alias-s="side_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"></div>

			<!-- ButtonCommand01..14: two rows, filled column by column like the .wnd -->
			<div class="cb-grid" data-if="context != 'construction' &amp;&amp; context != 'ocl' &amp;&amp; context != 'beacon' &amp;&amp; !observer_list_shown &amp;&amp; !observer_info_shown">
				<div class="cb-slot" data-cb="c0" data-alias-s="commands[0]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c1" data-alias-s="commands[1]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c2" data-alias-s="commands[2]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c3" data-alias-s="commands[3]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c4" data-alias-s="commands[4]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c5" data-alias-s="commands[5]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c6" data-alias-s="commands[6]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c7" data-alias-s="commands[7]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c8" data-alias-s="commands[8]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c9" data-alias-s="commands[9]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c10" data-alias-s="commands[10]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c11" data-alias-s="commands[11]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c12" data-alias-s="commands[12]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				<div class="cb-slot" data-cb="c13" data-alias-s="commands[13]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
			</div>

			<!-- Under construction and OCL timers: Pro's dark overlay over the grid, the one button, what is going on -->
			<div class="cb-task" data-if="context == 'construction' || context == 'ocl'">
				<div class="cb-slot cb-task-slot" data-cb="x0" data-if="context == 'construction'" data-alias-s="context_buttons[0]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
				<div class="cb-slot cb-task-slot" data-cb="x1" data-if="context == 'ocl'" data-alias-s="context_buttons[1]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
				<div class="cb-task-info">
					<div class="cb-task-text">{{context_text}}</div>
					<div class="cb-task-bar" data-if="context_has_percent"><div class="cb-task-fill" data-style-width="context_percent"></div></div>
				</div>
			</div>

			<!-- A beacon: delete it, and for our own its message (EditBeaconText; Enter sends it) -->
			<div class="cb-task cb-beacon" data-if="context == 'beacon'">
				<div class="cb-text-btn cb-beacon-delete" data-cb="x2" data-alias-s="context_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:DeleteBeacon"/></div>
				<div class="cb-beacon-entry" data-if="beacon_editable">
					<div class="cb-beacon-label"><gametext key="GUI:BeaconLabel"/></div>
					<div class="cb-beacon-row">
						<input type="text" id="cb-beacon-text" class="cb-input" maxlength="64" data-value="beacon_text" data-event-change="beacon_change"/>
						<div class="cb-text-btn" data-cb="x3" data-alias-s="context_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:Clear"/></div>
					</div>
				</div>
			</div>

			<!-- Observing: the players to look at (ButtonPlayer0..7) -->
			<div class="cb-observers" data-if="observer_list_shown">
				<div class="cb-obs-player" data-for="p : observer_players" data-if="p.shown" data-attr-data-cb="'o' + it_index">
					<div class="cb-obs-side"><mappedimage data-if="p.icon != ''" data-attr-name="p.icon"/></div>
					<div class="cb-obs-name" data-style-color="p.color">{{p.name}}</div>
				</div>
			</div>

			<!-- Observing a player: name, flag, units, buildings, kills and losses, in Pro's player window -->
			<div class="cb-observed" data-if="observer_info_shown">
				<div class="cb-obs-head">
					<div class="cb-obs-flag"><mappedimage data-if="observer_flag != ''" data-attr-name="observer_flag"/></div>
					<div class="cb-obs-title" data-style-color="observer_color">{{observer_name}}</div>
				</div>
				<div class="cb-obs-stats">
					<div class="cb-obs-stat"><div class="cb-obs-label"><gametext key="GUI:Units"/></div><div class="cb-obs-value">{{observer_units}}</div></div>
					<div class="cb-obs-stat"><div class="cb-obs-label"><gametext key="GUI:Buildings"/></div><div class="cb-obs-value">{{observer_buildings}}</div></div>
					<div class="cb-obs-stat"><div class="cb-obs-label"><gametext key="GUI:UnitsKilled"/></div><div class="cb-obs-value">{{observer_kills}}</div></div>
					<div class="cb-obs-stat"><div class="cb-obs-label"><gametext key="GUI:UnitsLost"/></div><div class="cb-obs-value">{{observer_losses}}</div></div>
				</div>
			</div>
			<div class="cb-side-btn cb-back" data-cb="o8" data-alias-s="observer_buttons[8]" data-if="observer_info_shown &amp;&amp; s.shown"></div>
		</div>

		<!-- The selection, bottom right: name and rank over the general's tab (min/max, promotions), then the
		     portrait and upgrades or the build queue, or the side's logo, and the general's experience -->
		<div class="cb-panel cb-unit">
			<div class="cb-unit-head">
				<div class="cb-name" data-if="portrait_shown || queue_shown">{{name}}<span class="cb-count" data-if="select_count &gt; 1">&#215;{{select_count}}</span></div>
				<div class="cb-rank" data-cb="i2" data-if="!observer_list_shown &amp;&amp; !observer_info_shown"><span class="cb-star" data-class-on="rank &gt;= 1">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 2">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 3">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 4">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 5">&#9733;</span></div>
			</div>
			<div class="cb-side-btn cb-minmax" data-cb="s5" data-alias-s="side_buttons[5]" data-if="s.shown" data-class-off="!s.enabled"></div>
			<div class="cb-side-btn cb-general" data-cb="s4" data-alias-s="side_buttons[4]" data-if="s.shown" data-class-off="!s.enabled" data-class-lit="general_lit"><span class="cb-badge" data-if="science_points &gt; 0">{{science_points}}</span></div>
			<div class="cb-unit-box">
				<div class="cb-emblem" data-if="!portrait_shown &amp;&amp; !queue_shown &amp;&amp; select_count &lt;= 1 &amp;&amp; !cameo_movie"></div>
				<div class="cb-multi" data-if="!portrait_shown &amp;&amp; !queue_shown &amp;&amp; select_count &gt; 1"><span class="cb-multi-x">&#215;</span>{{select_count}}</div>
				<div class="cb-portrait" data-if="portrait_shown">
					<div class="cb-win">
						<mappedimage data-if="portrait != ''" data-attr-name="portrait"/>
						<div class="cb-portrait-vet" data-if="portrait_overlay != ''"><mappedimage data-attr-name="portrait_overlay"/></div>
					</div>
				</div>
				<div class="cb-upgrades" data-if="portrait_shown">
					<div class="cb-upgrade cb-up0" data-alias-u="upgrades[0]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
					<div class="cb-upgrade cb-up1" data-alias-u="upgrades[1]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
					<div class="cb-upgrade cb-up2" data-alias-u="upgrades[2]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
					<div class="cb-upgrade cb-up3" data-alias-u="upgrades[3]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
					<div class="cb-upgrade cb-up4" data-alias-u="upgrades[4]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
				</div>
				<video class="cb-cameo-movie" source="cameo-movie" fit="cover" data-if="cameo_movie"></video>
				<div class="cb-queue" data-if="queue_shown">
					<div class="cb-slot cb-qslot cb-cell0" data-cb="q0" data-alias-s="queue[0]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell1" data-cb="q1" data-alias-s="queue[1]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell2" data-cb="q2" data-alias-s="queue[2]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell3" data-cb="q3" data-alias-s="queue[3]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell4" data-cb="q4" data-alias-s="queue[4]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell5" data-cb="q5" data-alias-s="queue[5]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell6" data-cb="q6" data-alias-s="queue[6]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell7" data-cb="q7" data-alias-s="queue[7]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
					<div class="cb-slot cb-qslot cb-cell8" data-cb="q8" data-alias-s="queue[8]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-hl"></div></div></div>
				</div>
				<div class="cb-exp" data-if="!observer_list_shown &amp;&amp; !observer_info_shown"><div class="cb-exp-well"><div class="cb-exp-fill" data-style-height="experience"></div></div><div class="cb-exp-fg"></div></div>
			</div>
		</div>

		<!-- The general's powers (GenPowersShortcutBar*.wnd): Pro's trays stacked up the right edge -->
