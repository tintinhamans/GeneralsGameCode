			<div class="cb-slot cb-sci cb-r32 cb-c3" data-cb="g15" data-alias-s="sciences[15]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div>
			<div class="cb-slot cb-sci cb-r30 cb-c4" data-cb="g16" data-alias-s="sciences[16]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div>
			<div class="cb-slot cb-sci cb-r31 cb-c4" data-cb="g17" data-alias-s="sciences[17]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div>
			<div class="cb-slot cb-sci cb-r32 cb-c4" data-cb="g18" data-alias-s="sciences[18]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-hl"></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div>
