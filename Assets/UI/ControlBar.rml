<rml>
<head>
	<title>ControlBar</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="ControlBar.rcss"/>
</head>
<!-- The in-game control bar (RmlControlBarScreen), a view over ControlBar.wnd, which stays the model. The
     body takes no pointer events: only the panels do, so the battlefield keeps every other click. Each
     button carries data-cb (c = command slot, q = queue, s = side, x = context button) for the view's
     listener, which hands the pointer to the .wnd button behind it. The faction class picks the art. -->
<body class="cb" data-model="controlbar" data-class-low="low" data-class-usa="!observer &amp;&amp; side == 'usa'" data-class-china="!observer &amp;&amp; side == 'china'" data-class-gla="!observer &amp;&amp; side == 'gla'" data-class-neutral="observer || (side != 'usa' &amp;&amp; side != 'china' &amp;&amp; side != 'gla')">

	<!-- The rail the panels stand on, screen edge to screen edge -->
	<div class="cb-rail"></div>
	<!-- Wings: from the screen edges to the dock, when the dock is narrower than the screen -->
	<div class="cb-wing cb-wing-l"></div>
	<div class="cb-wing cb-wing-r"></div>

	<!-- Everything else lives in the dock: the full width, or a centred band on wide screens -->
	<div class="cb-dock">

		<!-- Radar, bottom left -->
		<div class="cb-panel cb-radar" data-class-alert="radar_alert">
			<div class="cb-skin"></div>
			<div class="cb-radar-well" data-class-dark="!has_radar"><radar class="cb-radar-map" data-world-middle="1"></radar><div class="cb-radar-bezel"></div></div>
			<div class="cb-frame"></div>
		</div>

		<!-- Money, power, the buttons round the bar and the command grid, bottom centre -->
		<div class="cb-centre">
		<div class="cb-panel cb-main">
			<div class="cb-skin"></div>
			<div class="cb-money" data-cb="i0" data-if="money_shown">{{money}}</div>
			<div class="cb-strip">
				<div class="cb-power" data-cb="i1" data-if="power_shown" data-class-low-power="power_state == 1" data-class-no-power="power_state == 2">
					<div class="cb-power-bar"><div class="cb-power-fill" data-style-width="power_fill"></div><div class="cb-power-seg"></div><div class="cb-power-rail" data-style-width="power_needle"><div class="cb-power-needle"></div></div></div>
					<div class="cb-power-value">{{power_text}}</div>
				</div>
				<div class="cb-strip-fill" data-if="!power_shown"></div>
				<div class="cb-replay" data-if="replay"><gametext key="GO:GUI:HudReplay"/></div>
			</div>
			<div class="cb-body">
				<!-- Round the bar, Pro's column left of the grid: menu, idle workers, beacon, diplomacy -->
				<div class="cb-side">
					<div class="cb-side-btn" data-cb="s0" data-alias-s="side_buttons[0]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9776;</span></div>
					<div class="cb-side-btn" data-cb="s1" data-alias-s="side_buttons[1]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9874;</span><span class="cb-badge" data-if="s.text != ''">{{s.text}}</span></div>
					<div class="cb-side-btn" data-cb="s2" data-alias-s="side_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9873;</span></div>
					<div class="cb-side-btn" data-cb="s3" data-alias-s="side_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph">&#9993;</span></div>
				</div>

				<!-- ButtonCommand01..14: two rows, filled column by column like the .wnd -->
				<div class="cb-grid" data-if="context != 'construction' &amp;&amp; context != 'ocl' &amp;&amp; context != 'beacon' &amp;&amp; !observer_list_shown &amp;&amp; !observer_info_shown">
					<div class="cb-slot" data-cb="c0" data-alias-s="commands[0]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c1" data-alias-s="commands[1]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c2" data-alias-s="commands[2]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c3" data-alias-s="commands[3]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c4" data-alias-s="commands[4]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c5" data-alias-s="commands[5]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c6" data-alias-s="commands[6]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c7" data-alias-s="commands[7]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c8" data-alias-s="commands[8]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c9" data-alias-s="commands[9]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c10" data-alias-s="commands[10]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c11" data-alias-s="commands[11]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c12" data-alias-s="commands[12]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
					<div class="cb-slot" data-cb="c13" data-alias-s="commands[13]" data-class-live="commands_shown &amp;&amp; s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash" data-class-b1="s.border == 1" data-class-b2="s.border == 2" data-class-b3="s.border == 3" data-class-b4="s.border == 4"><div class="cb-win"><div class="cb-art" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.key != ''">{{s.key}}</span><span class="cb-text" data-if="commands_shown &amp;&amp; s.shown &amp;&amp; s.text != ''">{{s.text}}</span></div>
				</div>

				<!-- Under construction and OCL timers: what is going on, its progress, and the one button -->
				<div class="cb-task" data-if="context == 'construction' || context == 'ocl'">
					<div class="cb-slot cb-task-slot" data-cb="x0" data-if="context == 'construction'" data-alias-s="context_buttons[0]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
					<div class="cb-slot cb-task-slot" data-cb="x1" data-if="context == 'ocl'" data-alias-s="context_buttons[1]" data-class-live="s.shown" data-class-off="!s.enabled"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-key" data-if="s.shown &amp;&amp; s.key != ''">{{s.key}}</span></div>
					<div class="cb-task-info">
						<div class="cb-task-text">{{context_text}}</div>
						<div class="cb-task-bar" data-if="context_has_percent"><div class="cb-task-fill" data-style-width="context_percent"></div></div>
					</div>
				</div>

				<!-- Observing: the players to look at (ButtonPlayer0..7) -->
				<div class="cb-observers" data-if="observer_list_shown">
					<div class="cb-obs-player" data-for="p : observer_players" data-if="p.shown" data-attr-data-cb="'o' + it_index">
						<div class="cb-obs-side"><mappedimage data-if="p.icon != ''" data-attr-name="p.icon"/></div>
						<div class="cb-obs-name" data-style-color="p.color">{{p.name}}</div>
					</div>
				</div>

				<!-- Observing a player: name, flag, units, buildings, kills, losses and Back -->
				<div class="cb-observed" data-if="observer_info_shown">
					<div class="cb-obs-flag"><mappedimage data-if="observer_flag != ''" data-attr-name="observer_flag"/></div>
					<div class="cb-obs-main">
						<div class="cb-obs-title" data-style-color="observer_color">{{observer_name}}</div>
						<div class="cb-obs-stats">
							<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_units}}</div><div class="cb-obs-label"><gametext key="GUI:Units"/></div></div>
							<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_buildings}}</div><div class="cb-obs-label"><gametext key="GUI:Buildings"/></div></div>
							<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_kills}}</div><div class="cb-obs-label"><gametext key="GUI:UnitsKilled"/></div></div>
							<div class="cb-obs-stat"><div class="cb-obs-value">{{observer_losses}}</div><div class="cb-obs-label"><gametext key="GUI:UnitsLost"/></div></div>
						</div>
					</div>
					<div class="cb-text-btn cb-obs-back" data-cb="o8" data-alias-s="observer_buttons[8]" data-if="s.shown"><gametext key="GUI:ControlBarBack"/></div>
				</div>

				<!-- A beacon: delete it, and for our own its message (EditBeaconText; Enter sends it) -->
				<div class="cb-task cb-beacon" data-if="context == 'beacon'">
					<div class="cb-text-btn cb-beacon-delete" data-cb="x2" data-alias-s="context_buttons[2]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:DeleteBeacon"/></div>
					<div class="cb-beacon-entry" data-if="beacon_editable">
						<div class="cb-beacon-label"><gametext key="GUI:BeaconLabel"/></div>
						<div class="cb-beacon-row">
							<input type="text" id="cb-beacon-text" class="cb-input" maxlength="64" data-value="beacon_text" data-event-change="beacon_change"/>
							<div class="cb-text-btn" data-cb="x3" data-alias-s="context_buttons[3]" data-if="s.shown" data-class-off="!s.enabled"><gametext key="GUI:Clear"/></div>
						</div>
					</div>
				</div>
			</div>
			<div class="cb-frame"></div>
		</div>
		</div>

		<!-- The right-hand tower over the selection, like Pro's: the general's powers (GenPowersShortcutBar*.wnd)
		     standing on the general's tab (rank, promotions, min/max) -->
		<div class="cb-tower">
		<div class="cb-powers" data-if="shortcuts_shown">
			<div class="cb-slot cb-pslot" data-cb="p0" data-alias-s="shortcuts[0]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p1" data-alias-s="shortcuts[1]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p2" data-alias-s="shortcuts[2]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p3" data-alias-s="shortcuts[3]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p4" data-alias-s="shortcuts[4]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p5" data-alias-s="shortcuts[5]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p6" data-alias-s="shortcuts[6]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p7" data-alias-s="shortcuts[7]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p8" data-alias-s="shortcuts[8]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p9" data-alias-s="shortcuts[9]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
			<div class="cb-slot cb-pslot" data-cb="p10" data-alias-s="shortcuts[10]" data-if="s.shown" data-class-live="s.shown" data-class-off="!s.enabled &amp;&amp; !s.not_ready" data-class-poor="s.poor" data-class-checked="s.checked" data-class-flash="s.flash"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-clock" data-if="s.has_clock" data-style-height="s.clock"></div></div><span class="cb-key" data-if="s.key != ''">{{s.key}}</span><span class="cb-text" data-if="s.text != ''">{{s.text}}</span></div>
		</div>
		<div class="cb-tab">
			<div class="cb-rank" data-cb="i2" data-if="!observer_list_shown &amp;&amp; !observer_info_shown"><span class="cb-star" data-class-on="rank &gt;= 1">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 2">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 3">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 4">&#9733;</span><span class="cb-star" data-class-on="rank &gt;= 5">&#9733;</span></div>
			<div class="cb-rank" data-if="observer_list_shown || observer_info_shown"></div>
			<div class="cb-side-btn cb-general" data-cb="s4" data-alias-s="side_buttons[4]" data-if="s.shown" data-class-off="!s.enabled" data-class-lit="general_lit"><span class="cb-glyph">&#9733;</span><span class="cb-badge" data-if="science_points &gt; 0">{{science_points}}</span></div>
			<div class="cb-tab-row">
			<div class="cb-side-btn cb-minmax" data-cb="s5" data-alias-s="side_buttons[5]" data-if="s.shown" data-class-off="!s.enabled"><span class="cb-glyph" data-if="!low">&#9662;</span><span class="cb-glyph" data-if="low">&#9652;</span></div>
			</div>
		</div>
		</div>

		<!-- The selection: name, portrait, veterancy and upgrades, or the build queue, and the general's experience, bottom right -->
		<div class="cb-panel cb-unit">
			<div class="cb-skin"></div>
			<div class="cb-unit-head">
				<div class="cb-name" data-if="portrait_shown || queue_shown">{{name}}</div>
				<div class="cb-count" data-if="select_count &gt; 1 &amp;&amp; (portrait_shown || queue_shown)">&#215;{{select_count}}</div>
			</div>
			<div class="cb-unit-body">
				<div class="cb-cells">
					<div class="cb-cell cb-cell0"></div><div class="cb-cell cb-cell1"></div><div class="cb-cell cb-cell2"></div><div class="cb-cell cb-cell3"></div><div class="cb-cell cb-cell4"></div><div class="cb-cell cb-cell5"></div><div class="cb-cell cb-cell6"></div><div class="cb-cell cb-cell7"></div><div class="cb-cell cb-cell8"></div>
					<div class="cb-emblem" data-if="!portrait_shown &amp;&amp; !queue_shown &amp;&amp; select_count &lt;= 1 &amp;&amp; !cameo_movie"><mappedimage class="cb-emblem-img" name="WatermarkUSA" data-if="!observer &amp;&amp; side == 'usa'"/><mappedimage class="cb-emblem-img" name="WatermarkChina" data-if="!observer &amp;&amp; side == 'china'"/><mappedimage class="cb-emblem-img" name="WatermarkGLA" data-if="!observer &amp;&amp; side == 'gla'"/></div>
					<div class="cb-multi" data-if="!portrait_shown &amp;&amp; !queue_shown &amp;&amp; select_count &gt; 1"><span class="cb-multi-x">&#215;</span>{{select_count}}</div>
					<div class="cb-portrait" data-if="portrait_shown">
						<div class="cb-win">
							<mappedimage data-if="portrait != ''" data-attr-name="portrait"/>
							<div class="cb-portrait-vet" data-if="portrait_overlay != ''"><mappedimage data-attr-name="portrait_overlay"/></div>
						</div>
					</div>
					<div class="cb-upgrades" data-if="portrait_shown">
						<div class="cb-upgrade cb-up0" data-alias-u="upgrades[0]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
						<div class="cb-upgrade cb-up1" data-alias-u="upgrades[1]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
						<div class="cb-upgrade cb-up2" data-alias-u="upgrades[2]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
						<div class="cb-upgrade cb-up3" data-alias-u="upgrades[3]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
						<div class="cb-upgrade cb-up4" data-alias-u="upgrades[4]" data-if="u.shown" data-class-owned="u.owned"><div class="cb-win"><mappedimage data-if="u.icon != ''" data-attr-name="u.icon"/></div></div>
					</div>
					<video class="cb-cameo-movie" source="cameo-movie" fit="cover" data-if="cameo_movie"></video>
					<div class="cb-queue" data-if="queue_shown">
						<div class="cb-slot cb-qslot" data-cb="q0" data-alias-s="queue[0]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div><div class="cb-clock" data-if="s.shown &amp;&amp; s.has_clock" data-style-height="s.clock"></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q1" data-alias-s="queue[1]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q2" data-alias-s="queue[2]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q3" data-alias-s="queue[3]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q4" data-alias-s="queue[4]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q5" data-alias-s="queue[5]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q6" data-alias-s="queue[6]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q7" data-alias-s="queue[7]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
						<div class="cb-slot cb-qslot" data-cb="q8" data-alias-s="queue[8]" data-class-live="s.shown &amp;&amp; s.icon != ''"><div class="cb-win"><div class="cb-art" data-if="s.shown &amp;&amp; s.icon != ''"><mappedimage data-attr-name="s.icon"/></div><div class="cb-vet" data-if="s.shown &amp;&amp; s.overlay != ''"><mappedimage data-attr-name="s.overlay"/></div></div></div>
					</div>
				</div>
				<div class="cb-exp" data-if="!observer_list_shown &amp;&amp; !observer_info_shown"><div class="cb-exp-fill" data-style-height="experience"></div><div class="cb-exp-seg"></div></div>
			</div>
			<div class="cb-frame"></div>
		</div>

		<!-- The general's promotions (GeneralsExpPoints.wnd): the rank, points to spend and the three tiers -->
		<div class="cb-panel cb-science" id="cb-science" data-if="science_shown">
			<div class="cb-sci-head">
				<div class="cb-sci-title">{{science_title}}</div>
				<div class="cb-sci-points" data-if="science_points &gt; 0"><span class="cb-sci-star">&#9733;</span>{{science_points}}</div>
			</div>
			<div class="cb-sci-exp"><div class="cb-sci-exp-fill" data-style-width="experience"></div></div>
			<div class="cb-sci-tier"><gametext key="GUI:Rank1Required"/></div>
			<div class="cb-sci-row"><div class="cb-slot cb-sci" data-cb="g0" data-alias-s="sciences[0]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g1" data-alias-s="sciences[1]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g2" data-alias-s="sciences[2]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g3" data-alias-s="sciences[3]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div></div>
			<div class="cb-sci-tier"><gametext key="GUI:Rank3Required"/></div>
			<div class="cb-sci-row cb-sci-rank3"><div class="cb-slot cb-sci" data-cb="g4" data-alias-s="sciences[4]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g5" data-alias-s="sciences[5]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g6" data-alias-s="sciences[6]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g7" data-alias-s="sciences[7]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div class="cb-win"><div class="cb-art" data-if="s.icon != ''"><mappedimage data-attr-name="s.icon"/></div></div><span class="cb-owned" data-if="s.poor &amp;&amp; !s.enabled">&#10003;</span></div><div class="cb-slot cb-sci" data-cb="g8" data-alias-s="sciences[8]" data-if="s.shown" data-class-live="s.shown" data-class-owned="s.poor &amp;&amp; !s.enabled" data-class-buy="s.enabled" data-class-off="!s.enabled &amp;&amp; !s.poor"><div c