			<div class="cb-sci-title">{{science_title}}</div>
		</div>

		<!-- The build tooltip above the radar, where Pro puts it (ControlBarPopupDescription.wnd): name, hotkey, cost, then
		     what it does and what it still needs, as ControlBar::populateBuildTooltipLayout() words it. -->
		<div class="cb-panel cb-tip" data-if="tooltip_shown">
			<div class="cb-tip-head">
				<div class="cb-tip-name">{{tooltip_name}}</div>
				<div class="cb-tip-key" data-if="tooltip_key != ''">{{tooltip_key}}</div>
			</div>
			<div class="cb-tip-cost" data-if="tooltip_cost != ''">{{tooltip_cost}}</div>
			<div class="cb-tip-desc" data-if="tooltip_description != ''">{{tooltip_description}}</div>
		</div>
	</div>
</body>
</rml>
