<rml>
<head>
	<title>JoinGame</title>
	<link type="text/rcss" href="common.rcss"/>
	<link type="text/rcss" href="JoinGame.rcss"/>
</head>
<body data-model="joingame">
	<div class="frame joingame-frame">
		<!-- ButtonCancel: a small X-icon close button in the .wnd's top-right corner, not a text button. -->
		<button class="joingame-close" data-event-click="cancel">X</button>

		<div class="row">
			<div class="label"><gametext key="GUI:GameName"/></div>
			<div class="control">{{lobby_name}}</div>
		</div>
		<div class="row">
			<div class="label"><gametext key="GUI:Password"/></div>
			<input type="password" class="control joingame-input" data-value="password" maxlength="10" data-event-change="password_committed"/>
		</div>
	</div>
</body>
</rml>
