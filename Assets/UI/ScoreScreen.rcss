/*
	ScoreScreen.rcss -- score table/chat/academy layout specific to ScoreScreen.rml.
	Palette/frame/button/scroll-container rules come from common.rcss.
*/

body
{
	width: 1200dp;
	height: 760dp;
	left: 50%;
	top: 50%;
	margin-left: -600dp;
	margin-top: -380dp;
}

.background
{
	position: absolute;
	width: 100%;
	height: 100%;
}

.panel
{
	position: relative;
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	width: 100%;
	height: 100%;
}

/* Wraps table/academy/chat (everything but the challenge splash). Needs to be a flex column
   itself and grow to fill .panel's leftover space -- otherwise .chat's flex:1 1 auto (below) is
   inert (its parent isn't a flex container), .chat never grows to fill the remaining height, and
   the footer ends up overlapping it instead of sitting cleanly below. */
.content
{
	display: flex;
	flex-direction: column;
	flex: 1 1 auto;
	min-height: 0;
}

/* ---- Player table -------------------------------------------------------------------- */
.table-header,
.table-row
{
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4dp 8dp;
	min-height: 36dp;
	box-sizing: border-box;
}

.table-row
{
	border-bottom: 1dp rgba(47, 55, 168, 80);
}

.table-header
{
	font-weight: bold;
	color: #8080FF;
	border-bottom: 1dp #2F37A8;
	min-height: 52dp;
}

.table-row.observer
{
	color: #C0C0C0;
}

.col-icon
{
	flex: 0 0 auto;
	width: 24dp;
	height: 24dp;
	margin-right: 8dp;
}

.col-name
{
	flex: 1 1 auto;
}

.col-stat
{
	flex: 0 0 auto;
	width: 112dp;
	margin-left: 8dp;
	text-align: right;
}

.table-body
{
	max-height: 300dp;
}

/* ---- Academy advice -------------------------------------------------------------------- */
.academy
{
	margin-top: 12dp;
	border-top: 1dp #2F37A8;
	padding-top: 12dp;
}

.academy-tip
{
	display: block;
}

.academy-body
{
	max-height: 90dp;
}

/* ---- Chat ---------------------------------------------------------------------------------
   The shared .chat/.chat-log (common.rcss), but sized by the leftover panel height instead of a
   fixed 140dp, and with the border/padding on .chat-border (only when the .wnd's chat box has one)
   instead of on the log itself. */
.chat
{
	display: block;
	height: auto;
	flex: 1 1 0%;
	min-height: 0;
}

.chat-border .chat-log
{
	border: 0dp transparent;
	padding: 0;
	background-color: transparent;
}

.chat-border
{
	display: flex;
	flex-direction: column;
	box-sizing: border-box;
	height: 100%;
	min-height: 0;
}

.chat-border.bordered
{
	border: 1dp #2F37A8;
	padding: 8dp;
}

/* ---- Challenge win/loss splash (single player), replaces the table/academy/chat -------- */
.challenge-splash
{
	display: flex;
	flex-direction: column;
	align-items: center;
	flex: 1 1 auto;
	padding-top: 24dp;
	text-align: center;
}

.challenge-portrait
{
	width: 128dp;
	height: 128dp;
	margin-bottom: 12dp;
}

.challenge-header
{
	font-size: 18dp;
	font-weight: bold;
	margin-bottom: 8dp;
}

/* ---- Save indicator (single player, campaign not yet complete) ------------------------- */
.save-game-text
{
	text-align: center;
	margin-top: 4dp;
}
