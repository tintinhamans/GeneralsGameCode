/*
	BuddyToast.rcss -- PopupBuddyListNotification.wnd (the bottom-right buddy notification toast).
	Persistent document, always loaded; visibility is driven by data-if="visible" on the one div
	below rather than Show()/Hide() (see RmlBuddyToastScreen.cpp), so body itself stays plain.
*/

/* Full-screen so the fixed toast has a viewport to sit in, but the empty part must not take the
   mouse from what is under it (the toast div turns pointer events back on). */
body
{
	width: 100%;
	height: 100%;
	pointer-events: none;
	z-index: 60; /* above the social dock (SocialDock.rcss), which a click on the toast opens */
}

/* The template's look (common.rcss): a dark surface with the buddy-blue edge of the social dock,
   Barlow body text, lit on hover like a row. */
.buddy-toast
{
	display: block;
	position: fixed;
	right: 72dp; /* in the bottom ruler band, clear of the frame line and the action bar */
	bottom: 8dp;
	max-width: 360dp;
	padding: 12dp 18dp 12dp 16dp;
	font-size: 18dp;
	line-height: 24dp;
	font-weight: bold;
	color: #EEF1FA;
	background-color: #070A1AF2;
	border-left: 4dp #14B1FF;
	pointer-events: auto;
	z-index: 200; /* above .context-menu's 101, same "always on top" role the .wnd's SEE_THRU toast had */
}

.buddy-toast:hover
{
	background-color: #141A3EF2;
	color: #FFFFFF;
}
